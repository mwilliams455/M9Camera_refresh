diff --git a/app/src/main/cpp/colourtrial1c/upstream/include/m9simd_portable.h b/app/src/main/cpp/colourtrial1c/upstream/include/m9simd_portable.h
new file mode 100644
index 0000000..0ed3bc5
--- /dev/null
+++ b/app/src/main/cpp/colourtrial1c/upstream/include/m9simd_portable.h
@@ -0,0 +1,117 @@
+////////////////////////////////////////////////////////////////
+//
+//  AMAZESIMD350: portable 4-lane float implementation of exactly the SSE2 helpers
+//  that AMaZE's vector path uses, written with GCC/clang vector extensions so the
+//  same source compiles to NEON on arm64 and to SSE on x86.
+//
+//  Every helper reproduces the SSE2 semantics it replaces bit for bit:
+//  IEEE add/sub/mul/div per lane (no fused multiply-add: build with
+//  -ffp-contract=off), _mm_min_ps/_mm_max_ps operand order on NaN and equality,
+//  ordered compares producing all-ones/zero lane masks, bitwise selects, and the
+//  _mm_set_* argument order. It is only used when __SSE2__ is not defined.
+//
+////////////////////////////////////////////////////////////////
+#ifndef M9SIMD_PORTABLE_H
+#define M9SIMD_PORTABLE_H
+
+#if defined(__SSE2__)
+#error "m9simd_portable.h replaces SSE2; use helpersse2.h on x86"
+#endif
+
+#include <stdint.h>
+#include <string.h>
+
+#ifndef INLINE
+#define INLINE __inline
+#endif
+
+typedef float vfloat __attribute__((vector_size(16)));
+typedef int32_t vint __attribute__((vector_size(16)));
+typedef vint vmask;
+typedef int8_t m9vi8 __attribute__((vector_size(16)));
+typedef uint8_t m9vu8 __attribute__((vector_size(16)));
+
+static INLINE vfloat m9_loadu_ps(const float* p) { vfloat v; memcpy(&v, p, sizeof v); return v; }
+static INLINE void m9_storeu_ps(float* p, vfloat v) { memcpy(p, &v, sizeof v); }
+
+#define LVF(x) m9_loadu_ps((const float*)&(x))
+#define LVFU(x) m9_loadu_ps(&(x))
+#define STVF(x,y) m9_storeu_ps(&(x),(y))
+#define STVFU(x,y) m9_storeu_ps(&(x),(y))
+
+static INLINE vfloat m9_set1_ps(float a) { return (vfloat){a, a, a, a}; }
+#define F2V(a) m9_set1_ps((a))
+#define ZEROV m9_set1_ps(0.f)
+
+// _mm_set_ps / _mm_set_epi32 take the highest lane first.
+static INLINE vfloat _mm_set_ps(float e3, float e2, float e1, float e0) { return (vfloat){e0, e1, e2, e3}; }
+static INLINE vint _mm_set_epi32(int e3, int e2, int e1, int e0) { return (vint){e0, e1, e2, e3}; }
+
+static INLINE vint _mm_load_si128(const vint* p) { vint v; memcpy(&v, p, sizeof v); return v; }
+static INLINE vint _mm_loadu_si128(const vint* p) { vint v; memcpy(&v, p, sizeof v); return v; }
+static INLINE void _mm_store_si128(vint* p, vint v) { memcpy(p, &v, sizeof v); }
+
+static INLINE vint _mm_set1_epi8(char value) {
+    const int8_t c = (int8_t)value;  // same bit pattern whether char is signed (x86) or unsigned (arm64)
+    m9vi8 v = {c, c, c, c, c, c, c, c, c, c, c, c, c, c, c, c};
+    return (vint)v;
+}
+// Signed saturating byte add: wrap in unsigned arithmetic, then clamp the lanes that overflowed.
+static INLINE vint _mm_adds_epi8(vint a, vint b) {
+    const m9vu8 ua = (m9vu8)a, ub = (m9vu8)b, sum = ua + ub;
+    const m9vu8 overflow = (m9vu8)(((m9vi8)(~(ua ^ ub) & (ua ^ sum))) >> 7);
+    const m9vu8 saturated = (ua >> 7) + (m9vu8){0x7f, 0x7f, 0x7f, 0x7f, 0x7f, 0x7f, 0x7f, 0x7f,
+                                                0x7f, 0x7f, 0x7f, 0x7f, 0x7f, 0x7f, 0x7f, 0x7f};
+    return (vint)((saturated & overflow) | (sum & ~overflow));
+}
+static INLINE vint _mm_cmpgt_epi8(vint a, vint b) { return (vint)((m9vi8)a > (m9vi8)b); }
+static INLINE vint _mm_cmplt_epi8(vint a, vint b) { return (vint)((m9vi8)a < (m9vi8)b); }
+static INLINE int _mm_movemask_ps(vfloat v) {
+    const vint negative = (vint)v < (vint){0, 0, 0, 0};
+    return (negative[0] & 1) | (negative[1] & 2) | (negative[2] & 4) | (negative[3] & 8);
+}
+
+static INLINE vmask vandm(vmask x, vmask y) { return x & y; }
+static INLINE vmask vandnotm(vmask x, vmask y) { return ~x & y; }
+static INLINE vmask vorm(vmask x, vmask y) { return x | y; }
+static INLINE vmask vnotm(vmask x) { return ~x; }
+
+static INLINE vmask vmaskf_lt(vfloat x, vfloat y) { return (vmask)(x < y); }
+static INLINE vmask vmaskf_le(vfloat x, vfloat y) { return (vmask)(x <= y); }
+static INLINE vmask vmaskf_gt(vfloat x, vfloat y) { return (vmask)(x > y); }
+static INLINE vmask vmaskf_ge(vfloat x, vfloat y) { return (vmask)(x >= y); }
+static INLINE vmask vmaskf_eq(vfloat x, vfloat y) { return (vmask)(x == y); }
+
+static INLINE vfloat vself(vmask mask, vfloat x, vfloat y) { return (vfloat)((mask & (vmask)x) | (~mask & (vmask)y)); }
+static INLINE vint vselc(vmask mask, vint x, vint y) { return (mask & x) | (~mask & y); }
+static INLINE vint vselinotzero(vmask mask, vint x) { return ~mask & x; }
+static INLINE vfloat vselfzero(vmask mask, vfloat x) { return (vfloat)(mask & (vmask)x); }
+static INLINE vfloat vselfnotzero(vmask mask, vfloat x) { return (vfloat)(~mask & (vmask)x); }
+
+// _mm_min_ps(x, y) is x < y ? x : y and _mm_max_ps(x, y) is x > y ? x : y, lane by lane.
+static INLINE vfloat vminf(vfloat x, vfloat y) { return vself(vmaskf_lt(x, y), x, y); }
+static INLINE vfloat vmaxf(vfloat x, vfloat y) { return vself(vmaskf_gt(x, y), x, y); }
+static INLINE vfloat vabsf(vfloat f) { return (vfloat)((vmask)f & (vmask){0x7fffffff, 0x7fffffff, 0x7fffffff, 0x7fffffff}); }
+static INLINE vfloat LIMV(vfloat a, vfloat b, vfloat c) { return vmaxf(b, vminf(a, c)); }
+static INLINE vfloat SQRV(vfloat a) { return a * a; }
+static INLINE vfloat vmul2f(vfloat a) { return a + a; }
+static INLINE vfloat vintpf(vfloat a, vfloat b, vfloat c) { return a * (b - c) + c; }
+static INLINE vfloat vadivapb(vfloat a, vfloat b) { return a / (a + b); }
+// _mm_unpacklo_ps(a, a)
+static INLINE vfloat vdup(vfloat a) { return (vfloat){a[0], a[0], a[1], a[1]}; }
+
+// _mm_shuffle_ps(a1, a2, _MM_SHUFFLE(2,0,2,0)) over a[0..7]
+static INLINE vfloat LC2VFU(float& a) {
+    const vfloat a1 = m9_loadu_ps(&a), a2 = m9_loadu_ps((&a) + 4);
+    return (vfloat){a1[0], a1[2], a2[0], a2[2]};
+}
+// Stores v into a[0], a[2], a[4], a[6]; a[1], a[3], a[5], a[7] are left unchanged.
+#define STC2VFU(a,v) { const vfloat M9STC2V = (v); (&(a))[0] = M9STC2V[0]; (&(a))[2] = M9STC2V[1];\
+                       (&(a))[4] = M9STC2V[2]; (&(a))[6] = M9STC2V[3]; }
+// { a[0]+a[1], a[2]+a[3], a[4]+a[5], a[6]+a[7] }, summed in the same lane order as SSE2.
+static INLINE vfloat vaddc2vfu(float& a) {
+    const vfloat a1 = m9_loadu_ps(&a), a2 = m9_loadu_ps((&a) + 4);
+    return (vfloat){a1[0], a1[2], a2[0], a2[2]} + (vfloat){a1[1], a1[3], a2[1], a2[3]};
+}
+
+#endif

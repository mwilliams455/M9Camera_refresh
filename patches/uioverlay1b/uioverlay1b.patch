diff --git a/app/src/test/java/com/particlesdevs/photoncamera/ui/camera/views/M9LinearRulerSelectionTest.java b/app/src/test/java/com/particlesdevs/photoncamera/ui/camera/views/M9LinearRulerSelectionTest.java
new file mode 100644
--- /dev/null
+++ b/app/src/test/java/com/particlesdevs/photoncamera/ui/camera/views/M9LinearRulerSelectionTest.java
@@ -0,0 +1,89 @@
+package com.particlesdevs.photoncamera.ui.camera.views;
+
+import com.particlesdevs.photoncamera.circularbarlib.ui.views.knobview.KnobItemInfo;
+import com.particlesdevs.photoncamera.circularbarlib.ui.views.knobview.KnobView;
+import com.particlesdevs.photoncamera.circularbarlib.ui.views.knobview.KnobViewChangedListener;
+import org.junit.Test;
+import java.util.Arrays;
+import java.util.ArrayList;
+import java.util.List;
+import static org.junit.Assert.*;
+
+public class M9LinearRulerSelectionTest {
+    static KnobItemInfo item(String label, int tick, double value) {
+        return new KnobItemInfo(null, label, tick, value);
+    }
+    static class Recorder implements KnobViewChangedListener {
+        int calls;
+        KnobItemInfo oldItem, selected;
+        public void onRotationStateChanged(KnobView view, KnobView.RotationState state) {}
+        public void onSelectedKnobItemChanged(KnobView view, KnobItemInfo old, KnobItemInfo value) {
+            calls++; oldItem = old; selected = value;
+        }
+    }
+
+    @Test public void evRunsNegativeToPositiveAndRetainsExactThirds() {
+        KnobItemInfo zero = item("0.0", 0, 0), plus = item("+0.3", 1, 1.0/3), minus = item("−0.3", -1, -1.0/3);
+        List<KnobItemInfo> original = new ArrayList<>(Arrays.asList(zero, plus, minus));
+        Recorder recorder = new Recorder(); M9LinearRulerSelection selection = new M9LinearRulerSelection();
+        selection.bind(original, 0, recorder);
+        assertEquals(1, selection.index()); assertEquals(0, recorder.calls);
+        assertEquals(Arrays.asList(zero, plus, minus), original); // No mutations of Photon models' order.
+        selection.select(0, null);
+        assertSame(minus, recorder.selected); assertSame(zero, recorder.oldItem);
+        assertEquals(-1.0/3, recorder.selected.value, 0);
+        selection.select(2, null); assertSame(plus, recorder.selected);
+    }
+
+    @Test public void shutterSelectionPassesOriginalNanosecondsWithoutRounding() {
+        KnobItemInfo auto = item("A", 0, 0), fast = item("1/125", 1, 7999999), slow = item("24s", 2, 24000123456d);
+        Recorder recorder = new Recorder(); M9LinearRulerSelection selection = new M9LinearRulerSelection();
+        selection.bind(Arrays.asList(auto, fast, slow), fast.value, recorder);
+        assertEquals(0, recorder.calls);
+        assertFalse(selection.select(1, null));
+        assertTrue(selection.select(2, null));
+        assertSame(slow, recorder.selected); assertEquals(24000123456d, recorder.selected.value, 0);
+    }
+
+    @Test public void autofocusAndDescendingFocusDistancesKeepTheirDeviceOrder() {
+        KnobItemInfo auto = item("A", 0, -1), near = item("8.0", 1, 8), far = item("0.0", 2, 0);
+        Recorder recorder = new Recorder(); M9LinearRulerSelection selection = new M9LinearRulerSelection();
+        selection.bind(Arrays.asList(far, auto, near), -1, recorder);
+        selection.select(1, null); assertSame(near, recorder.selected);
+        selection.select(2, null); assertSame(far, recorder.selected);
+        selection.select(0, null); assertSame(auto, recorder.selected);
+    }
+
+    @Test public void dragTapAndEndpointsUseHorizontalDistance() {
+        assertEquals(7, M9LinearRulerSelection.draggedPosition(5, -40, 20, 20), 0);
+        assertEquals(3, M9LinearRulerSelection.draggedPosition(5, 40, 20, 20), 0);
+        assertEquals(0, M9LinearRulerSelection.draggedPosition(0, 5000, 20, 20), 0);
+        assertEquals(19, M9LinearRulerSelection.draggedPosition(19, -5000, 20, 20), 0);
+        assertEquals(7, M9LinearRulerSelection.tappedIndex(5, 240, 200, 20, 20));
+        assertEquals(3, M9LinearRulerSelection.tappedIndex(5, 160, 200, 20, 20));
+        assertEquals(0, M9LinearRulerSelection.clampPosition(Float.NaN, 20), 0);
+    }
+
+    @Test public void lensRebindAndVisualResetCannotApplyStaleChoices() {
+        Recorder previous = new Recorder(), active = new Recorder();
+        M9LinearRulerSelection selection = new M9LinearRulerSelection();
+        selection.bind(Arrays.asList(item("A", 0, 0), item("1600", 1, 1600)), 1600, previous);
+        KnobItemInfo auto = item("A", 0, 0), upper = item("800", 1, 800);
+        selection.bind(Arrays.asList(auto, upper), 0, active);
+        selection.select(999, null); assertSame(upper, active.selected);
+        assertEquals(0, previous.calls);
+        selection.syncReset(); assertSame(auto, selection.current());
+        assertEquals(1, active.calls); // Console owns the actual reset, not this visual sync.
+        assertFalse(selection.select(0, null));
+    }
+
+    @Test public void missingAndSingleValueControlsAreSafe() {
+        M9LinearRulerSelection selection = new M9LinearRulerSelection();
+        selection.bind(null, 0, null); assertNull(selection.current()); assertFalse(selection.select(1, null));
+        Recorder recorder = new Recorder();
+        KnobItemInfo fixed = item("Fixed", 0, -1);
+        selection.bind(Arrays.asList(fixed), -1, recorder);
+        assertFalse(selection.select(Integer.MAX_VALUE, null)); assertEquals(0, recorder.calls);
+        assertEquals(0, M9LinearRulerSelection.draggedPosition(0, -100, 20, 1), 0);
+    }
+}

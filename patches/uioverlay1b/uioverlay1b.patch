+package com.particlesdevs.photoncamera.ui.camera.views;
+
+import android.content.Context;
+import android.graphics.Canvas;
+import android.graphics.Paint;
+import android.graphics.Typeface;
+import android.os.Bundle;
+import android.util.AttributeSet;
+import android.view.KeyEvent;
+import android.view.MotionEvent;
+import android.view.ViewConfiguration;
+import android.view.accessibility.AccessibilityEvent;
+import android.view.accessibility.AccessibilityNodeInfo;
+import androidx.core.content.ContextCompat;
+import com.particlesdevs.photoncamera.R;
+import com.particlesdevs.photoncamera.circularbarlib.ui.views.knobview.KnobInfo;
+import com.particlesdevs.photoncamera.circularbarlib.ui.views.knobview.KnobItemInfo;
+import com.particlesdevs.photoncamera.circularbarlib.ui.views.knobview.KnobView;
+import com.particlesdevs.photoncamera.circularbarlib.ui.views.knobview.KnobViewChangedListener;
+import com.particlesdevs.photoncamera.circularbarlib.ui.views.knobview.Rotation;
+import java.util.List;
+import java.util.function.BooleanSupplier;
+
+/** Flat, horizontal replacement implementing the accepted manual-console view contract. */
+public final class M9LinearManualView extends KnobView {
+    private final M9LinearRulerSelection selection = new M9LinearRulerSelection();
+    private final Paint paint = new Paint(Paint.ANTI_ALIAS_FLAG);
+    private final int touchSlop;
+    private BooleanSupplier interactionAllowed = () -> false;
+    private String controlLabel = "";
+    private float position, downX, downPosition;
+    private boolean touching, dragged;
+
+    public M9LinearManualView(Context context, AttributeSet attrs) {
+        super(context, attrs);
+        touchSlop = ViewConfiguration.get(context).getScaledTouchSlop();
+        paint.setTextAlign(Paint.Align.CENTER);
+        setFocusable(true);
+        setClickable(true);
+        setImportantForAccessibility(IMPORTANT_FOR_ACCESSIBILITY_YES);
+        setBackgroundResource(R.drawable.m9_overlay_panel_bg);
+        setClipToOutline(true);
+    }
+
+    public void setInteractionAllowed(BooleanSupplier allowed) { interactionAllowed = allowed; }
+    public void setControlLabel(String label) { controlLabel = label; describe(); invalidate(); }
+
+    @Override public void setPrimaryWheel(KnobInfo info, List<KnobItemInfo> items, double value,
+                                         KnobViewChangedListener listener) {
+        cancelTouchEvent();
+        selection.bind(items, value, listener);
+        position = selection.index();
+        describe();
+        invalidate();
+    }
+
+    // One active straight ruler; the console still remembers values for the other controls.
+    @Override public void setSecondaryWheel(KnobInfo info, List<KnobItemInfo> items, double value,
+                                           KnobViewChangedListener listener) {}
+    @Override public void clearSecondaryWheel() {}
+    @Override public void setDomeProgress(float progress) {} // Visibility still uses the inherited alpha animation.
+    @Override public void setKnobItemsRotation(Rotation rotation) {} // Labels share one horizontal baseline.
+    @Override protected void onSizeChanged(int w, int h, int oldw, int oldh) {} // No circular geometry.
+    @Override public KnobItemInfo getCurrentKnobItem() { return selection.current(); }
+    @Override public int getTick() { return selection.current() == null ? 0 : selection.current().tick; }
+    @Override public void resetKnob() {
+        cancelTouchEvent();
+        selection.syncReset(); // The console's following model.resetModel() performs the real reset.
+        position = selection.index();
+        describe();
+        invalidate();
+    }
+
+    @Override protected void onDraw(Canvas canvas) {
+        super.onDraw(canvas);
+        if (selection.current() == null) return;
+        float centre = getWidth() / 2f;
+        float spacing = dp(20);
+        canvas.save();
+        canvas.clipRect(dp(8), 0, getWidth() - dp(8), getHeight());
+        paint.setColor(ContextCompat.getColor(getContext(), R.color.cam_on_surface));
+        paint.setTypeface(Typeface.create(Typeface.DEFAULT, Typeface.BOLD));
+        paint.setTextSize(sp(16));
+        canvas.drawText(controlLabel + " · " + selection.current().text, centre, dp(26), paint);
+        paint.setTypeface(Typeface.DEFAULT);
+        paint.setTextSize(sp(12));
+        paint.setStrokeWidth(dp(1));
+        int stride = selection.item(0).tick < 0 ? 3 : 4;
+        float longest = 0;
+        for (int i = 0; i < selection.size(); i++) longest = Math.max(longest, paint.measureText(selection.item(i).text));
+        while (stride * spacing < longest + dp(14)) stride += selection.item(0).tick < 0 ? 3 : 4;
+        boolean autoFirst = selection.item(0).tick == 0 && selection.item(0).value <= 0;
+        for (int i = 0; i < selection.size(); i++) {
+            float x = centre + (i - position) * spacing;
+            if (x < -longest || x > getWidth() + longest) continue;
+            KnobItemInfo item = selection.item(i);
+            boolean major = i == 0 || i == selection.size() - 1 || (item.tick - (autoFirst ? 1 : 0)) % stride == 0;
+            paint.setColor(ContextCompat.getColor(getContext(), R.color.cam_on_surface_variant));
+            canvas.drawLine(x, dp(major ? 48 : 55), x, dp(68), paint);
+            if (major) canvas.drawText(item.text, x, dp(89), paint);
+        }
+        paint.setColor(ContextCompat.getColor(getContext(), R.color.cam_primary));
+        paint.setStrokeWidth(dp(2));
+        canvas.drawLine(centre, dp(41), centre, dp(71), paint);
+        canvas.restore();
+    }
+
+    private boolean canInteract() { return isEnabled() && selection.size() > 1 && interactionAllowed.getAsBoolean(); }
+
+    @Override public boolean onTouchEvent(MotionEvent event) {
+        if (!canInteract()) { cancelTouchEvent(); return false; }
+        switch (event.getActionMasked()) {
+            case MotionEvent.ACTION_DOWN:
+                touching = true; dragged = false;
+                downX = event.getX(); downPosition = position;
+                if (getParent() != null) getParent().requestDisallowInterceptTouchEvent(true);
+                selection.movement(this, RotationState.STARTING);
+                return true;
+            case MotionEvent.ACTION_MOVE:
+                if (!touching) return false;
+                if (Math.abs(event.getX() - downX) > touchSlop) dragged = true;
+                if (dragged) {
+                    position = M9LinearRulerSelection.draggedPosition(downPosition, event.getX() - downX, dp(20), selection.size());
+                    selection.movement(this, RotationState.ROTATING);
+                    choose(Math.round(position));
+                    invalidate();
+                }
+                return true;
+            case MotionEvent.ACTION_UP:
+                if (!touching) return false;
+                if (!dragged) {
+                    choose(M9LinearRulerSelection.tappedIndex(position, event.getX(), getWidth() / 2f, dp(20), selection.size()));
+                    performClick();
+                }
+                cancelTouchEvent();
+                return true;
+            case MotionEvent.ACTION_CANCEL:
+                cancelTouchEvent();
+                return true;
+            default: return touching;
+        }
+    }
+
+    private boolean choose(int index) {
+        if (!canInteract()) return false; // Recheck at dispatch, including mid-gesture save/capture locks.
+        boolean changed = selection.select(index, this);
+        if (changed) { describe(); sendAccessibilityEvent(AccessibilityEvent.TYPE_VIEW_SELECTED); }
+        return changed;
+    }
+
+    @Override public void cancelTouchEvent() {
+        if (touching) {
+            selection.movement(this, RotationState.STOPPING);
+            selection.movement(this, RotationState.IDLE);
+        }
+        touching = false; dragged = false;
+        position = selection.index();
+        if (getParent() != null) getParent().requestDisallowInterceptTouchEvent(false);
+        invalidate();
+    }
+
+    @Override public void onCancelPendingInputEvents() { cancelTouchEvent(); }
+    @Override protected void onDetachedFromWindow() { cancelTouchEvent(); super.onDetachedFromWindow(); }
+    @Override public boolean performClick() { super.performClick(); return true; }
+
+    @Override public boolean onKeyDown(int keyCode, KeyEvent event) {
+        if (canInteract() && (keyCode == KeyEvent.KEYCODE_DPAD_LEFT || keyCode == KeyEvent.KEYCODE_DPAD_RIGHT)) {
+            choose(selection.index() + (keyCode == KeyEvent.KEYCODE_DPAD_LEFT ? -1 : 1));
+            position = selection.index(); invalidate(); return true;
+        }
+        return super.onKeyDown(keyCode, event);
+    }
+
+    @Override public void onInitializeAccessibilityNodeInfo(AccessibilityNodeInfo info) {
+        super.onInitializeAccessibilityNodeInfo(info);
+        info.setClassName("android.widget.SeekBar");
+        if (selection.size() > 1) {
+            info.setRangeInfo(AccessibilityNodeInfo.RangeInfo.obtain(AccessibilityNodeInfo.RangeInfo.RANGE_TYPE_INT,
+                    0, selection.size() - 1, selection.index()));
+            if (canInteract()) {
+                info.addAction(AccessibilityNodeInfo.AccessibilityAction.ACTION_SCROLL_FORWARD);
+                info.addAction(AccessibilityNodeInfo.AccessibilityAction.ACTION_SCROLL_BACKWARD);
+                info.addAction(AccessibilityNodeInfo.AccessibilityAction.ACTION_SET_PROGRESS);
+            }
+        }
+    }
+
+    @Override public boolean performAccessibilityAction(int action, Bundle args) {
+        if (!canInteract()) return false;
+        int target;
+        if (action == AccessibilityNodeInfo.ACTION_SCROLL_FORWARD) target = selection.index() + 1;
+        else if (action == AccessibilityNodeInfo.ACTION_SCROLL_BACKWARD) target = selection.index() - 1;
+        else if (action == AccessibilityNodeInfo.AccessibilityAction.ACTION_SET_PROGRESS.getId() && args != null) {
+            target = Math.round(args.getFloat(AccessibilityNodeInfo.ACTION_ARGUMENT_PROGRESS_VALUE, selection.index()));
+        } else return super.performAccessibilityAction(action, args);
+        boolean changed = choose(target);
+        position = selection.index(); invalidate(); return changed;
+    }
+
+    private void describe() {
+        setContentDescription(controlLabel + (selection.current() == null ? "" : ", " + selection.current().text));
+    }
+    private float dp(float value) { return value * getResources().getDisplayMetrics().density; }
+    private float sp(float value) { return value * getResources().getDisplayMetrics().scaledDensity; }
+}

+++ b/app/src/main/java/com/particlesdevs/photoncamera/ui/camera/views/M9LinearRulerSelection.java
@@ -0,0 +1,68 @@
+package com.particlesdevs.photoncamera.ui.camera.views;
+
+import com.particlesdevs.photoncamera.circularbarlib.ui.views.knobview.KnobItemInfo;
+import com.particlesdevs.photoncamera.circularbarlib.ui.views.knobview.KnobView;
+import com.particlesdevs.photoncamera.circularbarlib.ui.views.knobview.KnobViewChangedListener;
+import java.util.ArrayList;
+import java.util.Comparator;
+import java.util.List;
+
+/** Orders the existing physical camera choices without inventing or rounding any values. */
+final class M9LinearRulerSelection {
+    private final List<KnobItemInfo> items = new ArrayList<>();
+    private KnobViewChangedListener listener;
+    private int index;
+
+    void bind(List<KnobItemInfo> source, double value, KnobViewChangedListener listener) {
+        items.clear();
+        if (source != null) items.addAll(source);
+        items.sort(Comparator.comparingInt(item -> item.tick));
+        this.listener = listener;
+        syncValue(value); // Binding/resume must not send a camera parameter change.
+    }
+
+    void syncValue(double value) {
+        index = 0;
+        double distance = Double.POSITIVE_INFINITY;
+        for (int i = 0; i < items.size(); i++) {
+            double d = Math.abs(items.get(i).value - value);
+            if (d < distance) { index = i; distance = d; }
+        }
+    }
+
+    void syncReset() {
+        for (int i = 0; i < items.size(); i++) if (items.get(i).tick == 0) { index = i; return; }
+    }
+
+    boolean select(int requestedIndex, KnobView view) {
+        if (items.isEmpty() || listener == null) return false;
+        int next = Math.max(0, Math.min(items.size() - 1, requestedIndex));
+        if (next == index) return false;
+        KnobItemInfo old = current();
+        index = next;
+        listener.onSelectedKnobItemChanged(view, old, current());
+        return true;
+    }
+
+    void movement(KnobView view, KnobView.RotationState state) {
+        if (listener != null) listener.onRotationStateChanged(view, state);
+    }
+
+    int size() { return items.size(); }
+    int index() { return index; }
+    KnobItemInfo item(int i) { return items.get(i); }
+    KnobItemInfo current() { return items.isEmpty() ? null : items.get(index); }
+
+    static float clampPosition(float position, int count) {
+        if (!Float.isFinite(position) || count <= 1) return 0f;
+        return Math.max(0f, Math.min(count - 1, position));
+    }
+
+    static float draggedPosition(float start, float deltaX, float spacing, int count) {
+        return clampPosition(start - deltaX / Math.max(1f, spacing), count);
+    }
+
+    static int tappedIndex(float position, float x, float centre, float spacing, int count) {
+        return Math.round(clampPosition(position + (x - centre) / Math.max(1f, spacing), count));
+    }
+}

+package com.particlesdevs.photoncamera.m9;
+
+/** Main-thread lifecycle guard: one copy at a time, with stale callbacks rejected after changes. */
+public final class M9DisplaySampleGate {
+    private long generation;
+    private boolean running, busy;
+    public void start() { running=true; generation++; }
+    public void stop() { running=false; generation++; }
+    public void invalidate() { generation++; }
+    public long begin() {
+        if (!running || busy) return -1;
+        busy=true; return generation;
+    }
+    public boolean accepts(long ticket) { return running && busy && ticket==generation; }
+    public void finish() { busy=false; }
+    public boolean isBusy() { return busy; }
+}

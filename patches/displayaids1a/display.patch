+package com.particlesdevs.photoncamera.m9;
+
+import java.util.Map;
+
+/** Display-code measurements only. This class cannot change camera or renderer settings. */
+public final class M9DisplayAids {
+    // Extend the existing shared display selector, retaining meanings of values 0..3.
+    public static final String MODE_KEY = "pref_show_afdata_key";
+    public static final String HIGHLIGHT_KEY = "pref_m9_highlight_warning";
+    public static final String SHADOW_KEY = "pref_m9_shadow_warning";
+    public static final int BINS = 64;
+    public static final int RED = 0xD0FF3030, BLUE = 0xD04080FF;
+    private M9DisplayAids() {}
+
+    public static final class Settings {
+        public final int mode, highlights, shadows;
+        public Settings(int mode, int highlights, int shadows) {
+            this.mode = mode >= 0 && mode <= 6 ? mode : 0;
+            this.highlights = highlights >= 95 && highlights <= 100 ? highlights : 0;
+            this.shadows = shadows >= 0 && shadows <= 5 ? shadows : -1;
+        }
+        public int histogram() { return mode == 2 || mode == 5 ? 2 : mode == 4 || mode == 6 ? 1 : 0; }
+        public int hud() { return mode == 3 ? 3 : mode == 1 || mode == 2 || mode == 6 ? 1 : 0; }
+        public boolean enabled() { return histogram() != 0 || highlights != 0 || shadows >= 0; }
+    }
+
+    public static Settings read(Map<String,?> values) {
+        return new Settings(integer(values,MODE_KEY,0),integer(values,HIGHLIGHT_KEY,0),integer(values,SHADOW_KEY,-1));
+    }
+    private static int integer(Map<String,?> values,String key,int fallback) {
+        Object value = values.get(key);
+        if (!(value instanceof String)) return fallback;
+        try { return Integer.parseInt((String)value); }
+        catch (NumberFormatException invalid) { return fallback; }
+    }
+    public static int withHistogram(int mode,int histogram) {
+        boolean info = mode == 1 || mode == 2 || mode == 6;
+        if (histogram == 1) return info ? 6 : 4;
+        if (histogram == 2) return info ? 2 : 5;
+        return info ? 1 : mode == 3 ? 3 : 0;
+    }
+    public static int highlightCode(int percent) { return percent == 0 ? 256 : Math.round(255f*percent/100f); }
+    public static int shadowCode(int percent) { return percent < 0 ? -1 : Math.round(255f*percent/100f); }
+
+    public static final class Sample {
+        public final int[][] rgb = new int[3][BINS];
+        public final int[] luminance = new int[BINS];
+        public final int[] mask;
+        public final int width,height;
+        public int measured,highlightCount,shadowCount;
+        Sample(int width,int height) { this.width=width; this.height=height; mask=new int[width*height]; }
+        public boolean hasWarnings() { return highlightCount != 0 || shadowCount != 0; }
+    }
+
+    /** Same 128x96 sampled-overlay approach as Monochrom; retain real RGB colours in M9. */
+    public static Sample analyze(int[] pixels,int width,int height,Settings settings,
+                                 float cornerRadiusX,float cornerRadiusY) {
+        if (width <= 0 || height <= 0 || pixels.length != width*height) throw new IllegalArgumentException("geometry");
+        Sample sample = new Sample(width,height);
+        int high = highlightCode(settings.highlights), low = shadowCode(settings.shadows);
+        for (int y=0;y<height;y++) for (int x=0;x<width;x++) {
+            int i=y*width+x, pixel=pixels[i];
+            if ((pixel>>>24)==0 || outsideCorner(x,y,width,height,cornerRadiusX,cornerRadiusY)) continue;
+            int r=(pixel>>>16)&255, g=(pixel>>>8)&255, b=pixel&255;
+            sample.rgb[0][r>>2]++; sample.rgb[1][g>>2]++; sample.rgb[2][b>>2]++;
+            int luma=(77*r+150*g+29*b+128)>>8;
+            sample.luminance[luma>>2]++; sample.measured++;
+            int maximum=Math.max(r,Math.max(g,b));
+            // Any high channel warns about colour-channel clipping; shadows require all channels low.
+            if (maximum >= high) { sample.mask[i]=RED; sample.highlightCount++; }
+            else if (maximum <= low) { sample.mask[i]=BLUE; sample.shadowCount++; }
+        }
+        return sample;
+    }
+
+    static boolean outsideCorner(int x,int y,int width,int height,float rx,float ry) {
+        if (rx<=0 || ry<=0) return false;
+        rx=Math.min(rx,width/2f); ry=Math.min(ry,height/2f);
+        double dx=Math.max(0,rx-Math.min(x+0.5,width-x-0.5))/rx;
+        double dy=Math.max(0,ry-Math.min(y+0.5,height-y-0.5))/ry;
+        return dx*dx+dy*dy>1.0;
+    }
+
+    /** Translate a photo frame into surface-local pixels; never stretch a partial intersection. */
+    public static int[] photoRect(int sx,int sy,int sw,int sh,int fx,int fy,int fw,int fh) {
+        int left=fx-sx,top=fy-sy;
+        if (fw<=0 || fh<=0 || sw<=0 || sh<=0 || left<0 || top<0 || left+fw>sw || top+fh>sh) return null;
+        return new int[]{left,top,left+fw,top+fh};
+    }
+}

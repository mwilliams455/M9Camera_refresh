@@ -0,0 +1,116 @@
+package com.particlesdevs.photoncamera.m9;
+
+import org.junit.Test;
+import java.util.Arrays;
+import java.util.HashMap;
+import java.util.Map;
+import static org.junit.Assert.*;
+
+public class M9DisplayAidsTest {
+    private static M9DisplayAids.Sample sample(int[] pixels,int high,int low) {
+        return M9DisplayAids.analyze(pixels,pixels.length,1,new M9DisplayAids.Settings(5,high,low),0,0);
+    }
+    @Test public void legacyHudValuesPreserveTheirDisplayMeaningAndDefaultsAreOff() {
+        assertFalse(M9DisplayAids.read(new HashMap<>()).enabled());
+        assertEquals(0,new M9DisplayAids.Settings(0,0,-1).hud());
+        assertEquals(1,new M9DisplayAids.Settings(1,0,-1).hud());
+        assertEquals(2,new M9DisplayAids.Settings(2,0,-1).histogram());
+        assertEquals(1,new M9DisplayAids.Settings(2,0,-1).hud());
+        assertEquals(3,new M9DisplayAids.Settings(3,0,-1).hud());
+        assertEquals(0,new M9DisplayAids.Settings(3,0,-1).histogram());
+    }
+    @Test public void standaloneHistogramDoesNotRequireCameraInfo() {
+        assertEquals(1,new M9DisplayAids.Settings(4,0,-1).histogram());
+        assertEquals(0,new M9DisplayAids.Settings(4,0,-1).hud());
+        assertEquals(2,new M9DisplayAids.Settings(5,0,-1).histogram());
+        assertEquals(0,new M9DisplayAids.Settings(5,0,-1).hud());
+        assertEquals(1,new M9DisplayAids.Settings(6,0,-1).histogram());
+        assertEquals(1,new M9DisplayAids.Settings(6,0,-1).hud());
+    }
+    @Test public void quickHistogramChoiceKeepsTheExistingInfoPreference() {
+        for (int mode:new int[]{1,2,6}) {
+            assertEquals(1,M9DisplayAids.withHistogram(mode,0));
+            assertEquals(6,M9DisplayAids.withHistogram(mode,1));
+            assertEquals(2,M9DisplayAids.withHistogram(mode,2));
+        }
+        for (int mode:new int[]{0,4,5}) {
+            assertEquals(0,M9DisplayAids.withHistogram(mode,0));
+            assertEquals(4,M9DisplayAids.withHistogram(mode,1));
+            assertEquals(5,M9DisplayAids.withHistogram(mode,2));
+        }
+        assertEquals(3,M9DisplayAids.withHistogram(3,0));
+    }
+    @Test public void thresholdOptionsMapToExpectedEightBitCodes() {
+        assertEquals(256,M9DisplayAids.highlightCode(0)); assertEquals(-1,M9DisplayAids.shadowCode(-1));
+        int[] high={242,245,247,250,252,255},low={0,3,5,8,10,13};
+        for (int i=0;i<6;i++) {
+            assertEquals(high[i],M9DisplayAids.highlightCode(95+i));
+            assertEquals(low[i],M9DisplayAids.shadowCode(i));
+        }
+    }
+    @Test public void eachHighlightThresholdIncludesBoundaryAndExcludesCodeBelow() {
+        for (int percent=95;percent<=100;percent++) {
+            int code=M9DisplayAids.highlightCode(percent);
+            M9DisplayAids.Sample s=sample(new int[]{0xFF000000|((code-1)<<16),0xFF000000|(code<<16)},percent,-1);
+            assertEquals(1,s.highlightCount); assertEquals(0,s.mask[0]); assertEquals(M9DisplayAids.RED,s.mask[1]);
+        }
+    }
+    @Test public void eachShadowThresholdRequiresEveryChannelAtOrBelowBoundary() {
+        for (int percent=0;percent<=5;percent++) {
+            int code=M9DisplayAids.shadowCode(percent);
+            M9DisplayAids.Sample s=sample(new int[]{0xFF000000|code|(code<<8)|(code<<16),0xFF000000|((code+1)<<8)},0,percent);
+            assertEquals(1,s.shadowCount); assertEquals(M9DisplayAids.BLUE,s.mask[0]); assertEquals(0,s.mask[1]);
+        }
+    }
+    @Test public void colourClippingIsNotMistakenForLuminanceClipping() {
+        M9DisplayAids.Sample s=sample(new int[]{0xFFFF0000,0xFF0000FF,0xFF000000,0xFF808080},100,0);
+        assertEquals(2,s.highlightCount); assertEquals(1,s.shadowCount);
+        assertEquals(M9DisplayAids.RED,s.mask[0]); assertEquals(M9DisplayAids.RED,s.mask[1]);
+        assertEquals(M9DisplayAids.BLUE,s.mask[2]); assertEquals(0,s.mask[3]);
+    }
+    @Test public void realMagentaIsMeasuredWithoutTheMonochromPeakingSubtraction() {
+        int[] pixels={0xFFFF00FF,0xFF000000,0xFFFFFFFF,0xFF808080};int[] original=pixels.clone();
+        M9DisplayAids.Sample s=sample(pixels,0,-1);
+        assertArrayEquals(original,pixels);
+        assertEquals(2,s.rgb[0][63]); assertEquals(2,s.rgb[2][63]); assertEquals(2,s.rgb[1][0]);
+        assertEquals(1,s.luminance[26]); // rounded display-code luma of magenta is 106
+        assertEquals(0,s.highlightCount); assertEquals(0,s.shadowCount);
+        for (int[] channel:s.rgb) assertEquals(4,Arrays.stream(channel).sum());
+        assertEquals(4,Arrays.stream(s.luminance).sum());
+    }
+    @Test public void transparentAndRoundedCornerBackgroundPixelsDoNotWarn() {
+        int[] pixels=new int[16];Arrays.fill(pixels,0xFF000000);pixels[5]=0;
+        M9DisplayAids.Sample s=M9DisplayAids.analyze(pixels,4,4,new M9DisplayAids.Settings(4,100,0),2,2);
+        assertEquals(0,s.mask[0]); assertEquals(0,s.mask[3]); assertEquals(0,s.mask[12]); assertEquals(0,s.mask[15]);
+        assertEquals(0,s.mask[5]); assertEquals(11,s.measured); assertEquals(11,s.shadowCount);
+    }
+    @Test public void sourceRectExcludesFullBleedBordersAndRejectsPartialFrames() {
+        assertArrayEquals(new int[]{0,120,1080,1560},M9DisplayAids.photoRect(0,0,1080,2400,0,120,1080,1440));
+        assertArrayEquals(new int[]{0,0,1080,1440},M9DisplayAids.photoRect(0,120,1080,1440,0,120,1080,1440));
+        assertArrayEquals(new int[]{120,0,1560,1080},M9DisplayAids.photoRect(0,0,2400,1080,120,0,1440,1080));
+        assertNull(M9DisplayAids.photoRect(0,0,100,100,-1,0,100,100));
+        assertNull(M9DisplayAids.photoRect(0,0,100,100,0,0,0,100));
+        assertNull(M9DisplayAids.photoRect(0,0,100,100,0,0,101,100));
+    }
+    @Test public void corruptPreferencesFallBackWithoutMutation() {
+        Map<String,Object> values=new HashMap<>();values.put(M9DisplayAids.MODE_KEY,true);
+        values.put(M9DisplayAids.HIGHLIGHT_KEY,"NaN");values.put(M9DisplayAids.SHADOW_KEY,"50");
+        Map<String,Object> original=new HashMap<>(values);
+        assertFalse(M9DisplayAids.read(values).enabled());assertEquals(original,values);
+    }
+    @Test public void samplesOwnTheirDataAndCannotBeMutatedByTheNextReadback() {
+        int[] pixels={0xFFFFFFFF}; M9DisplayAids.Sample first=sample(pixels,100,0);
+        pixels[0]=0xFF000000; M9DisplayAids.Sample second=sample(pixels,100,0);
+        assertEquals(M9DisplayAids.RED,first.mask[0]); assertEquals(M9DisplayAids.BLUE,second.mask[0]);
+        assertEquals(1,first.rgb[0][63]);assertEquals(1,second.rgb[0][0]);
+    }
+    @Test public void samplerDoesNotOverlapAndRejectsPauseAndSettingChangeCallbacks() {
+        M9DisplaySampleGate gate=new M9DisplaySampleGate();assertEquals(-1,gate.begin());gate.start();
+        long first=gate.begin();assertTrue(gate.accepts(first));assertEquals(-1,gate.begin());
+        gate.invalidate();assertFalse(gate.accepts(first));assertEquals(-1,gate.begin());
+        gate.finish();long second=gate.begin();assertTrue(gate.accepts(second));
+        gate.stop();assertFalse(gate.accepts(second));gate.start();assertEquals(-1,gate.begin());
+        gate.finish();long third=gate.begin();assertTrue(gate.accepts(third));gate.finish();
+        assertFalse(gate.isBusy());
+    }
+}

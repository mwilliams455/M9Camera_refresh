+        boolean landscape=orientation==90 || orientation==270;
+        float pivotX=getWidth()-margin-(landscape?(height+label)/2:width/2);
+        float pivotY=margin+(landscape?width/2:(height+label)/2);
+        float left=pivotX-width/2,top=pivotY-(height+label)/2+label,bottom=top+height;
+        canvas.save(); canvas.rotate(orientation,pivotX,pivotY);
+        fill.setColor(0xB0000000); fill.setStyle(Paint.Style.FILL);
+        canvas.drawRect(left-3*density,top-label-2*density,left+width+3*density,bottom+3*density,fill);
+        fill.setColor(Color.WHITE); fill.setTextSize(10*density);
+        canvas.drawText(getResources().getString(R.string.m9_display_preview_label),left,top-3*density,fill);
+        line.setColor(0x70FFFFFF); canvas.drawRect(left,top,left+width,bottom,line);
+        for (int i=1;i<11;i++) canvas.drawLine(left+width*i/11,top,left+width*i/11,bottom,line);
+        int channels=settings.histogram()==2?3:1,maximum=1;
+        for (int channel=0;channel<channels;channel++) {
+            int[] bins=channels==3?sample.rgb[channel]:sample.luminance;
+            for (int value:bins) maximum=Math.max(maximum,value);
+        }
+        for (int channel=0;channel<channels;channel++) {
+            int[] bins=channels==3?sample.rgb[channel]:sample.luminance;
+            fill.setColor(channels==1?0xE8FFFFFF:new int[]{0xB8FF5050,0xB84CE06A,0xB85C8CFF}[channel]);
+            graph.reset(); graph.moveTo(left,bottom);
+            for (int i=0;i<M9DisplayAids.BINS;i++) {
+                float amount=(float)Math.sqrt(bins[i]/(double)maximum);
+                graph.lineTo(left+width*i/(M9DisplayAids.BINS-1),bottom-height*amount);
+            }
+            graph.lineTo(left+width,bottom); graph.close(); canvas.drawPath(graph,fill);
+        }
+        if (settings.highlights>0) {
+            line.setColor(Color.RED); float x=left+width*M9DisplayAids.highlightCode(settings.highlights)/255;
+            canvas.drawLine(x,top,x,bottom,line);
+        }
+        if (settings.shadows>=0) {
+            line.setColor(0xFF4080FF); float x=left+width*M9DisplayAids.shadowCode(settings.shadows)/255;
+            canvas.drawLine(x,top,x,bottom,line);
+        }
+        canvas.restore();
+    }
+    @Override protected void onDetachedFromWindow() {
+        clear();
+        if (mask!=null) { mask.recycle(); mask=null; }
+        super.onDetachedFromWindow();
+    }
+}

+package com.particlesdevs.photoncamera.ui.camera;
+
+import android.content.Context;
+import android.content.SharedPreferences;
+import android.graphics.Bitmap;
+import android.graphics.Rect;
+import android.os.Handler;
+import android.os.Looper;
+import android.view.PixelCopy;
+import android.view.SurfaceView;
+import android.view.View;
+import androidx.appcompat.app.AlertDialog;
+import com.google.android.material.dialog.MaterialAlertDialogBuilder;
+import com.particlesdevs.photoncamera.R;
+import com.particlesdevs.photoncamera.api.CameraMode;
+import com.particlesdevs.photoncamera.app.PhotonCamera;
+import com.particlesdevs.photoncamera.m9.M9Config;
+import com.particlesdevs.photoncamera.m9.M9DisplayAids;
+import com.particlesdevs.photoncamera.m9.M9DisplaySampleGate;
+import com.particlesdevs.photoncamera.settings.PreferenceKeys;
+import com.particlesdevs.photoncamera.ui.camera.views.viewfinder.M9DisplayAidsView;
+import com.particlesdevs.photoncamera.util.BlurSupport;
+import java.util.Arrays;
+import java.util.Objects;
+
+/** Small asynchronous readback of the visible photo area; no camera requests or GL writes. */
+final class M9DisplayAidsController implements SharedPreferences.OnSharedPreferenceChangeListener {
+    private static final int WIDTH=128,HEIGHT=96,INTERVAL=150;
+    private final Context context;
+    private final SurfaceView source;
+    private final View frame,button;
+    private final M9DisplayAidsView overlay;
+    private final SharedPreferences preferences;
+    private final Handler main=new Handler(Looper.getMainLooper());
+    private final M9DisplaySampleGate gate=new M9DisplaySampleGate();
+    private final int[] pixels=new int[WIDTH*HEIGHT];
+    private M9DisplayAids.Settings settings;
+    private Bitmap bitmap;
+    private boolean running,destroyed,wasPhoto;
+    private String cameraId;
+    private AlertDialog dialog;
+
+    M9DisplayAidsController(Context context,SurfaceView source,View frame,View button,M9DisplayAidsView overlay) {
+        this.context=context; this.source=source; this.frame=frame; this.button=button; this.overlay=overlay;
+        preferences=PhotonCamera.getSettingsManagerStatic().getDefaultPreferences();
+        preferences.registerOnSharedPreferenceChangeListener(this);
+        button.setOnClickListener(v -> showControls()); refresh();
+    }
+    boolean isSupportedMode() {
+        if (!M9Config.isM9Modern() || PhotonCamera.getSettings()==null) return false;
+        CameraMode mode=PhotonCamera.getSettings().selectedMode;
+        return mode==CameraMode.PHOTO || mode==CameraMode.NIGHT || mode==CameraMode.MOTION || mode==CameraMode.VIDEO;
+    }
+    int hudMode() { return settings.hud(); }
+    void setOrientation(int orientation) { overlay.setOrientation(orientation); }
+    void start() {
+        if (destroyed || running) return;
+        running=true; gate.start(); refresh(); main.post(tick);
+    }
+    void stop() {
+        running=false; gate.stop(); main.removeCallbacks(tick); overlay.clear(); overlay.setVisibility(View.GONE);
+        if (dialog!=null) dialog.dismiss();
+    }
+    void close() {
+        stop(); destroyed=true; preferences.unregisterOnSharedPreferenceChangeListener(this);
+        button.setOnClickListener(null); releaseBitmap();
+    }
+    private void releaseBitmap() {
+        // PixelCopy owns its destination until the callback. Never recycle it while a copy is active.
+        if (!gate.isBusy() && bitmap!=null) { bitmap.recycle(); bitmap=null; }
+    }
+    @Override public void onSharedPreferenceChanged(SharedPreferences prefs,String key) {
+        if (key==null || key.equals(M9DisplayAids.MODE_KEY) || key.equals(M9DisplayAids.HIGHLIGHT_KEY)
+                || key.equals(M9DisplayAids.SHADOW_KEY) || key.equals(PreferenceKeys.Key.KEY_SHOW_ROUND_EDGE.mValue)) refresh();
+    }
+    private void refresh() {
+        settings=M9DisplayAids.read(preferences.getAll()); gate.invalidate(); overlay.setSettings(settings);
+        button.setAlpha(settings.enabled()?1f:0.65f);
+        button.setContentDescription(context.getString(R.string.m9_display_quick_description,
+                histogramName(),highlightName(),shadowName()));
+    }
+
+    private final Runnable tick=new Runnable() {
+        @Override public void run() {
+            if (!running || destroyed) return;
+            boolean photo=isSupportedMode(); String nextCamera=PreferenceKeys.getCameraID();
+            if (photo!=wasPhoto || !Objects.equals(cameraId,nextCamera)) {
+                wasPhoto=photo; cameraId=nextCamera; gate.invalidate(); overlay.clear();
+            }
+            button.setVisibility(photo?View.VISIBLE:View.GONE);
+            overlay.setVisibility(photo && settings.enabled()?View.VISIBLE:View.GONE);
+            if (photo && settings.enabled()) request();
+            if (running) main.postDelayed(this,INTERVAL);
+        }
+    };
+
+    private int[] rect() {
+        if (!source.isAttachedToWindow() || !frame.isShown()) return null;
+        int[] surfacePosition=new int[2],framePosition=new int[2];
+        source.getLocationInWindow(surfacePosition); frame.getLocationInWindow(framePosition);
+        return M9DisplayAids.photoRect(surfacePosition[0],surfacePosition[1],source.getWidth(),source.getHeight(),
+                framePosition[0],framePosition[1],frame.getWidth(),frame.getHeight());
+    }
+    private void request() {
+        int[] bounds=rect();
+        if (bounds==null || !source.getHolder().getSurface().isValid()) { overlay.clear(); return; }
+        long ticket=gate.begin(); if (ticket<0) return;
+        final M9DisplayAids.Settings requested=settings;
+        final String requestedCamera=cameraId;
+        final float corner=PreferenceKeys.isRoundEdgeOn()?context.getResources().getDimension(R.dimen.viewfinder_round_corner_radius):0;
+        try {
+            if (bitmap==null) bitmap=Bitmap.createBitmap(WIDTH,HEIGHT,Bitmap.Config.ARGB_8888);
+            PixelCopy.request(source,new Rect(bounds[0],bounds[1],bounds[2],bounds[3]),bitmap,result -> {
+                try {
+                    if (!gate.accepts(ticket) || destroyed || !isSupportedMode()
+                            || !Objects.equals(requestedCamera,PreferenceKeys.getCameraID())
+                            || !Arrays.equals(bounds,rect())) return;
+                    if (result!=PixelCopy.SUCCESS) { overlay.clear(); return; }
+                    bitmap.getPixels(pixels,0,WIDTH,0,0,WIDTH,HEIGHT);
+                    M9DisplayAids.Sample sample=M9DisplayAids.analyze(pixels,WIDTH,HEIGHT,requested,
+                            corner*WIDTH/(bounds[2]-bounds[0]),corner*HEIGHT/(bounds[3]-bounds[1]));
+                    overlay.setSample(sample);
+                } catch (RuntimeException failedSample) {
+                    overlay.clear();
+                } finally {
+                    gate.finish(); if (destroyed) releaseBitmap();
+                }
+            },main);
+        } catch (RuntimeException unavailableSurface) {
+            gate.finish(); overlay.clear(); if (destroyed) releaseBitmap();
+        }
+    }
+
+    private String histogramName() { return context.getResources().getStringArray(R.array.m9_histogram_choices)[settings.histogram()]; }
+    private String highlightName() { return settings.highlights==0?context.getString(R.string.off):settings.highlights+"%"; }
+    private String shadowName() { return settings.shadows<0?context.getString(R.string.off):settings.shadows+"%"; }
+    private void showControls() {
+        CharSequence[] rows={context.getString(R.string.m9_display_histogram_row,histogramName()),
+                context.getString(R.string.m9_display_highlight_row,highlightName()),
+                context.getString(R.string.m9_display_shadow_row,shadowName())};
+        show(new MaterialAlertDialogBuilder(context).setTitle(R.string.m9_display_title)
+                .setItems(rows,(d,which) -> choose(which))
+                .setNeutralButton(R.string.m9_display_all_off,(d,w) -> preferences.edit()
+                        .putString(M9DisplayAids.MODE_KEY,Integer.toString(M9DisplayAids.withHistogram(settings.mode,0)))
+                        .putString(M9DisplayAids.HIGHLIGHT_KEY,"0").putString(M9DisplayAids.SHADOW_KEY,"-1").apply())
+                .setPositiveButton(R.string.m9_display_done,null).create());
+    }
+    private void choose(int which) {
+        String[] entries=context.getResources().getStringArray(which==0?R.array.m9_histogram_choices:
+                which==1?R.array.m9_highlight_entries:R.array.m9_shadow_entries);
+        int selected=which==0?settings.histogram():which==1?(settings.highlights==0?0:101-settings.highlights):settings.shadows+1;
+        show(new MaterialAlertDialogBuilder(context)
+                .setTitle(which==0?R.string.m9_display_histogram:which==1?R.string.m9_display_highlights:R.string.m9_display_shadows)
+                .setSingleChoiceItems(entries,selected,(d,index) -> {
+                    if (which==0) preferences.edit().putString(M9DisplayAids.MODE_KEY,
+                            Integer.toString(M9DisplayAids.withHistogram(settings.mode,index))).apply();
+                    else preferences.edit().putString(which==1?M9DisplayAids.HIGHLIGHT_KEY:M9DisplayAids.SHADOW_KEY,
+                            Integer.toString(which==1?(index==0?0:101-index):index-1)).apply();
+                    d.dismiss(); showControls();
+                }).setNegativeButton(android.R.string.cancel,null).create());
+    }
+    private void show(AlertDialog next) {
+        dialog=next; next.setOnDismissListener(d -> { if (dialog==next) dialog=null; }); BlurSupport.show(next);
+    }
+}

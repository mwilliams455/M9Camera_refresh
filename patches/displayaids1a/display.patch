+/** Separate View overlay: masks never enter the sampled preview surface or saved image. */
+public final class M9DisplayAidsView extends View {
+    private final Paint fill = new Paint(Paint.ANTI_ALIAS_FLAG);
+    private final Paint line = new Paint(Paint.ANTI_ALIAS_FLAG);
+    private final Paint maskPaint = new Paint();
+    private final Path graph = new Path();
+    private final RectF destination = new RectF();
+    private M9DisplayAids.Settings settings = new M9DisplayAids.Settings(0,0,-1);
+    private M9DisplayAids.Sample sample;
+    private Bitmap mask;
+    private long sampledAt;
+    private int orientation;
+    private final float density;
+
+    public M9DisplayAidsView(Context context,AttributeSet attrs) {
+        super(context,attrs); density=getResources().getDisplayMetrics().density;
+        line.setStyle(Paint.Style.STROKE); line.setStrokeWidth(density);
+        maskPaint.setFilterBitmap(false);
+        setClickable(false); setFocusable(false); setImportantForAccessibility(IMPORTANT_FOR_ACCESSIBILITY_NO);
+    }
+    public void setSettings(M9DisplayAids.Settings next) {
+        settings=next; clear();
+    }
+    public void setOrientation(int value) {
+        int normalized=(value%360+360)%360;
+        if (orientation!=normalized) { orientation=normalized; invalidate(); }
+    }
+    public void setSample(M9DisplayAids.Sample value) {
+        sample=value; sampledAt=SystemClock.uptimeMillis();
+        if (value.hasWarnings()) {
+            if (mask==null || mask.getWidth()!=value.width || mask.getHeight()!=value.height) {
+                if (mask!=null) mask.recycle();
+                mask=Bitmap.createBitmap(value.width,value.height,Bitmap.Config.ARGB_8888);
+            }
+            mask.setPixels(value.mask,0,value.width,0,0,value.width,value.height);
+        }
+        invalidate();
+    }
+    public void clear() { sample=null; invalidate(); }
+
+    @Override protected void onDraw(Canvas canvas) {
+        super.onDraw(canvas);
+        if (sample==null || SystemClock.uptimeMillis()-sampledAt>750) return;
+        if (sample.hasWarnings() && mask!=null && ((SystemClock.uptimeMillis()/350)&1)==0) {
+            destination.set(0,0,getWidth(),getHeight());
+            canvas.drawBitmap(mask,null,destination,maskPaint);
+        }
+        if (settings.histogram()!=0) histogram(canvas);
+        // Expire stale data and continue the Monochrom-style flash without a constant animation loop.
+        postInvalidateDelayed(sample.hasWarnings()?175:750);
+    }

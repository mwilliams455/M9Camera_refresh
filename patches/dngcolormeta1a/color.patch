+package com.particlesdevs.photoncamera.processing;
+
+import android.hardware.camera2.CameraCharacteristics;
+import android.hardware.camera2.CaptureResult;
+import android.hardware.camera2.params.ColorSpaceTransform;
+import android.util.Rational;
+
+/** Only the physical characteristics/result carried with the owned RAW may supply colour. */
+public final class M9DngColorCapture {
+    private M9DngColorCapture() {}
+
+    public static M9DngColorMetadata read(CameraCharacteristics camera, CaptureResult result) {
+        if (camera == null || result == null) {
+            throw new IllegalArgumentException("Missing owned physical colour metadata");
+        }
+        Byte second = camera.get(CameraCharacteristics.SENSOR_REFERENCE_ILLUMINANT2);
+        Rational[] neutral = result.get(CaptureResult.SENSOR_NEUTRAL_COLOR_POINT);
+        float[] white = null;
+        if (neutral != null && neutral.length == 3) {
+            white = new float[3];
+            for (int i = 0; i < 3; i++) white[i] = neutral[i] == null
+                    ? Float.NaN : neutral[i].floatValue();
+        }
+        return M9DngColorMetadata.create(
+                camera.get(CameraCharacteristics.SENSOR_REFERENCE_ILLUMINANT1),
+                second == null ? null : Byte.toUnsignedInt(second),
+                matrix(camera.get(CameraCharacteristics.SENSOR_COLOR_TRANSFORM1)),
+                matrix(camera.get(CameraCharacteristics.SENSOR_COLOR_TRANSFORM2)),
+                matrix(camera.get(CameraCharacteristics.SENSOR_CALIBRATION_TRANSFORM1)),
+                matrix(camera.get(CameraCharacteristics.SENSOR_CALIBRATION_TRANSFORM2)),
+                matrix(camera.get(CameraCharacteristics.SENSOR_FORWARD_MATRIX1)),
+                matrix(camera.get(CameraCharacteristics.SENSOR_FORWARD_MATRIX2)), white);
+    }
+
+    private static float[] matrix(ColorSpaceTransform transform) {
+        if (transform == null) return null;
+        float[] out = new float[9];
+        // Camera2 getElement is (column, row); DNG storage is row major.
+        for (int row = 0; row < 3; row++) for (int column = 0; column < 3; column++) {
+            Rational value = transform.getElement(column, row);
+            out[row*3+column] = value == null ? Float.NaN : value.floatValue();
+        }
+        return out;
+    }
+}

+package com.particlesdevs.photoncamera.processing;
+
+import java.util.LinkedHashMap;
+import java.util.Map;
+
+/** Owned physical-camera colour tags. No renderer settings or sensor substitution. */
+public final class M9DngColorMetadata {
+    public static final String REVISION = "M9DNGCOLORMETA1A_PHYSICAL_COLOR";
+    private final LinkedHashMap<Integer, double[]> values = new LinkedHashMap<>();
+
+    private M9DngColorMetadata() {}
+
+    public static M9DngColorMetadata create(Integer illuminant1, Integer illuminant2,
+            float[] color1, float[] color2, float[] calibration1, float[] calibration2,
+            float[] forward1, float[] forward2, float[] neutral) {
+        if (!illuminant(illuminant1) || !matrix(color1) || !neutral(neutral)) {
+            throw new IllegalArgumentException(REVISION + ": missing or invalid required calibration");
+        }
+        M9DngColorMetadata result = new M9DngColorMetadata();
+        boolean dual = illuminant1 != 0 && illuminant(illuminant2)
+                && illuminant2 != 0 && !illuminant1.equals(illuminant2) && matrix(color2);
+        result.values.put(50778, new double[]{illuminant1});
+        if (dual) result.values.put(50779, new double[]{illuminant2});
+        result.add(50721, color1);
+        if (dual) result.add(50722, color2);
+        if (matrix(calibration1)) result.add(50723, calibration1);
+        if (dual && matrix(calibration2)) result.add(50724, calibration2);
+        // Do not let an incomplete dual-illuminant forward pair replace a valid
+        // ColorMatrix path. In a single-illuminant profile only ForwardMatrix1 is needed.
+        if (matrix(forward1) && (!dual || matrix(forward2))) {
+            result.add(50964, forward1);
+            if (dual) result.add(50965, forward2);
+        }
+        result.add(50728, neutral);
+        return result;
+    }
+
+    /** Fresh arrays on each read prevent callers/diagnostics from changing a later write. */
+    public Map<Integer, double[]> tags() {
+        LinkedHashMap<Integer, double[]> copy = new LinkedHashMap<>();
+        for (Map.Entry<Integer, double[]> item : values.entrySet()) {
+            copy.put(item.getKey(), item.getValue().clone());
+        }
+        return copy;
+    }
+
+    private void add(int tag, float[] source) {
+        double[] copy = new double[source.length];
+        for (int i = 0; i < source.length; i++) copy[i] = source[i];
+        values.put(tag, copy);
+    }
+
+    private static boolean illuminant(Integer value) {
+        return value != null && (value >= 0 && value <= 4 || value >= 9 && value <= 24);
+    }
+
+    private static boolean neutral(float[] a) {
+        if (a == null || a.length != 3) return false;
+        for (float v : a) if (!Float.isFinite(v) || v <= 0) return false;
+        return true;
+    }
+
+    private static boolean matrix(float[] a) {
+        if (a == null || a.length != 9) return false;
+        double max = 0;
+        for (float v : a) {
+            if (!Float.isFinite(v)) return false;
+            max = Math.max(max, Math.abs((double) v));
+        }
+        if (max == 0) return false;
+        double[] n = new double[9];
+        for (int i = 0; i < 9; i++) n[i] = a[i] / max;
+        double determinant = n[0]*(n[4]*n[8]-n[5]*n[7])
+                - n[1]*(n[3]*n[8]-n[5]*n[6]) + n[2]*(n[3]*n[7]-n[4]*n[6]);
+        return Math.abs(determinant) > 1e-12;
+    }
+}

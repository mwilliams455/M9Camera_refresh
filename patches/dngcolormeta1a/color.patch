+package com.particlesdevs.photoncamera.processing;
+
+import org.junit.Test;
+import java.util.Map;
+import static org.junit.Assert.*;
+
+public class M9DngColorMetadataTest {
+    private final float[] color={.8f,-.2f,.1f,-.1f,1.1f,.15f,.05f,.1f,.7f};
+    private final float[] identity={1,0,0,0,1,0,0,0,1};
+    private final float[] forward={.6f,.3f,.0642f,.2f,.7f,.1f,.02f,.1f,.7049f};
+    private final float[] neutral={.5f,1,.75f};
+    private M9DngColorMetadata full() {
+        return M9DngColorMetadata.create(17,21,color,color,identity,identity,forward,forward,neutral);
+    }
+    private void rejects(Runnable task) {
+        try { task.run(); fail("accepted invalid required colour"); }
+        catch (IllegalArgumentException expected) { assertTrue(expected.getMessage().contains("M9DNGCOLORMETA1A")); }
+    }
+    @Test public void physicalValuesAndRowOrderArePreserved() {
+        Map<Integer,double[]> tags=full().tags();assertEquals(9,tags.size());
+        for(int i=0;i<9;i++) assertEquals((double)color[i],tags.get(50721)[i],0);
+        assertArrayEquals(new double[]{.5,1,.75},tags.get(50728),0);
+        assertEquals(17,tags.get(50778)[0],0);assertEquals(21,tags.get(50779)[0],0);
+    }
+    @Test public void snapshotOwnsInputsAndEveryExport() {
+        M9DngColorMetadata m=full();color[0]=99;neutral[0]=99;
+        Map<Integer,double[]> tags=m.tags();tags.get(50721)[0]=88;tags.clear();
+        assertEquals((double).8f,m.tags().get(50721)[0],0);assertEquals(.5,m.tags().get(50728)[0],0);
+    }
+    @Test public void absentOptionalMatricesStayAbsent() {
+        Map<Integer,double[]> tags=M9DngColorMetadata.create(21,null,color,null,null,null,null,null,neutral).tags();
+        assertEquals(3,tags.size());assertFalse(tags.containsKey(50779));
+        assertFalse(tags.containsKey(50964));assertFalse(tags.containsKey(50723));
+    }
+    @Test public void singleIlluminantRetainsItsRealForwardMatrix() {
+        Map<Integer,double[]> tags=M9DngColorMetadata.create(21,null,color,color,identity,identity,forward,forward,neutral).tags();
+        assertTrue(tags.containsKey(50964));assertFalse(tags.containsKey(50965));assertFalse(tags.containsKey(50722));
+    }
+    @Test public void incompleteDualForwardPairUsesColorMatrices() {
+        Map<Integer,double[]> tags=M9DngColorMetadata.create(17,21,color,color,identity,identity,forward,null,neutral).tags();
+        assertTrue(tags.containsKey(50722));assertFalse(tags.containsKey(50964));assertFalse(tags.containsKey(50965));
+    }
+    @Test public void singularNonzeroRowsAreNotCalibration() {
+        float[] singular={1,2,3,2,4,6,3,6,9};
+        rejects(()->M9DngColorMetadata.create(21,null,singular,null,null,null,null,null,neutral));
+        Map<Integer,double[]> tags=M9DngColorMetadata.create(21,null,color,null,singular,null,singular,null,neutral).tags();
+        assertFalse(tags.containsKey(50723));assertFalse(tags.containsKey(50964));
+    }
+    @Test public void invalidRequiredValuesFailWithoutGlobalFallback() {
+        rejects(()->M9DngColorMetadata.create(null,null,color,null,null,null,null,null,neutral));
+        rejects(()->M9DngColorMetadata.create(255,null,color,null,null,null,null,null,neutral));
+        rejects(()->M9DngColorMetadata.create(21,null,null,null,null,null,null,null,neutral));
+        for(float bad:new float[]{0,-1,Float.NaN,Float.POSITIVE_INFINITY}) {
+            rejects(()->M9DngColorMetadata.create(21,null,color,null,null,null,null,null,new float[]{bad,1,1}));
+        }
+        rejects(()->M9DngColorMetadata.create(21,null,color,null,null,null,null,null,new float[]{1,1}));
+    }
+    @Test public void unusableSecondSetFallsBackToFirstOnly() {
+        for(Integer ref:new Integer[]{null,0,17,255}) {
+            Map<Integer,double[]> tags=M9DngColorMetadata.create(17,ref,color,color,identity,identity,forward,forward,neutral).tags();
+            assertFalse(tags.containsKey(50779));assertFalse(tags.containsKey(50722));assertTrue(tags.containsKey(50964));
+        }
+        assertFalse(M9DngColorMetadata.create(17,21,color,null,identity,identity,forward,forward,neutral).tags().containsKey(50779));
+    }
+    @Test public void optionalNonfiniteMatricesAreOmitted() {
+        float[] bad=identity.clone();bad[2]=Float.NaN;
+        Map<Integer,double[]> tags=M9DngColorMetadata.create(21,null,color,null,bad,null,bad,null,neutral).tags();
+        assertFalse(tags.containsKey(50723));assertFalse(tags.containsKey(50964));
+    }
+}

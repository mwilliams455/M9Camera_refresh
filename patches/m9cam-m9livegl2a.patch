+            this.undo=undo.clone(); this.source=source.clone(); this.target=target.clone();
+            this.white=new float[]{(float)white[0],(float)white[1],(float)white[2]};
+            tungstenWeight=tungsten; this.inverse=inverse.clone(); postRawBoost=boost;
+        }
+        public static Frame fallback(String reason) { return new Frame(reason); }
+        public float[] matrix(int index) { return (index==0?undo:index==1?source:target).clone(); }
+        public float[] white() { return white.clone(); }
+        public byte[] inverseTexture() { return inverse.clone(); }
+        public JSONObject diagnostics() {
+            JSONObject o=new JSONObject();
+            try {
+                o.put("revision",REVISION).put("ready",ready).put("reason",reason).put("cameraId",cameraId);
+                o.put("inputDomain",ready?"reported_contrast_curve_OES_reconstructed_sensor_RGB":"processed_OES_exposure_only_fallback");
+                o.put("sourceToTarget",ready?"native_physical_sensor_ProPhoto_D50_M9":"bypassed");
+                o.put("postRawBoostRemoved",ready?postRawBoost:JSONObject.NULL);
+                o.put("sourceReconstructionExact",false);
+                o.put("limitations","ISP_CCM_approximation_demosaic_shading_and_preexisting_clipping;_no_RAW_recovery");
+                o.put("toneNormalization","unity_pending_live_linear_TC20_meter");
+                o.put("rawCpuPreview",false).put("fittedResidualStack",false);
+                o.put("sat2",ready).put("curve02",ready).put("tungstenWeight",tungstenWeight);
+                o.put("inputToSensorGL",new JSONArray(undo));
+                o.put("sensorToProPhotoGL",new JSONArray(source));
+                o.put("proPhotoToM9GL",new JSONArray(target));
+                o.put("clipWhite",new JSONArray(white));
+            } catch (org.json.JSONException e) { throw new IllegalStateException(e); }
+            return o;
+        }
+    }
+}

+package com.particlesdevs.photoncamera.m9.preview;
+
+import android.hardware.camera2.CameraCharacteristics;
+import android.hardware.camera2.CaptureRequest;
+import android.hardware.camera2.CaptureResult;
+import android.hardware.camera2.TotalCaptureResult;
+import android.hardware.camera2.params.ColorSpaceTransform;
+import android.hardware.camera2.params.RggbChannelVector;
+import android.hardware.camera2.params.TonemapCurve;
+import android.os.Build;
+import com.particlesdevs.photoncamera.m9.render.M9R35Renderer;
+import org.json.JSONArray;
+import org.json.JSONObject;
+import java.util.Arrays;
+
+/** Controlled OES reconstruction. This is not RAW: clipping and ISP demosaic are irreversible. */
+public final class M9GpuPreview2A {
+    public static final String REVISION="M9LIVEGL2A_CONTROLLEDOES";
+    private M9GpuPreview2A() {}
+    private static String cachedKey;
+    private static Frame cachedFrame;
+
+    public static void configure(CaptureRequest.Builder builder, CameraCharacteristics chars) {
+        if (chars==null) return;
+        int[] modes=chars.get(CameraCharacteristics.TONEMAP_AVAILABLE_TONE_MAP_MODES);
+        boolean supported=false;
+        if (modes!=null) for (int mode:modes) if (mode==CaptureRequest.TONEMAP_MODE_CONTRAST_CURVE) supported=true;
+        Integer max=chars.get(CameraCharacteristics.TONEMAP_MAX_CURVE_POINTS);
+        if (!supported || max==null || max<16) return;
+        float[] curve=M9PreviewMath2A.srgbCurve(max);
+        builder.set(CaptureRequest.TONEMAP_MODE,CaptureRequest.TONEMAP_MODE_CONTRAST_CURVE);
+        builder.set(CaptureRequest.TONEMAP_CURVE,new TonemapCurve(curve,curve,curve));
+    }
+
+    public static synchronized Frame from(CameraCharacteristics chars, CaptureResult logical,
+            String cameraId) {
+        try {
+            if (logical==null || chars==null || cameraId==null) return Frame.fallback("missing_camera_metadata");
+            CaptureResult result=logical;
+            String[] ids=cameraId.split("-");
+            if (ids.length==2 && !ids[0].equals(ids[1])) {
+                if (Build.VERSION.SDK_INT<28 || !(logical instanceof TotalCaptureResult))
+                    return Frame.fallback("physical_result_unavailable");
+                result=((TotalCaptureResult)logical).getPhysicalCameraResults().get(ids[1]);
+                if (result==null) return Frame.fallback("physical_result_unavailable");
+            }
+            Integer mode=result.get(CaptureResult.TONEMAP_MODE);
+            if (mode==null || mode!=CaptureResult.TONEMAP_MODE_CONTRAST_CURVE)
+                return Frame.fallback("controlled_curve_not_reported");
+            TonemapCurve curve=result.get(CaptureResult.TONEMAP_CURVE);
+            ColorSpaceTransform transform=result.get(CaptureResult.COLOR_CORRECTION_TRANSFORM);
+            RggbChannelVector gains=result.get(CaptureResult.COLOR_CORRECTION_GAINS);
+            android.util.Rational[] neutral=result.get(CaptureResult.SENSOR_NEUTRAL_COLOR_POINT);
+            Integer boost=result.get(CaptureResult.CONTROL_POST_RAW_SENSITIVITY_BOOST);
+            if (curve==null || transform==null || gains==null || neutral==null || boost==null || boost<=0)
+                return Frame.fallback("incomplete_source_contract");
+            // Both greens are merged by demosaic. A materially different gain cannot be inverted from RGB.
+            if (Math.abs(gains.getGreenEven()-gains.getGreenOdd())>.01f)
+                return Frame.fallback("unequal_green_gains");
+            String key=cameraId+"|"+System.identityHashCode(chars)+"|"+curve+"|"+transform+"|"+gains+"|"+Arrays.toString(neutral)+"|"+boost;
+            if (key.equals(cachedKey)) return cachedFrame;
+            float[][] curves=new float[3][];
+            for (int c=0;c<3;c++) {
+                curves[c]=new float[2*curve.getPointCount(c)]; curve.copyColorCurve(c,curves[c],0);
+                if (!M9PreviewMath2A.validCurve(curves[c])) return Frame.fallback("noninvertible_tonemap_curve");
+            }
+            double[] ccm=new double[9];
+            for (int y=0;y<3;y++) for (int x=0;x<3;x++) ccm[y*3+x]=transform.getElement(x,y).doubleValue();
+            double[] undo=M9PreviewMath2A.inverse(ccm);
+            double[] wb={gains.getRed(),(gains.getGreenEven()+gains.getGreenOdd())*.5,gains.getBlue()};
+            for (int y=0;y<3;y++) {
+                if (!Double.isFinite(wb[y]) || wb[y]<=0) return Frame.fallback("invalid_WB_gain");
+                for (int x=0;x<3;x++) undo[y*3+x]/=wb[y]*(boost/100.0);
+            }
+            // Read-only export uses the exact production native physical-sensor context builder.
+            double[][] nativeContext=M9R35Renderer.exportPreviewContext2A(chars,result);
+            Frame frame=new Frame(cameraId,M9PreviewMath2A.columnMajor(undo),
+                    M9PreviewMath2A.columnMajor(nativeContext[0]),M9PreviewMath2A.columnMajor(nativeContext[1]),
+                    nativeContext[2],(float)nativeContext[3][0],M9PreviewMath2A.inverseTexture(curves),boost);
+            cachedKey=key; cachedFrame=frame; return frame;
+        } catch (Exception e) { return Frame.fallback("source_contract_error:"+e.getClass().getSimpleName()); }
+    }
+
+    public static final class Frame {
+        public final boolean ready;
+        public final String reason, cameraId;
+        public final float tungstenWeight;
+        public final int postRawBoost;
+        private final float[] undo, source, target, white;
+        private final byte[] inverse;
+        private Frame(String reason) {
+            ready=false; this.reason=reason; cameraId=""; tungstenWeight=0; postRawBoost=100;
+            undo=source=target=new float[]{1,0,0,0,1,0,0,0,1}; white=new float[]{1,1,1}; inverse=new byte[0];
+        }

+package com.particlesdevs.photoncamera.capture;
+
+import static org.junit.Assert.*;
+import static org.mockito.Mockito.*;
+import android.app.Application;
+import android.graphics.ImageFormat;
+import android.graphics.Rect;
+import android.hardware.camera2.CameraCharacteristics;
+import android.hardware.camera2.params.StreamConfigurationMap;
+import android.util.Size;
+import com.particlesdevs.photoncamera.api.CameraReflectionApi;
+import com.particlesdevs.photoncamera.api.Settings;
+import com.particlesdevs.photoncamera.app.PhotonCamera;
+import java.lang.reflect.InvocationTargetException;
+import java.lang.reflect.Method;
+import java.util.Arrays;
+import java.util.Collections;
+import org.junit.*;
+import org.junit.runner.RunWith;
+import org.mockito.MockedStatic;
+import org.robolectric.RobolectricTestRunner;
+import org.robolectric.annotation.Config;
+import org.robolectric.util.ReflectionHelpers;
+
+@RunWith(RobolectricTestRunner.class)
+@Config(sdk=35, application=Application.class)
+public class RawGeometryTest {
+    private final Rect active = new Rect(0, 0, 4000, 3000);
+    private final Rect pre = new Rect(4, 6, 4016, 3024);
+    private final Size standard = new Size(4000, 3000), vendor = new Size(8000, 6000);
+
+    @Test public void ordinaryTwoTimesScalePreservesValuesAndInputs() {
+        RawGeometry1A.Pair p = RawGeometry1A.prepare(active, pre, vendor);
+        assertNotNull(p);
+        assertEquals(new Rect(0,0,8000,6000), p.active);
+        assertEquals(new Rect(8,12,8032,6048), p.preCorrection);
+        assertEquals(new Rect(0,0,4000,3000), active);
+        assertEquals(new Rect(4,6,4016,3024), pre);
+        assertNotSame(active, p.active); assertNotSame(pre, p.preCorrection);
+    }
+    @Test public void nonZeroOriginKeepsBottomBasedConventionAndTruncation() {
+        RawGeometry1A.Pair p = RawGeometry1A.prepare(new Rect(3,7,4003,3007), pre, vendor);
+        assertNotNull(p);
+        double k = 6000.0 / 3007;
+        assertEquals(new Rect((int)(3*k),(int)(7*k),(int)(4003*k),(int)(3007*k)),p.active);
+        assertEquals(new Rect((int)(4*k),(int)(6*k),(int)(4016*k),(int)(3024*k)),p.preCorrection);
+    }
+    @Test public void rejectsNullRectangles() {
+        assertNull(RawGeometry1A.prepare(null,pre,vendor));
+        assertNull(RawGeometry1A.prepare(active,null,vendor));
+    }
+    @Test public void rejectsZeroBottomBeforeDivision() { assertNull(RawGeometry1A.prepare(new Rect(0,0,4000,0),pre,vendor)); }
+    @Test public void rejectsNegativeCoordinates() {
+        for (Rect r : Arrays.asList(new Rect(-1,0,4000,3000),new Rect(0,-1,4000,3000),new Rect(0,0,-1,3000),new Rect(0,0,4000,-1)))
+            assertNull(RawGeometry1A.prepare(r,pre,vendor));
+    }
+    @Test public void rejectsEmptyAndReversedRectangles() {
+        for (Rect r : Arrays.asList(new Rect(2,0,2,3000),new Rect(3,0,2,3000),new Rect(0,3,4000,3),new Rect(0,4,4000,3)))
+            assertNull(RawGeometry1A.prepare(active,r,vendor));
+    }
+    @Test public void rejectsNullAndNonPositiveTarget() {
+        for (Size s : Arrays.asList(null,new Size(0,6000),new Size(-1,6000),new Size(8000,0),new Size(8000,-1)))
+            assertNull(RawGeometry1A.prepare(active,pre,s));
+    }
+    @Test public void rejectsNonFiniteAndNonPositiveScale() {
+        for (double k : new double[]{Double.NaN,Double.POSITIVE_INFINITY,Double.NEGATIVE_INFINITY,0,-1})
+            assertNull(RawGeometry1A.scale(active,k));
+    }
+    @Test public void rejectsCoordinateOverflowWithoutSaturation() {
+        assertNull(RawGeometry1A.scale(new Rect(0,0,Integer.MAX_VALUE,3000),1.0000001));
+        assertNull(RawGeometry1A.scale(active,Double.MAX_VALUE));
+    }
+    @Test public void acceptsExactlyRepresentableIntegerBoundary() {
+        Rect r = new Rect(0,0,Integer.MAX_VALUE,Integer.MAX_VALUE);
+        assertEquals(r,RawGeometry1A.scale(r,1.0));
+    }
+    @Test public void rejectsGeometryCollapsedByTruncation() { assertNull(RawGeometry1A.scale(new Rect(1,1,2,2),0.1)); }
+    @Test public void secondRectangleFailureLeavesBothSourcesUntouched() {
+        Rect invalidPre = new Rect(0,0,Integer.MAX_VALUE,3024);
+        assertNull(RawGeometry1A.prepare(active,invalidPre,vendor));
+        assertEquals(new Rect(0,0,4000,3000),active);
+        assertEquals(new Rect(0,0,Integer.MAX_VALUE,3024),invalidPre);
+    }
+    @Test public void repeatedPreparationIsStable() {
+        RawGeometry1A.Pair a=RawGeometry1A.prepare(active,pre,vendor), b=RawGeometry1A.prepare(active,pre,vendor);
+        assertEquals(a.active,b.active); assertEquals(a.preCorrection,b.preCorrection);
+    }
+    @Test public void publicFallbackChoosesLargestValidSizeUnderLimit() {
+        assertEquals(standard,RawGeometry1A.publicFallback(new Size[]{vendor,null,new Size(65536,65536),standard,new Size(2000,1500)},true,20_000_000));
+    }
+    @Test public void fallbackUsesSmallestAdvertisedWhenAllExceedLimit() {
+        assertEquals(standard,RawGeometry1A.publicFallback(new Size[]{vendor,standard},true,1));
+    }
+    @Test public void fallbackNeverInventsOrAcceptsInvalidRawSize() {
+        assertNull(RawGeometry1A.publicFallback(new Size[]{new Size(4001,3000),new Size(0,3000),new Size(65536,65536)},true,20_000_000));
+        assertNull(RawGeometry1A.publicFallback(null,true,20_000_000));
+    }
+
+    /** Exercise the actual controller selector and its publication/fallback boundary. */
+    private final class ControllerFixture implements AutoCloseable {
+        final CameraCharacteristics chars=mock(CameraCharacteristics.class);
+        final StreamConfigurationMap map=mock(StreamConfigurationMap.class);
+        final CaptureController controller=mock(CaptureController.class);
+        final RawSizeCompatibility1A policy=new RawSizeCompatibility1A();
+        final Settings settings=mock(Settings.class);
+        final CameraCharacteristics oldChars=ReflectionHelpers.getStaticField(CaptureController.class,"mCameraCharacteristics");
+        final int oldFormat=ReflectionHelpers.getStaticField(CaptureController.class,"mTargetFormat");
+        final MockedStatic<PhotonCamera> photon=mockStatic(PhotonCamera.class);
+        final MockedStatic<CameraReflectionApi> reflection=mockStatic(CameraReflectionApi.class);
+        final String key="2/2/"+ImageFormat.RAW_SENSOR;
+        ControllerFixture() {
+            settings.QuadBayer=true;
+            photon.when(PhotonCamera::getSettings).thenReturn(settings);
+            ReflectionHelpers.setStaticField(CaptureController.class,"mCameraCharacteristics",chars);
+            ReflectionHelpers.setStaticField(CaptureController.class,"mTargetFormat",ImageFormat.RAW_SENSOR);
+            ReflectionHelpers.setField(controller,"logicalID","2");
+            ReflectionHelpers.setField(controller,"physicalID","2");
+            ReflectionHelpers.setField(controller,"rawSizeCompatibility1A",policy);
+            ReflectionHelpers.setField(controller,"useMaximumResolutionKey",true);
+            when(chars.get(CameraCharacteristics.SENSOR_INFO_ACTIVE_ARRAY_SIZE)).thenReturn(active);
+            when(chars.get(CameraCharacteristics.SENSOR_INFO_PRE_CORRECTION_ACTIVE_ARRAY_SIZE)).thenReturn(pre);
+            when(chars.get(CameraCharacteristics.SCALER_STREAM_CONFIGURATION_MAP)).thenReturn(map);
+            when(map.getOutputSizes(ImageFormat.RAW_SENSOR)).thenReturn(new Size[]{standard});
+            RawSizeCompatibility1A.Discovery discovery=policy.discover(key,Collections.singletonList(standard),Collections.singletonList(vendor),true,true);
+            ReflectionHelpers.setField(controller,"rawSizeDiscovery1A",discovery);
+            ReflectionHelpers.setField(controller,"rawSizeTrial1A",discovery.trial(vendor,chars,active,pre));
+        }
+        Size select() throws Exception {
+            Method m=CaptureController.class.getDeclaredMethod("getCameraOutputSize",Size[].class,Size.class);
+            m.setAccessible(true); return (Size)m.invoke(controller,new Size[]{standard,vendor},new Size(1920,1080));
+        }
+        @Override public void close() {
+            reflection.close(); photon.close();
+            ReflectionHelpers.setStaticField(CaptureController.class,"mCameraCharacteristics",oldChars);
+            ReflectionHelpers.setStaticField(CaptureController.class,"mTargetFormat",oldFormat);
+        }
+    }
+    @Test public void controllerPublishesBothValidatedCopiesForValidGeometry() throws Exception {
+        try (ControllerFixture f=new ControllerFixture()) {
+            assertEquals(vendor,f.select());
+            f.reflection.verify(()->CameraReflectionApi.set(eq(f.chars),eq(CameraCharacteristics.SENSOR_INFO_ACTIVE_ARRAY_SIZE),eq(new Rect(0,0,8000,6000))));
+            f.reflection.verify(()->CameraReflectionApi.set(eq(f.chars),eq(CameraCharacteristics.SENSOR_INFO_PRE_CORRECTION_ACTIVE_ARRAY_SIZE),eq(new Rect(8,12,8032,6048))));
+            assertEquals(new Rect(0,0,4000,3000),active); assertEquals(new Rect(4,6,4016,3024),pre);
+            assertTrue(ReflectionHelpers.getField(f.controller,"useMaximumResolutionKey"));
+        }
+    }
+    @Test public void controllerRejectsZeroBottomWithoutPublishingEitherRectangle() throws Exception {
+        try (ControllerFixture f=new ControllerFixture()) {
+            when(f.chars.get(CameraCharacteristics.SENSOR_INFO_ACTIVE_ARRAY_SIZE)).thenReturn(new Rect(0,0,4000,0));
+            assertEquals(standard,f.select()); f.reflection.verifyNoInteractions();
+        }
+    }
+    @Test public void controllerSecondRectangleOverflowCannotPartlyPublishFirst() throws Exception {
+        try (ControllerFixture f=new ControllerFixture()) {
+            when(f.chars.get(CameraCharacteristics.SENSOR_INFO_PRE_CORRECTION_ACTIVE_ARRAY_SIZE)).thenReturn(new Rect(0,0,Integer.MAX_VALUE,3024));
+            assertEquals(standard,f.select()); f.reflection.verifyNoInteractions();
+            assertEquals(new Rect(0,0,4000,3000),active);
+        }
+    }
+    @Test public void controllerFallbackClearsTrialsAndMaximumResolutionAndBlocksHintsForThisCamera() throws Exception {
+        try (ControllerFixture f=new ControllerFixture()) {
+            when(f.chars.get(CameraCharacteristics.SENSOR_INFO_ACTIVE_ARRAY_SIZE)).thenReturn(null);
+            assertEquals(standard,f.select());
+            assertNull(ReflectionHelpers.getField(f.controller,"rawSizeTrial1A"));
+            assertNull(ReflectionHelpers.getField(f.controller,"rawSizeDiscovery1A"));
+            assertFalse(ReflectionHelpers.getField(f.controller,"useMaximumResolutionKey"));
+            assertTrue(f.policy.discover(f.key,Collections.singletonList(standard),Collections.singletonList(vendor),true,true).additions.isEmpty());
+            assertFalse(f.policy.discover("3/3/32",Collections.singletonList(standard),Collections.singletonList(vendor),true,true).additions.isEmpty());
+        }
+    }
+    @Test public void controllerWithoutPublicFallbackRejectsInsteadOfUsingPreviewDimensions() throws Exception {
+        try (ControllerFixture f=new ControllerFixture()) {
+            when(f.chars.get(CameraCharacteristics.SENSOR_INFO_ACTIVE_ARRAY_SIZE)).thenReturn(null);
+            when(f.map.getOutputSizes(ImageFormat.RAW_SENSOR)).thenReturn(null);
+            InvocationTargetException error=assertThrows(InvocationTargetException.class,f::select);
+            assertTrue(error.getCause() instanceof IllegalArgumentException);
+            assertTrue(error.getCause().getMessage().contains("RAWGEOMETRY1A"));
+            f.reflection.verifyNoInteractions();
+        }
+    }
+    @Test public void controllerFallbackIsRepeatableAndDoesNotPublishOnRetry() throws Exception {
+        try (ControllerFixture f=new ControllerFixture()) {
+            when(f.chars.get(CameraCharacteristics.SENSOR_INFO_PRE_CORRECTION_ACTIVE_ARRAY_SIZE)).thenReturn(null);
+            assertEquals(standard,f.select()); assertEquals(standard,f.select());
+            f.reflection.verifyNoInteractions();
+        }
+    }
+}

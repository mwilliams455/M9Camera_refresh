+package com.particlesdevs.photoncamera.capture;
+
+import android.graphics.Rect;
+import android.util.Size;
+
+/** Validate the whole Quad Bayer geometry before publishing either rectangle. */
+final class RawGeometry1A {
+    static final String REVISION = "RAWGEOMETRY1A";
+
+    static final class Pair {
+        final Rect active, preCorrection;
+        Pair(Rect active, Rect preCorrection) {
+            this.active = active;
+            this.preCorrection = preCorrection;
+        }
+    }
+
+    static boolean valid(Rect rect) {
+        return rect != null && rect.left >= 0 && rect.top >= 0
+                && rect.right > rect.left && rect.bottom > rect.top;
+    }
+
+    static Pair prepare(Rect active, Rect preCorrection, Size target) {
+        if (!valid(active) || !valid(preCorrection) || target == null
+                || target.getWidth() <= 0 || target.getHeight() <= 0) return null;
+        // Preserve the established coordinate convention, including non-zero
+        // origins: changing bottom to height would be a separate behavior change.
+        double scale = (double) target.getHeight() / active.bottom;
+        Rect scaledActive = scale(active, scale);
+        Rect scaledPreCorrection = scale(preCorrection, scale);
+        return scaledActive == null || scaledPreCorrection == null ? null
+                : new Pair(scaledActive, scaledPreCorrection);
+    }
+
+    static Rect scale(Rect source, double scale) {
+        if (!valid(source) || !Double.isFinite(scale) || scale <= 0.0) return null;
+        double left = source.left * scale, top = source.top * scale;
+        double right = source.right * scale, bottom = source.bottom * scale;
+        if (!coordinate(left) || !coordinate(top) || !coordinate(right)
+                || !coordinate(bottom)) return null;
+        // Same double multiplication and truncation as the former int *= double.
+        // Check before narrowing so Java cannot silently saturate overflow.
+        Rect result = new Rect((int) left, (int) top, (int) right, (int) bottom);
+        return valid(result) ? result : null;
+    }
+
+    private static boolean coordinate(double value) {
+        return Double.isFinite(value) && value >= 0.0 && value <= Integer.MAX_VALUE;
+    }
+
+    static Size publicFallback(Size[] sizes, boolean raw, long areaLimit) {
+        Size preferred = null, smallest = null;
+        if (sizes != null) for (Size size : sizes) {
+            if (size == null || size.getWidth() <= 0 || size.getHeight() <= 0
+                    || (raw && !RawSizeCompatibility1A.valid(size))) continue;
+            long area = (long) size.getWidth() * size.getHeight();
+            if (smallest == null || area < (long) smallest.getWidth() * smallest.getHeight())
+                smallest = size;
+            if (area <= areaLimit && (preferred == null
+                    || area > (long) preferred.getWidth() * preferred.getHeight())) preferred = size;
+        }
+        return preferred != null ? preferred : smallest;
+    }
+}

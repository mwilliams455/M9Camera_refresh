+package com.particlesdevs.photoncamera.m9;
+
+import org.junit.Test;
+import org.json.JSONObject;
+import java.util.HashMap;
+import java.util.Map;
+import java.util.concurrent.atomic.AtomicInteger;
+import static org.junit.Assert.*;
+
+public class M9BracketTest {
+    private M9Bracket1A.Context context(double ev,String camera,long session,long lock,String output){
+        return new M9Bracket1A.Context(new M9AeLock1A.Context(camera,"PHOTO",session,ev,0,0,"iso800","torch_off"),lock,output);
+    }
+    private M9Bracket1A.Context normal(){return context(-1.0/3,"0",1,2,"jpegraw");}
+    private M9ExposurePlan1A plan(long id,long now){
+        return new M9ExposurePlan1A(id,now,now*1000000,"0","PHOTO",200,10000000,200,10000000,
+                160,10000000,-1.0/3,0.1,"placement",0,0,100)
+                .withAutoIsoControls("iso800").withAeLockState(2,12)
+                .withAllocationSnapshot2G("{\"base\":true}").withAutoPlacement2D("{\"held\":true}");
+    }
+    private long start(M9Bracket1A.Series s,int frames,int step,int order,int mode){
+        return s.start(normal(),new M9Bracket1A.Settings(true,frames,step,order),mode,true,2,2,3,100);
+    }
+    @Test public void supportedSequencesAndSevenFrameRestriction(){
+        assertArrayEquals(new double[]{0,.5,-.5},new M9Bracket1A.Settings(true,3,1,0).offsets(),0);
+        assertArrayEquals(new double[]{0,1,-1,2,-2},new M9Bracket1A.Settings(true,5,2,0).offsets(),0);
+        assertArrayEquals(new double[]{-4,-2,0,2,4},new M9Bracket1A.Settings(true,5,4,1).offsets(),0);
+        assertArrayEquals(new double[]{-3,-2,-1,0,1,2,3},new M9Bracket1A.Settings(true,7,4,1).offsets(),0);
+        assertEquals(2,new M9Bracket1A.Settings(true,7,3,0).halfStops);
+    }
+    @Test public void defaultOffIgnoresInheritedPhotonHdrAndInvalidPreferences(){
+        Map<String,Object> m=new HashMap<>();m.put("pref_bracketing_key","2");
+        assertFalse(M9Bracket1A.Settings.read(m).enabled);
+        m.put(M9Bracket1A.ENABLED,"bad");m.put(M9Bracket1A.FRAMES,7);
+        assertFalse(M9Bracket1A.Settings.read(m).enabled);assertEquals(3,M9Bracket1A.Settings.read(m).frames);
+        m.put(M9Bracket1A.ENABLED,"1");m.put(M9Bracket1A.FRAMES,"7");m.put(M9Bracket1A.STEP,"4");
+        assertTrue(M9Bracket1A.Settings.read(m).enabled);assertEquals(2,M9Bracket1A.Settings.read(m).halfStops);
+    }
+    @Test public void everySeriesSavesRequestedCountAtFixedIsoForAllOutputModes(){
+        for(int mode=0;mode<3;mode++)for(int count:new int[]{3,5,7})for(int order=0;order<2;order++)for(int step=1;step<=4;step++) {
+            M9Bracket1A.Series s=new M9Bracket1A.Series();long token=start(s,count,step,order,mode);
+            assertTrue(token>0);assertEquals(0,start(s,count,step,order,mode));
+            double[] ev=new M9Bracket1A.Settings(true,count,step,order).offsets();
+            for(int i=0;i<count;i++) {
+                long now=100+i*2000;assertTrue(s.request(token,normal(),now));assertFalse(s.request(token,normal(),now));
+                M9ExposurePlan1A f=s.frame(token,normal(),plan(10+i,now),1000+i,now,1000,1000000000L);
+                assertNotNull(f);assertEquals(160,f.iso);assertEquals(Math.round(10000000*Math.pow(2,ev[i])),f.exposureNs);
+                assertEquals(10,f.bracket.basePlanId);assertEquals(ev[i],f.bracket.requestedEv,0);
+                assertEquals(mode,f.bracket.saveMode);assertEquals(i,f.bracket.index);assertEquals(count,f.bracket.count);
+                assertFalse(s.ready());assertNull(s.frame(token,normal(),plan(10,now),33,now,1,Long.MAX_VALUE));
+                M9Bracket1A.Completion done=new M9Bracket1A.Completion(f.bracket,0);
+                assertEquals(i==count-1?2:1,s.complete(done,normal(),now+50));
+                assertEquals(0,s.complete(done,normal(),now+51));
+            }
+            assertFalse(s.active());
+        }
+    }
+    @Test public void actualLimitsClampShutterWithoutChangingIsoOrNumberOfFiles(){
+        M9Bracket1A.Series s=new M9Bracket1A.Series();long t=start(s,3,4,1,1);
+        long[] times={8000000,10000000,12000000};
+        for(int i=0;i<3;i++){
+            assertTrue(s.request(t,normal(),100));
+            M9ExposurePlan1A f=s.frame(t,normal(),plan(10,100),20+i,100,8000000,12000000);
+            assertEquals(times[i],f.exposureNs);assertEquals(160,f.iso);
+            assertEquals(Math.log(times[i]/10000000.0)/Math.log(2),f.bracket.actualEv,1e-12);
+            assertEquals(i==2?2:1,s.complete(new M9Bracket1A.Completion(f.bracket,0),normal(),101));
+        }
+    }
+    @Test public void tc20DoesNotNormalizeBracketBrightnessBackToTheCentre(){
+        M9ExposurePlan1A base=plan(10,100);
+        double referenceGain=-1;
+        for(int stop=-3;stop<=3;stop++){
+            long time=M9Bracket1A.shutter(base.exposureNs,stop,1000,1000000000);
+            M9Bracket1A.Frame metadata=new M9Bracket1A.Frame(1,20,10,base.exposureNs,base.iso,stop+3,7,stop,time,1,false,2,2,3);
+            M9ExposurePlan1A f=M9Bracket1A.project(base,base,20,100,metadata,time);
+            double scale=f.renderIntentScale(f.iso,f.exposureNs);
+            double median=40*scale,tail=80*scale;
+            double gain=M9ExposurePlan1A.neutralBaseGain(median,scale,64);
+            if(referenceGain<0)referenceGain=gain;
+            assertEquals(referenceGain,gain,1e-12);
+            assertEquals(2.5,M9ExposurePlan1A.neutralGuardGain(tail,scale,200),1e-12);
+            assertEquals(64*scale,median*gain,1e-10);
+            assertEquals(base.userEv,f.userEv,0);assertEquals(base.autoEv,f.autoEv,0);
+        }
+    }
+    @Test public void liveReferencePreservesSceneChangesAndActualSensorExposure(){
+        M9ExposurePlan1A base=plan(10,100);
+        M9ExposurePlan1A live=new M9ExposurePlan1A(11,2000,2,"0","PHOTO",200,5000000,200,5000000,
+                160,5000000,base.userEv,0,"new scene",0,0,100);
+        M9Bracket1A.Frame meta=new M9Bracket1A.Frame(1,20,10,base.exposureNs,160,1,3,1,20000000,1,false,2,2,3);
+        M9ExposurePlan1A f=M9Bracket1A.project(base,live,20,2000,meta,20000000);
+        assertEquals(5000000,f.referenceExposureNs);assertEquals(160,f.iso);assertEquals(20000000,f.exposureNs);
+        assertEquals(3.2,f.renderIntentScale(160,20000000),1e-12);
+        assertEquals(2.4,f.renderIntentScale(160,15000000),1e-12); // HAL limited time
+        assertEquals(12,f.aeLockSourcePlanId);
+    }
+    @Test public void metadataSurvivesAllPlanCopiesAndDiagnostics() throws Exception {
+        M9Bracket1A.Series s=new M9Bracket1A.Series();long token=start(s,3,1,0,1);s.request(token,normal(),100);
+        M9ExposurePlan1A f=s.frame(token,normal(),plan(10,100),11,100,1,Long.MAX_VALUE);
+        M9ExposurePlan1A copy=f.withAutoIsoControls("x").withAutoPlacement2D("{}")
+                .withAllocationSnapshot2G("{}").withAeLockState(4,3).withShutterPreviewSnapshot1W("{}");
+        assertSame(f.bracket,copy.bracket);
+        JSONObject json=M9ExposurePlanDiagnostics1A.toJson(copy);
+        assertTrue(json.getBoolean("bracketingFrame"));assertFalse(json.getBoolean("bracketingHdrMerge"));
+        assertEquals(3,json.getInt("bracketingCount"));assertEquals(token,json.getLong("bracketingSeriesId"));
+    }
+    @Test public void cancelledAndPreviousControllerEventsCannotAdvanceNewSeries(){
+        M9Bracket1A.Series old=new M9Bracket1A.Series();long t=start(old,3,1,0,1);old.request(t,normal(),100);
+        M9ExposurePlan1A f=old.frame(t,normal(),plan(10,100),11,100,1,Long.MAX_VALUE);old.cancel();
+        assertFalse(old.request(t,normal(),200));assertNull(old.frame(t,normal(),plan(1,200),3,200,1,Long.MAX_VALUE));
+        M9Bracket1A.Series next=new M9Bracket1A.Series();long nextToken=start(next,3,1,0,1);assertNotEquals(t,nextToken);
+        next.request(nextToken,normal(),100);next.frame(nextToken,normal(),plan(10,100),11,100,1,Long.MAX_VALUE);
+        assertEquals(0,next.complete(new M9Bracket1A.Completion(f.bracket,0),normal(),110));assertTrue(next.active());
+    }
+    @Test public void contextChangesAndSaveFailureStopTheRemainingSeries(){
+        for(M9Bracket1A.Context changed:new M9Bracket1A.Context[]{context(0,"0",1,2,"jpegraw"),
+                context(-1.0/3,"1",1,2,"jpegraw"),context(-1.0/3,"0",2,2,"jpegraw"),
+                context(-1.0/3,"0",1,3,"jpegraw"),context(-1.0/3,"0",1,2,"raw")}) {
+            M9Bracket1A.Series s=new M9Bracket1A.Series();long t=start(s,3,1,0,1);s.request(t,normal(),100);
+            M9ExposurePlan1A f=s.frame(t,normal(),plan(10,100),11,100,1,Long.MAX_VALUE);
+            assertFalse(s.valid(t,changed));assertEquals(-1,s.complete(new M9Bracket1A.Completion(f.bracket,0),changed,101));
+            assertFalse(s.active());
+        }
+        M9Bracket1A.Series s=new M9Bracket1A.Series();long t=start(s,3,1,0,1);s.request(t,normal(),100);
+        M9ExposurePlan1A f=s.frame(t,normal(),plan(10,100),11,100,1,Long.MAX_VALUE);
+        assertEquals(-1,s.complete(new M9Bracket1A.Completion(f.bracket,M9SaveStatus.DNG),normal(),101));
+        assertFalse(s.active());
+    }
+    @Test public void freshnessAndDeadlinesDoNotTruncateLongExposure(){
+        M9Bracket1A.Series s=new M9Bracket1A.Series();long t=start(s,3,1,0,1);
+        assertFalse(s.expired(20099));assertTrue(s.expired(20100));s.request(t,normal(),200);
+        assertNull(s.frame(t,normal(),plan(10,100),11,1601,1,Long.MAX_VALUE));
+        assertNull(s.frame(t,normal(),plan(10,100),11,99,1,Long.MAX_VALUE));
+        M9ExposurePlan1A longPlan=new M9ExposurePlan1A(10,1000,1,"0","PHOTO",160,240000000000L,
+                160,240000000000L,160,240000000000L,-1.0/3,0,"long",0,0,100);
+        assertNotNull(s.frame(t,normal(),longPlan,11,1000,1,Long.MAX_VALUE));
+        assertFalse(s.expired(360999));assertTrue(s.expired(361000));
+    }
+    @Test public void finalOutputTicketRequiresSelectedFormatsAndCompletesExactlyOnce() throws Exception {
+        for(int mode=0;mode<3;mode++) {
+            M9SaveStatus status=new M9SaveStatus();AtomicInteger calls=new AtomicInteger(),issues=new AtomicInteger(-1);
+            M9SaveStatus.Ticket ticket=status.begin(M9SaveSelection.fromMode(mode,false),p->{calls.incrementAndGet();issues.set(p);});
+            assertEquals(0,calls.get());assertEquals(1,status.snapshot().pending);
+            ticket.complete(mode!=2,mode!=0,mode!=0,false,true);
+            ticket.complete(false,false,false,false,false);ticket.fail(32);
+            assertEquals(1,calls.get());assertEquals(0,issues.get());assertEquals(1,status.snapshot().saved);
+        }
+        M9SaveStatus status=new M9SaveStatus();AtomicInteger issues=new AtomicInteger();
+        M9SaveStatus.Ticket missing=status.begin(M9SaveSelection.fromMode(1,false),issues::set);
+        missing.complete(true,false,false,false,true);assertEquals(M9SaveStatus.DNG,issues.get());
+    }
+    @Test public void concurrentCompletionAndFailureOnlyReleaseOneEvent() throws Exception {
+        M9SaveStatus status=new M9SaveStatus();AtomicInteger calls=new AtomicInteger();
+        M9SaveStatus.Ticket ticket=status.begin(M9SaveSelection.fromMode(0,false),p->calls.incrementAndGet());
+        Thread a=new Thread(()->ticket.complete(true,false,false,false,true));
+        Thread b=new Thread(()->ticket.fail(M9SaveStatus.PROCESSING));a.start();b.start();a.join();b.join();
+        assertEquals(1,calls.get());assertEquals(0,status.snapshot().pending);
+    }
+}

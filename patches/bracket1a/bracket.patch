+package com.particlesdevs.photoncamera.m9;
+
+import java.util.Map;
+import java.util.Objects;
+import java.util.concurrent.atomic.AtomicLong;
+
+/** Separate exposures. Pure sequence/intent policy shared by capture and save completion. */
+public final class M9Bracket1A {
+    public static final String REVISION="M9BRACKET1A";
+    public static final String ENABLED="pref_m9_bracket_enabled", FRAMES="pref_m9_bracket_frames",
+            STEP="pref_m9_bracket_step", ORDER="pref_m9_bracket_order";
+    private static final AtomicLong IDS=new AtomicLong();
+    private M9Bracket1A() {}
+    public static final class Settings {
+        public final boolean enabled;
+        public final int frames, halfStops, order;
+        public Settings(boolean enabled,int frames,int halfStops,int order) {
+            this.enabled=enabled; this.frames=frames==5?5:frames==7?7:3;
+            this.halfStops=Math.max(1,Math.min(this.frames==7?2:4,halfStops));
+            this.order=order==1?1:0;
+        }
+        public String identity(){return enabled+":"+frames+":"+halfStops+":"+order;}
+        public double[] offsets(){
+            double[] result=new double[frames];int side=(frames-1)/2;
+            if(order==1) {for(int i=0;i<frames;i++)result[i]=(i-side)*halfStops*0.5;}
+            else {for(int i=1;i<=side;i++){result[2*i-1]=i*halfStops*0.5;result[2*i]=-i*halfStops*0.5;}}
+            return result;
+        }
+        public static Settings read(Map<String,?> values){
+            return new Settings(number(values,ENABLED,0)==1,number(values,FRAMES,3),
+                    number(values,STEP,1),number(values,ORDER,0));
+        }
+        private static int number(Map<String,?> values,String key,int fallback){
+            Object v=values==null?null:values.get(key);
+            try{return v instanceof String?Integer.parseInt((String)v):fallback;}
+            catch(NumberFormatException invalid){return fallback;}
+        }
+    }
+    public static final class Context {
+        public final M9AeLock1A.Context exposure;
+        public final long lockGeneration;
+        public final String settings;
+        public Context(M9AeLock1A.Context exposure,long lockGeneration,String settings){
+            this.exposure=exposure;this.lockGeneration=lockGeneration;this.settings=settings;
+        }
+        @Override public boolean equals(Object other){
+            if(!(other instanceof Context))return false;Context c=(Context)other;
+            return lockGeneration==c.lockGeneration && Objects.equals(exposure,c.exposure)
+                    && Objects.equals(settings,c.settings);
+        }
+        @Override public int hashCode(){return Objects.hash(exposure,lockGeneration,settings);}
+    }
+    public static final class Frame {
+        public final long seriesId,planId,basePlanId,baseExposureNs;
+        public final int index,count,baseIso,saveMode,saturation,contrast,sharpness;
+        public final boolean unfiltered;
+        public final double requestedEv,actualEv;
+        public Frame(long seriesId,long planId,long basePlanId,long baseTime,int baseIso,int index,int count,
+                double requestedEv,long time,int saveMode,boolean unfiltered,int saturation,int contrast,int sharpness){
+            this.seriesId=seriesId;this.planId=planId;this.basePlanId=basePlanId;this.baseExposureNs=baseTime;
+            this.baseIso=baseIso;this.index=index;this.count=count;this.requestedEv=requestedEv;
+            this.actualEv=Math.log(time/(double)baseTime)/Math.log(2.0);this.saveMode=saveMode;
+            this.unfiltered=unfiltered;this.saturation=saturation;this.contrast=contrast;this.sharpness=sharpness;
+        }
+    }
+    public static final class Completion {
+        public final Frame frame; public final int issues;
+        public Completion(Frame frame,int issues){this.frame=frame;this.issues=issues;}
+    }
+    public static long shutter(long base,double ev,long min,long max){
+        if(base<=0 || !Double.isFinite(ev) || min<=0 || max<min)
+            throw new IllegalArgumentException("Invalid bracket exposure range");
+        double target=base*Math.pow(2.0,ev);
+        return target>=max?max:target<=min?min:Math.round(target);
+    }
+    public static M9ExposurePlan1A project(M9ExposurePlan1A base,M9ExposurePlan1A live,
+            long id,long now,Frame frame,long time){
+        return new M9ExposurePlan1A(id,now,live.sensorTimestampNs,base.cameraId,base.mode,
+                live.observedIso,live.observedExposureNs,live.referenceIso,live.referenceExposureNs,
+                base.iso,time,base.userEv,base.autoEv,"leica_separate_bracket",
+                base.manualExposureNs,base.manualIso,live.postRawBoost)
+                .withAutoIsoControls(base.getAutoIsoControlsIdentity())
+                .withAutoPlacement2D(base.getAutoPlacementSnapshot2D())
+                .withAllocationSnapshot2G(base.getAllocationSnapshot2G())
+                .withAeLockState(base.aeLockGeneration,base.aeLockSourcePlanId)
+                .withShutterPreviewSnapshot1W(live.getShutterPreviewSnapshot1W()).withBracket(frame);
+    }
+    /** A queued/stale/double completion cannot release an unrelated physical capture. */
+    public static final class Series {
+        private static final int IDLE=0,READY=1,REQUEST=2,SAVING=3;
+        private int state,index,saveMode,saturation,contrast,sharpness;
+        private boolean unfiltered;
+        private long ticket,deadline;
+        private Context context;private Settings settings;private M9ExposurePlan1A base;
+        private Frame pending;
+        public synchronized long start(Context context,Settings settings,int mode,boolean unfiltered,
+                int saturation,int contrast,int sharpness,long now){
+            if(active() || !settings.enabled || context.exposure.manualTime>0
+                    || !"PHOTO".equals(context.exposure.mode))return 0;
+            this.context=context;this.settings=settings;this.saveMode=mode;this.unfiltered=unfiltered;
+            this.saturation=saturation;this.contrast=contrast;this.sharpness=sharpness;
+            base=null;pending=null;index=0;state=READY;deadline=now+20000;return ticket=IDS.incrementAndGet();
+        }
+        public synchronized boolean active(){return state!=IDLE;}
+        public synchronized boolean ready(){return state==READY;}
+        public synchronized long ticket(){return ticket;}
+        public synchronized int index(){return index;}
+        public synchronized int count(){return settings==null?0:settings.frames;}
+        public synchronized boolean valid(long token,Context current){return active()&&ticket==token&&Objects.equals(context,current);}
+        public synchronized boolean expired(long now){return active()&&now>=deadline;}
+        public synchronized void cancel(){state=IDLE;ticket=IDS.incrementAndGet();base=null;pending=null;}
+        public synchronized boolean request(long token,Context current,long now){
+            if(!ready()||!valid(token,current))return false;state=REQUEST;deadline=now+30000;return true;
+        }
+        public synchronized M9ExposurePlan1A frame(long token,Context current,M9ExposurePlan1A live,
+                long id,long now,long min,long max){
+            if(state!=REQUEST||!valid(token,current)||live==null||now<live.createdMs
+                    ||now-live.createdMs>M9ExposurePlan1A.MAX_AGE_MS)return null;
+            if(base==null)base=live;
+            double offset=settings.offsets()[index];long time=shutter(base.exposureNs,offset,min,max);
+            pending=new Frame(ticket,id,base.id,base.exposureNs,base.iso,index,settings.frames,offset,time,
+                    saveMode,unfiltered,saturation,contrast,sharpness);
+            state=SAVING;deadline=now+120000+time/1000000;
+            return project(base,live,id,now,pending,time);
+        }
+        /** 0 ignored, -1 failed, 1 next exposure, 2 complete. */
+        public synchronized int complete(Completion result,Context current,long now){
+            if(state!=SAVING||result==null||result.frame==null||pending==null
+                    ||result.frame.seriesId!=ticket||result.frame.planId!=pending.planId
+                    ||result.frame.index!=index)return 0;
+            if(result.issues!=0||!Objects.equals(context,current)){cancel();return -1;}
+            if(++index==settings.frames){cancel();return 2;}
+            pending=null;state=READY;deadline=now+20000;return 1;
+        }
+    }
+}

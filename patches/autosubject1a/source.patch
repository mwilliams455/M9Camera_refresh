+package com.particlesdevs.photoncamera.control.subject;
+
+import com.particlesdevs.photoncamera.control.tracking.SubjectAnchorPolicy.Candidate;
+import com.particlesdevs.photoncamera.control.tracking.SubjectAnchorPolicy.ClassId;
+import java.util.List;
+
+/** Select one subject on fresh, upright preview frames. Session ownership is checked by the caller. */
+public final class AutomaticSubjectSelection {
+    public static final long MAX_AGE_NS = 350_000_000L;
+    private static final long HOLD_NS = 650_000_000L;
+
+    public static final class Box {
+        public final ClassId type;
+        public final int faceId;
+        public final float left, top, right, bottom, aimX, aimY;
+        public final boolean face, eye;
+
+        private Box(ClassId type, int faceId, boolean face, float left, float top, float right,
+                    float bottom, float aimX, float aimY, boolean eye) {
+            this.type = type;
+            this.faceId = faceId;
+            this.face = face;
+            this.left = left;
+            this.top = top;
+            this.right = right;
+            this.bottom = bottom;
+            this.aimX = aimX;
+            this.aimY = aimY;
+            this.eye = eye;
+        }
+        public float cx() { return (left + right) * .5f; }
+        public float cy() { return (top + bottom) * .5f; }
+        private float area() { return (right - left) * (bottom - top); }
+
+        public static Box fromFace(SubjectFocusPolicy.Face f, boolean admittedEye) {
+            if (f == null || !f.valid() || f.right - f.left < .055f || f.bottom - f.top < .055f)
+                return null;
+            boolean left = f.contains(f.leftEyeX, f.leftEyeY);
+            boolean right = f.contains(f.rightEyeX, f.rightEyeY);
+            if (!(left || right) || !(f.contains(f.noseX, f.noseY) || f.contains(f.mouthX, f.mouthY)))
+                return null;
+            boolean eye = admittedEye && (left || right);
+            // Pick the eye closest to the face centre (the visible eye on profiles).
+            boolean useLeft = left && (!right || Math.abs(f.leftEyeX-f.cx()) <= Math.abs(f.rightEyeX-f.cx()));
+            return new Box(ClassId.PERSON, f.id, true, f.left, f.top, f.right, f.bottom,
+                    eye ? (useLeft ? f.leftEyeX : f.rightEyeX) : f.cx(),
+                    eye ? (useLeft ? f.leftEyeY : f.rightEyeY) : f.cy(), eye);
+        }
+
+        public static Box fromBody(Candidate c) {
+            if (c == null || !c.valid() || c.score < .55f) return null;
+            return new Box(c.category, -1, false, c.left, c.top, c.right, c.bottom,
+                    c.cx(), c.top + c.height() * (c.category == ClassId.PERSON ? .32f : .45f), false);
+        }
+
+        /** A subject-sized square in preview pixels, shared by portrait and landscape. */
+        public float squareSide(int width, int height) {
+            float shortEdge = Math.min(width, height);
+            float extent = Math.max((right-left)*width, (bottom-top)*height);
+            return Math.min(shortEdge*.9f, Math.max(shortEdge*.16f, extent));
+        }
+    }
+
+    private Box active;
+    private long lastSeen = Long.MIN_VALUE, lastFrame = Long.MIN_VALUE;
+    private int hits;
+
+    public void reset() {
+        active = null;
+        lastSeen = lastFrame = Long.MIN_VALUE;
+        hits = 0;
+    }
+
+    public boolean mayAim() { return active != null && hits >= 2; }
+
+    private static float overlap(Box a, Box b) {
+        float w = Math.max(0f, Math.min(a.right,b.right)-Math.max(a.left,b.left));
+        float h = Math.max(0f, Math.min(a.bottom,b.bottom)-Math.max(a.top,b.top));
+        return w*h / (a.area() + b.area() - w*h);
+    }
+
+    private static float continuity(Box a, Box b) {
+        if (a.type != b.type) return 0f;
+        float iou = overlap(a,b);
+        if (a.face && b.face && a.faceId >= 0 && b.faceId >= 0) {
+            if (a.faceId != b.faceId) return 0f;
+            return iou > .03f || Math.hypot(a.cx()-b.cx(),a.cy()-b.cy()) < .24 ? 2f+iou : 0f;
+        }
+        if (a.face != b.face) {
+            Box face = a.face ? a : b, body = a.face ? b : a;
+            if (face.cx() >= body.left && face.cx() <= body.right && face.cy() >= body.top
+                    && face.cy() <= body.bottom && face.area() <= body.area()) return .6f+iou;
+        }
+        return iou >= .18f ? iou : 0f;
+    }
+
+    /** Skip object inference if a face already covers the current human selection. */
+    public boolean facesSuffice(List<Box> faces) {
+        if (active == null) return !faces.isEmpty();
+        for (Box face : faces) if (continuity(active,face) > 0f) return true;
+        return false;
+    }
+
+    public Box observe(long frame, long now, List<Box> boxes) {
+        if (frame <= lastFrame || frame <= 0 || now < frame) return null;
+        lastFrame = frame;
+        if (now-frame > MAX_AGE_NS) { hits=0; return null; }
+        if (active != null && frame-lastSeen > HOLD_NS) { active=null; hits=0; }
+        Box best=null;
+        double score=-Double.MAX_VALUE, runner=-Double.MAX_VALUE;
+        for (Box box : boxes) {
+            double rank;
+            if (active != null) {
+                rank=continuity(active,box);
+                if (rank<=0) continue;
+            } else {
+                rank=Math.sqrt(box.area())-.28*Math.hypot(box.cx()-.5f,box.cy()-.5f);
+            }
+            if (rank>score) { runner=score; score=rank; best=box; }
+            else runner=Math.max(runner,rank);
+        }
+        if (best==null || (active!=null && score-runner<.06)) { hits=0; return null; }
+        hits=Math.min(2,hits+1);
+        lastSeen=frame;
+        active=best;
+        return best;
+    }
+}

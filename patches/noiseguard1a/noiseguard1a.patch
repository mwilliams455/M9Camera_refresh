+package com.particlesdevs.photoncamera.processing.render;
+
+import android.util.Pair;
+import com.particlesdevs.photoncamera.settings.NoiseStrength1A;
+
+/** Validate both legacy GL coefficients before either is published. */
+public final class NoiseCoefficients1A {
+    public final float slope;
+    public final float offset;
+
+    private NoiseCoefficients1A(float slope, float offset) {
+        this.slope = slope;
+        this.offset = offset;
+    }
+
+    public static NoiseCoefficients1A compute(Pair<Double, Double>[] model,
+                                               double strength, float shift) {
+        if (model == null || model.length != 3) throw invalid();
+        for (Pair<Double, Double> channel : model) {
+            if (channel == null) throw invalid();
+            coefficient(channel.first);
+            coefficient(channel.second);
+        }
+        // Keep the original per-channel double-to-float conversion and float sum order.
+        float slope = model[0].first.floatValue() + model[1].first.floatValue()
+                + model[2].first.floatValue();
+        float offset = model[0].second.floatValue() + model[1].second.floatValue()
+                + model[2].second.floatValue();
+        requireFinite(slope);
+        requireFinite(offset);
+        slope /= 3.f;
+        offset /= 3.f;
+        double multiplier = Math.pow(2.0, NoiseStrength1A.sanitize(strength) + shift);
+        if (!(multiplier > 0.0) || Double.isInfinite(multiplier)) throw invalid();
+        // Narrow once, after the original double multiplication.
+        slope = (float) (slope * multiplier);
+        offset = (float) (offset * multiplier);
+        requireFinite(slope);
+        requireFinite(offset);
+        // Preserve the established floor, including finite negative/zero model values.
+        return new NoiseCoefficients1A(Math.max(slope, Float.MIN_NORMAL),
+                Math.max(offset, Float.MIN_NORMAL));
+    }
+
+    private static void coefficient(Double value) {
+        if (value == null || Double.isNaN(value) || Double.isInfinite(value)) throw invalid();
+        requireFinite(value.floatValue());
+    }
+
+    private static void requireFinite(float value) {
+        if (Float.isNaN(value) || Float.isInfinite(value)) throw invalid();
+    }
+
+    private static IllegalArgumentException invalid() {
+        return new IllegalArgumentException("NOISEGUARD1A: invalid noise model or coefficients");
+    }
+}

+package com.particlesdevs.photoncamera.processing.render;
+
+import android.app.Application;
+import android.util.Pair;
+import com.particlesdevs.photoncamera.settings.NoiseStrength1A;
+import org.junit.Test;
+import org.junit.runner.RunWith;
+import org.robolectric.RobolectricTestRunner;
+import org.robolectric.annotation.Config;
+import static org.junit.Assert.*;
+
+@RunWith(RobolectricTestRunner.class)
+@Config(sdk=35, application=Application.class)
+public class NoiseGuardTest {
+    @SuppressWarnings("unchecked")
+    static Pair<Double,Double>[] model(double slope, double offset) {
+        return new Pair[]{new Pair<>(slope,offset),new Pair<>(slope,offset),new Pair<>(slope,offset)};
+    }
+    private static void rejects(Pair<Double,Double>[] input, double strength, float shift) {
+        try { NoiseCoefficients1A.compute(input,strength,shift);fail("Invalid model accepted"); }
+        catch (IllegalArgumentException expected) { assertTrue(expected.getMessage().contains("NOISEGUARD1A")); }
+    }
+    @Test public void validStoredBoundsAndFractionalValuesRetainFloatBits() {
+        for (String input:new String[]{"-6","4","0","-0.0","-0.15","1.234567"," 2.5 ","0x1.0p-1"})
+            assertEquals(Float.floatToRawIntBits(Float.parseFloat(input)),Float.floatToRawIntBits(NoiseStrength1A.parse(input,0)));
+    }
+    @Test public void nonFiniteStoredValuesUseDefault() {
+        for(String input:new String[]{"NaN","Infinity","-Infinity","1e100","-1e100"})
+            assertEquals(0.f,NoiseStrength1A.parse(input,0),0.f);
+    }
+    @Test public void outOfRangeStoredValuesUseDefaultWithoutSaturating() {
+        for(String input:new String[]{"-6.000001","4.000001","140","-140"})
+            assertEquals(0.f,NoiseStrength1A.parse(input,0),0.f);
+    }
+    @Test public void malformedAndMissingStoredValuesUseDefault() {
+        for(String input:new String[]{null,""," ","bad","1,5"})
+            assertEquals(0.f,NoiseStrength1A.parse(input,0),0.f);
+    }
+    @Test public void validExplicitDefaultIsRespected() { assertEquals(-1.25f,NoiseStrength1A.parse("bad",-1.25f),0.f); }
+    @Test public void invalidExplicitDefaultReturnsEstablishedZero() {
+        for(float value:new float[]{Float.NaN,Float.POSITIVE_INFINITY,-7,5})
+            assertEquals(0.f,NoiseStrength1A.parse(null,value),0.f);
+    }
+    @Test public void cachedDoubleStrengthIsNotNarrowed() {
+        double value=0.12345678912345;assertEquals(Double.doubleToRawLongBits(value),Double.doubleToRawLongBits(NoiseStrength1A.sanitize(value)));
+    }
+    @Test public void invalidCachedStrengthUsesDefault() {
+        NoiseCoefficients1A expected=NoiseCoefficients1A.compute(model(0.125,0.25),0,0);
+        for(double value:new double[]{Double.NaN,Double.POSITIVE_INFINITY,Double.NEGATIVE_INFINITY,-7,5,140}) {
+            NoiseCoefficients1A actual=NoiseCoefficients1A.compute(model(0.125,0.25),value,0);
+            assertEquals(expected.slope,actual.slope,0.f);assertEquals(expected.offset,actual.offset,0.f);
+        }
+    }
+    @Test public void missingModelRejected() { rejects(null,0,0); }
+    @Test public void wrongChannelCountRejected() { rejects(new Pair[2],0,0);rejects(new Pair[4],0,0); }
+    @Test public void missingChannelRejected() { Pair<Double,Double>[] a=model(1,2);a[1]=null;rejects(a,0,0); }
+    @Test public void missingCoefficientRejected() {
+        Pair<Double,Double>[] a=model(1,2);a[2]=new Pair<>(null,2.0);rejects(a,0,0);
+        a[2]=new Pair<>(1.0,null);rejects(a,0,0);
+    }
+    @Test public void nonFiniteModelRejected() {
+        for(double value:new double[]{Double.NaN,Double.POSITIVE_INFINITY,Double.NEGATIVE_INFINITY}) {
+            rejects(model(value,1),0,0);rejects(model(1,value),0,0);
+        }
+    }
+    @Test public void doubleToFloatOverflowRejected() { rejects(model(Double.MAX_VALUE,1),0,0);rejects(model(1,-Double.MAX_VALUE),0,0); }
+    @Test public void floatSumOverflowRejectedBeforeDivision() { rejects(model(Float.MAX_VALUE,1),-6,0);rejects(model(1,Float.MAX_VALUE),-6,0); }
+    @Test public void scaledSlopeOverflowRejected() { rejects(model(Float.MAX_VALUE/4.0,1),4,0); }
+    @Test public void scaledOffsetOverflowRejected() { rejects(model(1,Float.MAX_VALUE/4.0),4,0); }
+    @Test public void invalidExponentShiftRejected() { rejects(model(1,2),0,Float.NaN);rejects(model(1,2),0,Float.POSITIVE_INFINITY);rejects(model(1,2),0,Float.NEGATIVE_INFINITY); }
+    @Test public void zeroAndFiniteNegativeModelsKeepExistingFloor() {
+        NoiseCoefficients1A a=NoiseCoefficients1A.compute(model(0,-1),0,0);
+        assertEquals(Float.MIN_NORMAL,a.slope,0.f);assertEquals(Float.MIN_NORMAL,a.offset,0.f);
+    }
+    @Test public void subnormalCoefficientsKeepExistingFloor() {
+        NoiseCoefficients1A a=NoiseCoefficients1A.compute(model(Double.MIN_VALUE,Float.MIN_VALUE),-6,0);
+        assertEquals(Float.MIN_NORMAL,a.slope,0.f);assertEquals(Float.MIN_NORMAL,a.offset,0.f);
+    }
+    @Test public void knownBoundsKeepExpectedMultipliers() {
+        for(int strength:new int[]{-6,0,4}) {
+            NoiseCoefficients1A a=NoiseCoefficients1A.compute(model(0.125,0.25),strength,0);
+            assertEquals((float)(0.125*Math.pow(2,strength)),a.slope,0.f);
+            assertEquals((float)(0.25*Math.pow(2,strength)),a.offset,0.f);
+        }
+    }
+    @Test public void repeatedCalculationLeavesModelUntouched() {
+        Pair<Double,Double>[] input=model(0.00123,0.00000456);Pair<Double,Double>[] before=input.clone();
+        NoiseCoefficients1A a=NoiseCoefficients1A.compute(input,1.25,0);
+        for(int i=0;i<20;i++) {
+            NoiseCoefficients1A b=NoiseCoefficients1A.compute(input,1.25,0);
+            assertEquals(a.slope,b.slope,0.f);assertEquals(a.offset,b.offset,0.f);
+            for(int j=0;j<3;j++)assertSame(before[j],input[j]);
+        }
+    }
+}

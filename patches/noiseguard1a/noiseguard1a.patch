+package com.particlesdevs.photoncamera.settings;
+
+/** Read-boundary policy for the existing -6..+4 noise-strength control. */
+public final class NoiseStrength1A {
+    public static final float DEFAULT = 0.0f;
+    private NoiseStrength1A() {}
+
+    public static double sanitize(double value) {
+        return value >= -6.0 && value <= 4.0 ? value : DEFAULT;
+    }
+
+    public static float parse(String stored, float fallback) {
+        float safeDefault = (float) sanitize(fallback);
+        if (stored == null) return safeDefault;
+        try {
+            float value = Float.parseFloat(stored);
+            return value >= -6.0f && value <= 4.0f ? value : safeDefault;
+        } catch (NumberFormatException invalid) {
+            return safeDefault;
+        }
+    }
+}

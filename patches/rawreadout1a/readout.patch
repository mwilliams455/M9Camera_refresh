+package com.particlesdevs.photoncamera.m9.capture;
+
+import android.hardware.camera2.*;
+import java.util.*;
+import org.json.JSONObject;
+import org.junit.Test;
+import static org.junit.Assert.*;
+import static org.mockito.Mockito.*;
+
+public class M9RawReadoutAuditTest {
+    private final String first = M9RawReadoutAudit1A.NAMES[0];
+    @SuppressWarnings("unchecked") private <T> CaptureRequest.Key<T> requestKey(String name) {
+        CaptureRequest.Key<T> key = mock(CaptureRequest.Key.class);
+        when(key.getName()).thenReturn(name); return key;
+    }
+    @SuppressWarnings("unchecked") private <T> CaptureResult.Key<T> resultKey(String name) {
+        CaptureResult.Key<T> key = mock(CaptureResult.Key.class);
+        when(key.getName()).thenReturn(name); return key;
+    }
+    private CameraCharacteristics characteristics(CaptureRequest.Key<?>... keys) {
+        CameraCharacteristics c = mock(CameraCharacteristics.class);
+        when(c.getAvailableCaptureRequestKeys()).thenReturn(Arrays.asList(keys));
+        when(c.getAvailableCaptureResultKeys()).thenReturn(Collections.emptyList());
+        return c;
+    }
+    @Test public void advertisedTypedKeyIsReadEvenWhenRequestOmitsItFromKeyList() throws Exception {
+        CaptureRequest.Key<int[]> key = requestKey(first);
+        CaptureRequest r = mock(CaptureRequest.class);
+        when(r.getKeys()).thenReturn(Collections.emptyList());
+        when(r.get(key)).thenReturn(new int[]{7, 0});
+        JSONObject f = new M9RawReadoutAudit1A(characteristics(key)).request(r).getJSONObject("fields").getJSONObject(first);
+        assertEquals("present", f.getString("status"));
+        assertEquals("[I", f.getString("javaValueType"));
+        assertEquals(7, f.getJSONArray("value").getInt(0));
+        assertFalse(f.getBoolean("listedInMetadata"));
+        verify(r).get(same(key));
+    }
+    @Test public void presentUnadvertisedKeyIsStillReadableWithoutInventingItsType() throws Exception {
+        CaptureRequest.Key<Byte> key = requestKey(first);
+        CaptureRequest r = mock(CaptureRequest.class);
+        when(r.getKeys()).thenReturn(Collections.singletonList(key)); when(r.get(key)).thenReturn((byte)0);
+        JSONObject f = new M9RawReadoutAudit1A(characteristics()).request(r).getJSONObject("fields").getJSONObject(first);
+        assertFalse(f.getBoolean("advertised")); assertTrue(f.getBoolean("listedInMetadata"));
+        assertEquals("present", f.getString("status")); assertEquals(0, f.getInt("value"));
+    }
+    @Test public void unknownKeyIsNotProbedWithAGuessedType() throws Exception {
+        CaptureRequest r = mock(CaptureRequest.class); when(r.getKeys()).thenReturn(Collections.emptyList());
+        JSONObject f = new M9RawReadoutAudit1A(characteristics()).request(r).getJSONObject("fields").getJSONObject(first);
+        assertEquals("no_public_typed_key", f.getString("status")); assertFalse(f.has("value"));
+        verify(r, never()).get(any());
+    }
+    @Test public void missingValueIsNotFalseAndReadFailureDoesNotDiscardOtherValues() throws Exception {
+        CaptureRequest.Key<Integer> missing = requestKey(first);
+        CaptureRequest.Key<Integer> broken = requestKey(M9RawReadoutAudit1A.NAMES[1]);
+        CaptureRequest.Key<Integer> zero = requestKey(M9RawReadoutAudit1A.NAMES[2]);
+        CaptureRequest r = mock(CaptureRequest.class); when(r.getKeys()).thenReturn(Collections.emptyList());
+        when(r.get(broken)).thenThrow(new IllegalArgumentException()); when(r.get(zero)).thenReturn(0);
+        JSONObject fields = new M9RawReadoutAudit1A(characteristics(missing, broken, zero)).request(r).getJSONObject("fields");
+        assertEquals("null_not_reported", fields.getJSONObject(first).getString("status"));
+        assertTrue(fields.getJSONObject(first).isNull("value"));
+        assertEquals("read_error", fields.getJSONObject(M9RawReadoutAudit1A.NAMES[1]).getString("status"));
+        assertEquals(0, fields.getJSONObject(M9RawReadoutAudit1A.NAMES[2]).getInt("value"));
+    }
+    @Test public void physicalResultDoesNotBorrowLogicalAdvertisedKeys() throws Exception {
+        CaptureResult.Key<Integer> key = resultKey(first);
+        CameraCharacteristics c = characteristics();
+        when(c.getAvailableCaptureResultKeys()).thenReturn(Collections.singletonList(key));
+        CaptureResult result = mock(CaptureResult.class); when(result.getKeys()).thenReturn(Collections.emptyList());
+        JSONObject f = new M9RawReadoutAudit1A(c).result(result, false).getJSONObject(first);
+        assertEquals("no_public_typed_key", f.getString("status")); verify(result, never()).get(any());
+    }
+    @Test public void advertisedResultNullAndPresentFalseRemainDistinct() throws Exception {
+        CaptureResult.Key<Boolean> a = resultKey(first), b = resultKey(M9RawReadoutAudit1A.NAMES[5]);
+        CameraCharacteristics c = characteristics(); when(c.getAvailableCaptureResultKeys()).thenReturn(Arrays.asList(a, b));
+        CaptureResult r = mock(CaptureResult.class); when(r.getKeys()).thenReturn(Collections.singletonList(b));
+        when(r.get(b)).thenReturn(false);
+        JSONObject fields = new M9RawReadoutAudit1A(c).result(r, true);
+        assertEquals("null_not_reported", fields.getJSONObject(first).getString("status"));
+        assertEquals("present", fields.getJSONObject(M9RawReadoutAudit1A.NAMES[5]).getString("status"));
+        assertFalse(fields.getJSONObject(M9RawReadoutAudit1A.NAMES[5]).getBoolean("value"));
+    }

+package com.particlesdevs.photoncamera.m9.capture;
+
+import android.graphics.ImageFormat;
+import android.hardware.camera2.*;
+import android.hardware.camera2.params.StreamConfigurationMap;
+import android.os.Build;
+import android.util.Size;
+import java.util.*;
+import org.json.JSONArray;
+import org.json.JSONObject;
+
+/** Read-only public Camera2 evidence. Key names and echoed values are not HAL execution proof. */
+public final class M9RawReadoutAudit1A {
+    public static final String REVISION = "M9RAWREADOUT1A";
+    static final String[] NAMES = {
+        "com.xiaomi.control.qcfa.isSuperRemosaic",
+        "org.codeaurora.qcamera3.sessionParameters.RawCbSourceType",
+        "org.codeaurora.qcamera3.sessionParameters.EnableIdealRAW",
+        "org.codeaurora.qcamera3.sessionParameters.EnableXCFAOptimization",
+        "android.sensor.pixelMode", "android.sensor.rawBinningFactorUsed"
+    };
+    private final Map<String, CaptureRequest.Key<?>> requests = new HashMap<>();
+    private final Map<String, CaptureResult.Key<?>> results = new HashMap<>();
+    private final Set<String> sessions = new HashSet<>();
+    private final JSONObject registry = new JSONObject();
+
+    M9RawReadoutAudit1A(CameraCharacteristics c) {
+        try {
+            if (c == null) { registry.put("status", "characteristics_unavailable"); return; }
+            List<CaptureRequest.Key<?>> rq = c.getAvailableCaptureRequestKeys();
+            if (rq != null) for (CaptureRequest.Key<?> k : rq) requests.put(k.getName(), k);
+            List<CaptureResult.Key<?>> rs = c.getAvailableCaptureResultKeys();
+            if (rs != null) for (CaptureResult.Key<?> k : rs) results.put(k.getName(), k);
+            if (Build.VERSION.SDK_INT >= 28) {
+                List<CaptureRequest.Key<?>> sk = c.getAvailableSessionKeys();
+                if (sk != null) for (CaptureRequest.Key<?> k : sk) {
+                    sessions.add(k.getName()); requests.putIfAbsent(k.getName(), k);
+                }
+            }
+            registry.put("status", "read");
+            registry.put("requestListAvailable", rq != null);
+            registry.put("resultListAvailable", rs != null);
+        } catch (Throwable e) { putError(registry, e); }
+    }
+
+    JSONObject request(CaptureRequest r) {
+        JSONObject out = new JSONObject();
+        try {
+            out.put("registry", registry);
+            if (r == null) return out.put("status", "no_request_provided");
+            Map<String, CaptureRequest.Key<?>> present = new HashMap<>();
+            List<CaptureRequest.Key<?>> list = r.getKeys();
+            if (list != null) for (CaptureRequest.Key<?> k : list) present.put(k.getName(), k);
+            JSONObject fields = new JSONObject();
+            for (String name : NAMES) {
+                CaptureRequest.Key<?> k = present.containsKey(name) ? present.get(name) : requests.get(name);
+                JSONObject f = availability(requests.containsKey(name), present.containsKey(name), sessions.contains(name));
+                try {
+                    if (k == null) f.put("status", "no_public_typed_key");
+                    else addValue(f, r.get(k));
+                } catch (Throwable e) { putError(f, e); }
+                fields.put(name, f);
+            }
+            out.put("fields", fields);
+        } catch (Throwable e) { putError(out, e); }
+        return out;
+    }
+
+    JSONObject builder(CaptureRequest.Builder b, String physicalId) {
+        JSONObject out = new JSONObject();
+        try {
+            CaptureRequest r = b.build(); out = request(r);
+            if (Build.VERSION.SDK_INT < 28 || physicalId == null) return out;
+            Map<String, CaptureRequest.Key<?>> keys = new HashMap<>(requests);
+            List<CaptureRequest.Key<?>> present = r.getKeys();
+            if (present != null) for (CaptureRequest.Key<?> k : present) keys.put(k.getName(), k);
+            JSONObject fields = new JSONObject();
+            for (String name : NAMES) {
+                JSONObject f = new JSONObject(); CaptureRequest.Key<?> k = keys.get(name);
+                try {
+                    if (k == null) f.put("status", "no_public_typed_key");
+                    else addValue(f, b.getPhysicalCameraKey(k, physicalId));
+                } catch (Throwable e) { putError(f, e); }
+                fields.put(name, f);
+            }
+            out.put("physicalId", physicalId); out.put("physicalMember", fields);
+            out.put("physicalScope", "builder_member_only_not_effective_HAL_value");
+        } catch (Throwable e) { putError(out, e); }
+        return out;
+    }
+
+    JSONObject result(CaptureResult r, boolean useSelectedRegistry) {
+        JSONObject out = new JSONObject();
+        try {
+            if (r == null) return out.put("status", "no_result_provided");
+            Map<String, CaptureResult.Key<?>> present = new HashMap<>();
+            List<CaptureResult.Key<?>> list = r.getKeys();
+            if (list != null) for (CaptureResult.Key<?> k : list) present.put(k.getName(), k);
+            for (String name : NAMES) {
+                CaptureResult.Key<?> k = present.get(name);
+                if (k == null && useSelectedRegistry) k = results.get(name);
+                JSONObject f = availability(useSelectedRegistry && results.containsKey(name), present.containsKey(name), false);
+                if (!useSelectedRegistry) f.put("advertised", JSONObject.NULL);
+                try {
+                    if (k == null) f.put("status", "no_public_typed_key");
+                    else addValue(f, r.get(k));
+                } catch (Throwable e) { putError(f, e); }
+                out.put(name, f);
+            }
+        } catch (Throwable e) { putError(out, e); }
+        return out;
+    }
+
+    private static JSONObject availability(boolean advertised, boolean listed, boolean session) throws Exception {
+        return new JSONObject().put("advertised", advertised).put("listedInMetadata", listed)
+                .put("advertisedSessionKey", session);
+    }
+    private static void addValue(JSONObject f, Object value) throws Exception {
+        f.put("status", value == null ? "null_not_reported" : "present");
+        f.put("javaValueType", value == null ? JSONObject.NULL : value.getClass().getName());
+        f.put("value", M9CaptureRequestAudit1A.encode(value));
+    }
+    private static void putError(JSONObject out, Throwable e) {
+        try { out.put("status", "read_error").put("errorType", e.getClass().getSimpleName()); }
+        catch (Exception ignored) { }
+    }
+
+    static JSONObject capabilities(CameraCharacteristics c) {
+        JSONObject out = new JSONObject();
+        if (c == null) { try { out.put("status", "characteristics_unavailable"); } catch (Exception ignored) {} return out; }
+        String[] wanted = {"android.request.availableCapabilities", "android.info.supportedHardwareLevel",
+            "android.sensor.info.pixelArraySize", "android.sensor.info.activeArraySize",
+            "android.sensor.info.preCorrectionActiveArraySize", "android.sensor.info.colorFilterArrangement",
+            "android.sensor.info.pixelArraySizeMaximumResolution", "android.sensor.info.activeArraySizeMaximumResolution",
+            "android.sensor.info.preCorrectionActiveArraySizeMaximumResolution", "android.sensor.info.binningFactor",
+            "android.sensor.info.lensShadingApplied", "android.lens.info.availableFocalLengths",
+            "android.lens.info.availableApertures", "android.logicalMultiCamera.physicalIds"};
+        try {
+            Map<String, CameraCharacteristics.Key<?>> keys = new HashMap<>();
+            List<CameraCharacteristics.Key<?>> all = c.getKeys();
+            if (all != null) for (CameraCharacteristics.Key<?> k : all) keys.put(k.getName(), k);
+            for (String name : wanted) {
+                JSONObject f = new JSONObject();
+                try {
+                    CameraCharacteristics.Key<?> k = keys.get(name);
+                    if (k == null) f.put("status", "not_listed"); else addValue(f, c.get(k));
+                } catch (Throwable e) { putError(f, e); }
+                out.put(name, f);
+            }
+            out.put("defaultRawStreams", stream(c, false));
+            out.put("maximumResolutionRawStreams", stream(c, true));
+            out.put("interpretation", "advertised_support_only_not_selected_readout_or_internal_processing_proof");
+        } catch (Throwable e) { putError(out, e); }
+        return out;
+    }
+
+    private static JSONObject stream(CameraCharacteristics c, boolean maximum) {
+        JSONObject out = new JSONObject();
+        try {
+            if (maximum && Build.VERSION.SDK_INT < 31) return out.put("status", "api_unavailable");
+            StreamConfigurationMap map = c.get(maximum ? CameraCharacteristics.SCALER_STREAM_CONFIGURATION_MAP_MAXIMUM_RESOLUTION
+                    : CameraCharacteristics.SCALER_STREAM_CONFIGURATION_MAP);
+            if (map == null) return out.put("status", "map_not_reported");
+            int[] formats = {ImageFormat.RAW_SENSOR, ImageFormat.RAW10, ImageFormat.RAW12};
+            for (int format : formats) {
+                JSONObject f = new JSONObject();
+                try {
+                    f.put("outputSizes", sizes(map.getOutputSizes(format)));
+                    f.put("highResolutionOutputSizes", sizes(map.getHighResolutionOutputSizes(format)));
+                    f.put("inputSizes", sizes(map.getInputSizes(format)));
+                } catch (Throwable e) { putError(f, e); }
+                out.put(String.valueOf(format), f);
+            }
+            out.put("status", "read");
+        } catch (Throwable e) { putError(out, e); }
+        return out;
+    }
+    private static Object sizes(Size[] sizes) throws Exception {
+        if (sizes == null) return JSONObject.NULL;
+        JSONArray values = new JSONArray();
+        for (int i = 0; i < Math.min(32, sizes.length); i++)
+            values.put(new JSONArray().put(sizes[i].getWidth()).put(sizes[i].getHeight()));
+        return new JSONObject().put("sizes", values).put("totalCount", sizes.length).put("truncated", sizes.length > 32);
+    }
+
+    /** Queried once at session configuration; never opens or reconfigures another camera. */
+    static JSONObject cameraInventory(CameraManager manager, String deviceId, String streamId) {
+        JSONObject out = new JSONObject();
+        try {
+            if (manager == null) return out.put("status", "manager_unavailable");
+            LinkedHashSet<String> ids = new LinkedHashSet<>();
+            if (deviceId != null) ids.add(deviceId);
+            if (streamId != null) ids.add(streamId);
+            String[] enumerated = manager.getCameraIdList();
+            out.put("enumeratedIds", M9CaptureRequestAudit1A.encode(enumerated));
+            if (enumerated != null) Collections.addAll(ids, enumerated);
+            JSONArray records = new JSONArray(); int index = 0; int recordChars = 0; boolean budgetReached = false;
+            // A queue also visits physical members advertised by an accessible logical camera.
+            List<String> queue = new ArrayList<>(ids);
+            while (index < queue.size() && index < 16) {
+                String id = queue.get(index++); JSONObject record = new JSONObject().put("cameraId", id);
+                try {
+                    CameraCharacteristics c = manager.getCameraCharacteristics(id);
+                    record.put("capabilities", capabilities(c));
+                    if (Build.VERSION.SDK_INT >= 28) for (String p : c.getPhysicalCameraIds())
+                        if (ids.add(p)) queue.add(p);
+                } catch (Throwable e) { putError(record, e); }
+                int length = record.toString().length();
+                if (recordChars + length > 49152) { budgetReached = true; break; }
+                recordChars += length; records.put(record);
+            }
+            out.put("cameras", records).put("discoveredCount", queue.size()).put("truncated", budgetReached || index < queue.size());
+            out.put("recordCharBudget", 49152).put("budgetReached", budgetReached);
+            out.put("scope", "public_enumeration_plus_session_ids_and_reported_physical_members_no_guessed_ids");
+        } catch (Throwable e) { putError(out, e); }
+        return out;
+    }
+}

diff --git a/app/src/test/java/com/particlesdevs/photoncamera/m9/M9SaveSelectionTest.java b/app/src/test/java/com/particlesdevs/photoncamera/m9/M9SaveSelectionTest.java
new file mode 100644
--- /dev/null
+++ b/app/src/test/java/com/particlesdevs/photoncamera/m9/M9SaveSelectionTest.java
@@ -0,0 +1,27 @@
+package com.particlesdevs.photoncamera.m9;
+import org.junit.Test;
+import static org.junit.Assert.*;
+public class M9SaveSelectionTest {
+    @Test public void jpegNeverCreatesRawEvenWithComparisonEnabled() {
+        M9SaveSelection s = M9SaveSelection.fromMode(0, true);
+        assertTrue(s.jpeg); assertFalse(s.dng); assertFalse(s.unfilteredDng);
+    }
+    @Test public void pairKeepsOptionalComparisonIndependent() {
+        for (boolean extra : new boolean[]{false,true}) {
+            M9SaveSelection s = M9SaveSelection.fromMode(1, extra);
+            assertTrue(s.jpeg); assertTrue(s.dng); assertEquals(extra,s.unfilteredDng);
+        }
+    }
+    @Test public void rawDoesNotRequestJpeg() {
+        for (boolean extra : new boolean[]{false,true}) {
+            M9SaveSelection s = M9SaveSelection.fromMode(2, extra);
+            assertFalse(s.jpeg); assertTrue(s.dng); assertEquals(extra,s.unfilteredDng);
+        }
+    }
+    @Test public void invalidSelectionDefaultsToJpeg() {
+        for(int mode : new int[]{-1,3,4,Integer.MAX_VALUE}) {
+            M9SaveSelection s=M9SaveSelection.fromMode(mode,true);
+            assertEquals(0,s.mode);assertTrue(s.jpeg);assertFalse(s.dng);assertFalse(s.unfilteredDng);
+        }
+    }
+}

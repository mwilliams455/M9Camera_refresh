+package com.particlesdevs.photoncamera.m9;
+
+/** M9SAVEMODE1A: immutable final-file selection, frozen before a RAW enters the queue. */
+public final class M9SaveSelection {
+    public final int mode;
+    public final boolean jpeg;
+    public final boolean dng;
+    public final boolean unfilteredDng;
+
+    private M9SaveSelection(int mode, boolean unfiltered) {
+        this.mode = mode;
+        jpeg = mode != 2;
+        dng = mode != 0;
+        unfilteredDng = dng && unfiltered;
+    }
+
+    public static M9SaveSelection fromMode(int mode, boolean unfiltered) {
+        // Unknown values fall back to JPEG, never silently add RAW output.
+        return new M9SaveSelection(mode >= 0 && mode <= 2 ? mode : 0, unfiltered);
+    }
+}

+    @Test public void lowerThreeEdgesContinueOnlyAfterABroadMiss() {
+        AutomaticSubjectSelection s = new AutomaticSubjectSelection();
+        Box full = Box.fromBody(new Candidate("person",.9f,0,0,1,1));
+        Box lap = Box.fromBody(new Candidate("person",.9f,.002f,.27f,.994f,.989f));
+        Box local = Box.fromBody(new Candidate("person",.9f,.2f,.2f,.7f,.8f));
+        long t = 1_000_000_000L;
+        assertNull(s.observe(t,t,Collections.singletonList(full)));
+        t += 200_000_000L; assertNull(s.observe(t,t,Collections.singletonList(lap)));
+        t += 200_000_000L; assertNull(s.observe(t,t,Collections.singletonList(lap)));
+        t += 200_000_000L; assertSame(local,s.observe(t,t,Collections.singletonList(local)));
+        s.reset();
+        assertSame(lap,s.observe(t,t,Collections.singletonList(lap)));
+        s.reset(); assertNull(s.observe(t,t,Collections.singletonList(full)));
+        t += AutomaticSubjectSelection.MAX_AGE_NS+1; assertSame(lap,s.observe(t,t,Collections.singletonList(lap)));

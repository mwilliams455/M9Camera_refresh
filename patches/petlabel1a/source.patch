+package com.particlesdevs.photoncamera.ui.camera;
+
+import android.content.Context;
+import android.graphics.Bitmap;
+import android.graphics.Canvas;
+import android.graphics.Paint;
+import android.graphics.Rect;
+import android.os.Handler;
+import android.os.Looper;
+import com.google.ai.edge.litert.Accelerator;
+import com.google.ai.edge.litert.CompiledModel;
+import com.google.ai.edge.litert.LiteRtException;
+import com.google.ai.edge.litert.TensorBuffer;
+import com.particlesdevs.photoncamera.control.subject.AutomaticSubjectSelection;
+import com.particlesdevs.photoncamera.control.subject.AutomaticSubjectSelection.Box;
+import com.particlesdevs.photoncamera.control.tracking.SubjectAnchorPolicy.ClassId;
+import java.util.List;
+import java.util.concurrent.ExecutorService;
+import java.util.concurrent.Executors;
+
+/** An independent species reading for a pet already acquired by the focus tracker. */
+final class PetSpeciesLabel implements AutoCloseable {
+    interface Callback { void complete(ClassId species, String stage); }
+
+    private static final int SIZE = 224;
+    private final Handler main = new Handler(Looper.getMainLooper());
+    private final ExecutorService worker = Executors.newSingleThreadExecutor(r -> new Thread(r, "M9 pet label"));
+    private final Paint filter = new Paint(Paint.FILTER_BITMAP_FLAG);
+    // Model and native buffers belong to worker. All track state belongs to the main looper.
+    private CompiledModel model;
+    private List<TensorBuffer> inputs, outputs;
+    private boolean busy, closed, unavailable, started;
+    private long owner = -1, previousFrame;
+    private ClassId previous, verified;
+
+    void reset() {
+        owner = -1;
+        previousFrame = 0;
+        previous = verified = null;
+    }
+
+    ClassId displayed(long selection, ClassId detector) {
+        if (owner != selection) {
+            reset();
+            owner = selection;
+        }
+        return verified != null ? verified : detector;
+    }
+
+    ClassId record(long selection, ClassId detector, ClassId species, long frame, long now) {
+        if (owner != selection) return detector;
+        if (now >= frame && now-frame <= AutomaticSubjectSelection.MAX_AGE_NS && frame > previousFrame) {
+            if (species != null && species == previous && frame-previousFrame <= AutomaticSubjectSelection.HOLD_NS)
+                verified = species;
+            previous = species;
+            previousFrame = frame;
+        }
+        return verified != null ? verified : detector;
+    }
+
+    static ClassId classify(byte[] scores) {
+        if (scores.length != 1001) throw new IllegalArgumentException("Expected 1001 species scores");
+        int dog = -1, cat = -1, other = -1;
+        for (int i = 0; i < scores.length; i++) {
+            int value = scores[i] & 255;
+            if (i >= 152 && i <= 269) dog = Math.max(dog, value);
+            else if (i >= 282 && i <= 286) cat = Math.max(cat, value);
+            else other = Math.max(other, value);
+        }
+        // The output step is 0.09889254 logits. A 21-step lead exceeds two logits.
+        if (dog > other && dog-cat >= 21) return ClassId.DOG;
+        if (cat > other && cat-dog >= 21) return ClassId.CAT;
+        return null;
+    }
+
+    void observe(Context context, Bitmap frame, Box pet, long selection, long frameNs, Callback callback) {
+        if (closed || busy || unavailable || verified != null || owner != selection || frame == null) return;
+        int w = frame.getWidth(), h = frame.getHeight();
+        float mx = (pet.right-pet.left)*.06f, my = (pet.bottom-pet.top)*.06f;
+        Rect region = new Rect(Math.max(0, Math.round((pet.left-mx)*w)), Math.max(0, Math.round((pet.top-my)*h)),
+                Math.min(w, Math.round((pet.right+mx)*w)), Math.min(h, Math.round((pet.bottom+my)*h)));
+        if (region.isEmpty()) return;
+        // PixelCopy reuses the preview. Only the independent 224-pixel crop crosses the thread boundary.
+        Bitmap crop = null;
+        try {
+            crop = Bitmap.createBitmap(SIZE, SIZE, Bitmap.Config.ARGB_8888);
+            new Canvas(crop).drawBitmap(frame, region, new Rect(0, 0, SIZE, SIZE), filter);
+        } catch (RuntimeException | OutOfMemoryError failure) {
+            if (crop != null) crop.recycle();
+            return;
+        }
+        final Bitmap owned = crop;
+        started = busy = true;
+        worker.execute(() -> {
+            ClassId classified = null;
+            boolean failed = false;
+            try {
+                if (model == null) {
+                    model = CompiledModel.create(context.getAssets(), "pet_species_mobilenet_v2.tflite",
+                            new CompiledModel.Options(Accelerator.CPU), null);
+                    inputs = model.createInputBuffers();
+                    outputs = model.createOutputBuffers();
+                }
+                int[] pixels = new int[SIZE*SIZE];
+                byte[] rgb = new byte[SIZE*SIZE*3];
+                owned.getPixels(pixels, 0, SIZE, 0, 0, SIZE, SIZE);
+                int offset = 0;
+                for (int argb : pixels) {
+                    rgb[offset++] = (byte)(argb >> 16);
+                    rgb[offset++] = (byte)(argb >> 8);
+                    rgb[offset++] = (byte)argb;
+                }
+                inputs.get(0).writeInt8(rgb);
+                model.run(inputs, outputs);
+                classified = classify(outputs.get(0).readInt8());
+            } catch (LiteRtException | RuntimeException | LinkageError | OutOfMemoryError failure) {
+                failed = true;
+            } finally {
+                owned.recycle();
+            }
+            final ClassId result = classified;
+            final boolean error = failed;
+            main.post(() -> {
+                busy = false;
+                unavailable = error;
+                if (!closed && owner == selection)
+                    callback.complete(result, error ? "unavailable" : result == null ? "abstain" : "classified");
+            });
+        });
+    }
+
+    @Override public void close() {
+        if (closed) return;
+        closed = true;
+        reset();
+        if (started) worker.execute(() -> {
+            if (inputs != null) for (TensorBuffer buffer : inputs) buffer.close();
+            if (outputs != null) for (TensorBuffer buffer : outputs) buffer.close();
+            if (model != null) model.close();
+        });
+        worker.shutdown();
+    }
+}

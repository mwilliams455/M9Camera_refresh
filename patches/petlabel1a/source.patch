+        scores[350] = (byte)235;
+        assertNull(PetSpeciesLabel.classify(scores));
+        scores[286] = (byte)255; scores[152] = (byte)200;
+        assertEquals(ClassId.CAT, PetSpeciesLabel.classify(scores));

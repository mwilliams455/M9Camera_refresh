+        }
+    }
+
+    private static final class Observation {
+        final TrackingGeometry geometry;
+        final long selection, time;
+        final float left, top, right, bottom;
+        final boolean face;
+        Observation(TrackingGeometry g, long selection, long time, float left, float top,
+                    float right, float bottom, boolean face) {
+            this.geometry = g; this.selection = selection; this.time = time;
+            this.left = left; this.top = top; this.right = right; this.bottom = bottom; this.face = face;
+        }
+    }
+
+    public static synchronized void clear() {
+        tracking = null;
+        older = newest = null;
+        waiting = null;
+        requestedAt = usedTexture = 0;
+    }
+
+    public static synchronized void request(TrackingGeometry g, long now) {
+        if (!g.same(tracking)) clear();
+        tracking = g;
+        requestedAt = now;
+    }
+
+    static synchronized boolean wanted(TrackingGeometry g, long now) {
+        return g != null && g.same(tracking) && now >= requestedAt && now - requestedAt <= MAX_AGE_NS;
+    }
+
+    static synchronized void publish(TrackingGeometry g, byte[] rgba, long now) {
+        if (!wanted(g, now) || (newest != null && g.frameTime <= newest.geometry.frameTime)) return;
+        older = newest;
+        newest = new Frame(g, rgba);
+        match(now);
+    }
+
+    public static synchronized void observe(TrackingGeometry g, long selection, long frame, long now,
+            float left, float top, float right, float bottom, boolean face) {
+        if (!g.same(tracking)) return;
+        waiting = new Observation(g, selection, frame, left, top, right, bottom, face);
+        match(now);
+    }
+
+    public static synchronized void missed(long frame) {
+        waiting = null;
+        M9TrackedSubjectMeter.missed(frame);
+    }
+
+    private static long skew(Frame f, Observation o) {
+        if (f == null || f.geometry.frameTime <= usedTexture || !f.geometry.same(o.geometry)) {
+            return Long.MAX_VALUE;
+        }
+        return Math.abs(f.geometry.frameTime - o.geometry.frameTime);
+    }
+
+    private static void match(long now) {
+        Observation o = waiting;
+        if (o == null) return;
+        if (now < o.time || now - o.time > MAX_AGE_NS) {
+            waiting = null;
+            return;
+        }
+        Frame f = skew(older, o) < skew(newest, o) ? older : newest;
+        if (skew(f, o) > MAX_SKEW_NS || now - f.geometry.published > MAX_AGE_NS) return;
+        usedTexture = f.geometry.frameTime;
+        waiting = null;
+        // Preserve the detector's original eight-pixel minimum box size on both orientations.
+        float scale = 720f / Math.max(o.geometry.w, o.geometry.h);
+        int w = Math.max(1, Math.round(o.geometry.w * scale));
+        int h = Math.max(1, Math.round(o.geometry.h * scale));
+        M9TrackedSubjectMeter.observePixels(o.geometry.camera, o.geometry.mode, o.selection, o.time, now,
+                w, h, (x,y) -> f.rgb(x * WIDTH / w, y * HEIGHT / h), o.left, o.top, o.right, o.bottom, o.face);
+    }
+}

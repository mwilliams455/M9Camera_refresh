+/** Pairs upright detector boxes with recent, pre-falloff pixels from the same preview geometry. */
+public final class M9SubjectMeterFrames {
+    static final int WIDTH = M9AutoExposure2D.WIDTH * M9AutoExposure2D.STEPS, HEIGHT = 256;
+    static final int BYTES = WIDTH * HEIGHT * 4;
+    private static final long MAX_SKEW_NS = 150_000_000L;
+    private static final long MAX_AGE_NS = 350_000_000L;
+    private static TrackingGeometry tracking;
+    private static long requestedAt, usedTexture;

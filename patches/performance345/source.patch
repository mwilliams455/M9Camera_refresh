+package com.particlesdevs.photoncamera.processing;
+
+import org.junit.Rule;
+import org.junit.Test;
+import org.junit.rules.TemporaryFolder;
+
+import java.io.ByteArrayOutputStream;
+import java.io.File;
+import java.io.IOException;
+import java.lang.reflect.Field;
+import java.nio.ByteBuffer;
+import java.nio.ByteOrder;
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.util.ArrayList;
+import java.util.List;
+import java.util.Random;
+
+import static org.junit.Assert.assertArrayEquals;
+import static org.junit.Assert.assertEquals;
+import static org.junit.Assert.assertFalse;
+import static org.junit.Assert.assertTrue;
+import static org.junit.Assert.fail;
+
+/**
+ * EXACTPERF1A: appending the Leica profile to the unpublished staging DNG must produce the
+ * same bytes as the previous copy-then-append path, and a failed append must leave the
+ * staging DNG byte-identical to the RAW that was written.
+ */
+public class M9DngProfileStagingTest {
+    @Rule public TemporaryFolder folder = new TemporaryFolder();
+
+    private static final class Tag {
+        final int code, type, count; final byte[] value;
+        Tag(int code, int type, int count, byte[] value) { this.code = code; this.type = type; this.count = count; this.value = value; }
+    }
+    private static ByteBuffer le(int n) { return ByteBuffer.allocate(n).order(ByteOrder.LITTLE_ENDIAN); }
+    private static byte[] shorts(int... v) { ByteBuffer b = le(2 * v.length); for (int x : v) b.putShort((short) x); return b.array(); }
+    private static byte[] longs(long... v) { ByteBuffer b = le(4 * v.length); for (long x : v) b.putInt((int) x); return b.array(); }
+    private static byte[] rationals(boolean signed, double... v) {
+        ByteBuffer b = le(8 * v.length);
+        for (double x : v) { b.putInt((int) Math.round(x * 10000)); b.putInt(10000); }
+        return b.array();
+    }
+
+    /** Minimal classic little-endian RAW16 CFA DNG with the tags the profile writer requires. */
+    static byte[] syntheticDng(int width, int height, boolean withExistingProfile, long seed) throws IOException {
+        Random random = new Random(seed);
+        byte[] pixels = new byte[width * height * 2]; random.nextBytes(pixels);
+        List<Tag> tags = new ArrayList<>();
+        tags.add(new Tag(254, 4, 1, longs(0)));
+        tags.add(new Tag(256, 4, 1, longs(width)));
+        tags.add(new Tag(257, 4, 1, longs(height)));
+        tags.add(new Tag(258, 3, 1, shorts(16)));
+        tags.add(new Tag(259, 3, 1, shorts(1)));
+        tags.add(new Tag(262, 3, 1, shorts(32803)));
+        tags.add(new Tag(273, 4, 1, longs(8)));
+        tags.add(new Tag(277, 3, 1, shorts(1)));
+        tags.add(new Tag(278, 4, 1, longs(height)));
+        tags.add(new Tag(279, 4, 1, longs(pixels.length)));
+        tags.add(new Tag(33421, 3, 2, shorts(2, 2)));
+        tags.add(new Tag(33422, 1, 4, new byte[] {0, 1, 1, 2}));
+        tags.add(new Tag(50706, 1, 4, new byte[] {1, 4, 0, 0}));
+        byte[] model = "Synthetic staging probe\0".getBytes(java.nio.charset.StandardCharsets.US_ASCII);
+        tags.add(new Tag(50708, 2, model.length, model));
+        tags.add(new Tag(50721, 10, 9, rationals(true, .8, -.2, .1, -.1, 1.1, .15, .05, .1, .7)));
+        tags.add(new Tag(50728, 5, 3, rationals(false, .5, 1, .75)));
+        tags.add(new Tag(50730, 10, 1, rationals(true, -.5)));
+        tags.add(new Tag(50778, 3, 1, shorts(21)));
+        if (withExistingProfile) tags.add(new Tag(50936, 2, 2, new byte[] {'X', 0}));
+        tags.add(new Tag(50964, 10, 9, rationals(true, .6, .3, .0642, .2, .7, .1, .02, .1, .7049)));
+        tags.sort((a, b) -> Integer.compare(a.code, b.code));
+
+        ByteArrayOutputStream out = new ByteArrayOutputStream();
+        out.write(new byte[8]);
+        out.write(pixels);
+        long[] offsets = new long[tags.size()];
+        for (int i = 0; i < tags.size(); i++) {
+            Tag t = tags.get(i);
+            if (t.value.length > 4) {
+                while ((out.size() & 3) != 0) out.write(0);
+                offsets[i] = out.size(); out.write(t.value);
+            }
+        }
+        while ((out.size() & 3) != 0) out.write(0);
+        long ifd = out.size();
+        out.write(shorts(tags.size()));
+        for (int i = 0; i < tags.size(); i++) {
+            Tag t = tags.get(i);
+            ByteBuffer e = le(12).putShort((short) t.code).putShort((short) t.type).putInt(t.count);
+            if (t.value.length > 4) e.putInt((int) offsets[i]); else e.put(java.util.Arrays.copyOf(t.value, 4));
+            out.write(e.array());
+        }
+        out.write(new byte[4]);
+        byte[] file = out.toByteArray();
+        ByteBuffer.wrap(file).order(ByteOrder.LITTLE_ENDIAN).put((byte) 'I').put((byte) 'I').putShort((short) 42).putInt((int) ifd);
+        return file;
+    }
+
+    private static byte[] firmwareCurve() throws IOException {
+        for (String candidate : new String[] {"src/main/assets/m9/m9_curve02_firmware.bin",
+                "app/src/main/assets/m9/m9_curve02_firmware.bin"}) {
+            File file = new File(candidate);
+            if (file.isFile()) return Files.readAllBytes(file.toPath());
+        }
+        throw new IOException("firmware curve asset not found from " + new File(".").getAbsolutePath());
+    }
+
+    private static M9DngProfile profile() throws IOException {
+        double[] matrix = {.9, .08, .02, .05, .9, .05, .01, .09, .9};
+        return new M9DngProfile(matrix, 1.37, firmwareCurve(), M9Saturation.STANDARD);
+    }
+
+    @Test public void stagedInPlaceAppendMatchesCopyThenAppendBytes() throws Exception {
+        M9DngProfile profile = profile();
+        for (int[] size : new int[][] {{64, 48}, {67, 33}, {1, 1}}) {
+            byte[] raw = syntheticDng(size[0], size[1], false, size[0]);
+            Path published = folder.newFolder().toPath().resolve("L1000001.dng");
+            Files.write(published, raw);
+            M9DngProfileWriter.Result copied = M9DngProfileWriter.embed(published, profile, "M9 Probe Standard");
+
+            Path staged = Files.createTempFile(folder.newFolder().toPath(), "M9_PROFILE_PENDING_", ".dng");
+            Files.write(staged, raw);
+            M9DngProfileWriter.Result inPlace = M9DngProfileWriter.embedInPlace(staged, profile, "M9 Probe Standard");
+
+            assertArrayEquals(Files.readAllBytes(published), Files.readAllBytes(staged));
+            assertEquals(copied.digest, inPlace.digest);
+            assertEquals(copied.addedBytes, inPlace.addedBytes);
+            assertTrue(inPlace.addedBytes > 0);
+            byte[] result = Files.readAllBytes(staged);
+            for (int i = 8; i < raw.length; i++) assertEquals("original byte " + i, raw[i], result[i]);
+        }
+    }
+
+    @Test public void rejectedBeforeWritingLeavesStagingUntouched() throws Exception {
+        byte[] raw = syntheticDng(32, 32, true, 7);
+        Path staged = Files.createTempFile(folder.newFolder().toPath(), "M9_PROFILE_PENDING_", ".dng");
+        Files.write(staged, raw);
+        try {
+            M9DngProfileWriter.embedInPlace(staged, profile(), "M9 Probe Standard");
+            fail("an existing profile must not be overwritten");
+        } catch (M9DngProfileWriter.StagingNotRestoredException unexpected) {
+            throw unexpected;
+        } catch (IOException expected) {
+            assertTrue(expected.getMessage().contains("Existing profile"));
+        }
+        assertArrayEquals(raw, Files.readAllBytes(staged));
+    }
+
+    @Test public void failureAfterAppendingRestoresExactOriginalBytes() throws Exception {
+        byte[] raw = syntheticDng(40, 30, false, 11);
+        Path staged = Files.createTempFile(folder.newFolder().toPath(), "M9_PROFILE_PENDING_", ".dng");
+        Files.write(staged, raw);
+        M9DngProfile broken = profile();
+        // A tone table whose size is not a whole number of float pairs is rejected by the
+        // writer only after the profile name has already been appended to the file.
+        Field tone = M9DngProfile.class.getDeclaredField("tone");
+        tone.setAccessible(true);
+        tone.set(broken, new byte[6]);
+        try {
+            M9DngProfileWriter.embedInPlace(staged, broken, "M9 Probe Standard");
+            fail("malformed profile must be rejected");
+        } catch (M9DngProfileWriter.StagingNotRestoredException unexpected) {
+            throw unexpected;
+        } catch (IOException expected) {
+            assertTrue(expected.getMessage().contains("Invalid profile field size"));
+        }
+        assertArrayEquals(raw, Files.readAllBytes(staged));
+        assertFalse(Files.size(staged) != raw.length);
+    }
+}

new file mode 100644
index 0000000..b71e12f
--- /dev/null
+++ b/app/src/main/java/com/particlesdevs/photoncamera/m9/render/M9ShadingParallel1A.java
@@ -0,0 +1,176 @@
+package com.particlesdevs.photoncamera.m9.render;
+
+import java.util.ArrayList;
+import java.util.List;
+import java.util.concurrent.ExecutionException;
+import java.util.concurrent.ExecutorService;
+import java.util.concurrent.Executors;
+import java.util.concurrent.Future;
+import java.util.concurrent.ThreadFactory;
+import java.util.concurrent.atomic.AtomicInteger;
+
+/**
+ * EXACTPERF1A: row-band parallel execution of the frozen SHADINGLUMADECOMP1A
+ * per-pixel lens-shading arithmetic.
+ *
+ * <p>Each output sample depends only on its own input sample, its row and column
+ * coordinates and the immutable gain table. Every pixel therefore performs the
+ * same double-precision operations, in the same order, as the serial loop it
+ * replaces; only the order in which independent rows are visited changes. The
+ * three counters are integer sums and are order-independent. The Bayer plane is
+ * read from a 2x2 table built with the same resolver the serial loop called per
+ * pixel; that resolver depends only on the sample's row and column parity.</p>
+ */
+final class M9ShadingParallel1A {
+    static final String REVISION = "M9EXACTPERF1A_SHADING_ROWBANDS_EXACT";
+    static final int WORKERS =
+            Math.max(2, Math.min(8, Runtime.getRuntime().availableProcessors()));
+    private static final int BANDS_PER_WORKER = 4;
+
+    private static final AtomicInteger THREAD_ID = new AtomicInteger();
+    private static final ThreadFactory THREADS = runnable -> {
+        Thread t = new Thread(runnable, "M9ShadingRows-" + THREAD_ID.incrementAndGet());
+        t.setDaemon(true);
+        return t;
+    };
+    private static volatile ExecutorService pool;
+
+    private M9ShadingParallel1A() {}
+
+    static final class Counts {
+        final long corrected;
+        final long aboveNominal;
+        final long postClip;
+

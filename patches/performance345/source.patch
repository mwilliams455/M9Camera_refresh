+    private static final class Frame {
+        final TrackingGeometry geometry;
+        final byte[] rgba;
+
+        Frame(TrackingGeometry geometry, byte[] rgba) {
+            this.geometry = geometry;
+            this.rgba = rgba;
+        }
+
+        int rgb(int x, int y) {

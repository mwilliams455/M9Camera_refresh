@@ -0,0 +1,34 @@
+package com.particlesdevs.photoncamera.m9.render;
+
+import java.io.IOException;
+import java.nio.file.AtomicMoveNotSupportedException;
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.nio.file.StandardCopyOption;
+
+/** A completed RAW can be discovered by its capture name even if its final rename fails. */
+final class M9DngPublication {
+    private M9DngPublication() {}
+
+    static Path createStagingFile(Path target) throws IOException {
+        String name = target.getFileName().toString();
+        int dot = name.lastIndexOf('.');
+        String stem = dot > 0 ? name.substring(0, dot) : name;
+        return Files.createTempFile(target.toAbsolutePath().getParent(), stem + "_recovered_", ".dng");
+    }
+
+    static Path publishStagedDng(Path complete, Path target) throws IOException {
+        try {
+            return Files.move(complete, target, StandardCopyOption.ATOMIC_MOVE,
+                    StandardCopyOption.REPLACE_EXISTING);
+        } catch (IOException failure) {
+            // Android File.renameTo uses a same-filesystem rename without copying to a
+            // visible final name. A failure leaves the completed source in place.
+            if (failure instanceof AtomicMoveNotSupportedException && complete.toFile().renameTo(target.toFile())) {
+                return target;
+            }
+            if (Files.isRegularFile(complete)) return complete;
+            throw new IOException("Unable to publish completed RAW from " + complete, failure);
+        }
+    }
+}

+        long aboveNominal = 0;
+        long postClip = 0;
+        boolean interrupted = false;
+        RuntimeException failure = null;
+        // Wait for every band so no worker can still be writing norm16 after we return.
+        for (Future<Counts> future : futures) {
+            while (true) {
+                try {
+                    Counts counts = future.get();
+                    corrected += counts.corrected;
+                    aboveNominal += counts.aboveNominal;
+                    postClip += counts.postClip;
+                    break;
+                } catch (InterruptedException e) {
+                    interrupted = true;
+                } catch (ExecutionException e) {
+                    if (failure == null) {
+                        failure = new IllegalStateException("EXACTPERF1A shading band failed", e.getCause());
+                    }
+                    break;
+                }
+            }
+        }
+        if (interrupted) Thread.currentThread().interrupt();
+        if (failure != null) throw failure;

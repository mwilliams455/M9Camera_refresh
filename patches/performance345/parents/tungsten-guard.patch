+package com.particlesdevs.photoncamera.m9.render;
+
+import com.particlesdevs.photoncamera.m9.preview.M9PreviewFrameState1W;
+import com.particlesdevs.photoncamera.settings.SettingsManager;
+import org.junit.Test;
+import static org.junit.Assert.*;
+import static org.mockito.Mockito.*;
+import org.mockito.MockMakers;
+
+public class M9TungstenGuardTest {
+    @Test public void existingInstallDefaultsToAutoAndSwitchCanChangeBothWays() {
+        assertTrue(M9TungstenGuardSettings.enabled(null));
+        SettingsManager settings = mock(SettingsManager.class, withSettings().mockMaker(MockMakers.SUBCLASS));
+        when(settings.getBoolean(SettingsManager.SCOPE_GLOBAL, M9TungstenGuardSettings.KEY, true))
+                .thenReturn(true, false, true).thenThrow(new NumberFormatException());
+        assertTrue(M9TungstenGuardSettings.enabled(settings));
+        assertFalse(M9TungstenGuardSettings.enabled(settings));
+        assertTrue(M9TungstenGuardSettings.enabled(settings));
+        assertTrue(M9TungstenGuardSettings.enabled(settings));
+    }
+
+    @Test public void autoRetainsOriginalCurveAndOffBypassesEveryIlluminant() {
+        double[] kelvin = {2800, 3200, 3850, 4500, 6500};
+        double[] expectedAuto = {1, 1, .5, 0, 0};
+        for (int i = 0; i < kelvin.length; i++) {
+            assertEquals(expectedAuto[i], M9R35Renderer.tungstenGuardWeight(kelvin[i], true), 0);
+            assertEquals(0, M9R35Renderer.tungstenGuardWeight(kelvin[i], false), 0);
+        }
+    }
+
+    @Test public void cachedFallbackFrameCanSwitchOffAndBackOn() {
+        M9PreviewFrameState1W frame = new M9PreviewFrameState1W(null, 1, 1, 1, 0, .75f,
+                0, 0, 1, 0, null);
+        assertEquals(.75f, frame.effectiveTungstenWeight(true), 0);
+        assertEquals(0f, frame.effectiveTungstenWeight(false), 0);
+        assertEquals(.75f, frame.effectiveTungstenWeight(true), 0);
+    }
+}

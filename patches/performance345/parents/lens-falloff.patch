+package com.particlesdevs.photoncamera.m9.render;
+
+import org.junit.Test;
+import static org.junit.Assert.*;
+
+public class M9LensFalloffTest {
+    @Test public void measuredEndpointsAndEvStrength() {
+        assertEquals(1, M9TargetFalloff1A.gain(0, 100), 0);
+        assertEquals(1, M9TargetFalloff1A.gain(1, 0), 0);
+        assertEquals(Math.pow(2, -.89), M9TargetFalloff1A.gain(1, 100), 1e-7);
+        assertEquals(Math.pow(2, -.445), M9TargetFalloff1A.gain(1, 50), 1e-7);
+        double previous = 1;
+        for (int i = 1; i <= 1000; i++) {
+            double gain = M9TargetFalloff1A.gain(i / 1000.0, 100);
+            assertTrue(gain <= previous);
+            previous = gain;
+        }
+    }
+
+    @Test public void stillAndPreviewGeometryAgreeInBothOrientationsAndAcrossStrips() {
+        for (int[] dims : new int[][] {{101, 75}, {75, 101}, {1, 1}}) {
+            int width = dims[0], height = dims[1];
+            float[] weights = M9TargetFalloff1A.previewWeights(width, height, width, height);
+            for (int strength : new int[] {0, 50, 100}) {
+                M9TargetFalloff1A.Raster raster = new M9TargetFalloff1A.Raster(width, height, strength);
+                for (int first = 0; first < height; first += 32) {
+                    int rows = Math.min(32, height - first);
+                    short[] rgb = new short[width * rows * 3];
+                    int[] color = {65535, 32767, 8191};
+                    for (int i = 0; i < rgb.length; i++) rgb[i] = (short) color[i % 3];
+                    raster.applyRows(rgb, first, rows);
+                    for (int i = 0; i < rgb.length; i++) {
+                        int x = i / 3 % width, y = first + i / (3 * width);
+                        double dx = (2.0 * (x + 0.5) / width - 1) * weights[0];
+                        double dy = (2.0 * (y + 0.5) / height - 1) * weights[1];
+                        double expected = color[i % 3] * M9TargetFalloff1A.gain(dx * dx + dy * dy, strength);
+                        assertEquals(expected, rgb[i] & 65535, strength == 0 ? 0 : 10);
+                    }
+                }
+            }
+        }
+    }
+
+    @Test public void widePreviewMapsToCenterCropOfRaw() {
+        float[] full = M9TargetFalloff1A.previewWeights(4000, 3000, 800, 600);
+        float[] crop = M9TargetFalloff1A.previewWeights(4000, 3000, 1920, 1080);
+        assertArrayEquals(new float[] {.8f, .6f}, full, .00001f);
+        assertArrayEquals(new float[] {.8f, .45f}, crop, .00001f);
+    }
+}

@@ -0,0 +1,56 @@
+package com.particlesdevs.photoncamera.ui.camera;
+
+import com.particlesdevs.photoncamera.control.subject.AutomaticSubjectSelection;
+import com.particlesdevs.photoncamera.control.subject.AutomaticSubjectSelection.Box;
+import com.particlesdevs.photoncamera.control.tracking.SubjectAnchorPolicy.Candidate;
+import java.util.Arrays;
+import org.junit.Test;
+import static org.junit.Assert.*;
+
+public class LowerBodyAcquisitionTest {
+    private static final long STEP = 200_000_000L;
+    private final AutomaticSubjectSelection selection = new AutomaticSubjectSelection();
+    private final Box foot = body("person", .702f, .643f, .996f, .989f);
+    private final Box nearby = body("person", .69f, .65f, .99f, 1f);
+    private final Box other = body("person", 0f, .6f, .3f, 1f);
+    private static Box body(String type, float l, float t, float r, float b) {
+        return Box.fromBody(new Candidate(type, .8f, l, t, r, b));
+    }
+    private Box sample(int n, Box... boxes) {
+        return selection.observe(n * STEP, n * STEP, Arrays.asList(boxes));
+    }
+
+    @Test public void floorObservationAloneCannotCreateOwner() {
+        assertNull(sample(1, foot));
+        assertEquals(0, selection.selectionId());
+        assertFalse(selection.visibleAt(STEP));
+        assertFalse(selection.mayAim());
+        assertNull(sample(2));
+        assertNull(sample(3, foot));
+        assertSame(nearby, sample(4, nearby));
+        assertEquals(1, selection.selectionId());
+        assertTrue(selection.mayAim());
+    }
+    @Test public void onlyOneAdjacentMatchingLowerBodyCanConfirm() {
+        assertNull(sample(1, foot));
+        assertNull(sample(2, other));
+        assertNull(sample(3, nearby, other));
+        assertNull(sample(4, foot));
+        assertNull(sample(6, nearby));
+        assertNull(selection.observe(7 * STEP, 9 * STEP, Arrays.asList(foot)));
+        assertNull(sample(8, foot));
+        selection.reset();
+        assertNull(sample(9, nearby));
+    }
+    @Test public void existingPersonAndNewCentralPersonOrPetRemainEligible() {
+        Box normal = body("person", .45f, .28f, 1f, 1f);
+        assertSame(normal, sample(1, foot, normal));
+        assertSame(foot, sample(2, foot));
+        selection.reset();
+        Box dog = body("dog", .69f, .59f, .99f, 1f);
+        assertSame(dog, sample(3, foot, dog));
+        selection.reset();
+        Box complete = body("person", .4f, .5f, .65f, .91f);
+        assertSame(complete, sample(4, complete));
+    }
+}

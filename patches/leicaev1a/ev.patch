+package com.particlesdevs.photoncamera.m9;
+
+import android.content.Context;
+import android.content.SharedPreferences;
+import android.content.res.Resources;
+import android.os.Vibrator;
+import com.particlesdevs.photoncamera.circularbarlib.control.LeicaEv;
+import com.particlesdevs.photoncamera.circularbarlib.control.ManualParamModel;
+import com.particlesdevs.photoncamera.circularbarlib.control.models.EvModel;
+import com.particlesdevs.photoncamera.circularbarlib.console.ManualModeConsoleImpl;
+import com.particlesdevs.photoncamera.circularbarlib.model.KnobModel;
+import com.particlesdevs.photoncamera.circularbarlib.ui.views.knobview.KnobItemInfo;
+import com.particlesdevs.photoncamera.circularbarlib.ui.views.knobview.ShadowTextDrawable;
+import org.junit.Test;
+import org.mockito.MockedConstruction;
+import java.lang.reflect.Field;
+import java.util.HashMap;
+import java.util.Map;
+import static org.junit.Assert.*;
+import static org.mockito.ArgumentMatchers.*;
+import static org.mockito.Mockito.*;
+
+public class M9LeicaEvTest {
+    private static final class Memory {
+        final Map<String,Object> values = new HashMap<>();
+        final SharedPreferences prefs = mock(SharedPreferences.class);
+        int writes;
+        Memory() {
+            when(prefs.getAll()).thenAnswer(i -> new HashMap<>(values));
+            when(prefs.getString(anyString(),nullable(String.class))).thenAnswer(i -> {
+                Object value=values.get(i.getArgument(0));
+                return value==null ? i.getArgument(1) : (String)value;
+            });
+            when(prefs.edit()).thenAnswer(i -> {
+                Map<String,Object> puts=new HashMap<>();
+                SharedPreferences.Editor editor=mock(SharedPreferences.Editor.class);
+                when(editor.putString(anyString(),anyString())).thenAnswer(call -> {
+                    puts.put(call.getArgument(0),call.getArgument(1)); return editor;
+                });
+                doAnswer(call -> { values.putAll(puts); ++writes; return null; }).when(editor).apply();
+                return editor;
+            });
+        }
+        Context context() {
+            Context c=mock(Context.class); Resources resources=mock(Resources.class);
+            when(c.getApplicationContext()).thenReturn(c);
+            when(c.getPackageName()).thenReturn("com.m9project.m9cam.photon");
+            when(c.getSharedPreferences("com.m9project.m9cam.photon_preferences",0)).thenReturn(prefs);
+            when(c.getResources()).thenReturn(resources);
+            when(c.getString(anyInt())).thenReturn("Auto");
+            when(resources.getInteger(anyInt())).thenReturn(120);
+            return c;
+        }
+    }
+    @Test public void exactNineteenStopsAndSymmetricRounding() {
+        for(int n=-9;n<=9;n++) {
+            double ev=n/3.0;
+            assertEquals(ev,LeicaEv.normalize(ev),0.0);
+            assertEquals(ev,Double.parseDouble(LeicaEv.encode(ev)),0.0);
+            assertEquals(-LeicaEv.normalize(ev),LeicaEv.normalize(-ev),0.0);
+        }
+        assertEquals(-2.0/3.0,LeicaEv.normalize(-0.68),0.0);
+        assertEquals(1.0/3.0,LeicaEv.normalize(0.25),0.0);
+        assertEquals(-1.0/3.0,LeicaEv.normalize(-1.0/6.0),0.0);
+        assertEquals(1.0/3.0,LeicaEv.normalize(1.0/6.0),0.0);
+        assertEquals(-3.0,LeicaEv.normalize(-4),0.0);
+        assertEquals(3.0,LeicaEv.normalize(4),0.0);
+    }
+    @Test public void labelsCannotSuggestQuarterStopsOrTwoCompensations() {
+        assertEquals("0",LeicaEv.label(0));
+        assertEquals("−⅔",LeicaEv.label(-2.0/3.0));
+        assertEquals("+1 ⅓",LeicaEv.label(4.0/3.0));
+        assertEquals("−3",LeicaEv.label(-3));
+    }
+    @Test public void nonfiniteValuesAreNeutral() {
+        for(double x:new double[]{Double.NaN,Double.POSITIVE_INFINITY,Double.NEGATIVE_INFINITY})
+            assertEquals(0.0,LeicaEv.normalize(x),0.0);
+    }
+    @Test public void oldSettingMigratesOnceAndKeepsOtherPreferences() {
+        Memory m=new Memory(); m.values.put(LeicaEv.KEY,"-0.680001"); m.values.put("unrelated","kept");
+        assertEquals(-2.0/3.0,LeicaEv.migrate(m.prefs),0.0);
+        assertEquals("-0.6666666666666666",m.values.get(LeicaEv.KEY));
+        assertEquals("kept",m.values.get("unrelated")); assertEquals(1,m.writes);
+        LeicaEv.migrate(m.prefs); assertEquals(1,m.writes);
+        assertEquals(-2.0/3.0,LeicaEv.read(m.prefs),0.0); assertEquals(1,m.writes);
+    }
+    @Test public void freshInstallReadsZeroWithoutWritesAndMalformedBackupRecovers() {
+        Memory m=new Memory(); assertEquals(0.0,LeicaEv.migrate(m.prefs),0.0); assertEquals(0,m.writes);
+        for(Object value:new Object[]{true,"bad","NaN","Infinity"}) {
+            m.values.put(LeicaEv.KEY,value);
+            assertEquals(0.0,LeicaEv.migrate(m.prefs),0.0);
+            assertEquals("0.0",m.values.get(LeicaEv.KEY));
+        }
+    }
+    @Test public void changingControlReplacesRatherThanAddsAndRestartReadsSameValue() {
+        Memory m=new Memory(); LeicaEv.write(m.prefs,-1);
+        LeicaEv.write(m.prefs,2.0/3.0);
+        assertEquals(2.0/3.0,LeicaEv.read(m.prefs),0.0);
+        Memory restarted=new Memory(); restarted.values.putAll(m.values);
+        assertEquals(2.0/3.0,LeicaEv.read(restarted.prefs),0.0);
+        assertEquals(1,m.values.size());
+    }
+    @Test public void hardwareConversionOnlyForLegacyFallbackIsBounded() {
+        assertEquals(3,LeicaEv.hardwareSteps(1,1.0/3.0,-9,9));
+        assertEquals(2,LeicaEv.hardwareSteps(1,0.5,-6,6));
+        assertEquals(2,LeicaEv.hardwareSteps(3,1.0/3.0,-2,2));
+        assertEquals(0,LeicaEv.hardwareSteps(1,0,-9,9));
+        assertEquals(0,LeicaEv.hardwareSteps(1,Double.NaN,-9,9));
+    }
+    @Test public void panelResetPreservesEvAndResetsActualManualExposure() {
+        ManualParamModel model=new ManualParamModel();
+        model.setCurrentEvValue(-2.0/3.0); model.setCurrentISOValue(400); model.setCurrentExposureValue(10000000);
+        model.reset();
+        assertEquals(-2.0/3.0,model.getCurrentEvValue(),0.0);
+        assertEquals(0.0,model.getCurrentISOValue(),0.0); assertEquals(0.0,model.getCurrentExposureValue(),0.0);
+        assertTrue(M9ExposurePlan1A.autoEligible(true,false,0,0));
+    }
+    @Test public void dialWorksWithoutVendorEvMetadataAndMirrorsProfileRecall() {
+        try(MockedConstruction<ShadowTextDrawable> ignored=mockConstruction(ShadowTextDrawable.class)) {
+            Memory m=new Memory(); ManualParamModel param=new ManualParamModel();
+            EvModel dial=new EvModel(m.context(),null,null,param,null,mock(Vibrator.class));
+            assertEquals(19,dial.getKnobInfoList().size());
+            for(KnobItemInfo item:dial.getKnobInfoList()) {
+                dial.onSelectedKnobItemChanged(item);
+                assertEquals(item.value,LeicaEv.read(m.prefs),0.0);
+                assertEquals(item.value,param.getCurrentEvValue(),0.0);
+            }
+            LeicaEv.write(m.prefs,1.0/3.0); int writes=m.writes;
+            dial.syncFromPreferences();
+            assertEquals(1.0/3.0,dial.getCurrentInfo().value,0.0);
+            assertEquals(1.0/3.0,param.getCurrentEvValue(),0.0);
+            assertEquals(writes,m.writes);
+        }
+    }
+    @Test public void closingPanelCannotResetTheLastEvWheelListener() throws Exception {
+        try(MockedConstruction<ShadowTextDrawable> ignored=mockConstruction(ShadowTextDrawable.class)) {
+            Memory m=new Memory(); LeicaEv.write(m.prefs,-2.0/3.0);
+            ManualModeConsoleImpl console=(ManualModeConsoleImpl)ManualModeConsoleImpl.newInstance();
+            EvModel dial=new EvModel(m.context(),null,null,console.getManualParamModel(),null,mock(Vibrator.class));
+            Field ev=ManualModeConsoleImpl.class.getDeclaredField("evModel"); ev.setAccessible(true); ev.set(console,dial);
+            // This models the widget's retained last listener even after deselection.
+            console.getKnobModel().addObserver((o,arg) -> {
+                if(arg==KnobModel.KnobModelFields.RESET) dial.resetModelSilently();
+            });
+            console.retractAllKnobs(); console.setPanelVisibility(false); console.setPanelVisibility(true);
+            assertEquals(-2.0/3.0,LeicaEv.read(m.prefs),0.0);
+            assertEquals(-2.0/3.0,console.getManualParamModel().getCurrentEvValue(),0.0);
+            console.resetAllValues(); assertEquals(0.0,LeicaEv.read(m.prefs),0.0);
+        }
+    }
+    @Test public void changedEvRejectsAnOlderDisplayedPlanAndIntentRemainsPhysical() {
+        M9ExposurePlan1A plan=new M9ExposurePlan1A(1,100,1,"0","PHOTO",100,10000000,
+                100,10000000,100,20000000,1,0,"test",0,0,100);
+        assertTrue(plan.matches("0","PHOTO",200,1,0,0));
+        assertFalse(plan.matches("0","PHOTO",200,2.0/3.0,0,0));
+        assertEquals(2.0,plan.previewScale(),0.0);
+        assertEquals(2.0,plan.renderIntentScale(100,20000000),0.0);
+        assertFalse(plan.matches("1","PHOTO",200,1,0,0));
+    }
+}

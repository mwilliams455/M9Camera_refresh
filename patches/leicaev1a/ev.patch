+package com.particlesdevs.photoncamera.circularbarlib.control;
+
+import android.content.Context;
+import android.content.SharedPreferences;
+
+/** M9LEICAEV1A: one persisted, stop-domain EV shared by menu, dial and profiles. */
+public final class LeicaEv {
+    // Reuse the old preference identity for backup/profile compatibility. It is
+    // now the complete EV value, never an offset added to the manual wheel.
+    public static final String KEY = "pref_expocompensation_seekbar_key";
+    public static final double MIN = -3.0, MAX = 3.0, STEP = 1.0 / 3.0;
+    private LeicaEv() {}
+
+    public static double normalize(double stops) {
+        if (!Double.isFinite(stops)) return 0.0;
+        double bounded = Math.max(MIN, Math.min(MAX, stops));
+        int thirds = (int)Math.copySign(Math.floor(Math.abs(bounded) * 3.0 + 0.5), bounded);
+        return thirds / 3.0;
+    }
+    public static String encode(double stops) { return Double.toString(normalize(stops)); }
+    public static String label(double stops) {
+        int thirds = (int)Math.round(normalize(stops) * 3.0);
+        if (thirds == 0) return "0";
+        int magnitude = Math.abs(thirds), whole = magnitude / 3, fraction = magnitude % 3;
+        String body = whole == 0 ? "" : Integer.toString(whole);
+        if (fraction != 0) body += (whole == 0 ? "" : " ") + (fraction == 1 ? "⅓" : "⅔");
+        return (thirds > 0 ? "+" : "−") + body;
+    }
+    public static double read(SharedPreferences preferences) {
+        if (preferences == null) return 0.0;
+        try { return normalize(Double.parseDouble(preferences.getString(KEY, "0.0"))); }
+        catch (RuntimeException invalid) { return 0.0; }
+    }
+    public static SharedPreferences preferences(Context context) {
+        // Same default-preference file used by AndroidX PreferenceManager and
+        // the app's SettingsManager; no second storage authority in the library.
+        return context.getApplicationContext().getSharedPreferences(
+                context.getPackageName() + "_preferences", Context.MODE_PRIVATE);
+    }
+    public static void write(SharedPreferences preferences, double stops) {
+        String value = encode(stops);
+        Object old = preferences.getAll().get(KEY);
+        if (!value.equals(old)) preferences.edit().putString(KEY, value).apply();
+    }
+    /** Normalize an existing legacy/backup value once, without writing on fresh install. */
+    public static double migrate(SharedPreferences preferences) {
+        double value = read(preferences);
+        if (preferences != null && preferences.getAll().containsKey(KEY)) write(preferences, value);
+        return value;
+    }
+    /** Only legacy non-M9 requests use Camera2 compensation units. */
+    public static int hardwareSteps(double stops, double step, int low, int high) {
+        if (!Double.isFinite(step) || step <= 0.0 || low > high) return 0;
+        long count = Math.round(normalize(stops) / step);
+        return (int)Math.max(low, Math.min(high, count));
+    }
+}

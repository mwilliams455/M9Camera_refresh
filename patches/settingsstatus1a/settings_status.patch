+package com.particlesdevs.photoncamera.m9;
+
+import android.app.NotificationChannel;
+import android.app.NotificationManager;
+import android.app.PendingIntent;
+import android.content.Context;
+import android.content.Intent;
+import android.os.Handler;
+import android.os.Looper;
+import androidx.core.app.NotificationCompat;
+import androidx.core.app.NotificationManagerCompat;
+import com.particlesdevs.photoncamera.R;
+import com.particlesdevs.photoncamera.app.PhotonCamera;
+
+/** Application-context notifications, independent of camera rearm and Fragment lifetime. */
+public final class M9SaveFeedback {
+    private static final String CHANNEL = "m9_final_save";
+    private static final int NOTIFICATION = 925;
+    private static final Handler MAIN = new Handler(Looper.getMainLooper());
+    private static boolean initialized;
+    private M9SaveFeedback() {}
+
+    public static synchronized void initialize() {
+        if (initialized) return;
+        initialized = true;
+        M9SaveStatus.INSTANCE.addObserver(() -> MAIN.post(M9SaveFeedback::refreshNotification));
+        MAIN.post(M9SaveFeedback::refreshNotification);
+    }
+
+    public static String text(Context context, M9SaveStatus.Snapshot state) {
+        if (state.pending > 0) {
+            String saving = context.getResources().getQuantityString(
+                    R.plurals.m9_photos_saving, state.pending, state.pending);
+            return state.failed == 0 ? saving : saving + " · " + context.getString(R.string.m9_save_issue_short);
+        }
+        if (state.failed > 0) return context.getResources().getQuantityString(
+                R.plurals.m9_photos_save_issues, state.failed, state.failed);
+        if (state.saved > 0) return context.getResources().getQuantityString(
+                R.plurals.m9_photos_saved, state.saved, state.saved);
+        return "";
+    }
+
+    public static String details(Context context, M9SaveStatus.Snapshot state) {
+        StringBuilder message = new StringBuilder();
+        int[] flags = {M9SaveStatus.JPEG, M9SaveStatus.DNG, M9SaveStatus.PROFILE,
+                M9SaveStatus.UNFILTERED, M9SaveStatus.PUBLICATION, M9SaveStatus.PROCESSING, M9SaveStatus.QUEUE};
+        int[] resources = {R.string.m9_save_jpeg_failed, R.string.m9_save_dng_failed,
+                R.string.m9_save_profile_failed, R.string.m9_save_unfiltered_failed,
+                R.string.m9_save_publication_failed, R.string.m9_save_processing_failed,
+                R.string.m9_save_queue_failed};
+        for (int i = 0; i < flags.length; i++) if ((state.issues & flags[i]) != 0) {
+            if (message.length() > 0) message.append("\n\n");
+            message.append(context.getString(resources[i]));
+        }
+        return message.toString();
+    }
+
+    private static void refreshNotification() {
+        Context context = PhotonCamera.getAppContext();
+        if (context == null) return;
+        M9SaveStatus.Snapshot state = M9SaveStatus.INSTANCE.snapshot();
+        try {
+            NotificationManagerCompat manager = NotificationManagerCompat.from(context);
+            manager.createNotificationChannel(new NotificationChannel(CHANNEL,
+                    context.getString(R.string.m9_save_channel), NotificationManager.IMPORTANCE_LOW));
+            if (state.pending == 0 && state.failed == 0) { manager.cancel(NOTIFICATION); return; }
+            NotificationCompat.Builder builder = new NotificationCompat.Builder(context, CHANNEL)
+                    .setSmallIcon(R.drawable.ic_round_photo_camera_24)
+                    .setContentTitle(context.getString(R.string.app_name))
+                    .setContentText(text(context, state)).setOnlyAlertOnce(true)
+                    .setOngoing(state.pending > 0).setAutoCancel(state.pending == 0)
+                    .setVisibility(NotificationCompat.VISIBILITY_PRIVATE)
+                    .setProgress(0, 0, state.pending > 0);
+            if (state.failed > 0) builder.setStyle(new NotificationCompat.BigTextStyle()
+                    .bigText(details(context, state)));
+            Intent open = context.getPackageManager().getLaunchIntentForPackage(context.getPackageName());
+            if (open != null) builder.setContentIntent(PendingIntent.getActivity(context, NOTIFICATION,
+                    open, PendingIntent.FLAG_UPDATE_CURRENT | PendingIntent.FLAG_IMMUTABLE));
+            manager.notify(NOTIFICATION, builder.build());
+        } catch (RuntimeException ignored) {
+            // The camera status remains available if notifications are disabled.
+        }
+    }
+}

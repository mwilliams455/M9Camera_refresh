--- /dev/null
+++ b/app/src/main/java/com/particlesdevs/photoncamera/m9/M9SaveStatus.java
@@ -0,0 +1,87 @@
+package com.particlesdevs.photoncamera.m9;
+
+import java.util.concurrent.CopyOnWriteArrayList;
+
+/** Capture-owned final-save state. Contains no Activity, image buffer or diagnostic export. */
+public final class M9SaveStatus {
+    public static final M9SaveStatus INSTANCE = new M9SaveStatus();
+    public static final int JPEG = 1, DNG = 2, PROFILE = 4, UNFILTERED = 8,
+            PUBLICATION = 16, PROCESSING = 32, QUEUE = 64;
+    public interface Observer { void changed(); }
+    private final CopyOnWriteArrayList<Observer> observers = new CopyOnWriteArrayList<>();
+    private int pending, saved, failed, issues;
+    private long revision;
+
+    public static final class Snapshot {
+        public final int pending, saved, failed, issues;
+        public final long revision;
+        private Snapshot(int pending, int saved, int failed, int issues, long revision) {
+            this.pending = pending; this.saved = saved; this.failed = failed;
+            this.issues = issues; this.revision = revision;
+        }
+    }
+
+    public final class Ticket {
+        private final M9SaveSelection output;
+        private boolean done;
+        private Ticket(M9SaveSelection output) { this.output = output; }
+
+        /** Called only after requested file writes, metadata and publication attempts end. */
+        public void complete(boolean jpeg, boolean dng, boolean profile, boolean unfiltered,
+                             boolean published) {
+            int problems = 0;
+            if (output.jpeg && !jpeg) problems |= JPEG;
+            if (output.dng && !dng) problems |= DNG;
+            if (output.dng && dng && !profile) problems |= PROFILE;
+            if (output.unfilteredDng && !unfiltered) problems |= UNFILTERED;
+            if (!published) problems |= PUBLICATION;
+            finish(problems);
+        }
+
+        public void fail(int reason) { finish(reason == 0 ? PROCESSING : reason); }
+
+        private void finish(int problems) {
+            synchronized (M9SaveStatus.this) {
+                if (done) return;
+                done = true;
+                pending--;
+                if (problems == 0) saved++; else failed++;
+                issues |= problems;
+                revision++;
+            }
+            notifyObservers();
+        }
+    }
+
+    public Ticket begin(M9SaveSelection output) {
+        if (output == null) throw new IllegalArgumentException("Missing save selection");
+        Ticket ticket = new Ticket(output);
+        synchronized (this) { pending++; revision++; }
+        notifyObservers();
+        return ticket;
+    }
+
+    public synchronized Snapshot snapshot() {
+        return new Snapshot(pending, saved, failed, issues, revision);
+    }
+
+    /** A stale timer/dialog must never clear a newer capture's result. */
+    public void acknowledge(long expectedRevision) {
+        synchronized (this) {
+            if (revision != expectedRevision || pending != 0) return;
+            saved = failed = issues = 0;
+            revision++;
+        }
+        notifyObservers();
+    }
+
+    public void addObserver(Observer observer) { observers.addIfAbsent(observer); }
+    public void removeObserver(Observer observer) { observers.remove(observer); }
+    private void notifyObservers() {
+        for (Observer observer : observers) {
+            try { observer.changed(); } catch (RuntimeException ignored) {
+                // A detached UI or unavailable notification may never fail a save.
+            }
+        }
+    }
+}

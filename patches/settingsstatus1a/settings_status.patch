@@ -0,0 +1,62 @@
+package com.particlesdevs.photoncamera.m9;
+
+import android.os.Handler;
+import android.os.Looper;
+import android.view.View;
+import android.widget.TextView;
+import com.google.android.material.dialog.MaterialAlertDialogBuilder;
+import com.particlesdevs.photoncamera.R;
+
+/** Resubscribes to process-owned status after rotation/background; retains no capture data. */
+public final class M9SaveStatusView {
+    private final TextView view;
+    private final Handler main = new Handler(Looper.getMainLooper());
+    private final M9SaveStatus.Observer observer = () -> main.post(this::refresh);
+    private boolean started;
+    private long successRevision;
+    private final Runnable dismissSuccess = () -> {
+        M9SaveStatus.Snapshot state = M9SaveStatus.INSTANCE.snapshot();
+        if (started && state.failed == 0 && state.pending == 0)
+            M9SaveStatus.INSTANCE.acknowledge(successRevision);
+    };
+
+    public M9SaveStatusView(TextView view) {
+        this.view = view;
+        view.setOnClickListener(v -> {
+            M9SaveStatus.Snapshot state = M9SaveStatus.INSTANCE.snapshot();
+            if (!started || state.failed == 0) return;
+            new MaterialAlertDialogBuilder(view.getContext())
+                    .setTitle(R.string.m9_save_issue_title)
+                    .setMessage(M9SaveFeedback.details(view.getContext(), state))
+                    .setPositiveButton(android.R.string.ok, (dialog, which) ->
+                            M9SaveStatus.INSTANCE.acknowledge(state.revision))
+                    .show();
+        });
+    }
+
+    public void start() {
+        started = true;
+        M9SaveFeedback.initialize();
+        M9SaveStatus.INSTANCE.addObserver(observer);
+        refresh();
+    }
+    public void stop() {
+        started = false;
+        M9SaveStatus.INSTANCE.removeObserver(observer);
+        main.removeCallbacksAndMessages(null);
+    }
+    private void refresh() {
+        if (!started) return;
+        main.removeCallbacks(dismissSuccess);
+        M9SaveStatus.Snapshot state = M9SaveStatus.INSTANCE.snapshot();
+        String text = M9SaveFeedback.text(view.getContext(), state);
+        view.setText(text);
+        view.setVisibility(text.isEmpty() ? View.GONE : View.VISIBLE);
+        view.setClickable(state.failed > 0);
+        view.setFocusable(state.failed > 0);
+        if (state.pending == 0 && state.failed == 0 && state.saved > 0) {
+            successRevision = state.revision;
+            main.postDelayed(dismissSuccess, 3500);
+        }
+    }
+}

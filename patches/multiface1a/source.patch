+        headCount = 0;
+        primaryHead = -1;
+        for (Box box : candidates) {
+            if (box.face) headCount++;
+        }
+        long now = SystemClock.elapsedRealtimeNanos();
+        headDeadlineNs = frameNs + AutomaticSubjectSelection.MAX_AGE_NS;
+        if (now < frameNs || now >= headDeadlineNs || headCount == 0
+                || (headCount == 1 && selected != null && selected.face)) {

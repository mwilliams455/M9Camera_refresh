+package com.particlesdevs.photoncamera.ui.camera.views;
+
+import android.app.Application;
+import android.graphics.Canvas;
+import android.graphics.Paint;
+import android.os.Looper;
+import android.os.SystemClock;
+import com.particlesdevs.photoncamera.control.subject.AutomaticSubjectSelection.Box;
+import com.particlesdevs.photoncamera.control.subject.SubjectFocusPolicy.Face;
+import com.particlesdevs.photoncamera.control.tracking.SubjectAnchorPolicy.Candidate;
+import java.time.Duration;
+import java.util.ArrayList;
+import java.util.Arrays;
+import java.util.Collections;
+import java.util.List;
+import org.junit.Before;
+import org.junit.Test;
+import org.junit.runner.RunWith;
+import org.robolectric.RobolectricTestRunner;
+import org.robolectric.RuntimeEnvironment;
+import org.robolectric.annotation.Config;
+import static org.junit.Assert.*;
+import static org.mockito.Mockito.*;
+import static org.robolectric.Shadows.shadowOf;
+
+@RunWith(RobolectricTestRunner.class)
+@Config(sdk=35, application=Application.class)
+public class MultiFaceOverlayTest {
+    private TrackingFocusView view;
+    private Canvas canvas;
+    private final List<Float> leftEdges = new ArrayList<>();
+    private final List<Integer> colors = new ArrayList<>();
+    private final Box left = face(1, .15f), right = face(2, .53f);
+    private final List<Box> both = Arrays.asList(left, right);
+
+    private static Box face(int id, float x) {
+        return Box.fromFace(new Face(id,x,.2f,x+.2f,.4f,x+.07f,.28f,Float.NaN,Float.NaN,
+                x+.10f,.31f,x+.12f,.35f),false);
+    }
+
+    @Before public void prepare() {
+        assertNotNull(left);
+        assertNotNull(right);
+        view = new TrackingFocusView(RuntimeEnvironment.getApplication(), null);
+        view.layout(0,0,600,800);
+        view.show(100,160,50,50,false);
+        canvas = mock(Canvas.class);
+        doAnswer(call -> {
+            float[] ticks = call.getArgument(0);
+            Paint paint = call.getArgument(1);
+            if (paint.getColor() != 0x99000000) {
+                leftEdges.add(ticks[0]);
+                colors.add(paint.getColor());
+            }
+            return null;
+        }).when(canvas).drawLines(any(float[].class), any(Paint.class));
+    }
+
+    private void draw() {
+        leftEdges.clear();
+        colors.clear();
+        view.onDraw(canvas);
+    }
+
+    private void heads(List<Box> boxes, Box selected, boolean heldFace) {
+        view.setHeadFrames(boxes, selected, heldFace, 20,30,400,500,SystemClock.elapsedRealtimeNanos());
+        draw();
+    }
+
+    @Test public void bothFacesAppearAtPreviewCoordinatesAndFocusCanChangeHands() {
+        // The face height is 100 pixels, so both head squares have a 50-pixel half-side.
+        heads(both, left, false);
+        assertEquals(2,leftEdges.size());
+        assertEquals(222f,leftEdges.get(0),.01f);
+        assertEquals(70f,leftEdges.get(1),.01f);
+        assertEquals(Arrays.asList(0xcceeeeee,0xfffcfcf8),colors);
+        heads(both, right, false);
+        assertEquals(70f,leftEdges.get(0),.01f);
+        assertEquals(222f,leftEdges.get(1),.01f);
+    }
+
+    @Test public void disappearingOrExpiredFacesDoNotPersist() {
+        heads(both,left,false);
+        heads(Collections.singletonList(right),null,true);
+        assertEquals(Collections.singletonList(0xcceeeeee),colors);
+        assertEquals(222f,leftEdges.get(0),.01f);
+        heads(both,left,false);
+        shadowOf(Looper.getMainLooper()).idleFor(Duration.ofMillis(351));
+        draw();
+        assertEquals(Collections.singletonList(50f),leftEdges);
+    }
+
+    @Test public void bodyAndManualTrackingKeepTheirOwnFrames() {
+        Box dog = Box.fromBody(new Candidate("dog",.9f,.4f,.3f,.6f,.7f));
+        heads(Arrays.asList(left,dog),dog,false);
+        assertEquals(2,leftEdges.size());
+        assertEquals(70f,leftEdges.get(0),.01f);
+        assertEquals(50f,leftEdges.get(1),.01f);
+        view.show(300,160,25,25,false);
+        draw();
+        assertEquals(Collections.singletonList(275f),leftEdges);
+    }
+}

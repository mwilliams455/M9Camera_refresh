+import com.particlesdevs.photoncamera.m9.M9SaveStatus;
+import com.particlesdevs.photoncamera.settings.PreferenceKeys;
+
+/** Refreshed chrome over the accepted 2.38 camera. All real controls delegate to it. */
+final class M9OverlayController implements AutoCloseable {
+    private final CameraFragment fragment;
+    private final View root;
+    private final Context context;
+    private final Handler handler = new Handler(Looper.getMainLooper());
+    private final TextView[] source = new TextView[4];
+    private final TextView[] controls = new TextView[4];
+    private final TextWatcher[] watchers = new TextWatcher[4];
+    private final String[] labels;
+    private final View photo, motion, settings, renderer;
+    private final TextView activeRender;
+    private volatile boolean burstLocked;
+    private boolean resumed;
+    private PopupWindow renderPopup;
+    private Dialog settingsDialog;
+
+    private final Runnable tick = new Runnable() {
+        @Override public void run() {
+            if (!resumed) return;
+            refresh();
+            handler.postDelayed(this, 180);
+        }
+    };
+
+    M9OverlayController(CameraFragment fragment) {
+        this.fragment = fragment;
+        root = fragment.cameraFragmentBinding.getRoot();
+        context = root.getContext();
+        labels = new String[]{context.getString(R.string.m9_overlay_iso),
+                context.getString(R.string.m9_overlay_shutter), context.getString(R.string.m9_overlay_ev),
+                context.getString(R.string.m9_overlay_focus)};
+        int[] sources = {R.id.iso_option_tv, R.id.exposure_option_tv, R.id.ev_option_tv, R.id.focus_option_tv};
+        int[] targets = {R.id.m9_overlay_iso, R.id.m9_overlay_shutter, R.id.m9_overlay_ev, R.id.m9_overlay_focus};
+        for (int i = 0; i < source.length; i++) {
+            final int index = i;
+            source[i] = root.findViewById(sources[i]);
+            controls[i] = root.findViewById(targets[i]);
+            // Retain the original model-bound TextViews and listeners, hiding only their cells.
+            ((View) source[i].getParent()).setVisibility(View.GONE);
+            controls[i].setOnClickListener(v -> openManual(source[index], false));
+            controls[i].setOnLongClickListener(v -> { openManual(source[index], true); return true; });
+            watchers[i] = new TextWatcher() {
+                public void beforeTextChanged(CharSequence s, int start, int count, int after) {}
+                public void onTextChanged(CharSequence s, int start, int before, int count) {}
+                public void afterTextChanged(Editable s) { handler.post(() -> mirror(index)); }
+            };
+            source[i].addTextChangedListener(watchers[i]);
+        }
+        ((View) root.findViewById(R.id.wb_option_tv).getParent()).setVisibility(View.GONE);
+        photo = root.findViewById(R.id.m9_overlay_photo);
+        motion = root.findViewById(R.id.m9_overlay_motion);
+        settings = root.findViewById(R.id.m9_overlay_settings);
+        renderer = root.findViewById(R.id.m9_overlay_renderer);
+        activeRender = root.findViewById(R.id.m9_overlay_active_render);
+        photo.setOnClickListener(v -> selectMode(M9OverlayPolicy.primaryMode(false)));
+        motion.setOnClickListener(v -> selectMode(M9OverlayPolicy.primaryMode(true)));
+        settings.setOnClickListener(v -> showSettings());
+        renderer.setOnClickListener(v -> showRenderers());
+        refresh();
+    }
+
+    void start() { resumed = true; handler.removeCallbacks(tick); handler.post(tick); }
+    void stop() { resumed = false; handler.removeCallbacksAndMessages(null); dismissSurfaces(); }
+    void setBurstLocked(boolean locked) { burstLocked = locked; handler.post(this::refresh); }
+
+    private boolean available() {
+        CaptureController c = fragment.captureController;
+        return M9OverlayPolicy.controlsAvailable(c != null && source[0].hasOnClickListeners(),
+                burstLocked, CaptureController.isProcessing,
+                fragment.cameraFragmentBinding.layoutBottombar.bottomButtons.shutterButton.isHovered(),
+                c != null && c.isM9BracketActive(),
+                c != null && (c.mIsRecordingVideo || c.onUnlimited),
+                M9SaveStatus.INSTANCE.snapshot().pending);
+    }
+
+    private boolean allowAction() {
+        if (available()) return true;
+        Toast.makeText(context, R.string.m9_overlay_busy, Toast.LENGTH_SHORT).show();
+        return false;
+    }
+
+    private void refresh() {
+        boolean enabled = available();
+        for (int i = 0; i < controls.length; i++) {
+            mirror(i);
+            setAvailable(controls[i], enabled);
+        }
+        for (View v : new View[]{photo, motion, settings, renderer}) setAvailable(v, enabled);
+        CameraMode mode = CameraMode.valueOf(PreferenceKeys.getCameraModeOrdinal());
+        photo.setSelected(mode == CameraMode.PHOTO);
+        motion.setSelected(mode == CameraMode.MOTION);
+        String heading = context.getString(R.string.m9_overlay_active_render);
+        if (mode != CameraMode.PHOTO && mode != CameraMode.MOTION) {
+            heading += " · " + context.getString(CameraMode.nameIds()[mode.ordinal()]);
+        }
+        int seconds = com.particlesdevs.photoncamera.m9.M9SelfTimer1A.seconds(PreferenceKeys.getCountdownTimerIndex());
+        if (seconds != 0 && (mode == CameraMode.PHOTO || mode == CameraMode.MOTION || mode == CameraMode.NIGHT)) {
+            heading += " · " + seconds + "s";
+        }
+        if (!heading.contentEquals(activeRender.getText())) activeRender.setText(heading);
+        if (!enabled) dismissSurfaces();
+    }
+
+    private void mirror(int i) {
+        String value = source[i].getText().toString();
+        if (value.isEmpty()) value = "—";
+        String text = labels[i] + "\n" + value;
+        if (!text.contentEquals(controls[i].getText())) controls[i].setText(text);
+        controls[i].setSelected(source[i].isSelected() || source[i].isActivated());
+        controls[i].setRotation(source[i].getRotation());
+        controls[i].setContentDescription(labels[i] + ", " + value);
+    }
+
+    private void setAvailable(View v, boolean enabled) {
+        v.setEnabled(enabled);
+        v.setAlpha(enabled ? 1f : .45f);
+    }
+
+    private void openManual(TextView original, boolean reset) {
+        if (!allowAction() || !original.hasOnClickListeners()) return;
+        dismissSurfaces();
+        fragment.getCameraFragmentViewModel().getCameraFragmentModel().setSettingsBarVisibility(false);
+        fragment.getManualModeConsole().setPanelVisibility(true);
+        original.performClick(); // Refresh the model-bound long-click listener after a lens change.
+        if (reset) original.performLongClick();
+        refresh();
+    }
+
+    private void selectMode(CameraMode mode) {
+        if (!allowAction()) return;
+        dismissSurfaces();
+        ((CameraUIViewImpl) fragment.getCameraUIView()).selectOverlayMode(mode);
+        refresh();
+    }
+
+    private void showRenderers() {
+        if (!allowAction()) return;
+        if (renderPopup != null && renderPopup.isShowing()) { dismissSurfaces(); return; }
+        dismissSurfaces();
+        LinearLayout panel = new LinearLayout(context);
+        panel.setOrientation(LinearLayout.VERTICAL);
+        panel.setPadding(dp(14), dp(8), dp(14), dp(14));
+        int surface = 0xFF171719; // Camera chrome stays dark in both application themes.
+        GradientDrawable background = new GradientDrawable();
+        background.setColor(surface); background.setCornerRadius(dp(22));
+        panel.setBackground(background);
+        LinearLayout heading = new LinearLayout(context);
+        heading.setGravity(Gravity.CENTER_VERTICAL);
+        TextView title = text(context.getString(R.string.m9_overlay_rendering), 17);
+        title.setTypeface(null, Typeface.BOLD);
+        heading.addView(title, new LinearLayout.LayoutParams(0, dp(48), 1));
+        TextView close = text("×", 26);
+        close.setGravity(Gravity.CENTER);
+        close.setContentDescription(context.getString(R.string.m9_overlay_close));
+        close.setOnClickListener(v -> dismissSurfaces());
+        heading.addView(close, new LinearLayout.LayoutParams(dp(48), dp(48)));
+        panel.addView(heading);
+        String[] names = {"M9", "Monochrom", "M10-R", "M11"};
+        for (int row = 0; row < 2; row++) {
+            LinearLayout line = new LinearLayout(context);
+            for (int col = 0; col < 2; col++) {
+                int index = row * 2 + col;
+                boolean installed = M9OverlayPolicy.rendererAvailable(index);
+                TextView card = text(names[index] + "\n" + context.getString(installed
+                        ? R.string.m9_overlay_selected : R.string.m9_overlay_unavailable), 15);
+                card.setPadding(dp(12), dp(12), dp(8), dp(12));
+                card.setBackgroundResource(R.drawable.m9_overlay_control_bg);
+                card.setSelected(installed);
+                card.setEnabled(installed);
+                card.setAlpha(installed ? 1f : .5f);
+                card.setContentDescription(card.getText());
+                card.setOnClickListener(v -> {
+                    if (allowAction() && M9OverlayPolicy.rendererAvailable(index)) dismissSurfaces();
+                });
+                LinearLayout.LayoutParams lp = new LinearLayout.LayoutParams(0, dp(84), 1);
+                lp.setMargins(dp(3), dp(3), dp(3), dp(3));
+                line.addView(card, lp);
+            }
+            panel.addView(line);
+        }
+        TextView note = text(context.getString(R.string.m9_overlay_future_info), 12);
+        note.setPadding(dp(3), dp(12), dp(3), 0);
+        panel.addView(note);
+        int width = Math.min(root.getWidth() - dp(20), dp(420));
+        panel.measure(View.MeasureSpec.makeMeasureSpec(width, View.MeasureSpec.EXACTLY),
+                View.MeasureSpec.makeMeasureSpec(0, View.MeasureSpec.UNSPECIFIED));
+        renderPopup = new PopupWindow(panel, width, ViewGroup.LayoutParams.WRAP_CONTENT, true);
+        renderPopup.setBackgroundDrawable(background);
+        renderPopup.setOutsideTouchable(true);
+        renderPopup.setElevation(dp(12));
+        renderPopup.setInputMethodMode(PopupWindow.INPUT_METHOD_NOT_NEEDED);
+        renderPopup.showAsDropDown(renderer, renderer.getWidth() - width,
+                -renderer.getHeight() - panel.getMeasuredHeight() - dp(8));
+    }
+
+    private TextView text(String value, int sp) {
+        TextView view = new TextView(context);
+        view.setText(value); view.setTextSize(sp); view.setGravity(Gravity.CENTER_VERTICAL);
+        view.setTextColor(ContextCompat.getColorStateList(context, R.color.m9_overlay_text));
+        return view;
+    }
+
+    private void showSettings() {
+        if (!allowAction()) return;
+        dismissSurfaces();
+        String[] items = {
+                context.getString(R.string.m9_overlay_all_settings),
+                context.getString(R.string.m9_overlay_timer) + " · " + timerLabel(),
+                context.getString(R.string.m9_overlay_grid),
+                context.getString(R.string.m9_display_title),
+                context.getString(R.string.m9_overlay_flash) + " · " + context.getString(PreferenceKeys.getAeMode() == 0 ? R.string.on : R.string.off),
+                context.getString(R.string.m9_overlay_white_balance),
+                context.getString(R.string.m9_overlay_zoom_lock),
+                context.getString(R.string.m9_overlay_more_modes)};
+        settingsDialog = new MaterialAlertDialogBuilder(context)
+                .setTitle(R.string.m9_overlay_quick_controls)
+                .setItems(items, (dialog, which) -> {
+                    if (!allowAction()) return;
+                    switch (which) {
+                        case 0: fragment.cameraFragmentBinding.layoutTopbar.settingsButton.performClick(); break;
+                        case 1: showTimer(); break;
+                        case 2: root.findViewById(R.id.grid_toggle_button).performClick(); break;
+                        case 3: root.findViewById(R.id.m9_display_aids_button).performClick(); break;
+                        case 4:
+                            if (root.findViewById(R.id.flash_button).getVisibility() == View.VISIBLE) {
+                                root.findViewById(R.id.flash_button).performClick();
+                                Toast.makeText(context, context.getString(R.string.m9_overlay_flash) + " · "
+                                        + context.getString(PreferenceKeys.getAeMode() == 0 ? R.string.on : R.string.off), Toast.LENGTH_SHORT).show();
+                            } else Toast.makeText(context, R.string.m9_overlay_torch_unavailable, Toast.LENGTH_SHORT).show();
+                            break;
+                        case 5: openManual(root.findViewById(R.id.wb_option_tv), false); break;
+                        case 6: root.findViewById(R.id.zoom_lock_button).performClick(); break;
+                        case 7: showOtherModes(); break;
+                        default: break;
+                    }
+                }).setNegativeButton(android.R.string.cancel, null).create();
+        settingsDialog.show();
+    }
+
+    private String timerLabel() {
+        int seconds = com.particlesdevs.photoncamera.m9.M9SelfTimer1A.seconds(PreferenceKeys.getCountdownTimerIndex());
+        return seconds == 0 ? context.getString(R.string.off) : seconds + " s";
+    }
+
+    private void showTimer() {
+        String[] values = {context.getString(R.string.off), "2 s", "12 s"};
+        settingsDialog = new MaterialAlertDialogBuilder(context).setTitle(R.string.m9_overlay_timer)
+                .setSingleChoiceItems(values, PreferenceKeys.getCountdownTimerIndex(), (d, target) -> {
+                    if (!allowAction()) return;
+                    // Reuse the accepted timer action; at most two steps around its three states.
+                    for (int n = 0; n < 3 && PreferenceKeys.getCountdownTimerIndex() != target; n++)
+                        root.findViewById(R.id.countdown_timer_button).performClick();
+                    dismissSurfaces();
+                    refresh();
+                }).setNegativeButton(android.R.string.cancel, null).create();
+        settingsDialog.show();
+    }
+
+    private void showOtherModes() {
+        CameraMode[] modes = {CameraMode.NIGHT, CameraMode.VIDEO, CameraMode.RAWVIDEO, CameraMode.UNLIMITED};
+        String[] names = new String[modes.length];
+        for (int i = 0; i < modes.length; i++) names[i] = context.getString(CameraMode.nameIds()[modes[i].ordinal()]);
+        settingsDialog = new MaterialAlertDialogBuilder(context).setTitle(R.string.m9_overlay_more_modes)
+                .setItems(names, (d, i) -> selectMode(modes[i]))
+                .setNegativeButton(android.R.string.cancel, null).create();
+        settingsDialog.show();
+    }
+
+    private void dismissSurfaces() {
+        if (renderPopup != null) renderPopup.dismiss();
+        renderPopup = null;
+        if (settingsDialog != null) settingsDialog.dismiss();
+        settingsDialog = null;
+    }
+
+    private int dp(int value) { return Math.round(value * context.getResources().getDisplayMetrics().density); }
+
+    @Override public void close() {
+        stop();
+        for (int i = 0; i < source.length; i++) source[i].removeTextChangedListener(watchers[i]);
+    }
+}

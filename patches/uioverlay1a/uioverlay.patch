+package com.particlesdevs.photoncamera.ui.camera;
+
+import com.particlesdevs.photoncamera.api.CameraMode;
+
+/** UI-only policy. No renderer, output, exposure or saved mode ordinals are changed. */
+final class M9OverlayPolicy {
+    private M9OverlayPolicy() {}
+
+    static CameraMode primaryMode(boolean motion) {
+        return motion ? CameraMode.MOTION : CameraMode.PHOTO;
+    }
+
+    static boolean controlsAvailable(boolean ready, boolean burst, boolean processing,
+                                     boolean countdown, boolean bracket, boolean recording,
+                                     int pendingSaves) {
+        return ready && !burst && !processing && !countdown && !bracket && !recording
+                && pendingSaves == 0;
+    }
+
+    static boolean rendererAvailable(int index) {
+        return index == 0; // M9 only. Future cards never change the active renderer.
+    }
+}

+public class M9OverlayPolicyTest {
+    @Test public void visibleOrderDoesNotReinterpretSavedPhotonModes() {
+        assertEquals(CameraMode.PHOTO, M9OverlayPolicy.primaryMode(false));
+        assertEquals(CameraMode.MOTION, M9OverlayPolicy.primaryMode(true));
+        assertEquals(CameraMode.MOTION, CameraMode.valueOf(2));
+        assertEquals(CameraMode.PHOTO, CameraMode.valueOf(3));
+        assertEquals(6, CameraMode.values().length);
+    }
+
+    @Test public void futureAndInvalidRenderersCannotBeSelected() {
+        assertTrue(M9OverlayPolicy.rendererAvailable(0));
+        for (int renderer : new int[]{-1, 1, 2, 3, 4, Integer.MAX_VALUE})
+            assertFalse(M9OverlayPolicy.rendererAvailable(renderer));
+    }
+
+    @Test public void controlsWaitThroughCountdownCaptureAndFinalPublication() {
+        assertTrue(allowed(true, false, false, false, false, false, 0));
+        assertFalse(allowed(false, false, false, false, false, false, 0)); // opening camera
+        assertFalse(allowed(true, false, false, true, false, false, 0)); // timer before shot
+        assertFalse(allowed(true, true, false, false, false, false, 0)); // burst gate
+        assertFalse(allowed(true, false, true, false, false, false, 0)); // processing
+        assertFalse(allowed(true, false, false, false, true, false, 0)); // between bracket shots
+        assertFalse(allowed(true, false, false, false, false, false, 2)); // saving two outputs
+        assertFalse(allowed(true, false, false, false, false, false, 1)); // final output pending
+        assertTrue(allowed(true, false, false, false, false, false, 0)); // publication complete
+    }
+
+    @Test public void recordingKeepsModeAndSettingsControlsLocked() {
+        assertFalse(allowed(true, false, false, false, false, true, 0));
+    }
+
+    private boolean allowed(boolean ready, boolean burst, boolean processing, boolean timer,
+                            boolean bracket, boolean recording, int pending) {
+        return M9OverlayPolicy.controlsAvailable(ready, burst, processing, timer, bracket, recording, pending);
+    }
+}

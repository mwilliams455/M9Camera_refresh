+    }
+
+    public void resetSamples() {
+        previousSample=currentSample=singleAt=0;
+        single=null;
+    }
+
+    public void beginSample(long frame) {
+        previousSample=currentSample;
+        currentSample=frame;
+    }
+
+    /** Only a face measured on two consecutive, upright preview samples can use
+     * the smaller head-to-body geometry. A skipped or stale sample breaks the chain. */
+    public boolean repeatedUpright(Box head,long frame) {
+        if (frame!=currentSample || head==null || !head.face) return false;
+        boolean successive=single!=null && singleAt==previousSample && frame>singleAt
+                && frame-singleAt<=AutomaticSubjectSelection.MAX_AGE_NS;
+        boolean matched=false;
+        if (successive) {
+            float w=Math.max(0,Math.min(single.right,head.right)-Math.max(single.left,head.left));
+            float h=Math.max(0,Math.min(single.bottom,head.bottom)-Math.max(single.top,head.top));
+            float area=(single.right-single.left)*(single.bottom-single.top)
+                    +(head.right-head.left)*(head.bottom-head.top)-w*h;
+            matched=w*h>=.40f*area;
+        }
+        single=head;
+        singleAt=frame;
+        return matched;
+    }
+
+    public static int upperBodyMatches(Box head,List<Box> bodies) {
+        int matches=0;
+        float w=head.right-head.left, h=head.bottom-head.top;
+        for (Box body : bodies) {
+            if (body==null || body.face || body.type!=ClassId.PERSON)
+                continue;
+            float bw=body.right-body.left, bh=body.bottom-body.top;
+            if (head.cx()>=body.left && head.cx()<=body.right
+                    && head.cy()>=body.top-.20f*h && head.cy()<=body.top+.38f*bh
+                    && w>=.12f*bw && w<=.85f*bw && h>=.09f*bh && h<=.65f*bh) matches++;
+        }
+        return matches;

@@ -0,0 +1,56 @@
+package com.particlesdevs.photoncamera.ui.camera;
+
+import com.particlesdevs.photoncamera.control.subject.AutomaticSubjectSelection;
+import com.particlesdevs.photoncamera.control.subject.AutomaticSubjectSelection.Box;
+import com.particlesdevs.photoncamera.control.subject.SceneHeads;
+import com.particlesdevs.photoncamera.control.tracking.SubjectAnchorPolicy.Candidate;
+import java.util.Arrays;
+import java.util.Collections;
+import org.junit.Test;
+import static org.junit.Assert.*;
+
+public class RepeatedFaceSupportTest {
+    private static final long STEP=200_000_000L;
+    private final SceneHeads scene=new SceneHeads();
+    private static Box head(int x,int y) {
+        return SceneHeads.decode(new float[]{x,y,50,60,x+13,y+17,x+37,y+17,x+25,y+31,
+                x+15,y+44,x+35,y+44,.9f},400,400,0);
+    }
+    private boolean sample(long frame,Box h) {
+        scene.beginSample(frame);
+        return scene.repeatedUpright(h,frame);
+    }
+    private static Box body(String type,float l,float t,float r,float b) {
+        return Box.fromBody(new Candidate(type,.8f,l,t,r,b));
+    }
+    @Test public void onlyAdjacentFreshMeasurementsOfSameHeadQualify() {
+        assertFalse(sample(STEP,head(100,80)));
+        assertTrue(sample(2*STEP,head(104,78)));
+        scene.beginSample(3*STEP);
+        assertFalse(sample(4*STEP,head(104,78)));
+        assertFalse(sample(5*STEP,head(250,60)));
+        assertFalse(sample(7*STEP,head(250,60)));
+        scene.resetSamples();
+        assertFalse(sample(8*STEP,head(250,60)));
+    }
+    @Test public void repeatedSmallHeadCanUseOnePersonAtTheCorrectHeight() {
+        Box h=head(100,80), person=body("person",.12f,.14f,.62f,.96f);
+        assertFalse(SceneHeads.supportedByOnePerson(h,Collections.singletonList(
+                new Candidate("person",.8f,.12f,.14f,.62f,.96f))));
+        assertEquals(1,SceneHeads.upperBodyMatches(h,Collections.singletonList(person)));
+        assertEquals(2,SceneHeads.upperBodyMatches(h,Arrays.asList(person,person)));
+        assertEquals(0,SceneHeads.upperBodyMatches(head(100,240),Collections.singletonList(person)));
+        assertEquals(0,SceneHeads.upperBodyMatches(h,Arrays.asList(
+                body("dog",.12f,.14f,.62f,.96f),body("person",.7f,.1f,1f,.9f),h)));
+    }
+    @Test public void ordinarySelectionStillRequiresFreshConfirmationBeforeAiming() {
+        AutomaticSubjectSelection selection=new AutomaticSubjectSelection();
+        Box h=head(100,80);
+        assertSame(h,selection.observe(STEP,STEP,Collections.singletonList(h)));
+        assertFalse(selection.mayAim());
+        assertSame(h,selection.observe(2*STEP,2*STEP,Collections.singletonList(h)));
+        assertTrue(selection.mayAim());
+        assertNull(selection.observe(3*STEP,5*STEP,Collections.singletonList(h)));
+        assertFalse(selection.mayAim());
+    }
+}

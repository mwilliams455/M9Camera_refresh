+++ b/app/src/main/java/com/particlesdevs/photoncamera/m9/M9DiagnosticPublicWriter1A.java
@@ -0,0 +1,110 @@
+package com.particlesdevs.photoncamera.m9;
+
+import java.io.IOException;
+import java.io.InputStream;
+import java.io.OutputStream;
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.util.concurrent.atomic.AtomicLong;
+import java.util.function.BooleanSupplier;
+
+/** Diagnostic transport only. A failed attempt never consumes the private payload. */
+final class M9DiagnosticPublicWriter1A {
+    static final String REVISION = "M9DIAGEXPORT1A_DIRECTFIRST";
+    private static final int COPY_BUFFER_BYTES = 64 * 1024;
+
+    interface Opener { OutputStream open(Path target) throws IOException; }
+    private interface Payload { void write(OutputStream output) throws IOException; }
+
+    private final Opener direct;
+    private final Opener fallback;
+    final AtomicLong directWrites = new AtomicLong();
+    final AtomicLong directFailures = new AtomicLong();
+    final AtomicLong fallbackWrites = new AtomicLong();
+    final AtomicLong fallbackFailures = new AtomicLong();
+    final AtomicLong directOpenNs = new AtomicLong();
+    final AtomicLong fallbackOpenNs = new AtomicLong();
+    final AtomicLong transferNs = new AtomicLong();
+    final AtomicLong lastDirectOpenNs = new AtomicLong();
+    final AtomicLong lastFallbackOpenNs = new AtomicLong();
+    final AtomicLong lastTransferNs = new AtomicLong();
+    final AtomicLong lastTotalNs = new AtomicLong();
+    volatile String lastRoute = "none";
+
+    M9DiagnosticPublicWriter1A(Opener direct, Opener fallback) {
+        this.direct = direct;
+        this.fallback = fallback;
+    }
+
+    boolean write(Path target, byte[] bytes, BooleanSupplier enabled) throws IOException {
+        return persist(target, output -> output.write(bytes), enabled);
+    }
+
+    boolean stream(Path target, Path source, BooleanSupplier enabled) throws IOException {
+        // Each attempt reopens the source at byte zero, including after a partial write.
+        return persist(target, output -> {
+            try (InputStream input = Files.newInputStream(source)) {
+                byte[] buffer = new byte[COPY_BUFFER_BYTES];
+                int count;
+                while ((count = input.read(buffer)) != -1) {
+                    if (count > 0) output.write(buffer, 0, count);
+                }
+            }
+        }, enabled);
+    }
+
+    private boolean persist(Path target, Payload payload, BooleanSupplier enabled) throws IOException {
+        if (!enabled.getAsBoolean()) return false;
+        long started = System.nanoTime();
+        IOException directError;
+        try {
+            try {
+                attempt(target, payload, direct, true);
+                directWrites.incrementAndGet();
+                lastRoute = "direct_filesystem";
+                return true;
+            } catch (IOException | SecurityException error) {
+                directFailures.incrementAndGet();
+                directError = new IOException("Diagnostic direct write failed", error);
+            }
+            // An in-flight write may finish after pause; never start another route then.
+            if (!enabled.getAsBoolean()) return false;
+            try {
+                attempt(target, payload, fallback, false);
+                fallbackWrites.incrementAndGet();
+                lastRoute = "saf_fallback";
+                return true;
+            } catch (IOException | SecurityException error) {
+                fallbackFailures.incrementAndGet();
+                IOException failure = new IOException("Diagnostic direct and SAF writes failed", error);
+                failure.addSuppressed(directError);
+                throw failure;
+            }
+        } finally {
+            lastTotalNs.set(System.nanoTime() - started);
+        }
+    }
+
+    private void attempt(Path target, Payload payload, Opener opener, boolean isDirect) throws IOException {
+        long opened = System.nanoTime();
+        OutputStream output;
+        try {
+            output = opener.open(target);
+            if (output == null) throw new IOException("No output stream for " + target);
+        } finally {
+            long elapsed = System.nanoTime() - opened;
+            (isDirect ? directOpenNs : fallbackOpenNs).addAndGet(elapsed);
+            (isDirect ? lastDirectOpenNs : lastFallbackOpenNs).set(elapsed);
+        }
+        long started = System.nanoTime();
+        try (OutputStream owned = output) {
+            payload.write(owned);
+            owned.flush();
+        } finally {
+            // Includes source opening, transfer, flush and close; not CPU-only time.
+            long elapsed = System.nanoTime() - started;
+            transferNs.addAndGet(elapsed);
+            lastTransferNs.set(elapsed);
+        }
+    }
+}

+    private void checkDogFace(long ticket, TrackingGeometry g, long owner, Box face, long frame) {
+        if (dogFaceBusy || !speciesLabel.canClassify()) return;
+        // Inference outlives this preview. Reuse one private snapshot until both workers finish.
+        try {
+            if (dogFaceInput == null || dogFaceInput.isRecycled() || dogFaceInput.getWidth() != bitmap.getWidth()
+                    || dogFaceInput.getHeight() != bitmap.getHeight()) {
+                if (dogFaceInput != null) dogFaceInput.recycle();
+                dogFaceInput = Bitmap.createBitmap(bitmap.getWidth(),bitmap.getHeight(),Bitmap.Config.ARGB_8888);
+            }
+            new Canvas(dogFaceInput).drawBitmap(bitmap,null,
+                    new Rect(0,0,bitmap.getWidth(),bitmap.getHeight()),null);
+        } catch (RuntimeException | OutOfMemoryError unavailable) {
+            return;
+        }
+        final Bitmap snapshot = dogFaceInput;
+        dogFaceBusy = speciesLabel.classifyCrop(overlay.getContext(),snapshot,face,(species,stage) -> {
+            long now = SystemClock.elapsedRealtimeNanos();
+            if (!accepts(ticket,g) || owner != automatic.selectionId() || now-frame > AutomaticSubjectSelection.MAX_AGE_NS) {
+                dogFaceBusy = false;
+                return;
+            }
+            if (species != SubjectAnchorPolicy.ClassId.DOG) {
+                automatic.recordDogFace(owner,face,null,frame,now);
+                dogFaceBusy = false;
+                return;
+            }
+            objectWorker.execute(() -> {
+                Box dog = null;
+                try {
+                    if (objects != null && !objectsUnavailable
+                            && SystemClock.elapsedRealtimeNanos()-frame < AutomaticSubjectSelection.MAX_AGE_NS)
+                        dog = objects.dogAroundFace(snapshot,face,frame);
+                } catch (RuntimeException | LinkageError | OutOfMemoryError unavailable) {
+                    // A failed optional check contributes no dog evidence.
+                }
+                final Box verified = dog;
+                main.post(() -> {
+                    dogFaceBusy = false;
+                    if (!accepts(ticket,g) || owner != automatic.selectionId()) return;
+                    long completed = SystemClock.elapsedRealtimeNanos();
+                    automatic.recordDogFace(owner,face,verified,frame,completed);
+                    if (headTrace != null) headTrace.dogFace(frame,owner,verified != null,completed);
+                });
+            });
+        });

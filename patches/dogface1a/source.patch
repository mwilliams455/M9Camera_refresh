+        dogEvidenceRepeated = dogFaceOwner == owner && frame-dogEvidenceFrame <= HOLD_NS
+                && sameFace(face,dogEvidenceFace) && samePet(dog,dogEvidenceBody)
+                && dogContainsFace(dog,face);

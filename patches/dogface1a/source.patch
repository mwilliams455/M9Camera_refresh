+        dogEvidenceFace = face;
+        dogEvidenceBody = dogContainsFace(dog,face) ? dog : null;
+    }
+
+    /** Correct only the face that actually won this new frame. Other people remain selectable. */
+    public Box correctDogFace(Box selected, long frame, long now) {
+        if (!dogEvidenceRepeated || selectionId != dogFaceOwner || selected != active
+                || frame != lastFrame || frame < dogEvidenceFrame || now < frame
+                || now-dogEvidenceFrame > MAX_AGE_NS || !sameFace(selected,dogEvidenceFace)
+                || !dogContainsFace(dogEvidenceBody,selected)) return null;
+        active = dogEvidenceBody;
+        clearDogFaceEvidence();
+        selectionId++;
+        hits = 1;
+        confirmed = lastWasRecovery = false;
+        challenger = pendingLowerBody = null;

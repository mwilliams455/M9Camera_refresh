+package com.particlesdevs.photoncamera.control.subject;
+
+import com.particlesdevs.photoncamera.control.subject.AutomaticSubjectSelection.Box;
+import com.particlesdevs.photoncamera.control.tracking.SubjectAnchorPolicy.ClassId;
+import java.util.Arrays;
+import java.util.Collections;
+import org.junit.Test;
+import static org.junit.Assert.*;
+
+public class DogFaceCorrectionTest {
+    private static final long MS = 1_000_000L;
+    private final AutomaticSubjectSelection selection = new AutomaticSubjectSelection();
+    private final Box head = Box.fromHead(.40f,.27f,.58f,.45f,0);
+    private final Box person = Box.fromHead(.11f,.32f,.25f,.49f,0);
+    private final Box dog = Box.verifiedPet(ClassId.DOG,.31f,.19f,.80f,.89f);
+
+    private void probe(long ms, Box result) {
+        long frame = ms*MS;
+        assertSame(head,selection.observe(frame,frame,Collections.singletonList(head)));
+        selection.recordDogFace(selection.selectionId(),head,result,frame,frame+50*MS);
+    }
+
+    private Box next(long ms) {
+        long frame=ms*MS;
+        Box chosen=selection.observe(frame,frame,Arrays.asList(head,person));
+        return selection.correctDogFace(chosen,frame,frame);
+    }
+
+    @Test public void promotionChangesTargetAndRequiresAnotherDogObservationToAim() {
+        probe(1000,dog);
+        assertNull(next(1100));
+        probe(1200,dog);
+        long previousOwner=selection.selectionId();
+        assertSame(dog,next(1400));
+        assertNotEquals(previousOwner,selection.selectionId());
+        assertFalse(selection.mayAim());
+        assertSame(dog,selection.observe(1600*MS,1600*MS,Arrays.asList(person,dog)));
+        assertTrue(selection.mayAim());
+        assertSame(person,selection.observe(2400*MS,2400*MS,Collections.singletonList(person)));
+    }
+
+    @Test public void conflictingAndSeparatedVotesCannotPromote() {
+        probe(1000,dog); probe(1200,null); probe(1400,dog);
+        assertNull(next(1500));
+        probe(2200,dog);
+        assertNull(next(2300));
+    }
+
+    @Test public void staleDuplicateAndWrongOwnerResultsCannotConfirm() {
+        probe(1000,dog);
+        long owner=selection.selectionId();
+        selection.recordDogFace(owner,head,dog,1000*MS,1100*MS);
+        selection.recordDogFace(owner+1,head,dog,1100*MS,1150*MS);
+        selection.recordDogFace(owner,head,dog,1100*MS,1500*MS);
+        assertNull(next(1500));
+        probe(1600,dog);
+        assertNull(next(1980));
+    }
+
+    @Test public void anotherFaceAndAnUnenclosedHeadCannotPromote() {
+        probe(1000,dog);
+        selection.recordDogFace(selection.selectionId(),person,dog,1100*MS,1150*MS);
+        assertNull(next(1200));
+        Box otherBody=Box.verifiedPet(ClassId.DOG,0,.1f,.3f,.8f);
+        probe(1300,otherBody); probe(1500,dog);
+        assertNull(next(1600));
+    }
+
+    @Test public void catAndResetCannotCarryDogEvidence() {
+        Box cat=Box.verifiedPet(ClassId.CAT,dog.left,dog.top,dog.right,dog.bottom);
+        probe(1000,cat); probe(1200,dog);
+        assertNull(next(1300));
+        probe(1400,dog);
+        selection.reset();
+        probe(1500,dog);
+        assertNull(next(1600));
+    }
+}

+    private static void resetTargetStability1A(boolean clearAccepted) {
+        targetStabilityRawEv=0;targetStabilityPendingEv=Double.NaN;
+        targetStabilityConfirmations=0;targetStabilityRequiredConfirmations=0;
+        targetStabilityAcceptedThisSample=false;targetStabilityReason="reset";
+        if(clearAccepted) {targetStabilityHaveAccepted=false;targetStabilityAcceptedEv=0;}
+    }
+    private static double stabilizePhotographicTarget1A(double rawTarget,double current,
+            boolean fresh,boolean hardSafety) {
+        targetStabilityRawEv=rawTarget;targetStabilityAcceptedThisSample=false;
+        if(!fresh) {
+            targetStabilityReason="no_fresh_sample";
+            return targetStabilityHaveAccepted?targetStabilityAcceptedEv:current;
+        }
+        if(hardSafety&&rawTarget<current-1e-9) {
+            targetStabilityHaveAccepted=true;targetStabilityAcceptedEv=rawTarget;
+            targetStabilityPendingEv=Double.NaN;targetStabilityConfirmations=0;
+            targetStabilityRequiredConfirmations=0;targetStabilityAcceptedThisSample=true;
+            targetStabilityReason="hard_safety_immediate";return rawTarget;
+        }
+        if(!targetStabilityHaveAccepted) {
+            targetStabilityHaveAccepted=true;targetStabilityAcceptedEv=rawTarget;
+            targetStabilityPendingEv=Double.NaN;targetStabilityConfirmations=0;
+            targetStabilityRequiredConfirmations=0;targetStabilityAcceptedThisSample=true;
+            targetStabilityReason="initial_target";return rawTarget;
+        }
+        double delta=rawTarget-targetStabilityAcceptedEv,abs=Math.abs(delta);
+        if(abs<=TARGET_STABILITY_DEADBAND_EV+1e-9) {
+            targetStabilityPendingEv=Double.NaN;targetStabilityConfirmations=0;
+            targetStabilityRequiredConfirmations=0;targetStabilityReason="deadband_hold";
+            return targetStabilityAcceptedEv;
+        }
+        if(abs>=TARGET_STABILITY_LARGE_BYPASS_EV-1e-9) {
+            targetStabilityAcceptedEv=rawTarget;targetStabilityPendingEv=Double.NaN;
+            targetStabilityConfirmations=0;targetStabilityRequiredConfirmations=0;
+            targetStabilityAcceptedThisSample=true;targetStabilityReason="large_transition_immediate";
+            return rawTarget;
+        }
+        int required=abs<=TARGET_STABILITY_SMALL_DELTA_EV+1e-9
+                ?TARGET_STABILITY_SMALL_CONFIRMATIONS:TARGET_STABILITY_MEDIUM_CONFIRMATIONS;
+        if(!Double.isFinite(targetStabilityPendingEv)
+                ||Math.abs(rawTarget-targetStabilityPendingEv)>TARGET_STABILITY_DEADBAND_EV+1e-9) {
+            targetStabilityPendingEv=rawTarget;targetStabilityConfirmations=1;
+        } else targetStabilityConfirmations++;
+        targetStabilityRequiredConfirmations=required;
+        if(targetStabilityConfirmations>=required) {
+            targetStabilityAcceptedEv=rawTarget;targetStabilityPendingEv=Double.NaN;
+            targetStabilityConfirmations=0;targetStabilityRequiredConfirmations=0;
+            targetStabilityAcceptedThisSample=true;targetStabilityReason="persistent_target_accepted";
+            return rawTarget;
+        }
+        targetStabilityReason="pending_persistence";return targetStabilityAcceptedEv;
+    }

+                        ?targetStabilityPendingEv:JSONObject.NULL)
+                .put("aeTargetConfirmations",targetStabilityConfirmations)
+                .put("aeTargetRequiredConfirmations",targetStabilityRequiredConfirmations)
+                .put("aeTargetAcceptedThisSample",targetStabilityAcceptedThisSample)
+                .put("aeTargetStabilityReason",targetStabilityReason)
+                .put("aeTargetDeadbandEv",TARGET_STABILITY_DEADBAND_EV)
+                .put("aeTargetSmallDeltaEv",TARGET_STABILITY_SMALL_DELTA_EV)
+                .put("aeTargetSmallConfirmations",TARGET_STABILITY_SMALL_CONFIRMATIONS)
+                .put("aeTargetMediumConfirmations",TARGET_STABILITY_MEDIUM_CONFIRMATIONS)
+                .put("aeTargetLargeBypassEv",TARGET_STABILITY_LARGE_BYPASS_EV)
+                .put("aeTargetPhotographicThresholdsChanged",false);
+    }

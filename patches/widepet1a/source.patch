@@ -0,0 +1,57 @@
+package com.particlesdevs.photoncamera.control.subject;
+
+import com.particlesdevs.photoncamera.control.subject.AutomaticSubjectSelection.Box;
+import com.particlesdevs.photoncamera.control.tracking.SubjectAnchorPolicy.ClassId;
+import java.util.List;
+
+/** A large new pet needs two consecutive corroborated observations before it enters selection. */
+public final class LargePetAcquisition {
+    private Box pending;
+    private long lastFrame;
+    private static final long MAX_GAP_NS = 500_000_000L;
+
+    static boolean isLarge(float width, float height) {
+        return width*height >= .15f;
+    }
+
+    public static boolean isLargePet(Box box) {
+        return box != null && box.type != ClassId.PERSON
+                && isLarge(box.right-box.left,box.bottom-box.top);
+    }
+
+    public void reset() {
+        pending = null;
+        lastFrame = 0;
+    }
+
+    public boolean awaiting(long frame) {
+        return pending != null && frame > lastFrame && frame-lastFrame <= MAX_GAP_NS;
+    }
+
+    private static boolean isNewLargePet(Box current, Box candidate) {
+        return isLargePet(candidate) && !AutomaticSubjectSelection.samePet(current,candidate);
+    }
+
+    /** Entries are already detector/pose-verified. Never admit a lone or ambiguous first sighting. */
+    public void filter(List<Box> boxes, Box current, long frame, long now) {
+        if (frame <= lastFrame || frame <= 0 || now < frame
+                || now-frame > AutomaticSubjectSelection.MAX_AGE_NS) {
+            if (frame > lastFrame) { pending = null; lastFrame = frame; }
+            if (!boxes.isEmpty()) boxes.removeIf(box -> isNewLargePet(current,box));
+            return;
+        }
+        Box observation = null;
+        for (Box box : boxes) {
+            if (!isNewLargePet(current,box)) continue;
+            if (observation != null) {
+                observation = null;
+                break;
+            }
+            observation = box;
+        }
+        boolean confirmed = awaiting(frame) && AutomaticSubjectSelection.samePet(pending,observation);
+        pending = observation;
+        lastFrame = frame;
+        if (!confirmed && !boxes.isEmpty()) boxes.removeIf(box -> isNewLargePet(current,box));
+    }
+}

+package com.particlesdevs.photoncamera.m9.render;
+
+import org.junit.Test;
+
+import java.util.Random;
+
+import static org.junit.Assert.assertArrayEquals;
+import static org.junit.Assert.assertEquals;
+
+/** JPEGPERF346: the band-parallel gate scan must equal the original serial full-pixel loop. */
+public class M9EdgePlacementGateScanTest {
+    private static final int GRID_R = 16, GRID_C = 22, REG_R = 4, REG_C = 6, SCAN_ROWS = 64;
+
+    private static int[] partitionMap(int n, int k) {
+        int[] out = new int[n];
+        for (int cell = 0; cell < k; cell++) {
+            int a = cell * n / k;
+            int b = (cell + 1) * n / k;
+            for (int i = a; i < b; i++) out[i] = cell;
+        }
+        return out;
+    }
+
+    /** Verbatim 3.45 serial loop over a row-major ARGB raster. */
+    private static long serial(int[] argb, int width, int height, int[] gridX, int[] gridY, int[] regX, int[] regY,
+                               long[] gridSums, long[] gridCounts, long[] regionHist) {
+        final int rowsPerBlock = Math.min(SCAN_ROWS, height);
+        final int[] pixels = new int[Math.multiplyExact(width, rowsPerBlock)];
+        long pixelCount = 0L;
+        for (int y0 = 0; y0 < height; y0 += rowsPerBlock) {
+            final int rows = Math.min(rowsPerBlock, height - y0);
+            System.arraycopy(argb, y0 * width, pixels, 0, rows * width);
+            for (int ly = 0; ly < rows; ly++) {
+                final int y = y0 + ly;
+                final int gy = gridY[y];
+                final int rr = regY[y];
+                final int rowBase = ly * width;
+                for (int x = 0; x < width; x++) {
+                    final int p = pixels[rowBase + x];
+                    final int r = (p >>> 16) & 0xff;
+                    final int g = (p >>> 8) & 0xff;
+                    final int b = p & 0xff;
+                    final int yy = (4899 * r + 9617 * g + 1868 * b) >> 14;
+                    final int gi = gy * GRID_C + gridX[x];
+                    gridSums[gi] += yy;
+                    gridCounts[gi]++;
+                    final int ri = rr * REG_C + regX[x];
+                    regionHist[(ri << 8) + yy]++;
+                    pixelCount++;
+                }
+            }
+        }
+        return pixelCount;
+    }
+
+    private static void check(int width, int height, int workers, long seed) {
+        Random random = new Random(seed);
+        int[] argb = new int[width * height];
+        for (int i = 0; i < argb.length; i++) argb[i] = random.nextInt();
+        int[] gridX = partitionMap(width, GRID_C), gridY = partitionMap(height, GRID_R);
+        int[] regX = partitionMap(width, REG_C), regY = partitionMap(height, REG_R);
+        long[] s1 = new long[GRID_R * GRID_C], c1 = new long[GRID_R * GRID_C], h1 = new long[REG_R * REG_C * 256];
+        long[] s2 = s1.clone(), c2 = c1.clone(), h2 = h1.clone();
+        long n1 = serial(argb, width, height, gridX, gridY, regX, regY, s1, c1, h1);
+        long n2 = M9EdgePlacementGate1ADiagnostic.scan(
+                (dst, w, y0, rows) -> System.arraycopy(argb, y0 * w, dst, 0, rows * w),
+                width, height, gridX, gridY, regX, regY, s2, c2, h2, workers);
+        String label = width + "x" + height + " workers=" + workers;
+        assertEquals(label, n1, n2);
+        assertArrayEquals(label, s1, s2);
+        assertArrayEquals(label, c1, c2);
+        assertArrayEquals(label, h1, h2);
+    }
+
+    @Test public void bandParallelScanEqualsSerialLoop() {
+        for (int workers : new int[] {1, 2, 3, 8})
+            for (int[] size : new int[][] {{22, 16}, {23, 17}, {640, 480}, {1, 1}, {3, 200}, {517, 63}})
+                check(size[0], size[1], workers, size[0] * 131L + size[1] + workers);
+    }
+
+    @Test public void fullFrameOrientationsMatch() {
+        check(4096, 3072, M9ShadingParallel1A.WORKERS, 4096);
+        check(3072, 4096, M9ShadingParallel1A.WORKERS, 3072);
+    }
+}

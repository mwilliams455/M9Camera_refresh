+package com.particlesdevs.photoncamera.m9.render;
+
+import org.junit.Test;
+
+import java.util.Random;
+
+import static org.junit.Assert.assertArrayEquals;
+
+/** JPEGPERF346: band-parallel lens falloff must equal the 3.45 whole-frame strip loop. */
+public class M9LensFalloffBandsTest {
+    /** Emulates OpenCV Mat.get/put on a packed RGB16 frame: copy up to the buffer length, clamped at the end. */
+    private static final class ArrayIo implements M9TargetFalloff1A.RowIo {
+        final short[] frame;
+        final int width;
+        ArrayIo(short[] frame, int width) { this.frame = frame; this.width = width; }
+        @Override public int get(int y, short[] strip) {
+            int start = y * width * 3, n = Math.min(strip.length, frame.length - start);
+            System.arraycopy(frame, start, strip, 0, n);
+            return n * Short.BYTES;
+        }
+        @Override public int put(int y, short[] strip) {
+            int start = y * width * 3, n = Math.min(strip.length, frame.length - start);
+            System.arraycopy(strip, 0, frame, start, n);
+            return n * Short.BYTES;
+        }
+    }
+
+    /** Verbatim 3.45 apply() loop, against the same Mat-like adapter. */
+    private static void serial(M9TargetFalloff1A.RowIo rgb, M9TargetFalloff1A.Raster raster, int width, int height) {
+        int stripHeight = Math.min(32, height);
+        short[] strip = new short[width * stripHeight * 3];
+        for (int y = 0; y < height; y += stripHeight) {
+            int rows = Math.min(stripHeight, height - y);
+            int bytes = rows * width * 3 * Short.BYTES;
+            if (rgb.get(y, strip) != bytes) throw new IllegalStateException("Incomplete RGB16 strip");
+            raster.applyRows(strip, y, rows);
+            if (rgb.put(y, strip) != bytes) throw new IllegalStateException("Incomplete RGB16 write");
+        }
+    }
+
+    private static void check(int width, int height, int strength, int workers, long seed) {
+        Random random = new Random(seed);
+        short[] expected = new short[width * height * 3];
+        for (int i = 0; i < expected.length; i++) expected[i] = (short) random.nextInt(65536);
+        short[] actual = expected.clone();
+        M9TargetFalloff1A.Raster raster = new M9TargetFalloff1A.Raster(width, height, strength);
+        serial(new ArrayIo(expected, width), raster, width, height);
+        M9TargetFalloff1A.applyBands(new ArrayIo(actual, width), raster, width, height, workers);
+        assertArrayEquals(width + "x" + height + " strength=" + strength + " workers=" + workers, expected, actual);
+    }
+
+    @Test public void bandsEqualWholeFrameStrips() {
+        for (int workers : new int[] {1, 2, 3, 8})
+            for (int strength : new int[] {1, 50, 100})
+                for (int[] size : new int[][] {{64, 33}, {65, 100}, {1, 1}, {7, 31}, {300, 257}, {4, 1000}})
+                    check(size[0], size[1], strength, workers, size[0] * 7L + size[1] + strength + workers);
+    }
+
+    @Test public void fullFrameMatches() {
+        check(4096, 3072, 100, M9ShadingParallel1A.WORKERS, 1);
+        check(3000, 4000, 73, M9ShadingParallel1A.WORKERS, 2);
+    }
+}

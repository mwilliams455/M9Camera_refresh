diff --git a/app/src/test/java/com/particlesdevs/photoncamera/ui/camera/AutomaticSubjectAfRetryTest.java b/app/src/test/java/com/particlesdevs/photoncamera/ui/camera/AutomaticSubjectAfRetryTest.java
new file mode 100644
index 0000000..63b89a8
--- /dev/null
+++ b/app/src/test/java/com/particlesdevs/photoncamera/ui/camera/AutomaticSubjectAfRetryTest.java
@@ -0,0 +1,52 @@
+package com.particlesdevs.photoncamera.ui.camera;
+
+import android.app.Application;
+import android.os.Looper;
+import android.view.SurfaceView;
+import android.view.View;
+import com.particlesdevs.photoncamera.capture.CaptureController;
+import com.particlesdevs.photoncamera.control.subject.AutomaticSubjectSelection.Box;
+import com.particlesdevs.photoncamera.control.tracking.SubjectAnchorPolicy.Candidate;
+import com.particlesdevs.photoncamera.control.tracking.TrackingGeometry;
+import com.particlesdevs.photoncamera.ui.camera.views.TrackingFocusView;
+import java.time.Duration;
+import org.junit.Test;
+import org.junit.runner.RunWith;
+import org.robolectric.RobolectricTestRunner;
+import org.robolectric.annotation.Config;
+import org.robolectric.util.ReflectionHelpers;
+import static org.junit.Assert.assertFalse;
+import static org.mockito.Mockito.*;
+import static org.robolectric.Shadows.shadowOf;
+
+@RunWith(RobolectricTestRunner.class)
+@Config(sdk=35, application=Application.class)
+public class AutomaticSubjectAfRetryTest {
+    @Test public void transientAfFailureKeepsRecognitionAndRetriesOnFreshSubject() {
+        CameraFragment fragment=mock(CameraFragment.class);
+        CaptureController capture=mock(CaptureController.class);
+        CaptureController.TrackingFocus busy=mock(CaptureController.TrackingFocus.class);
+        CaptureController.TrackingFocus ready=mock(CaptureController.TrackingFocus.class);
+        when(fragment.getCaptureController()).thenReturn(capture);
+        when(capture.newTrackingFocus()).thenReturn(busy,ready);
+        when(ready.valid()).thenReturn(true);
+        TrackingFocusView overlay=mock(TrackingFocusView.class);
+        HumanSubjectFocusController subjects=new HumanSubjectFocusController(fragment,
+                mock(SurfaceView.class),overlay);
+        try {
+            ReflectionHelpers.setField(subjects,"boxVisible",true);
+            TrackingGeometry geometry=mock(TrackingGeometry.class);
+            Box first=Box.fromBody(new Candidate("cat",.8f,.2f,.25f,.45f,.61f));
+            Box next=Box.fromBody(new Candidate("cat",.8f,.31f,.25f,.56f,.61f));
+            subjects.updateAutomaticAf(1,geometry,first);
+            verify(busy).close();
+            assertFalse((Boolean)ReflectionHelpers.getField(subjects,"unsupported"));
+            subjects.updateAutomaticAf(1,geometry,first);
+            verify(capture,times(1)).newTrackingFocus();
+            shadowOf(Looper.getMainLooper()).idleFor(Duration.ofMillis(800));
+            subjects.updateAutomaticAf(1,geometry,next);
+            verify(ready).update(eq(geometry),eq(next.aimX),eq(next.aimY),any());
+            verify(overlay,never()).setVisibility(View.GONE);
+        } finally { subjects.close(); }
+    }
+}

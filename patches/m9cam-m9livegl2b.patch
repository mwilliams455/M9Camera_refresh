+    public static JSONObject focusSnapshot2B(CaptureRequest preview, CaptureResult result) {
+        JSONObject o = new JSONObject();
+        try {
+            o.put("revision", M9FocusContinuity2B.REVISION);
+            o.put("scope", "shutter_preview_request_and_latest_result_not_post_capture_trace");
+            if (preview != null) {
+                putNumberOrNull(o, "requestAfMode", preview.get(CaptureRequest.CONTROL_AF_MODE));
+                putNumberOrNull(o, "requestAfTrigger", preview.get(CaptureRequest.CONTROL_AF_TRIGGER));
+                putNumberOrNull(o, "requestFocusDistanceDiopters", preview.get(CaptureRequest.LENS_FOCUS_DISTANCE));
+            }
+            if (result != null) {
+                putNumberOrNull(o, "resultAfMode", result.get(CaptureResult.CONTROL_AF_MODE));
+                putNumberOrNull(o, "resultAfState", result.get(CaptureResult.CONTROL_AF_STATE));
+                putNumberOrNull(o, "resultFocusDistanceDiopters", result.get(CaptureResult.LENS_FOCUS_DISTANCE));
+                putNumberOrNull(o, "resultLensState", result.get(CaptureResult.LENS_STATE));
+                putNumberOrNull(o, "resultTimestampNs", result.get(CaptureResult.SENSOR_TIMESTAMP));
+            }
+        } catch (Exception e) {
+            Log.w(TAG, "M9LIVEGL2B focus snapshot failed: " + e);
+        }
+        return o;
+    }

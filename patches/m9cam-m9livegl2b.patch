@@ -0,0 +1,48 @@
+package com.particlesdevs.photoncamera.m9.preview;
+
+import android.hardware.camera2.CameraAccessException;
+import android.hardware.camera2.CameraCaptureSession;
+import android.hardware.camera2.CaptureRequest;
+import android.os.Handler;
+
+/** Keep focus mode/lock across RAW capture; triggers belong to one request only. */
+public final class M9FocusContinuity2B {
+    public static final String REVISION = "M9LIVEGL2B_FOCUSCONTINUITY";
+    private M9FocusContinuity2B() {}
+
+    public static boolean continuous(Integer mode) {
+        return mode != null && (mode == CaptureRequest.CONTROL_AF_MODE_CONTINUOUS_PICTURE
+                || mode == CaptureRequest.CONTROL_AF_MODE_CONTINUOUS_VIDEO);
+    }
+
+    public static boolean canTrigger(Integer mode, Float minimumFocusDistance) {
+        return mode != null && (mode == CaptureRequest.CONTROL_AF_MODE_AUTO
+                || mode == CaptureRequest.CONTROL_AF_MODE_MACRO || continuous(mode))
+                && (minimumFocusDistance == null || minimumFocusDistance > 0);
+    }
+
+    public static void prepareStill(CaptureRequest.Builder preview, CaptureRequest.Builder still) {
+        Integer mode = preview.get(CaptureRequest.CONTROL_AF_MODE);
+        if (mode != null) still.set(CaptureRequest.CONTROL_AF_MODE, mode);
+        still.set(CaptureRequest.CONTROL_AF_TRIGGER, CaptureRequest.CONTROL_AF_TRIGGER_IDLE);
+        still.set(CaptureRequest.CONTROL_AF_REGIONS, preview.get(CaptureRequest.CONTROL_AF_REGIONS));
+        // Zero diopters is a valid manual infinity setting. Do not use the last
+        // measured AF position as a manual-focus override on an automatic lens.
+        if (mode != null && mode == CaptureRequest.CONTROL_AF_MODE_OFF) {
+            Float distance = preview.get(CaptureRequest.LENS_FOCUS_DISTANCE);
+            if (distance != null) still.set(CaptureRequest.LENS_FOCUS_DISTANCE, distance);
+        }
+    }
+
+    public static void triggerOnce(CaptureRequest.Builder preview, CameraCaptureSession session,
+            CameraCaptureSession.CaptureCallback callback, Handler handler, int trigger)
+            throws CameraAccessException {
+        try {
+            preview.set(CaptureRequest.CONTROL_AF_TRIGGER, trigger);
+            session.capture(preview.build(), callback, handler);
+        } finally {
+            // Even a failed submission must not leak START/CANCEL into repeating.
+            preview.set(CaptureRequest.CONTROL_AF_TRIGGER, CaptureRequest.CONTROL_AF_TRIGGER_IDLE);
+        }
+    }
+}

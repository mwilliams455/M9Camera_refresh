@@ -0,0 +1,36 @@
+package com.particlesdevs.photoncamera.m9;
+
+import com.particlesdevs.photoncamera.settings.SettingsManager;
+import org.junit.Test;
+import org.mockito.MockMakers;
+import static org.junit.Assert.*;
+import static org.mockito.Mockito.*;
+
+public class M9OutputSettingsTest {
+    private SettingsManager settings() {
+        return mock(SettingsManager.class, withSettings().mockMaker(MockMakers.SUBCLASS));
+    }
+    @Test public void missingSettingsDisableOptionalFiles() {
+        assertFalse(M9OutputSettings.enabled(null,M9OutputSettings.UNFILTERED_DNG_KEY));
+        assertFalse(M9OutputSettings.enabled(null,M9OutputSettings.DIAGNOSTICS_KEY));
+        SettingsManager s=settings();
+        assertFalse(M9OutputSettings.enabled(s,M9OutputSettings.DIAGNOSTICS_KEY));
+        verify(s).getBoolean(SettingsManager.SCOPE_GLOBAL,M9OutputSettings.DIAGNOSTICS_KEY,false);
+    }
+    @Test public void choicesAreIndependentAndReadWithoutRestart() {
+        SettingsManager s=settings();
+        for(boolean raw:new boolean[]{false,true})for(boolean diag:new boolean[]{false,true}) {
+            when(s.getBoolean(SettingsManager.SCOPE_GLOBAL,M9OutputSettings.UNFILTERED_DNG_KEY,false)).thenReturn(raw);
+            when(s.getBoolean(SettingsManager.SCOPE_GLOBAL,M9OutputSettings.DIAGNOSTICS_KEY,false)).thenReturn(diag);
+            assertEquals(raw,M9OutputSettings.enabled(s,M9OutputSettings.UNFILTERED_DNG_KEY));
+            assertEquals(diag,M9OutputSettings.enabled(s,M9OutputSettings.DIAGNOSTICS_KEY));
+        }
+    }
+    @Test public void malformedPreferenceCannotPreventNormalCapture() {
+        SettingsManager s=settings();
+        when(s.getBoolean(SettingsManager.SCOPE_GLOBAL,M9OutputSettings.UNFILTERED_DNG_KEY,false)).thenThrow(new NumberFormatException());
+        when(s.getBoolean(SettingsManager.SCOPE_GLOBAL,M9OutputSettings.DIAGNOSTICS_KEY,false)).thenThrow(new ClassCastException());
+        assertFalse(M9OutputSettings.enabled(s,M9OutputSettings.UNFILTERED_DNG_KEY));
+        assertFalse(M9OutputSettings.enabled(s,M9OutputSettings.DIAGNOSTICS_KEY));
+    }
+}

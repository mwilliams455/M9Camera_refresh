@@ -0,0 +1,22 @@
+package com.particlesdevs.photoncamera.m9;
+
+import com.particlesdevs.photoncamera.app.PhotonCamera;
+import com.particlesdevs.photoncamera.settings.SettingsManager;
+
+/** M9OUTPUTMENU1A: optional output only; never gates capture metadata or DNG look generation. */
+public final class M9OutputSettings {
+    public static final String UNFILTERED_DNG_KEY = "pref_m9_save_unfiltered_dng";
+    public static final String DIAGNOSTICS_KEY = "pref_m9_save_diagnostic_files";
+    private M9OutputSettings() {}
+    public static boolean saveUnfilteredDng() {
+        return enabled(PhotonCamera.getSettingsManagerStatic(), UNFILTERED_DNG_KEY);
+    }
+    public static boolean diagnosticsEnabled() {
+        return enabled(PhotonCamera.getSettingsManagerStatic(), DIAGNOSTICS_KEY);
+    }
+    static boolean enabled(SettingsManager settings, String key) {
+        if (settings == null) return false;
+        try { return settings.getBoolean(SettingsManager.SCOPE_GLOBAL, key, false); }
+        catch (NumberFormatException | ClassCastException malformed) { return false; }
+    }
+}

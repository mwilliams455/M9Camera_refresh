+#include "raw16_adapter.h"
+#include <cmath>
+#include <limits>
+#include <vector>
+extern "C" int phone_noise_shaded(const uint16_t*, uint16_t*, int, int, int, double,
+    const double*, const double*, double, const float*, int, int, const double*) noexcept;
+
+extern "C" int m9_dng_noise_raw16(const uint16_t* src, size_t srcBytes,
+    uint16_t* dst, size_t dstBytes, int width, int height, int white, int scale,
+    const double* black, const double* profile, const float* grids, int gw, int gh) noexcept {
+    if (!src || !dst || !black || !profile || !grids || width<6 || height<6
+        || width>32767 || height>32767 || (width&1) || (height&1)
+        || size_t(width)*height>32000000 || white<1 || white>16383 || scale<1
+        || scale>8192 || (scale&(scale-1)) || int64_t(white)*scale>16383
+        || gw<1 || gh<1 || gw>1024 || gh>1024) return -1;
+    size_t n=size_t(width)*height, bytes=n*sizeof(uint16_t);
+    if (srcBytes<bytes || dstBytes<bytes) return -1;
+    uintptr_t a=reinterpret_cast<uintptr_t>(src), b=reinterpret_cast<uintptr_t>(dst);
+    if ((a|b)%alignof(uint16_t) || a>std::numeric_limits<uintptr_t>::max()-bytes
+        || b>std::numeric_limits<uintptr_t>::max()-bytes) return -1;
+    if (a<b+bytes && b<a+bytes) return -2;
+    double scaledBlack[4];
+    for (int c=0;c<4;c++) {
+        if (!std::isfinite(black[c]) || black[c]<0 || black[c]>=white
+            || std::floor(black[c])!=black[c]) return -3;
+        scaledBlack[c]=black[c]*scale;
+    }
+    try {
+        std::vector<uint16_t> expanded(n);
+        for (size_t i=0;i<n;i++) {
+            if (src[i]>white) return -4;
+            expanded[i]=uint16_t(src[i]*scale);
+        }
+        double geometry[4]={1.0/(gh>1?gh-1:1),1.0/(gw>1?gw-1:1),0,0};
+        return phone_noise_shaded(expanded.data(),dst,width,height,1,1.0,profile,
+            scaledBlack,white*scale,grids,gh,gw,geometry);
+    } catch (...) { return -5; }
+}

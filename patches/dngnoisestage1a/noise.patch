+#include "raw16_adapter.h"
+#include <jni.h>
+#include <vector>
+
+extern "C" JNIEXPORT jint JNICALL
+Java_com_particlesdevs_photoncamera_processing_M9DngNoiseStage_filterNative(
+    JNIEnv* env, jclass, jobject src, jobject dst, jint w, jint h, jint white, jint scale,
+    jdoubleArray black, jdoubleArray profile, jfloatArray grids, jint gw, jint gh) {
+    if (!src || !dst || !black || !profile || !grids || gw<1 || gh<1 || gw>1024 || gh>1024
+        || env->GetArrayLength(black)!=4 || env->GetArrayLength(profile)!=8
+        || env->GetArrayLength(grids)!=4*gw*gh) return -1;
+    auto in=static_cast<const uint16_t*>(env->GetDirectBufferAddress(src));
+    auto out=static_cast<uint16_t*>(env->GetDirectBufferAddress(dst));
+    jlong inBytes=env->GetDirectBufferCapacity(src), outBytes=env->GetDirectBufferCapacity(dst);
+    if (!in || !out || inBytes<0 || outBytes<0) return -1;
+    try {
+        double b[4], p[8]; std::vector<float> g(size_t(4)*gw*gh);
+        env->GetDoubleArrayRegion(black,0,4,b);
+        if (env->ExceptionCheck()) return -1;
+        env->GetDoubleArrayRegion(profile,0,8,p);
+        if (env->ExceptionCheck()) return -1;
+        env->GetFloatArrayRegion(grids,0,jsize(g.size()),g.data());
+        if (env->ExceptionCheck()) return -1;
+        return m9_dng_noise_raw16(in,size_t(inBytes),out,size_t(outBytes),w,h,white,scale,b,p,g.data(),gw,gh);
+    } catch (...) { return -5; }
+}

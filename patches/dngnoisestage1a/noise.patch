+// Experimental phone adapter 02: virtual shading -> noise -> inverse shading.
+// Recovered M9 same-phase kernels/pass order, adapted Camera2 noise thresholds.
+// This is not a bit-exact Leica firmware implementation or production default.
+#include <algorithm>
+#include <cmath>
+#include <cstdint>
+#include <cstring>
+#include <limits>
+#include <vector>
+
+// Four phase-major grids, sharing geometry. Normalized DNG pixel-centre coords.
+static double gain_at(const float* grids,int gh,int gw,const double* geo,
+                      int width,int height,int y,int x) {
+    const int c=(y&1)*2+(x&1);
+    double fy=std::clamp(((y+0.5)/height-geo[2])/geo[0],0.0,double(gh-1));
+    double fx=std::clamp(((x+0.5)/width-geo[3])/geo[1],0.0,double(gw-1));
+    int iy=int(fy),ix=int(fx),jy=std::min(iy+1,gh-1),jx=std::min(ix+1,gw-1);
+    fy-=iy;fx-=ix;const float* g=grids+size_t(c)*gh*gw;
+    double a=g[iy*gw+ix]*(1-fy)+g[jy*gw+ix]*fy;
+    double b=g[iy*gw+jx]*(1-fy)+g[jy*gw+jx]*fy;
+    return a*(1-fx)+b*fx;
+}
+
+extern "C" int phone_noise_shaded(const uint16_t* src,uint16_t* dst,
+        int width,int height,int mode,double strength,const double* profile,
+        const double* black,double white,const float* grids,int gh,int gw,
+        const double* geo) noexcept {
+    if(!src||!dst||!profile||!black||!grids||!geo||width<1||height<1||width>32767||height>32767
+       ||gh<1||gw<1||gh>1024||gw>1024||mode<0||mode>2
+       ||!std::isfinite(strength)||strength<0||strength>4
+       ||!std::isfinite(white)||white<=0||white>65535) return -1;
+    int border=2*mode;
+    if(mode&&(width<=2*border||height<=2*border)) return -1;
+    for(int i=0;i<4;i++) {
+        if(!std::isfinite(profile[2*i])||profile[2*i]<=0||profile[2*i]>1
+           ||!std::isfinite(profile[2*i+1])||profile[2*i+1]<0||profile[2*i+1]>1
+           ||!std::isfinite(black[i])||black[i]<0||black[i]>=white||!std::isfinite(geo[i]))return -3;
+    }
+    if(geo[0]<=0||geo[1]<=0)return -3;
+    for(size_t i=0;i<size_t(4)*gh*gw;i++)
+        if(!std::isfinite(grids[i])||grids[i]<1.0/64||grids[i]>64)return -3;
+    const size_t count=size_t(width)*height,bytes=count*sizeof(uint16_t);
+    const uintptr_t a=reinterpret_cast<uintptr_t>(src),b=reinterpret_cast<uintptr_t>(dst);
+    if(a>std::numeric_limits<uintptr_t>::max()-bytes||b>std::numeric_limits<uintptr_t>::max()-bytes)return -1;
+    if(a<b+bytes&&b<a+bytes)return -2;
+    for(size_t i=0;i<count;i++)if(src[i]>white)return -4;
+    if(!mode||strength==0){std::memcpy(dst,src,bytes);return 0;}
+    constexpr int rows=64;
+    const int taps=mode==1?3:5,denom=mode==1?4:8;
+    const int w1[3]={1,2,1},w2[5]={1,2,2,2,1};const int* weights=mode==1?w1:w2;
+    const double center=mode==1?0.25:0.0625;
+    try {
+        const size_t n=size_t(rows+2*border)*width;
+        std::vector<double> value(n),variance(n),gain(n),first(n),firstVar(n);
+        std::vector<uint8_t> valid(n);
+        std::memcpy(dst,src,bytes);
+        for(int y0=border;y0<height-border;y0+=rows) {
+            int y1=std::min(y0+rows,height-border),top=y0-border,bottom=y1+border;
+            for(int y=top;y<bottom;y++)for(int x=0;x<width;x++) {
+                size_t i=size_t(y-top)*width+x;int c=(y&1)*2+(x&1);
+                double g=gain_at(grids,gh,gw,geo,width,height,y,x),range=white-black[c];
+                double raw=src[size_t(y)*width+x],signal=(raw-black[c])/range;
+                gain[i]=g;value[i]=black[c]+g*(raw-black[c]);
+                variance[i]=g*g*range*range*(profile[2*c]*std::max(0.0,signal)+profile[2*c+1]);
+                // Exclude censored support plus a one-code margin in both
+                // encoded input and normalized reader domains. No highlight
+                // reconstruction or black clipping is inferred from the model.
+                const double margin=std::max(1.0,(g+1)*range/65535.0);
+                valid[i]=raw>black[c]+margin&&raw<white-margin
+                    &&value[i]>black[c]+margin&&value[i]<white-margin;
+            }
+            // Preserve recovered separable pass order and floor each value
+            // pass. Variance uses squared weights and is not rounded.
+            if(mode==1) {
+                for(int y=top;y<bottom;y++)for(int x=border;x<width-border;x++) {
+                    size_t i=size_t(y-top)*width+x;double v=0,var=0;
+                    for(int k=0;k<taps;k++){int dx=2*k-border;v+=weights[k]*std::floor(value[i+dx]);var+=weights[k]*weights[k]*variance[i+dx];}
+                    first[i]=std::floor(v/denom);firstVar[i]=var/(denom*denom);
+                }
+            } else {
+                for(int y=y0;y<y1;y++)for(int x=0;x<width;x++) {
+                    size_t i=size_t(y-top)*width+x;double v=0,var=0;
+                    for(int k=0;k<taps;k++){int dy=2*k-border;size_t j=size_t(y-top+dy)*width+x;v+=weights[k]*std::floor(value[j]);var+=weights[k]*weights[k]*variance[j];}
+                    first[i]=std::floor(v/denom);firstVar[i]=var/(denom*denom);
+                }
+            }
+            for(int y=y0;y<y1;y++)for(int x=border;x<width-border;x++) {
+                size_t i=size_t(y-top)*width+x,output=size_t(y)*width+x;
+                bool safe=true;
+                for(int ky=0;ky<taps&&safe;ky++)for(int kx=0;kx<taps;kx++)
+                    if(!valid[size_t(y-top+2*ky-border)*width+x+2*kx-border]){safe=false;break;}
+                if(!safe)continue;
+                double v=0,var=0;
+                for(int k=0;k<taps;k++) {
+                    int offset=2*k-border;
+                    size_t j=mode==1?size_t(y-top+offset)*width+x:i+offset;
+                    v+=weights[k]*first[j];var+=weights[k]*weights[k]*firstVar[j];
+                }
+                double smooth=std::floor(v/denom),resVar=var/(denom*denom)+(1-2*center)*variance[i];
+                const double q=std::floor(value[i]);
+                double distance=std::abs(q-smooth),threshold=strength*std::sqrt(resVar);
+                if(distance==0||!(threshold>distance))continue;
+                double alpha=1-distance/threshold;
+                double filtered=std::floor(q+alpha*(smooth-q));
+                // Transfer only the integer noise-stage residual. Keep the
+                // original shading fraction so a no-op/flat signal cannot
+                // acquire a rounding-only change during inverse shading.
+                int c=(y&1)*2+(x&1);
+                double candidate=std::floor(src[output]+(filtered-q)/gain[i]+0.5);
+                double projected=black[c]+gain[i]*(candidate-black[c]);
+                const double margin=std::max(1.0,(gain[i]+1)*(white-black[c])/65535.0);
+                if(candidate>black[c]+margin&&candidate<white-margin
+                   &&projected>black[c]+margin&&projected<white-margin)
+                    dst[output]=uint16_t(candidate);
+            }
+        }
+    } catch(...) {return -5;}
+    return 0;
+}

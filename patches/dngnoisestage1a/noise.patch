+package com.particlesdevs.photoncamera.processing;
+
+import org.junit.Test;
+import java.nio.ByteBuffer;
+import java.nio.ByteOrder;
+import static org.junit.Assert.*;
+
+public class M9DngNoiseStageTest {
+    private final double[] profile={.0004,.000001,.00038,.0000008,.00039,.0000009,.00042,.0000011};
+    private M9DngNoiseStage.Calibration calibration(int cfa, int white, float[] black,
+                                                   boolean geometry, boolean owned) {
+        return M9DngNoiseStage.prepare(16,12,cfa,white,black,profile,
+                new float[]{1,2,3,4,5,6,7,8},2,1,geometry,owned);
+    }
+    private M9DngNoiseStage.Calibration good() {
+        return calibration(0,1023,new float[]{64,65,66,67},true,true);
+    }
+    private ByteBuffer source() {
+        ByteBuffer b=ByteBuffer.allocateDirect(384).order(ByteOrder.LITTLE_ENDIAN);
+        for(int i=0;i<192;i++) b.putShort(i*2,(short)(100+i));
+        return b;
+    }
+    private void rejects(Runnable task) {
+        try {task.run();fail("expected unsupported calibration");}
+        catch (IllegalArgumentException expected) {assertNotNull(expected.getMessage());}
+    }
+
+    @Test public void mapsAllCfasIncludingBothDistinctGreens() {
+        float[][] expected={{1,5,2,6,3,7,4,8},{2,6,1,5,4,8,3,7},
+                            {2,6,4,8,1,5,3,7},{4,8,2,6,3,7,1,5}};
+        for(int cfa=0;cfa<4;cfa++) assertArrayEquals(expected[cfa],
+                calibration(cfa,1023,new float[]{64,65,66,67},true,true).phaseGrids,0);
+    }
+    @Test public void encodingScalesAreExactPowersOfTwoWithoutDiscardingSourcePrecision() {
+        for(int bits=8;bits<=14;bits++) {
+            M9DngNoiseStage.Calibration c=calibration(0,(1<<bits)-1,new float[]{64,65,66,67},true,true);
+            assertEquals(1<<(14-bits),c.scale);
+            assertTrue(c.white*c.scale<=16383);
+        }
+        rejects(()->calibration(0,65535,new float[]{64,65,66,67},true,true));
+    }
+    @Test public void rejectsCropSubstitutedMapAndFractionalBlack() {
+        rejects(()->calibration(0,1023,new float[]{64,65,66,67},false,true));
+        rejects(()->calibration(0,1023,new float[]{64,65,66,67},true,false));
+        rejects(()->calibration(0,1023,new float[]{64.25f,65,66,67},true,true));
+        rejects(()->calibration(4,1023,new float[]{64,65,66,67},true,true));
+    }
+    @Test public void rejectsBadNoiseAndGains() {
+        for(double value:new double[]{0,-1,Double.NaN,Double.POSITIVE_INFINITY,1.1}) {
+            double saved=profile[0];profile[0]=value;rejects(this::good);profile[0]=saved;
+        }
+        for(float value:new float[]{0,Float.NaN,65}) rejects(()->M9DngNoiseStage.prepare(
+                16,12,0,1023,new float[]{64,65,66,67},profile,new float[]{1,value,1,1},1,1,true,true));
+    }
+    @Test public void ownsCalibrationCopies() {
+        float[] b={64,65,66,67},g={1,2,3,4};
+        M9DngNoiseStage.Calibration c=M9DngNoiseStage.prepare(16,12,0,1023,b,profile,g,1,1,true,true);
+        b[0]=99;g[0]=99;profile[0]=.9;
+        assertEquals(64,c.black[0],0);assertEquals(1,c.phaseGrids[0],0);assertEquals(.0004,c.profile[0],0);
+    }
+    @Test public void successfulStageOwnsOutputAndPreservesSourceWindowAndState() {
+        ByteBuffer src=source();src.position(13);src.mark();src.limit(300);
+        M9DngNoiseStage.Result r=M9DngNoiseStage.process(src,good(),(in,out,c)->{
+            assertTrue(in.isReadOnly());assertEquals(0,in.position());assertEquals(384,in.limit());
+            in.order(ByteOrder.LITTLE_ENDIAN());
+            for(int i=0;i<192;i++) out.putShort(i*2,(short)((in.getShort(i*2)&65535)*c.scale));
+            return 0;
+        });
+        assertTrue(r.applied);assertNotSame(src,r.buffer);assertEquals(16,r.scale);
+        assertEquals(13,src.position());assertEquals(300,src.limit());src.reset();
+        ByteBuffer view=src.duplicate().order(ByteOrder.LITTLE_ENDIAN());view.clear();
+        for(int i=0;i<192;i++) {assertEquals(100+i,view.getShort(i*2));assertEquals((100+i)*16,r.buffer.getShort(i*2));}
+    }
+    @Test public void failedStageDiscardsPartialOutputAndPreservesOriginalEncoding() {
+        ByteBuffer src=source();
+        for(int code:new int[]{-1,-2,-3,-4,-5,-6}) {
+            M9DngNoiseStage.Result r=M9DngNoiseStage.process(src,good(),(in,out,c)->{out.putShort(0,(short)999);return code;});
+            assertFalse(r.applied);assertSame(src,r.buffer);assertEquals(1,r.scale);assertEquals(100,src.getShort(0));
+        }
+    }
+    @Test public void allocationLinkAndRuntimeFailuresBypass() {
+        for(int kind=0;kind<3;kind++) {
+            final int k=kind;ByteBuffer src=source();
+            M9DngNoiseStage.Result r=M9DngNoiseStage.process(src,good(),(in,out,c)->{
+                if(k==0)throw new OutOfMemoryError();if(k==1)throw new UnsatisfiedLinkError();
+                throw new IllegalStateException();
+            });
+            assertFalse(r.applied);assertSame(src,r.buffer);assertEquals(1,r.scale);
+        }
+    }
+    @Test public void invalidBuffersDoNotEnterNativeCode() {
+        for(ByteBuffer src:new ByteBuffer[]{null,ByteBuffer.allocate(384),ByteBuffer.allocateDirect(383)}) {
+            M9DngNoiseStage.Result r=M9DngNoiseStage.process(src,good(),(in,out,c)->{fail("native entered");return 0;});
+            assertFalse(r.applied);assertSame(src,r.buffer);
+        }
+    }
+}

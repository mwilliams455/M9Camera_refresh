+package com.particlesdevs.photoncamera.processing;
+
+import java.nio.ByteBuffer;
+import java.nio.ByteOrder;
+
+/** DNGNOISESTAGE1A test: shade-aware same-phase RAW noise, mode 1 / k=1.
+ * Owns a separate output. Source/JPEG bytes and caller buffer state are never changed.
+ * This phone-calibrated threshold is not a recovered Leica ISO/LUT calibration.
+ */
+public final class M9DngNoiseStage {
+    public static final String ID = "M9DNGNOISESTAGE1A_SHADED_K1";
+    private M9DngNoiseStage() {}
+
+    public static final class Calibration {
+        final int width, height, white, scale, gridWidth, gridHeight;
+        final double[] black, profile;
+        final float[] phaseGrids;
+        private Calibration(int w, int h, int white, int scale, int gw, int gh,
+                            double[] black, double[] profile, float[] grids) {
+            this.width=w; this.height=h; this.white=white; this.scale=scale;
+            this.gridWidth=gw; this.gridHeight=gh; this.black=black;
+            this.profile=profile; this.phaseGrids=grids;
+        }
+    }
+
+    public static final class Result {
+        public final ByteBuffer buffer;
+        public final boolean applied;
+        public final String reason;
+        public final int scale;
+        public final double elapsedMs;
+        Result(ByteBuffer buffer, boolean applied, String reason, int scale, long start) {
+            this.buffer=buffer; this.applied=applied; this.reason=reason; this.scale=scale;
+            this.elapsedMs=(System.nanoTime()-start)/1_000_000.0;
+        }
+    }
+
+    /** The geometry must describe the full, uncropped RAW and the exact written GainMap. */
+    public static Calibration prepare(int w, int h, int cfa, int white, float[] black,
+                                      double[] profile, float[] cameraGrids, int gw, int gh,
+                                      boolean fullFrameGeometry, boolean ownedGainMap) {
+        if (!fullFrameGeometry) throw new IllegalArgumentException("unsupported_crop_or_gain_area");
+        if (!ownedGainMap) throw new IllegalArgumentException("missing_or_substituted_capture_gain_map");
+        if (w<6 || h<6 || w>32767 || h>32767 || (w&1)!=0 || (h&1)!=0
+                || (long)w*h>32_000_000L) throw new IllegalArgumentException("unsupported_raw_dimensions");
+        if (cfa<0 || cfa>3) throw new IllegalArgumentException("unsupported_physical_cfa");
+        if (white<1 || white>16383) throw new IllegalArgumentException("unsupported_white_level");
+        if (black==null || black.length!=4 || profile==null || profile.length!=8)
+            throw new IllegalArgumentException("missing_physical_calibration");
+        double[] b=new double[4];
+        for (int p=0;p<4;p++) {
+            // Existing writer stores integer black levels. Fractional calibration is
+            // deliberately bypassed, never silently reinterpreted during filtering.
+            if (!Float.isFinite(black[p]) || black[p]<0 || black[p]>=white
+                    || black[p]!=(int)black[p]) throw new IllegalArgumentException("unsupported_black_level");
+            b[p]=black[p];
+            if (!Double.isFinite(profile[2*p]) || profile[2*p]<=0 || profile[2*p]>1
+                    || !Double.isFinite(profile[2*p+1]) || profile[2*p+1]<0 || profile[2*p+1]>1)
+                throw new IllegalArgumentException("invalid_physical_noise_profile");
+        }
+        if (gw<1 || gh<1 || gw>1024 || gh>1024 || cameraGrids==null
+                || cameraGrids.length!=4L*gw*gh) throw new IllegalArgumentException("invalid_gain_grid_shape");
+        // Camera2 fixed channel order R, G-even, G-odd, B -> physical row-major CFA.
+        // Same phase table as the production DngCreator GainMap serializer.
+        int[][] channelToPhase={{0,1,2,3},{1,0,3,2},{2,0,3,1},{3,1,2,0}};
+        float[] grids=new float[cameraGrids.length];
+        int points=gw*gh;
+        for (int i=0;i<points;i++) for (int c=0;c<4;c++) {
+            float g=cameraGrids[4*i+c];
+            if (!Float.isFinite(g) || g<1f/64f || g>64f)
+                throw new IllegalArgumentException("invalid_gain_factor");
+            grids[channelToPhase[cfa][c]*points+i]=g;
+        }
+        int scale=1;
+        while ((long)white*scale*2<=16383) scale*=2;
+        return new Calibration(w,h,white,scale,gw,gh,b,profile.clone(),grids);
+    }
+
+    interface Backend { int run(ByteBuffer source, ByteBuffer destination, Calibration c); }
+    private static boolean attempted, available;
+    private static synchronized boolean loadNative() {
+        if (!attempted) {
+            attempted=true;
+            try { System.loadLibrary("m9dngnoise"); available=true; }
+            catch (UnsatisfiedLinkError | SecurityException ignored) { available=false; }
+        }
+        return available;
+    }
+    private static native int filterNative(ByteBuffer src, ByteBuffer dst, int w, int h,
+            int white, int scale, double[] black, double[] profile, float[] grids, int gw, int gh);
+
+    public static Result process(ByteBuffer source, Calibration c) {
+        return process(source,c,(src,dst,cal)->loadNative()
+                ? filterNative(src,dst,cal.width,cal.height,cal.white,cal.scale,
+                               cal.black,cal.profile,cal.phaseGrids,cal.gridWidth,cal.gridHeight) : -6);
+    }
+    static Result process(ByteBuffer source, Calibration c, Backend backend) {
+        long start=System.nanoTime();
+        try {
+            if (c==null || source==null || !source.isDirect()
+                    || source.capacity()<(long)c.width*c.height*2)
+                return new Result(source,false,"invalid_source_buffer",1,start);
+            // Match the existing native writer's base-address window, irrespective
+            // of the caller's position/limit. Read-only view prevents Java mutation.
+            ByteBuffer input=source.asReadOnlyBuffer(); input.clear();
+            ByteBuffer output=ByteBuffer.allocateDirect(c.width*c.height*2).order(ByteOrder.LITTLE_ENDIAN);
+            int status=backend.run(input,output,c);
+            if (status!=0) return new Result(source,false,"native_status_"+status,1,start);
+            output.clear();
+            return new Result(output,true,"applied",c.scale,start);
+        } catch (OutOfMemoryError | UnsatisfiedLinkError | RuntimeException error) {
+            return new Result(source,false,"fallback_"+error.getClass().getSimpleName(),1,start);
+        }
+    }
+    public static Result bypass(ByteBuffer source, String reason) {
+        return new Result(source,false,reason,1,System.nanoTime());
+    }
+}

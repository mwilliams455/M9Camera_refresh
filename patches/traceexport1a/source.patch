+    /** Copy retained tracking rows to a user-chosen document, independently of public log checkpoints. */
+    public long copyTrackingTrace(Writer output) throws IOException {
+        Map<File,Long> sizes = new TreeMap<>();
+        synchronized (this) {
+            flush();
+            File[] files = dir.listFiles((d,n) -> n.matches("log-\\d{4}-\\d{2}-\\d{2}\\.txt"));
+            if (files == null) throw new IOException("Cannot list the camera journal");
+            for (File file : files) sizes.put(file,file.length());
+        }
+        long written = 0;
+        for (Map.Entry<File,Long> day : sizes.entrySet()) {
+            // The writer can append new rows while the user-selected destination is slow.
+            try (FileInputStream input = new FileInputStream(day.getKey());
+                 BufferedReader lines = snapshotReader(input,day.getValue())) {
+                for (String line; (line = lines.readLine()) != null;) {
+                    if (line.startsWith(" I/M9HeadTrace: tNs=", 23)) {
+                        output.write(line);
+                        output.write('\n');
+                        written++;
+                    }
+                }
+            }
+        }
+        output.flush();
+        return written;
+    }
+
+    private static BufferedReader snapshotReader(FileInputStream input,long size) {
+        InputStream prefix = new FilterInputStream(input) {
+            long remaining = size;
+            @Override public int read(byte[] dst, int off, int len) throws IOException {
+                if (len == 0) return 0;
+                if (remaining == 0) return -1;
+                int n = super.read(dst, off, (int)Math.min(remaining, len));
+                if (n > 0) remaining -= n;
+                return n;
+            }
+            @Override public int read() throws IOException {
+                if (remaining == 0) return -1;
+                int value = super.read();
+                if (value >= 0) remaining--;
+                return value;
+            }
+        };
+        return new BufferedReader(new InputStreamReader(prefix, StandardCharsets.UTF_8));
+    }

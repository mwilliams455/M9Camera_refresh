+package com.particlesdevs.photoncamera.ui.settings;
+
+import android.app.Application;
+import android.content.Context;
+import androidx.activity.result.ActivityResultLauncher;
+import androidx.preference.Preference;
+import com.particlesdevs.photoncamera.util.Log;
+import java.io.StringWriter;
+import java.util.concurrent.CompletableFuture;
+import java.util.concurrent.TimeUnit;
+import org.junit.Test;
+import org.junit.runner.RunWith;
+import org.robolectric.RobolectricTestRunner;
+import org.robolectric.RuntimeEnvironment;
+import org.robolectric.annotation.Config;
+import org.robolectric.util.ReflectionHelpers;
+import static org.junit.Assert.*;
+import static org.mockito.Mockito.*;
+
+@RunWith(RobolectricTestRunner.class)
+@Config(sdk=35,application=Application.class)
+public class TrackingTraceSettingsTest {
+    @Test public void tappingExportOpensPickerWithNamedTextFile() {
+        SettingsActivity.SettingsFragment fragment = new SettingsActivity.SettingsFragment();
+        ActivityResultLauncher<String> picker = mock(ActivityResultLauncher.class);
+        ReflectionHelpers.setField(fragment,"trackingTraceLauncher",picker);
+        Preference entry = new Preference(RuntimeEnvironment.getApplication());
+        entry.setKey("pref_export_tracking_trace");
+        assertTrue(fragment.onPreferenceTreeClick(entry));
+        verify(picker).launch(matches("M9_TRACKING_TRACE_[0-9]{8}_[0-9]{6}\\.txt"));
+    }
+
+    @Test public void exportSeesTrackingRowsQueuedImmediatelyBeforeRequest() throws Exception {
+        Context app = RuntimeEnvironment.getApplication();
+        Log.initPrivate(app);
+        Log.i("M9HeadTrace","tNs=987654321 display squares=2");
+        CompletableFuture<String> result = new CompletableFuture<>();
+        Log.exportTrackingTrace(journal -> {
+            try {
+                StringWriter file = new StringWriter();
+                journal.copyTrackingTrace(file);
+                result.complete(file.toString());
+            } catch (Exception failure) {
+                result.completeExceptionally(failure);
+            }
+        });
+        assertTrue(result.get(6,TimeUnit.SECONDS).contains("I/M9HeadTrace: tNs=987654321 display squares=2"));
+    }
+}

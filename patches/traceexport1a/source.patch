+package com.particlesdevs.photoncamera.util;
+
+import java.io.File;
+import java.io.IOException;
+import java.io.StringWriter;
+import java.io.Writer;
+import org.junit.Rule;
+import org.junit.Test;
+import org.junit.rules.TemporaryFolder;
+import static org.junit.Assert.*;
+
+public class TrackingTraceExportTest {
+    @Rule public TemporaryFolder temp = new TemporaryFolder();
+    private static final long DAY = 86_400_000L;
+    private static final long START = 1_780_000_000_000L;
+
+    @Test public void recoversPreviousVersionAcrossDaysAheadOfBacklog() throws Exception {
+        File folder = temp.newFolder();
+        M9LocalLog1E previous = new M9LocalLog1E(folder);
+        StringBuilder bulk = new StringBuilder();
+        for (int i=0;i<4096;i++) bulk.append('x');
+        for (int i=0;i<100;i++) previous.append(START,"D","Converter",bulk.toString());
+        previous.append(START+DAY,"I","M9HeadTrace","tNs=101 display squares=2");
+        previous.append(START+2*DAY,"I","M9HeadTrace","tNs=222 display squares=1");
+        previous.close();
+        M9LocalLog1E upgraded = new M9LocalLog1E(folder);
+        StringWriter out = new StringWriter();
+        assertEquals(2,upgraded.copyTrackingTrace(out));
+        assertTrue(out.toString().indexOf("tNs=101") < out.toString().indexOf("tNs=222"));
+        assertFalse(out.toString().contains("Converter"));
+        assertEquals(0,folder.listFiles((d,n)->n.endsWith(".offset")).length);
+    }
+
+    @Test public void skipsOtherTagsAndReportsEmptyWhenNoTraceWasSaved() throws Exception {
+        M9LocalLog1E journal = new M9LocalLog1E(temp.newFolder());
+        journal.append(START,"I","Other","mentions I/M9HeadTrace: tNs=1");
+        journal.append(START,"I","M9HeadTraceExtra","tNs=2");
+        journal.append(START,"I","M9HeadTrace","unrelated text");
+        StringWriter out = new StringWriter();
+        assertEquals(0,journal.copyTrackingTrace(out));
+        assertEquals("",out.toString());
+        journal.close();
+    }
+
+    @Test public void snapshotIncludesBufferedWritesAndExcludesLaterAppends() throws Exception {
+        M9LocalLog1E journal = new M9LocalLog1E(temp.newFolder());
+        journal.append(START,"I","M9HeadTrace","tNs=1");
+        Writer sink = new Writer() {
+            boolean added;
+            @Override public void write(char[] chars,int start,int length) throws IOException {
+                if (!added) {
+                    added = true;
+                    journal.append(START,"I","M9HeadTrace","tNs=2");
+                    journal.flush();
+                }
+            }
+            @Override public void close() {}
+            @Override public void flush() {}
+        };
+        assertEquals(1,journal.copyTrackingTrace(sink));
+        assertEquals(2,journal.copyTrackingTrace(new StringWriter()));
+        journal.close();
+    }
+
+    @Test public void failedSaveCanBeRetriedFromSameRetainedRows() throws Exception {
+        M9LocalLog1E journal = new M9LocalLog1E(temp.newFolder());
+        journal.append(START,"I","M9HeadTrace","tNs=1");
+        Writer failed = new Writer() {
+            @Override public void write(char[] c,int off,int len) throws IOException { throw new IOException("full"); }
+            @Override public void close() {}
+            @Override public void flush() {}
+        };
+        try {
+            journal.copyTrackingTrace(failed);
+            fail("Storage error must reach caller");
+        } catch (IOException expected) { assertEquals("full",expected.getMessage()); }
+        assertEquals(1,journal.copyTrackingTrace(new StringWriter()));
+        journal.close();
+    }
+}

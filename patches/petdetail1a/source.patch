+++ b/app/src/main/java/com/particlesdevs/photoncamera/control/subject/PetDetailInput.java
@@ -0,0 +1,66 @@
+package com.particlesdevs.photoncamera.control.subject;
+
+import com.particlesdevs.photoncamera.control.subject.AutomaticSubjectSelection.Box;
+import com.particlesdevs.photoncamera.control.tracking.SubjectAnchorPolicy.Candidate;
+import com.particlesdevs.photoncamera.control.tracking.SubjectAnchorPolicy.ClassId;
+import java.util.List;
+
+/** A low-confidence cat or dog can request one closer look. Only corroborated geometry is actionable. */
+public final class PetDetailInput {
+    public final int left, top, side;
+    private final int width, height;
+    private final Candidate proposal;
+
+    private PetDetailInput(int width, int height, Candidate proposal) {
+        this.width = width;
+        this.height = height;
+        this.proposal = proposal;
+        int shortEdge = Math.min(width, height);
+        float extent = Math.max(proposal.width()*width, proposal.height()*height);
+        side = Math.min(shortEdge, Math.max(1, Math.round(Math.max(shortEdge*.22f, 1.6f*extent))));
+        left = Math.max(0, Math.min(width-side, Math.round(proposal.cx()*width-side*.5f)));
+        top = Math.max(0, Math.min(height-side, Math.round(proposal.cy()*height-side*.5f)));
+    }
+
+    public static PetDetailInput choose(int width, int height, List<Candidate> candidates, Box trackedPet) {
+        if (width <= 0 || height <= 0) return null;
+        Candidate best = null;
+        double bestRank = Double.NEGATIVE_INFINITY;
+        for (Candidate c : candidates) {
+            if (!plausible(c)) continue;
+            if (trackedPet != null && overlap(c, trackedPet.left, trackedPet.top,
+                    trackedPet.right, trackedPet.bottom) < .18f) continue;
+            double rank = c.score - .28*Math.hypot(c.cx()-.5f, c.cy()-.5f);
+            if (rank > bestRank) { bestRank = rank; best = c; }
+        }
+        return best == null ? null : new PetDetailInput(width, height, best);
+    }
+
+    private static boolean plausible(Candidate c) {
+        return c != null && (c.category == ClassId.CAT || c.category == ClassId.DOG)
+                && Float.isFinite(c.score) && c.score >= .30f && c.score <= 1f
+                && c.left >= 0f && c.top >= 0f && c.right <= 1f && c.bottom <= 1f
+                && c.width() >= .04f && c.height() >= .035f && c.width()*c.height() <= .15f;
+    }
+
+    public Box confirm(List<Candidate> details) {
+        Box match = null;
+        for (Candidate c : details) {
+            if (c == null || (c.category != ClassId.CAT && c.category != ClassId.DOG)
+                    || !c.valid() || c.score < .55f || c.score > 1f) continue;
+            float l=(left+c.left*side)/width, r=(left+c.right*side)/width;
+            float t=(top+c.top*side)/height, b=(top+c.bottom*side)/height;
+            if (overlap(proposal, l,t,r,b) < .40f) continue;
+            if (match != null) return null;
+            match = Box.verifiedPet(c.category, l,t,r,b);
+        }
+        return match;
+    }
+
+    private static float overlap(Candidate c, float l, float t, float r, float b) {
+        float w=Math.max(0f, Math.min(c.right,r)-Math.max(c.left,l));
+        float h=Math.max(0f, Math.min(c.bottom,b)-Math.max(c.top,t));
+        float intersection=w*h;
+        return intersection/(c.width()*c.height()+(r-l)*(b-t)-intersection);
+    }
+}

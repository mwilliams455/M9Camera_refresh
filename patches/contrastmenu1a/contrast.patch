+package com.particlesdevs.photoncamera.processing;
+
+/** Leica M9 1.216 normal-ISO sRGB contrast bank; no synthetic curve scaling. */
+public final class M9Contrast {
+    public static final int STANDARD = 2;
+    private M9Contrast() {}
+    public static boolean isValid(int level) { return level >= 0 && level < 5; }
+    public static int normalize(int level) { return isValid(level) ? level : STANDARD; }
+    public static int parse(String value) {
+        try { return normalize(Integer.parseInt(value)); }
+        catch (RuntimeException invalid) { return STANDARD; }
+    }
+    public static String name(int level) {
+        return new String[]{"Low", "Medium low", "Standard", "Medium high", "High"}[normalize(level)];
+    }
+    public static String curveName(int level) { return "curve0" + normalize(level); }
+}

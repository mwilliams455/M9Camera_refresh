+package com.particlesdevs.photoncamera.m9.render;
+
+import com.particlesdevs.photoncamera.app.PhotonCamera;
+import com.particlesdevs.photoncamera.processing.M9Contrast;
+import com.particlesdevs.photoncamera.settings.SettingsManager;
+
+/** Global across cameras; default SharedPreferences is also the settings UI's store. */
+public final class M9ContrastSettings {
+    public static final String KEY = "pref_m9_contrast";
+    private M9ContrastSettings() {}
+    public static int selected() {
+        return selected(PhotonCamera.getSettingsManagerStatic());
+    }
+    static int selected(SettingsManager settings) {
+        if (settings == null) return M9Contrast.STANDARD;
+        try { return M9Contrast.parse(settings.getString(SettingsManager.SCOPE_GLOBAL, KEY, "2")); }
+        catch (ClassCastException invalidType) { return M9Contrast.STANDARD; }
+    }
+}

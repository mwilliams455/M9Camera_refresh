+package com.particlesdevs.photoncamera.m9.render;
+import com.particlesdevs.photoncamera.settings.SettingsManager;
+import com.particlesdevs.photoncamera.processing.M9Contrast;
+import org.junit.Test;
+import org.mockito.MockMakers;
+import static org.junit.Assert.*;
+import static org.mockito.Mockito.*;
+
+public class M9ContrastSettingsTest {
+    private SettingsManager settings() {
+        return mock(SettingsManager.class, withSettings().mockMaker(MockMakers.SUBCLASS));
+    }
+    @Test public void installationWithoutPreferenceUsesAcceptedStandard() {
+        assertEquals(2, M9ContrastSettings.selected(null));
+        SettingsManager s=settings();
+        when(s.getString(SettingsManager.SCOPE_GLOBAL,M9ContrastSettings.KEY,"2")).thenReturn("2");
+        assertEquals(2,M9ContrastSettings.selected(s));
+    }
+    @Test public void allFiveLevelsCanChangeWithoutRestart() {
+        SettingsManager s=settings();
+        when(s.getString(SettingsManager.SCOPE_GLOBAL,M9ContrastSettings.KEY,"2")).thenReturn("0","1","2","3","4","2");
+        for(int n:new int[]{0,1,2,3,4,2}) assertEquals(n,M9ContrastSettings.selected(s));
+    }
+    @Test public void corruptOrFuturePreferenceFallsBackToStandard() {
+        SettingsManager s=settings();
+        when(s.getString(SettingsManager.SCOPE_GLOBAL,M9ContrastSettings.KEY,"2")).thenReturn("broken","-1","5",null);
+        for(int n=0;n<4;n++) assertEquals(2,M9ContrastSettings.selected(s));
+    }
+    @Test public void wrongStoredTypeDoesNotPreventCapture() {
+        SettingsManager s=settings();
+        when(s.getString(SettingsManager.SCOPE_GLOBAL,M9ContrastSettings.KEY,"2")).thenThrow(new ClassCastException());
+        assertEquals(2,M9ContrastSettings.selected(s));
+    }
+}

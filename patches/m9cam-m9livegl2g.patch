+    /**
+     * M9LIVEGL2G_EXPOSUREENERGY: mode/gyro caps choose a preferred shutter, not
+     * a different scene brightness. Restore the original intent in physical ISO
+     * units after the legacy allocator's ISO saturation/rounding and dial overrides.
+     * Automatic RAW ISO stays in the reported analog range: the 15U returned
+     * ISO 3200 for a 12800 request. This is a conservative automatic policy, not
+     * a claim that Camera2 forbids RAW digital gain on every sensor. Explicit ISO
+     * remains authoritative, including values above that automatic ceiling.
+     */
+    private static void finishM9Allocation2G(ExpoPair pair, PlanInput1A input,
+            CaptureController controller) {
+        final int isoLow = getISOLOW(), sensorIsoHigh = getISOHIGH();
+        final long timeLow = getEXPLOW(), sensorTimeHigh = getEXPHIGH();
+        Integer analog = CaptureController.mCameraCharacteristics.get(
+                CameraCharacteristics.SENSOR_MAX_ANALOG_SENSITIVITY);
+        final boolean validAnalog = analog != null && analog >= isoLow && analog <= sensorIsoHigh;
+        int autoIsoHigh = validAnalog ? analog : sensorIsoHigh;
+        long autoTimeHigh = sensorTimeHigh;
+        // Retain explicit exposure-balance limits and the existing tripod override.
+        // The legacy UI applies those limits in Photo (Motion uses its own policy).
+        if (PhotonCamera.getSettings().selectedMode == CameraMode.PHOTO && controller != null) {
+            int limit = controller.exposureBalanceIsoLimit;
+            int configuredMax = limit == -4 ? getISOAnalog() / 4
+                    : limit == -3 ? getISOAnalog() / 2
+                    : limit == -2 ? getISOAnalog()
+                    : limit > 0 ? limit : sensorIsoHigh;
+            autoIsoHigh = Math.max(isoLow, Math.min(autoIsoHigh, configuredMax));
+            if (!input.tripod) autoTimeHigh = Math.max(timeLow, Math.min(sensorTimeHigh,
+                    pair.resolveShutterLimit(controller.exposureBalanceShutterLimit, controller)));
+        }
+        final double target = M9ExposurePlan1A.energy(input.iso, input.exposureNs)
+                * Math.pow(2.0, input.ev + input.autoEv);
+        final int preferredIso = pair.iso;
+        final long preferredTime = pair.exposure;
+        final boolean manualIso = input.manualIso > 0, manualTime = input.manualExposureNs > 0;
+        String reason;
+        if (manualIso && manualTime) {
+            pair.iso = Math.max(isoLow, Math.min(sensorIsoHigh, input.manualIso));
+            pair.exposure = Math.max(timeLow, Math.min(sensorTimeHigh, input.manualExposureNs));
+            reason = "explicit_sensor_pair";
+        } else if (manualTime) {
+            pair.exposure = Math.max(timeLow, Math.min(sensorTimeHigh, input.manualExposureNs));
+            pair.iso = (int) Math.max(isoLow, Math.min(autoIsoHigh, Math.round(target / pair.exposure)));
+            reason = "explicit_shutter_auto_iso";
+        } else if (manualIso) {
+            pair.iso = Math.max(isoLow, Math.min(sensorIsoHigh, input.manualIso));
+            pair.exposure = Math.max(timeLow, Math.min(autoTimeHigh, Math.round(target / pair.iso)));
+            reason = "explicit_iso_auto_shutter";
+        } else if (target <= M9ExposurePlan1A.energy(isoLow, timeLow)) {
+            pair.iso = isoLow; pair.exposure = timeLow;
+            reason = "minimum_exposure_boundary";
+        } else if (target >= M9ExposurePlan1A.energy(autoIsoHigh, autoTimeHigh)) {
+            pair.iso = autoIsoHigh; pair.exposure = autoTimeHigh;
+            reason = "maximum_automatic_exposure_boundary";
+        } else {

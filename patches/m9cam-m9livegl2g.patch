+            // that can actually retain its energy, then resolve integer sensor ISO.
+            double shortest = Math.max(timeLow, target / autoIsoHigh);
+            double longest = Math.min(autoTimeHigh, target / isoLow);
+            double shutter = Math.max(shortest, Math.min(longest, preferredTime));
+            pair.iso = (int) Math.max(isoLow, Math.min(autoIsoHigh, Math.ceil(target / shutter)));

+                .put("preferredIso", preferredIso).put("preferredExposureNs", preferredTime)
+                .put("targetEnergyIsoNs", target)
+                .put("allocatedEnergyIsoNs", M9ExposurePlan1A.energy(pair.iso, pair.exposure))
+                .put("allocationErrorEv", errorEv)
+                .put("preferredShutterExtended", !manualTime && pair.exposure > preferredTime)
+                .put("explicitSensorControl", manualIso || manualTime).toString();
+        } catch (org.json.JSONException invalid) {

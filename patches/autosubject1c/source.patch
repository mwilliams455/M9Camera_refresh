@@ -0,0 +1,32 @@
+package com.particlesdevs.photoncamera.control.subject;
+
+import com.particlesdevs.photoncamera.control.tracking.SubjectAnchorPolicy.Candidate;
+import com.particlesdevs.photoncamera.control.tracking.SubjectAnchorPolicy.ClassId;
+
+/** The second detector view fits the complete preview inside the centre half of a square. */
+public final class PersonRecoveryInput {
+    public static final int SIZE = 320;
+    public final int left, top, width, height;
+
+    public PersonRecoveryInput(int previewWidth, int previewHeight) {
+        float scale = (.5f * SIZE) / Math.max(previewWidth, previewHeight);
+        width = Math.max(1, Math.round(previewWidth * scale));
+        height = Math.max(1, Math.round(previewHeight * scale));
+        left = (SIZE-width)/2;
+        top = (SIZE-height)/2;
+    }
+
+    public AutomaticSubjectSelection.Box toPreview(Candidate c) {
+        if (c == null || c.category != ClassId.PERSON || !Float.isFinite(c.score) || c.score < .55f)
+            return null;
+        float x = c.cx()*SIZE, y = c.cy()*SIZE;
+        if (x < left || x > left+width || y < top || y > top+height) return null;
+        return AutomaticSubjectSelection.Box.fromBody(new Candidate("person", c.score,
+                clamp((c.left*SIZE-left)/width), clamp((c.top*SIZE-top)/height),
+                clamp((c.right*SIZE-left)/width), clamp((c.bottom*SIZE-top)/height)));
+    }
+
+    private static float clamp(float coordinate) {
+        return Math.max(0f, Math.min(1f, coordinate));
+    }
+}

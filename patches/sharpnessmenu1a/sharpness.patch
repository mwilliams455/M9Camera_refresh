+package com.particlesdevs.photoncamera.m9.render;
+import org.junit.Test;
+import org.json.JSONObject;
+import static org.junit.Assert.*;
+
+public class M9SharpnessDiagnosticsTest {
+    @Test public void missingRendererCannotClaimOldStandard() throws Exception {
+        JSONObject out=new JSONObject();M9SharpnessStage.describe(out,null);
+        assertEquals("not_reported",out.getString("sharpnessResearch"));
+        assertTrue(out.isNull("sharpnessApplied"));assertTrue(out.isNull("sharpnessMenu"));
+    }
+    @Test public void actualCapturedSelectionOwnsSummary() throws Exception {
+        JSONObject actual=new JSONObject().put("revision","M9SHARPNESSMENU1A")
+                .put("name","High").put("applied",true).put("isoSlot",12).put("internalMode",5);
+        JSONObject out=new JSONObject();M9SharpnessStage.describe(out,new JSONObject().put("sharpness",actual));
+        assertEquals("High",out.getString("sharpnessMenu"));assertEquals(12,out.getInt("sharpnessSlot"));
+        assertEquals(5,out.getInt("sharpnessInternalMode"));assertTrue(out.getBoolean("sharpnessApplied"));
+    }
+    @Test public void explicitOffIsNotUnknownOrStandard() throws Exception {
+        JSONObject actual=new JSONObject().put("revision","M9SHARPNESSMENU1A")
+                .put("name","Off").put("applied",false).put("isoSlot",0).put("internalMode",0);
+        JSONObject out=new JSONObject();M9SharpnessStage.describe(out,new JSONObject().put("sharpness",actual));
+        assertEquals("Off",out.getString("sharpnessMenu"));assertFalse(out.getBoolean("sharpnessApplied"));
+    }
+}

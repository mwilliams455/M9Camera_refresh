+package com.particlesdevs.photoncamera.m9.render;
+import android.hardware.camera2.CaptureResult;
+import com.particlesdevs.photoncamera.processing.M9Sharpness;
+import org.json.JSONObject;
+/** Recovered Sharp kernel with colour-preserving transport onto accepted AMaZE. */
+public final class M9SharpnessStage {
+    private M9SharpnessStage() {}
+    private static final class Native {static {System.loadLibrary("m9sharpness");}static void ready(){}}
+    private static native int applyNative(long rgb,int w,int h,int slot,int level,double[] stats);
+    static JSONObject apply(long rgb,int w,int h,int choice,CaptureResult capture) throws Exception {
+        int level=M9Sharpness.normalize(choice);
+        Integer measured=capture==null?null:capture.get(CaptureResult.SENSOR_SENSITIVITY);
+        int iso=measured!=null&&measured>0?measured:160,slot=M9Sharpness.isoSlot(iso);
+        double[] stats=new double[7];
+        if(level!=0){Native.ready();int rc=applyNative(rgb,w,h,slot,level,stats);
+            if(rc!=0)throw new IllegalStateException("M9SHARPNESSMENU1A failed: "+rc);}
+        JSONObject d=new JSONObject();
+        d.put("revision","M9SHARPNESSMENU1A");d.put("level",level);d.put("name",M9Sharpness.name(level));
+        d.put("applied",level!=0);d.put("sensorIso",iso);d.put("isoFallback",measured==null||measured<=0);
+        d.put("leicaIso",M9Sharpness.ISOS[slot]);d.put("isoSlot",slot);d.put("internalMode",M9Sharpness.mode(level,slot));
+        d.put("isoPolicy","capture_SENSOR_SENSITIVITY_nearest_log_ISO160_2500_no_device_factor");
+        d.put("kernel","firmware_Gaussian121_residual_LUT_14bit");
+        d.put("source","accepted_AMaZE_camera_green_after_shading_restore");
+        d.put("rgbTransport","common_ratio_gain_joint_headroom_cap_half_up_16bit");
+        d.put("fullLeicaReconstruction",false);d.put("offPolicy","exact_stage_bypass_2_27_pixels");
+        d.put("stage","after_meter_and_gain_selection_before_target_colour_preparation");
+        d.put("consideredPixels",(long)stats[0]);d.put("changedPixels",(long)stats[1]);
+        d.put("jointHeadroomLimitedPixels",(long)stats[2]);d.put("maxCorrection16",(long)stats[3]);
+        d.put("elapsedMs",stats[4]);d.put("scratchBytes",(long)stats[5]);d.put("untouchedBorder",18);
+        d.put("previewPolicy","camera_ISP_preview_no_spatial_sharpness_simulation");
+        d.put("dngPolicy","reader_controls_spatial_detail_profile_is_colour_and_tone_only");
+        return d;
+    }
+    public static void describe(JSONObject output,JSONObject renderer) throws Exception {
+        JSONObject d=renderer==null?null:renderer.optJSONObject("sharpness");
+        output.put("sharpness",d==null?JSONObject.NULL:d);
+        output.put("sharpnessResearch",d==null?"not_reported":d.optString("revision"));
+        output.put("sharpnessMenu",d==null?JSONObject.NULL:d.optString("name"));
+        output.put("sharpnessApplied",d==null?JSONObject.NULL:d.getBoolean("applied"));
+        output.put("sharpnessSlot",d==null?JSONObject.NULL:d.getInt("isoSlot"));
+        output.put("sharpnessInternalMode",d==null?JSONObject.NULL:d.getInt("internalMode"));
+    }
+}

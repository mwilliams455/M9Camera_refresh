+package com.particlesdevs.photoncamera.m9.render;
+import com.particlesdevs.photoncamera.settings.SettingsManager;
+import com.particlesdevs.photoncamera.processing.M9Sharpness;
+import org.junit.Test;
+import org.mockito.MockMakers;
+import static org.junit.Assert.*;
+import static org.mockito.Mockito.*;
+
+public class M9SharpnessSettingsTest {
+    private SettingsManager settings() {
+        return mock(SettingsManager.class, withSettings().mockMaker(MockMakers.SUBCLASS));
+    }
+    @Test public void installationWithoutPreferenceUsesSelectedLeicaStandard() {
+        assertEquals(2, M9SharpnessSettings.selected(null));
+        SettingsManager s=settings();
+        when(s.getString(SettingsManager.SCOPE_GLOBAL,M9SharpnessSettings.KEY,"2")).thenReturn("2");
+        assertEquals(2,M9SharpnessSettings.selected(s));
+    }
+    @Test public void allFiveLevelsCanChangeWithoutRestart() {
+        SettingsManager s=settings();
+        when(s.getString(SettingsManager.SCOPE_GLOBAL,M9SharpnessSettings.KEY,"2")).thenReturn("0","1","2","3","4","2");
+        for(int n:new int[]{0,1,2,3,4,2}) assertEquals(n,M9SharpnessSettings.selected(s));
+    }
+    @Test public void corruptOrFuturePreferenceFallsBackToStandard() {
+        SettingsManager s=settings();
+        when(s.getString(SettingsManager.SCOPE_GLOBAL,M9SharpnessSettings.KEY,"2")).thenReturn("broken","-1","5",null);
+        for(int n=0;n<4;n++) assertEquals(2,M9SharpnessSettings.selected(s));
+    }
+    @Test public void wrongStoredTypeDoesNotPreventCapture() {
+        SettingsManager s=settings();
+        when(s.getString(SettingsManager.SCOPE_GLOBAL,M9SharpnessSettings.KEY,"2")).thenThrow(new ClassCastException());
+        assertEquals(2,M9SharpnessSettings.selected(s));
+    }
+    @Test public void actualCaptureIsoMapsWithoutDeviceMultiplier() {
+        for(int i=0;i<M9Sharpness.ISOS.length;i++) assertEquals(i,M9Sharpness.isoSlot(M9Sharpness.ISOS[i]));
+        assertEquals(0,M9Sharpness.isoSlot(80));assertEquals(12,M9Sharpness.isoSlot(25600));
+        assertEquals(0,M9Sharpness.isoSlot(178));assertEquals(1,M9Sharpness.isoSlot(180));
+        assertEquals(4,M9Sharpness.mode(2,0));assertEquals(3,M9Sharpness.mode(2,6));assertEquals(2,M9Sharpness.mode(2,12));
+    }
+}

+package com.particlesdevs.photoncamera.ui.camera;
+
+import java.lang.reflect.Field;
+import java.util.ArrayList;
+import java.util.Arrays;
+import org.junit.Test;
+import static org.junit.Assert.assertEquals;
+
+public class SceneHeadOutputNamesTest {
+    @Test public void outputNamesAreCompatibleWithOpenCvNativeArrayListMethods() throws Exception {
+        Field field = SceneHeadTracker.class.getDeclaredField("OUTPUTS");
+        field.setAccessible(true);
+        // ART aborts if the JNI receiver is an Arrays.asList view, even with the right names.
+        ArrayList<?> names = ArrayList.class.cast(field.get(null));
+        assertEquals(Arrays.asList("boxes", "scores", "classes"), names);
+    }
+}

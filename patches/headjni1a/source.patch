+package com.particlesdevs.photoncamera.ui.camera;
+
+import android.content.Context;
+import android.graphics.Bitmap;
+import androidx.test.ext.junit.runners.AndroidJUnit4;
+import androidx.test.platform.app.InstrumentationRegistry;
+import org.junit.Test;
+import org.junit.runner.RunWith;
+import static org.junit.Assert.assertTrue;
+
+@RunWith(AndroidJUnit4.class)
+public class SceneHeadNativeTest {
+    @Test public void repeatedInferenceAcceptsTheThreeNamedOutputs() throws Exception {
+        Context context = InstrumentationRegistry.getInstrumentation().getTargetContext();
+        Bitmap blank = Bitmap.createBitmap(540, 720, Bitmap.Config.ARGB_8888);
+        try (SceneHeadTracker tracker = SceneHeadTracker.open(context)) {
+            for (int i = 1; i <= 3; i++) {
+                assertTrue(tracker.detect(blank, 1L, i * 200_000_000L).isEmpty());
+            }
+        } finally {
+            blank.recycle();
+        }
+    }
+}

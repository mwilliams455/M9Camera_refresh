+++ b/app/src/main/java/com/particlesdevs/photoncamera/processing/render/M9CaptureParameters.java
@@ -0,0 +1,113 @@
+package com.particlesdevs.photoncamera.processing.render;
+
+import android.hardware.camera2.CameraCharacteristics;
+
+import com.particlesdevs.photoncamera.app.PhotonCamera;
+import com.particlesdevs.photoncamera.settings.SensorConfigInjector;
+import com.particlesdevs.photoncamera.settings.TunableInjector;
+import com.particlesdevs.photoncamera.util.Allocator;
+
+/** M9CAPTUREFREEZE1A: capture-owned inputs for both deferred parameter builders.
+ * Frozen at RAW enqueue, before DefaultSaver rearms capture/lens controls.
+ * Holds metadata only; no image, Activity, request builder or shared working Parameters.
+ */
+public final class M9CaptureParameters {
+    private static final ThreadLocal<M9CaptureParameters> ACTIVE = new ThreadLocal<>();
+    final CameraCharacteristics characteristics;
+    final String cameraId;
+    final float compressor;
+    final int cfaPattern, colorMethod;
+    final boolean rawColorCorrection, binning;
+    private final boolean dynamicBlack, dynamicWhite, disableMirror;
+    private final int whiteOverride;
+    private final float blackOverride;
+    private final SpecificSettingSensor sensor;
+
+    private M9CaptureParameters(CameraCharacteristics characteristics) {
+        if (characteristics == null) throw new IllegalArgumentException("Missing capture characteristics");
+        this.characteristics = characteristics;
+        cameraId = PhotonCamera.getSettings().mCameraID;
+        compressor = (float) PhotonCamera.getSettings().compressor;
+        cfaPattern = PhotonCamera.getSettings().cfaPattern;
+        colorMethod = PhotonCamera.getSettings().colorMethod;
+        rawColorCorrection = PhotonCamera.getSpecific().specificSetting.isRawColorCorrection;
+        binning = Allocator.binning;
+        sensor = copySensor(PhotonCamera.getSpecificSensor().selectedSensorSpecifics);
+        Parameters overrides = new Parameters();
+        TunableInjector.inject(overrides);
+        String[] ids = cameraId.split("-");
+        SensorConfigInjector.applyToSensor(String.valueOf(Integer.parseInt(ids[ids.length - 1])), overrides);
+        dynamicBlack = overrides.useDynamicBlackLevel;
+        dynamicWhite = overrides.useDynamicWhiteLevel;
+        disableMirror = overrides.disableMirror;
+        whiteOverride = overrides.whiteLevelOverride;
+        blackOverride = overrides.blackLevelOverride;
+    }
+
+    public static M9CaptureParameters freeze(CameraCharacteristics characteristics) {
+        return new M9CaptureParameters(characteristics);
+    }
+
+    static M9CaptureParameters current() { return ACTIVE.get(); }
+
+    /** The renderer and DNG worker each enter the same immutable snapshot.
+     * Nested synchronous DNG fallback restores the surrounding render scope.
+     */
+    public Scope open() { return new Scope(this); }
+
+    public static final class Scope implements AutoCloseable {
+        private final M9CaptureParameters previous;
+        private Scope(M9CaptureParameters inputs) {
+            previous = ACTIVE.get();
+            ACTIVE.set(inputs);
+        }
+        @Override public void close() {
+            if (previous == null) ACTIVE.remove(); else ACTIVE.set(previous);
+        }
+    }
+
+    void applyOverrides(Parameters p) {
+        p.useDynamicBlackLevel = dynamicBlack;
+        p.useDynamicWhiteLevel = dynamicWhite;
+        p.disableMirror = disableMirror;
+        p.whiteLevelOverride = whiteOverride;
+        p.blackLevelOverride = blackOverride;
+    }
+
+    SpecificSettingSensor sensorCopy() { return copySensor(sensor); }
+
+    // Android ColorSpaceTransform is immutable. Every mutable array is copied,
+    // including nested noise/matrix arrays; JPEG and DNG get separate working copies.
+    private static SpecificSettingSensor copySensor(SpecificSettingSensor s) {
+        if (s == null) return null;
+        SpecificSettingSensor d = new SpecificSettingSensor();
+        d.id=s.id; d.isRawColorCorrection=s.isRawColorCorrection;
+        d.blackLevel=copy(s.blackLevel); d.captureSharpeningS=s.captureSharpeningS;
+        d.captureSharpeningIntense=s.captureSharpeningIntense; d.aberrationCorrection=copy(s.aberrationCorrection);
+        d.CalibrationTransform1=copy(s.CalibrationTransform1); d.CalibrationTransform2=copy(s.CalibrationTransform2);
+        d.ColorTransform1=copy(s.ColorTransform1); d.ColorTransform2=copy(s.ColorTransform2);
+        d.ForwardMatrix1=copy(s.ForwardMatrix1); d.ForwardMatrix2=copy(s.ForwardMatrix2);
+        d.calibrationTransform1=s.calibrationTransform1; d.calibrationTransform2=s.calibrationTransform2;
+        d.colorTransform1=s.colorTransform1; d.colorTransform2=s.colorTransform2;
+        d.forwardMatrix1=s.forwardMatrix1; d.forwardMatrix2=s.forwardMatrix2;
+        d.CCTExists=s.CCTExists; d.referenceIlluminant1=s.referenceIlluminant1; d.referenceIlluminant2=s.referenceIlluminant2;
+        d.profileHueSatMapDims=copy(s.profileHueSatMapDims); d.profileLookTableDims=copy(s.profileLookTableDims);
+        d.profileHueSatMapData1=copy(s.profileHueSatMapData1); d.profileHueSatMapData2=copy(s.profileHueSatMapData2);
+        d.profileLookTableData=copy(s.profileLookTableData); d.overrideRawColors=s.overrideRawColors;
+        d.NoiseModelerArr=s.NoiseModelerArr == null ? null : new double[s.NoiseModelerArr.length][];
+        if (d.NoiseModelerArr != null) for (int i=0;i<d.NoiseModelerArr.length;i++)
+            d.NoiseModelerArr[i]=s.NoiseModelerArr[i] == null ? null : s.NoiseModelerArr[i].clone();
+        d.ModelerExists=s.ModelerExists; d.preferredResolution=copy(s.preferredResolution);
+        // ISZ is a capture-session configuration and is never read by Parameters.
+        d.iszKey=s.iszKey; d.iszZoomRatio=s.iszZoomRatio; d.hasIsz=s.hasIsz;
+        return d;
+    }
+    private static float[] copy(float[] a) { return a == null ? null : a.clone(); }
+    private static int[] copy(int[] a) { return a == null ? null : a.clone(); }
+    private static float[][] copy(float[][] a) {
+        if (a == null) return null;
+        float[][] b=new float[a.length][];
+        for (int i=0;i<a.length;i++) b[i]=copy(a[i]);
+        return b;
+    }
+}

+package com.particlesdevs.photoncamera.processing;
+
+import org.junit.Test;
+import static org.junit.Assert.*;
+
+public class M9DngNoiseProfileTest {
+    @Test public void mapsAllFourPhysicalCfasToRgbWithoutScaling() {
+        double[][] raw = {
+                {0.01,0.001, 0.02,0.004, 0.03,0.002, 0.04,0.003},
+                {0.02,0.004, 0.01,0.001, 0.04,0.003, 0.03,0.002},
+                {0.02,0.004, 0.04,0.003, 0.01,0.001, 0.03,0.002},
+                {0.04,0.003, 0.02,0.004, 0.03,0.002, 0.01,0.001}};
+        double[] expected = {0.01,0.001, 0.03,0.002, 0.04,0.003};
+        for (int cfa = 0; cfa < 4; cfa++)
+            assertArrayEquals(expected, M9DngNoiseProfile.fromCfa(raw[cfa], cfa), 0.0);
+    }
+
+    @Test public void greenKeepsCompleteHigherSlopePairNotAverageOrMaxOffset() {
+        assertArrayEquals(new double[]{1,0, 4,0.25, 2,0},
+                M9DngNoiseProfile.fromCfa(new double[]{1,0, 4,0.25, 3,0.5, 2,0}, 0), 0.0);
+    }
+
+    @Test public void equalGreenSlopesKeepFirstCfaPositionLikeAndroidDngCreator() {
+        assertArrayEquals(new double[]{1,0, 3,0.5, 2,0},
+                M9DngNoiseProfile.fromCfa(new double[]{1,0, 3,0.5, 3,0.25, 2,0}, 0), 0.0);
+        assertArrayEquals(new double[]{1,0, 3,0.25, 2,0},
+                M9DngNoiseProfile.fromCfa(new double[]{3,0.25, 1,0, 2,0, 3,0.5}, 1), 0.0);
+    }
+
+    @Test public void rejectsMissingOrUnsupportedSourceInsteadOfInventingCalibration() {
+        assertNull(M9DngNoiseProfile.fromCfa(null, 0));
+        for (int n : new int[]{0,2,6,7,9,10})
+            assertNull(M9DngNoiseProfile.fromCfa(new double[n], 0));
+        double[] good = {1,0, 2,0, 3,0, 4,0};
+        for (int cfa : new int[]{-1,4,5,6,255}) assertNull(M9DngNoiseProfile.fromCfa(good, cfa));
+    }
+
+    @Test public void rejectsInvalidCoefficientsEvenInUnselectedGreen() {
+        for (int position = 0; position < 8; position++) {
+            double[] invalid = position % 2 == 0
+                    ? new double[]{0,-1,Double.NaN,Double.POSITIVE_INFINITY,Double.NEGATIVE_INFINITY}
+                    : new double[]{-1,Double.NaN,Double.POSITIVE_INFINITY,Double.NEGATIVE_INFINITY};
+            for (double value : invalid) {
+                double[] input = {1,0, 2,0, 3,0, 4,0}; input[position] = value;
+                assertNull(M9DngNoiseProfile.fromCfa(input, 0));
+            }
+        }
+    }
+
+    @Test public void preservesSourceAndDoesNotShareOutputAcrossCaptures() {
+        double[] source = {0.01,0.001, 0.02,0.004, 0.03,0.002, 0.04,0.003};
+        double[] saved = source.clone();
+        double[] first = M9DngNoiseProfile.fromCfa(source, 0);
+        first[0] = 99;
+        double[] second = M9DngNoiseProfile.fromCfa(source, 0);
+        assertArrayEquals(saved, source, 0.0);
+        assertEquals(0.01, second[0], 0.0);
+    }
+}

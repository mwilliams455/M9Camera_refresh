+package com.particlesdevs.photoncamera.processing;
+
+/** Single-frame Camera2 CFA coefficients to DNG CFAPlaneColor RGB order. */
+public final class M9DngNoiseProfile {
+    public static final String ID = "M9DNGNOISEMETA1A_PHYSICAL_SINGLE_RAW";
+    private M9DngNoiseProfile() {}
+
+    /**
+     * Input is four (S,O) pairs in physical CFA row order, never a stacking model.
+     * Match Android DngCreator: for duplicated green, retain the complete pair
+     * having the higher S; ties retain the first channel in CFA row order.
+     * Missing/invalid calibration omits this optional tag, without guessing.
+     */
+    public static double[] fromCfa(double[] pairs, int cfa) {
+        if (pairs == null || pairs.length != 8 || cfa < 0 || cfa > 3) return null;
+        for (int i = 0; i < 8; i += 2) {
+            if (!Double.isFinite(pairs[i]) || pairs[i] <= 0.0
+                    || !Double.isFinite(pairs[i + 1]) || pairs[i + 1] < 0.0) return null;
+        }
+        final int[][] colours = {{0,1,1,2}, {1,0,2,1}, {1,2,0,1}, {2,1,1,0}};
+        double[] rgb = new double[6];
+        for (int pos = 0; pos < 4; pos++) {
+            int plane = colours[cfa][pos];
+            if (pairs[2 * pos] > rgb[2 * plane]) {
+                rgb[2 * plane] = pairs[2 * pos];
+                rgb[2 * plane + 1] = pairs[2 * pos + 1];
+            }
+        }
+        return rgb;
+    }
+}

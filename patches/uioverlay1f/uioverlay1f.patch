+++ b/app/src/test/java/com/particlesdevs/photoncamera/ui/camera/M9OverlayLayoutTest.java
@@ -0,0 +1,50 @@
+package com.particlesdevs.photoncamera.ui.camera;
+
+import static org.junit.Assert.*;
+import static org.mockito.Mockito.*;
+import org.mockito.MockedStatic;
+import com.particlesdevs.photoncamera.app.PhotonCamera;
+import com.particlesdevs.photoncamera.settings.SettingsManager;
+import com.particlesdevs.photoncamera.settings.PreferenceKeys;
+import android.app.Activity;
+import android.app.Application;
+import android.view.View;
+import com.particlesdevs.photoncamera.R;
+import org.junit.Test;
+import org.junit.runner.RunWith;
+import org.robolectric.Robolectric;
+import org.robolectric.RobolectricTestRunner;
+import org.robolectric.android.controller.ActivityController;
+import org.robolectric.annotation.Config;
+
+@RunWith(RobolectricTestRunner.class)
+@Config(sdk = 35, application = Application.class, qualifiers = "mdpi")
+public class M9OverlayLayoutTest {
+    @Test public void chevronStaysCentredWithAeLockVisibleOrHidden() {
+        try (ActivityController<Activity> controller = Robolectric.buildActivity(Activity.class).setup()) {
+            Activity activity = controller.get(); activity.setTheme(R.style.Theme_Photon_BaseApp);
+            // The real app initializes these before inflating Photon controls; this test
+            // supplies only that app service boundary, retaining real Android layout behavior.
+            try (MockedStatic<PhotonCamera> app = mockStatic(PhotonCamera.class)) {
+            app.when(() -> PhotonCamera.getStringStatic(anyInt())).thenAnswer(call -> activity.getString(call.getArgument(0)));
+            app.when(PhotonCamera::getSettingsManagerStatic).thenReturn(mock(SettingsManager.class));
+            PreferenceKeys.initialise(PhotonCamera.getSettingsManagerStatic());
+            View root = activity.getLayoutInflater().inflate(R.layout.layout_main_topbar, null);
+            View header = root.findViewById(R.id.m9_overlay_header);
+            View arrow = root.findViewById(R.id.m9_overlay_quick_controls);
+            View night = root.findViewById(R.id.m9_overlay_night);
+            View lock = root.findViewById(R.id.m9_ae_lock_button);
+            for (int width : new int[]{320, 360, 480}) for (int visibility : new int[]{View.VISIBLE, View.GONE}) {
+                lock.setVisibility(visibility);
+                root.measure(View.MeasureSpec.makeMeasureSpec(width, View.MeasureSpec.EXACTLY),
+                        View.MeasureSpec.makeMeasureSpec(0, View.MeasureSpec.UNSPECIFIED));
+                root.layout(0, 0, width, root.getMeasuredHeight());
+                assertEquals(header.getWidth() / 2f, (arrow.getLeft() + arrow.getRight()) / 2f, .5f);
+                assertTrue(night.getRight() <= arrow.getLeft());
+                if (visibility == View.VISIBLE) assertTrue(arrow.getRight() <= lock.getLeft());
+                assertTrue(arrow.getHeight() >= 48);
+            }
+            }
+        }
+    }
+}
diff --git a/app/src/test/java/com/particlesdevs/photoncamera/ui/camera/M9ShootingControlsTest.java b/app/src/test/java/com/particlesdevs/photoncamera/ui/camera/M9ShootingControlsTest.java
new file mode 100644
--- /dev/null
+++ b/app/src/test/java/com/particlesdevs/photoncamera/ui/camera/M9ShootingControlsTest.java
@@ -0,0 +1,149 @@
+package com.particlesdevs.photoncamera.ui.camera;
+
+import static org.junit.Assert.*;
+import android.app.Activity;
+import android.app.Application;
+import android.content.Context;
+import android.content.SharedPreferences;
+import android.view.View;
+import android.view.ViewGroup;
+import android.view.accessibility.AccessibilityNodeInfo;
+import androidx.appcompat.app.AlertDialog;
+import com.particlesdevs.photoncamera.R;
+import com.particlesdevs.photoncamera.m9.M9DisplayAids;
+import org.junit.After;
+import org.junit.Before;
+import org.junit.Test;
+import org.junit.runner.RunWith;
+import org.robolectric.Robolectric;
+import org.robolectric.RobolectricTestRunner;
+import org.robolectric.android.controller.ActivityController;
+import org.robolectric.annotation.Config;
+import org.robolectric.shadows.ShadowDialog;
+
+@RunWith(RobolectricTestRunner.class)
+@Config(sdk = 35, application = Application.class)
+public class M9ShootingControlsTest {
+    private ActivityController<Activity> controller;
+    private Activity activity;
+    private SharedPreferences preferences, remembered;
+    private FakeHost host;
+    private M9ShootingControls panel;
+
+    @Before public void setUp() {
+        controller = Robolectric.buildActivity(Activity.class).setup();
+        activity = controller.get(); activity.setTheme(R.style.Theme_Photon_BaseApp);
+        preferences = activity.getSharedPreferences("shooting_test", Context.MODE_PRIVATE);
+        remembered = activity.getSharedPreferences("shooting_test_ui", Context.MODE_PRIVATE);
+        preferences.edit().clear().commit(); remembered.edit().clear().commit();
+        host = new FakeHost();
+        panel = new M9ShootingControls(activity, preferences, remembered, host);
+        activity.setContentView(panel);
+    }
+    @After public void tearDown() { panel.close(); controller.close(); }
+
+    @Test public void timerAndGridRestoreLastChoiceAcrossPanelRecreation() {
+        host.timer = 2; host.grid = 4; panel.refresh();
+        tile(R.string.m9_overlay_timer).performClick();
+        tile(R.string.m9_overlay_grid).performClick();
+        assertEquals(0, host.timer); assertEquals(0, host.grid);
+        panel.close(); panel = new M9ShootingControls(activity, preferences, remembered, host);
+        tile(R.string.m9_overlay_timer).performClick();
+        tile(R.string.m9_overlay_grid).performClick();
+        assertEquals(2, host.timer); assertEquals(4, host.grid);
+    }
+
+    @Test public void histogramTogglePreservesCameraInfoAndRgbChoice() {
+        preferences.edit().putString(M9DisplayAids.MODE_KEY, "2").commit();
+        tile(R.string.m9_display_histogram).performClick();
+        assertEquals("1", preferences.getString(M9DisplayAids.MODE_KEY, ""));
+        tile(R.string.m9_display_histogram).performClick();
+        assertEquals("2", preferences.getString(M9DisplayAids.MODE_KEY, ""));
+    }
+
+    @Test public void clippingTogglesKeepThresholdsAndZeroPercentShadowIsOn() {
+        preferences.edit().putString(M9DisplayAids.HIGHLIGHT_KEY, "97")
+                .putString(M9DisplayAids.SHADOW_KEY, "0").commit();
+        panel.refresh();
+        assertTrue(tile(R.string.m9_shooting_shadows).isSelected());
+        tile(R.string.m9_shooting_highlights).performClick();
+        tile(R.string.m9_shooting_shadows).performClick();
+        assertEquals("0", preferences.getString(M9DisplayAids.HIGHLIGHT_KEY, ""));
+        assertEquals("-1", preferences.getString(M9DisplayAids.SHADOW_KEY, ""));
+        tile(R.string.m9_shooting_highlights).performClick();
+        tile(R.string.m9_shooting_shadows).performClick();
+        assertEquals("97", preferences.getString(M9DisplayAids.HIGHLIGHT_KEY, ""));
+        assertEquals("0", preferences.getString(M9DisplayAids.SHADOW_KEY, ""));
+    }
+
+    @Test public void busyAndUnsupportedActionsCannotChangeState() {
+        host.ready = false; panel.refresh();
+        tile(R.string.m9_overlay_timer).performClick();
+        tile(R.string.m9_shooting_highlights).performClick();
+        assertEquals(0, host.timer); assertTrue(preferences.getAll().isEmpty());
+        host.ready = true; host.display = false; host.auto = false; panel.refresh();
+        tile(R.string.m9_display_histogram).performClick();
+        tile(R.string.m9_shooting_lens_lock).performClick();
+        assertEquals(0, host.lockToggles); assertTrue(preferences.getAll().isEmpty());
+        assertFalse(tile(R.string.m9_display_histogram).isEnabled());
+    }
+
+    @Test public void lockUsesRealActionAndExposesCheckedState() {
+        tile(R.string.m9_shooting_lens_lock).performClick();
+        assertEquals(1, host.lockToggles);
+        AccessibilityNodeInfo info = tile(R.string.m9_shooting_lens_lock).createAccessibilityNodeInfo();
+        assertTrue(info.isCheckable()); assertTrue(info.isChecked());
+        assertEquals("On", info.getStateDescription().toString());
+    }
+
+    @Test public void holdChoosesTimerAndBusyStateBlocksOpenDialogAction() {
+        tile(R.string.m9_overlay_timer).performLongClick();
+        AlertDialog dialog = (AlertDialog) ShadowDialog.getLatestDialog();
+        assertTrue(dialog.isShowing());
+        dialog.getListView().performItemClick(null, 2, 2);
+        assertEquals(2, host.timer); assertFalse(dialog.isShowing());
+        tile(R.string.m9_overlay_timer).performLongClick();
+        dialog = (AlertDialog) ShadowDialog.getLatestDialog();
+        host.ready = false;
+        dialog.getListView().performItemClick(null, 0, 0);
+        assertEquals(2, host.timer); assertFalse(dialog.isShowing());
+    }
+
+    @Test public void closeDismissesChoicesAndInvalidRememberedValueFallsBack() {
+        remembered.edit().putInt("quick_last_0", 99).commit();
+        tile(R.string.m9_overlay_timer).performClick();
+        assertEquals(1, host.timer);
+        tile(R.string.m9_overlay_grid).performLongClick();
+        android.app.Dialog dialog = ShadowDialog.getLatestDialog();
+        panel.close(); assertFalse(dialog.isShowing());
+    }
+
+    private View tile(int label) {
+        View result = find(panel, activity.getString(label));
+        assertNotNull(result); return result;
+    }
+    private View find(View root, String description) {
+        if (description.contentEquals(root.getContentDescription() == null ? "" : root.getContentDescription())) return root;
+        if (root instanceof ViewGroup) for (int i = 0; i < ((ViewGroup) root).getChildCount(); i++) {
+            View found = find(((ViewGroup) root).getChildAt(i), description);
+            if (found != null) return found;
+        }
+        return null;
+    }
+    private static final class FakeHost implements M9ShootingControls.Host {
+        int timer, grid, lockToggles;
+        boolean ready = true, display = true, auto = true, locked;
+        public boolean available() { return ready; }
+        public int timer() { return timer; }
+        public void timer(int index) { timer = index; }
+        public int grid() { return grid; }
+        public void grid(int index) { grid = index; }
+        public boolean displayAvailable() { return display; }
+        public boolean lockAvailable() { return auto; }
+        public boolean locked() { return locked; }
+        public boolean autoSwitch() { return auto; }
+        public void toggleLock() { lockToggles++; locked = !locked; }
+        public void otherModes() {}
+        public void dismiss() {}
+    }
+}

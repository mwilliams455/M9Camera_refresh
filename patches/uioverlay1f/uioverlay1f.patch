--- /dev/null
+++ b/app/src/main/java/com/particlesdevs/photoncamera/ui/camera/M9ShootingControls.java
@@ -0,0 +1,226 @@
+package com.particlesdevs.photoncamera.ui.camera;
+
+import android.app.Dialog;
+import android.content.Context;
+import android.content.SharedPreferences;
+import android.graphics.Typeface;
+import android.graphics.drawable.GradientDrawable;
+import android.view.Gravity;
+import android.view.View;
+import android.view.accessibility.AccessibilityNodeInfo;
+import android.widget.ImageView;
+import android.widget.LinearLayout;
+import android.widget.TextView;
+import androidx.core.view.ViewCompat;
+import com.google.android.material.dialog.MaterialAlertDialogBuilder;
+import com.particlesdevs.photoncamera.R;
+import com.particlesdevs.photoncamera.m9.M9DisplayAids;
+
+/** Camera-only quick panel. Its state comes from the existing controls/preferences. */
+final class M9ShootingControls extends LinearLayout implements AutoCloseable {
+    interface Host {
+        boolean available();
+        int timer();
+        void timer(int index);
+        int grid();
+        void grid(int index);
+        boolean displayAvailable();
+        boolean lockAvailable();
+        boolean locked();
+        boolean autoSwitch();
+        void toggleLock();
+        void otherModes();
+        void dismiss();
+    }
+
+    private final Host host;
+    private final SharedPreferences preferences, remembered;
+    private final Tile[] tiles = new Tile[6];
+    private final int[] labels = {R.string.m9_overlay_timer, R.string.m9_overlay_grid,
+            R.string.m9_display_histogram, R.string.m9_shooting_highlights,
+            R.string.m9_shooting_shadows, R.string.m9_shooting_lens_lock};
+    private Dialog choices;
+
+    M9ShootingControls(Context context, SharedPreferences preferences,
+                       SharedPreferences remembered, Host host) {
+        super(context);
+        this.host = host; this.preferences = preferences; this.remembered = remembered;
+        setOrientation(VERTICAL);
+        setPadding(dp(12), dp(8), dp(12), dp(12));
+        setBackground(surface(0xFF171719, 20));
+        LinearLayout heading = new LinearLayout(context);
+        TextView title = text(context.getString(R.string.m9_overlay_quick_controls), 16, 0xFFFFFFFF);
+        title.setTypeface(null, Typeface.BOLD);
+        heading.addView(title, new LayoutParams(0, dp(48), 1));
+        TextView close = text("×", 26, 0xFFFFFFFF);
+        close.setGravity(Gravity.CENTER);
+        close.setContentDescription(context.getString(R.string.m9_overlay_close));
+        close.setOnClickListener(v -> host.dismiss());
+        heading.addView(close, new LayoutParams(dp(48), dp(48)));
+        addView(heading);
+        int[] icons = {R.drawable.m9_overlay_timer, R.drawable.ic_grid_on, R.drawable.ic_m9_display_aids,
+                R.drawable.m9_overlay_highlights, R.drawable.m9_overlay_shadows, R.drawable.ic_zoom_lock};
+        for (int row = 0; row < 2; row++) {
+            LinearLayout line = new LinearLayout(context);
+            for (int column = 0; column < 3; column++) {
+                int index = row * 3 + column;
+                Tile tile = new Tile(context, labels[index], icons[index]);
+                tiles[index] = tile;
+                tile.setOnClickListener(v -> toggle(index));
+                if (index < 5) tile.setOnLongClickListener(v -> { choose(index); return true; });
+                LayoutParams lp = new LayoutParams(0, LayoutParams.WRAP_CONTENT, 1);
+                lp.setMargins(dp(3), dp(3), dp(3), dp(3));
+                line.addView(tile, lp);
+            }
+            addView(line);
+        }
+        TextView hint = text(context.getString(R.string.m9_shooting_hint), 12, 0xFFB0B0B6);
+        hint.setGravity(Gravity.CENTER);
+        hint.setPadding(0, dp(10), 0, dp(6));
+        addView(hint);
+        TextView more = text(context.getString(R.string.m9_overlay_more_modes) + "  ›", 14, 0xFFFFFFFF);
+        more.setGravity(Gravity.CENTER);
+        more.setMinHeight(dp(48));
+        more.setOnClickListener(v -> { if (host.available()) host.otherModes(); });
+        addView(more);
+        refresh();
+    }
+
+    private String[] entries(int index) {
+        if (index == 0) return new String[]{getContext().getString(R.string.off), "2 s", "12 s"};
+        int[] arrays = {0, R.array.vf_grid_entries, R.array.m9_histogram_choices,
+                R.array.m9_highlight_entries, R.array.m9_shadow_entries};
+        return getResources().getStringArray(arrays[index]);
+    }
+
+    private int current(int index) {
+        M9DisplayAids.Settings aids = M9DisplayAids.read(preferences.getAll());
+        switch (index) {
+            case 0: return host.timer();
+            case 1: return host.grid();
+            case 2: return aids.histogram();
+            case 3: return aids.highlights == 0 ? 0 : 101 - aids.highlights;
+            case 4: return aids.shadows + 1;
+            default: return host.locked() ? 1 : 0;
+        }
+    }
+
+    private boolean supported(int index) {
+        return index >= 2 && index <= 4 ? host.displayAvailable()
+                : index != 5 || host.lockAvailable();
+    }
+
+    void refresh() {
+        boolean ready = host.available();
+        for (int index = 0; index < tiles.length; index++) {
+            int value = current(index);
+            boolean supported = supported(index);
+            String state = index == 5 ? getContext().getString(value == 0 ? R.string.off : R.string.on)
+                    : entries(index)[Math.max(0, Math.min(value, entries(index).length - 1))];
+            if (!supported) state = getContext().getString(index == 5 && !host.autoSwitch()
+                    ? R.string.m9_shooting_fixed_lock : R.string.m9_shooting_unavailable);
+            tiles[index].bind(value != 0, ready && supported, state);
+        }
+    }
+
+    private void toggle(int index) {
+        if (!host.available() || !supported(index)) return;
+        if (index == 5) host.toggleLock();
+        else {
+            int value = current(index);
+            if (value > 0) {
+                remembered.edit().putInt("quick_last_" + index, value).apply();
+                apply(index, 0);
+            } else {
+                int fallback = index == 2 ? 2 : 1;
+                int last = remembered.getInt("quick_last_" + index, fallback);
+                apply(index, last > 0 && last < entries(index).length ? last : fallback);
+            }
+        }
+        refresh();
+    }
+
+    private void apply(int index, int value) {
+        if (index == 0) host.timer(value);
+        else if (index == 1) host.grid(value);
+        else {
+            M9DisplayAids.Settings aids = M9DisplayAids.read(preferences.getAll());
+            String key = index == 2 ? M9DisplayAids.MODE_KEY
+                    : index == 3 ? M9DisplayAids.HIGHLIGHT_KEY : M9DisplayAids.SHADOW_KEY;
+            int stored = index == 2 ? M9DisplayAids.withHistogram(aids.mode, value)
+                    : index == 3 ? (value == 0 ? 0 : 101 - value) : value - 1;
+            preferences.edit().putString(key, Integer.toString(stored)).apply();
+        }
+    }
+
+    private void choose(int index) {
+        if (!host.available() || !supported(index)) return;
+        close();
+        choices = new MaterialAlertDialogBuilder(getContext()).setTitle(labels[index])
+                .setSingleChoiceItems(entries(index), current(index), (dialog, value) -> {
+                    if (!host.available() || !supported(index)) { close(); return; }
+                    int previous = current(index);
+                    if (value > 0 || previous > 0)
+                        remembered.edit().putInt("quick_last_" + index, value > 0 ? value : previous).apply();
+                    apply(index, value);
+                    close();
+                    refresh();
+                }).setNegativeButton(android.R.string.cancel, null).create();
+        choices.show();
+    }
+
+    @Override public void close() {
+        if (choices != null) choices.dismiss();
+        choices = null;
+    }
+
+    private TextView text(String value, int size, int color) {
+        TextView text = new TextView(getContext());
+        text.setText(value); text.setTextSize(size); text.setTextColor(color);
+        text.setGravity(Gravity.CENTER_VERTICAL);
+        return text;
+    }
+    private GradientDrawable surface(int color, int radius) {
+        GradientDrawable shape = new GradientDrawable();
+        shape.setColor(color); shape.setCornerRadius(dp(radius));
+        return shape;
+    }
+    private int dp(int value) { return Math.round(value * getResources().getDisplayMetrics().density); }
+
+    private final class Tile extends LinearLayout {
+        private final TextView state;
+        private final String label;
+        Tile(Context context, int labelId, int iconId) {
+            super(context);
+            label = context.getString(labelId);
+            setOrientation(VERTICAL); setGravity(Gravity.CENTER);
+            setPadding(dp(4), dp(10), dp(4), dp(10)); setMinimumHeight(dp(100));
+            setFocusable(true); setClipToOutline(true);
+            ImageView icon = new ImageView(context);
+            icon.setImageResource(iconId); icon.setColorFilter(0xFFFFFFFF);
+            addView(icon, new LayoutParams(dp(24), dp(24)));
+            TextView name = text(label, 12, 0xFFFFFFFF);
+            name.setGravity(Gravity.CENTER); name.setPadding(0, dp(6), 0, 0);
+            addView(name);
+            state = text("", 11, 0xFFB0B0B6);
+            state.setGravity(Gravity.CENTER); addView(state);
+            for (int i = 0; i < getChildCount(); i++)
+                getChildAt(i).setImportantForAccessibility(View.IMPORTANT_FOR_ACCESSIBILITY_NO);
+            setContentDescription(label);
+        }
+        void bind(boolean checked, boolean enabled, String value) {
+            if (getBackground() == null || checked != isSelected())
+                setBackground(surface(checked ? 0xFF424247 : 0xFF242427, 12));
+            setSelected(checked); setEnabled(enabled); setAlpha(enabled ? 1f : .45f);
+            if (!value.contentEquals(state.getText())) {
+                state.setText(value);
+                ViewCompat.setStateDescription(this, value);
+            }
+        }
+        @Override public void onInitializeAccessibilityNodeInfo(AccessibilityNodeInfo info) {
+            super.onInitializeAccessibilityNodeInfo(info);
+            info.setClassName("android.widget.Switch");
+            info.setCheckable(true); info.setChecked(isSelected());
+        }
+    }
+}

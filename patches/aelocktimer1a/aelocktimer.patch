+import java.util.Objects;
+
+/** Leica M9 delay choices; stored preference remains the existing 0/1/2 index. */
+public final class M9SelfTimer1A {
+    public static final String REVISION="M9SELFTIMER1A";
+    private M9SelfTimer1A() {}
+    public static int index(int value) { return value>=0 && value<=2 ? value : 0; }
+    public static int seconds(int index) { return index==1 ? 2 : index==2 ? 12 : 0; }
+
+    /** One release per countdown, including queued completions after cancel/restart/session switch. */
+    public static final class Gate {
+        private long generation;
+        private boolean running;
+        private String context;
+        public long start(String context) { this.context=context; running=true; return ++generation; }
+        public boolean running() { return running; }
+        public void cancel() { running=false; generation++; }
+        public boolean finish(long ticket, String currentContext) {
+            if (!running || ticket!=generation) return false;
+            running=false;
+            return Objects.equals(context,currentContext);
+        }
+    }
+}

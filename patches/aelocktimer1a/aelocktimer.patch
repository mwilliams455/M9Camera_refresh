+package com.particlesdevs.photoncamera.m9;
+
+import java.util.Objects;
+
+/** Session-scoped metering memory. The displayed physical exposure is the lock authority. */
+public final class M9AeLock1A {
+    public static final String REVISION = "M9AELOCK1A";
+    public static final class Context {
+        public final String camera, mode, autoIsoIdentity, policy;
+        public final long session, manualTime;
+        public final int manualIso;
+        public final double ev;
+        public Context(String camera, String mode, long session, double ev, long manualTime,
+                int manualIso, String autoIsoIdentity, String policy) {
+            this.camera=camera; this.mode=mode; this.session=session; this.ev=ev;
+            this.manualTime=manualTime; this.manualIso=manualIso;
+            this.autoIsoIdentity=autoIsoIdentity; this.policy=policy;
+        }
+        @Override public boolean equals(Object other) {
+            if (!(other instanceof Context)) return false;
+            Context c=(Context)other;
+            return session==c.session && Double.doubleToLongBits(ev)==Double.doubleToLongBits(c.ev)
+                    && manualTime==c.manualTime && manualIso==c.manualIso
+                    && Objects.equals(camera,c.camera) && Objects.equals(mode,c.mode)
+                    && Objects.equals(autoIsoIdentity,c.autoIsoIdentity) && Objects.equals(policy,c.policy);
+        }
+        @Override public int hashCode() {
+            return Objects.hash(camera,mode,session,ev,manualTime,manualIso,autoIsoIdentity,policy);
+        }
+    }
+    private Context context;
+    private long generation=1;
+    private M9ExposurePlan1A source;
+
+    public synchronized long context(Context next) {
+        if (!Objects.equals(context,next)) { context=next; source=null; generation++; }
+        return generation;
+    }
+    public synchronized boolean isLocked() { return source!=null; }
+    public synchronized void clear() { source=null; generation++; }
+
+    public synchronized boolean engage(M9ExposurePlan1A displayed, Context current, long nowMs) {
+        context(current);
+        if (current==null || current.manualTime>0 || !M9ExposurePlan1A.supportsMode1B(current.mode)
+                || !accepts(displayed,current,nowMs)) return false;
+        source=displayed; generation++;
+        return true;
+    }
+
+    /** Reject work computed across a toggle, control edit, or session boundary. */
+    public synchronized M9ExposurePlan1A stamp(M9ExposurePlan1A plan, Context expected, long token) {
+        if (plan==null || token!=generation || !Objects.equals(context,expected)) return null;
+        if (source!=null) return plan.aeLockGeneration==token && plan.aeLockSourcePlanId==source.id ? plan : null;
+        return plan.withAeLockState(token,0L);
+    }
+
+    public synchronized boolean accepts(M9ExposurePlan1A plan, Context current, long nowMs) {
+        context(current);
+        return current!=null && plan!=null && plan.aeLockGeneration==generation
+                && plan.aeLockSourcePlanId==(source==null ? 0L : source.id)
+                && plan.matches(current.camera,current.mode,nowMs,current.ev,current.manualTime,current.manualIso)
+                && plan.matchesAutoIsoControls(current.autoIsoIdentity);
+    }
+
+    /** Fresh observations refresh preview simulation and the neutral measurement reference. ISO/time stay held. */
+    public synchronized M9ExposurePlan1A project(Context expected, long token, long id, long nowMs,
+            long sensorTimestampNs, int observedIso, long observedTime, int boost, int referenceIso, long referenceTime) {
+        if (source==null || token!=generation || !Objects.equals(context,expected)
+                || observedIso<=0 || observedTime<=0 || referenceIso<=0 || referenceTime<=0) return null;
+        return new M9ExposurePlan1A(id,nowMs,sensorTimestampNs,source.cameraId,source.mode,
+                observedIso,observedTime,referenceIso,referenceTime,
+                source.iso,source.exposureNs,source.userEv,source.autoEv,"metering_memory_lock",
+                source.manualExposureNs,source.manualIso,boost>0?boost:100)
+                .withAutoIsoControls(source.getAutoIsoControlsIdentity())
+                .withAllocationSnapshot2G(source.getAllocationSnapshot2G())
+                .withAutoPlacement2D(source.getAutoPlacementSnapshot2D())
+                .withAeLockState(generation,source.id);
+    }
+}

diff --git a/app/src/test/java/com/particlesdevs/photoncamera/m9/M9AeLockTest.java b/app/src/test/java/com/particlesdevs/photoncamera/m9/M9AeLockTest.java
new file mode 100644
--- /dev/null
+++ b/app/src/test/java/com/particlesdevs/photoncamera/m9/M9AeLockTest.java
@@ -0,0 +1,119 @@
+package com.particlesdevs.photoncamera.m9;
+
+import org.junit.Test;
+import org.json.JSONObject;
+import static org.junit.Assert.*;
+
+public class M9AeLockTest {
+    private static M9AeLock1A.Context context(String camera, String mode, long session,
+            double ev, long manualTime, int manualIso, int maximum, String policy) {
+        return new M9AeLock1A.Context(camera,mode,session,ev,manualTime,manualIso,
+                new M9AutoIsoSettings(maximum,1).resolve(24,36).identity,policy);
+    }
+    private static M9AeLock1A.Context normal() { return context("0","PHOTO",1,-1.0/3,0,0,800,"default"); }
+    private static M9ExposurePlan1A candidate(M9AeLock1A.Context c, long id, long now) {
+        return new M9ExposurePlan1A(id,now,now*1000000,c.camera,c.mode,200,16000000L,
+                400,8000000L,320,8000000L,c.ev,0.2,"auto_placement",c.manualTime,c.manualIso,100)
+                .withAutoIsoControls(c.autoIsoIdentity).withAllocationSnapshot2G("{\"source\":true}")
+                .withAutoPlacement2D("{\"meter\":true}");
+    }
+    private static M9ExposurePlan1A publish(M9AeLock1A lock, M9AeLock1A.Context c, long now) {
+        long generation=lock.context(c); return lock.stamp(candidate(c,now,now),c,generation);
+    }
+    private static M9ExposurePlan1A hold(M9AeLock1A lock, M9AeLock1A.Context c) {
+        M9ExposurePlan1A shown=publish(lock,c,100); assertTrue(lock.engage(shown,c,110)); return shown;
+    }
+    @Test public void locksDisplayedPairWithLiveReferenceAcrossFreshObservationsForMultipleShots() {
+        M9AeLock1A lock=new M9AeLock1A(); M9AeLock1A.Context c=normal();
+        M9ExposurePlan1A shown=hold(lock,c);
+        for (int n=1;n<=120;n++) {
+            long now=1000L*n;
+            M9ExposurePlan1A held=lock.project(c,lock.context(c),now,now,now*1000000,
+                    n*10,10000000L,100,n*10,10000000L);
+            assertNotNull(held); assertTrue(lock.accepts(held,c,now+10));
+            assertEquals(shown.id,held.aeLockSourcePlanId); assertEquals(shown.iso,held.iso);
+            assertEquals(shown.exposureNs,held.exposureNs);
+            assertEquals(n*10,held.referenceIso);
+            assertEquals(10000000L,held.referenceExposureNs);
+            assertEquals(shown.autoEv,held.autoEv,0); assertEquals(shown.userEv,held.userEv,0);
+            assertEquals(held.iso*held.exposureNs/(double)(n*10*10000000L),held.previewScale(),1e-12);
+            assertEquals(held.previewScale(),held.renderIntentScale(held.iso,held.exposureNs),0);
+        }
+        assertTrue(lock.isLocked());
+    }
+    @Test public void freshLockedPlanExpiresIfObservationsStop() {
+        M9AeLock1A lock=new M9AeLock1A(); M9AeLock1A.Context c=normal(); hold(lock,c);
+        M9ExposurePlan1A p=lock.project(c,lock.context(c),2000,2000,1,100,2000000L,100,100,2000000L);
+        assertTrue(lock.accepts(p,c,3500)); assertFalse(lock.accepts(p,c,3501));
+        assertNull(lock.project(c,lock.context(c),1,2,3,0,1000000L,100,100,1000000L));
+    }
+    @Test public void refusesMissingStaleUndisplayedAndManualShutterPlans() {
+        M9AeLock1A lock=new M9AeLock1A(); M9AeLock1A.Context c=normal();
+        assertFalse(lock.engage(null,c,100));
+        assertFalse(lock.engage(candidate(c,100,100),c,100));
+        M9ExposurePlan1A p=publish(lock,c,100); assertFalse(lock.engage(p,c,1601));
+        M9AeLock1A.Context manual=context("0","PHOTO",1,0,10000000L,0,800,"default");
+        assertFalse(lock.engage(publish(lock,manual,100),manual,101));
+        M9AeLock1A.Context video=context("0","VIDEO",1,0,0,0,800,"default");
+        assertFalse(lock.engage(publish(lock,video,100),video,101));
+    }
+    @Test public void manualIsoWithAutomaticShutterCanLock() {
+        M9AeLock1A lock=new M9AeLock1A();
+        M9AeLock1A.Context c=context("0","PHOTO",1,0,0,320,800,"default");
+        hold(lock,c); assertTrue(lock.isLocked());
+    }
+    @Test public void changedExposureControlsCameraModeOrSessionClearAndRejectOldPlan() {
+        M9AeLock1A.Context[] changes={
+            context("1","PHOTO",1,-1.0/3,0,0,800,"default"),
+            context("0","MOTION",1,-1.0/3,0,0,800,"default"),
+            context("0","PHOTO",2,-1.0/3,0,0,800,"default"),
+            context("0","PHOTO",1,0,0,0,800,"default"),
+            context("0","PHOTO",1,-1.0/3,1000000L,0,800,"default"),
+            context("0","PHOTO",1,-1.0/3,0,200,800,"default"),
+            context("0","PHOTO",1,-1.0/3,0,0,400,"default"),
+            context("0","PHOTO",1,-1.0/3,0,0,800,"torch"),
+            new M9AeLock1A.Context("0","PHOTO",1,-1.0/3,0,0,
+                    new M9AutoIsoSettings(800,5).resolve(24,36).identity,"default")};
+        for (M9AeLock1A.Context next:changes) {
+            M9AeLock1A lock=new M9AeLock1A();M9AeLock1A.Context c=normal();hold(lock,c);
+            M9ExposurePlan1A p=lock.project(c,lock.context(c),120,120,1,100,10000000L,100,100,10000000L);
+            assertFalse(lock.accepts(p,next,121));assertFalse(lock.isLocked());
+            assertFalse(lock.accepts(p,c,122));
+        }
+    }
+    @Test public void racingPlansCannotCrossEngageUnlockOrReopen() {
+        M9AeLock1A lock=new M9AeLock1A();M9AeLock1A.Context c=normal();
+        long before=lock.context(c);M9ExposurePlan1A old=publish(lock,c,100);
+        assertTrue(lock.engage(old,c,101));assertFalse(lock.accepts(old,c,102));
+        assertNull(lock.stamp(candidate(c,102,102),c,before));
+        long heldToken=lock.context(c);M9ExposurePlan1A held=lock.project(c,heldToken,103,103,1,100,10000000L,100,100,10000000L);
+        lock.clear();assertFalse(lock.accepts(held,c,104));assertNull(lock.stamp(held,c,heldToken));
+        M9ExposurePlan1A fresh=publish(lock,c,105);assertTrue(lock.accepts(fresh,c,106));
+        assertEquals(0,fresh.aeLockSourcePlanId);assertEquals(fresh.previewScale(),candidate(c,105,105).previewScale(),0);
+        lock.context(context("0","PHOTO",2,-1.0/3,0,0,800,"default"));
+        assertFalse(lock.accepts(fresh,c,107));
+    }
+    @Test public void liveNeutralReferencePreventsToneNormalizationFromUndoingPhysicalLock() {
+        M9AeLock1A lock=new M9AeLock1A();M9AeLock1A.Context c=normal();hold(lock,c);
+        long token=lock.context(c);
+        M9ExposurePlan1A first=lock.project(c,token,200,200,1,400,8000000L,100,400,8000000L);
+        // Scene becomes one stop brighter: neutral AE halves its exposure, held RAW doubles its median.
+        M9ExposurePlan1A brighter=lock.project(c,token,300,300,2,200,8000000L,100,200,8000000L);
+        double gainBefore=M9ExposurePlan1A.neutralBaseGain(.08,first.renderIntentScale(first.iso,first.exposureNs),.18);
+        double gainAfter=M9ExposurePlan1A.neutralBaseGain(.16,brighter.renderIntentScale(brighter.iso,brighter.exposureNs),.18);
+        assertEquals(first.iso,brighter.iso);assertEquals(first.exposureNs,brighter.exposureNs);
+        assertEquals(gainBefore,gainAfter,1e-12);
+        assertEquals(2.0,(.16*gainAfter)/(.08*gainBefore),1e-12);
+    }
+
+    @Test public void allPlanCopiesKeepLockIdentityAndDiagnostics() throws Exception {
+        M9AeLock1A lock=new M9AeLock1A();M9AeLock1A.Context c=normal();hold(lock,c);
+        M9ExposurePlan1A p=lock.project(c,lock.context(c),200,200,1,100,10000000L,100,100,10000000L)
+                .withAllocationSnapshot2G("{}").withAutoPlacement2D("{}")
+                .withAutoIsoControls(c.autoIsoIdentity).withShutterPreviewSnapshot1W("{}");
+        assertTrue(lock.accepts(p,c,201));
+        JSONObject json=M9ExposurePlanDiagnostics1A.toJson(p);
+        assertTrue(json.getBoolean("aeLockHeld")); assertEquals(100,json.getLong("aeLockSourcePlanId"));
+        assertEquals(p.aeLockGeneration,json.getLong("aeLockGeneration"));
+    }
+}

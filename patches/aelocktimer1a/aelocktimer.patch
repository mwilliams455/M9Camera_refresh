+++ b/app/src/test/java/com/particlesdevs/photoncamera/m9/M9SelfTimerTest.java
@@ -0,0 +1,47 @@
+package com.particlesdevs.photoncamera.m9;
+
+import org.junit.Test;
+import static org.junit.Assert.*;
+
+public class M9SelfTimerTest {
+    @Test public void storedIndicesUseLeicaDelaysAndInvalidDataMeansOff() {
+        assertEquals(0,M9SelfTimer1A.seconds(0));assertEquals(2,M9SelfTimer1A.seconds(1));
+        assertEquals(12,M9SelfTimer1A.seconds(2));
+        for (int bad:new int[]{-1,3,12,Integer.MAX_VALUE}) {
+            assertEquals(0,M9SelfTimer1A.index(bad)); assertEquals(0,M9SelfTimer1A.seconds(bad));
+        }
+    }
+    @Test public void finishCanReleaseOnceOnlyIncludingZeroDelay() {
+        M9SelfTimer1A.Gate gate=new M9SelfTimer1A.Gate();
+        for (int index=0;index<3;index++) {
+            long ticket=gate.start("main:PHOTO:session1"); assertTrue(gate.running());
+            assertTrue(gate.finish(ticket,"main:PHOTO:session1"));
+            assertFalse(gate.running()); assertFalse(gate.finish(ticket,"main:PHOTO:session1"));
+        }
+    }
+    @Test public void canceledCallbacksCannotCaptureOrCancelReplacementTimer() {
+        M9SelfTimer1A.Gate gate=new M9SelfTimer1A.Gate();
+        long old=gate.start("main");gate.cancel();assertFalse(gate.finish(old,"main"));
+        long fresh=gate.start("main"); assertFalse(gate.finish(old,"main"));assertTrue(gate.running());
+        assertTrue(gate.finish(fresh,"main"));
+    }
+    @Test public void lensModeSessionAndPauseChangesSuppressRelease() {
+        for (String next:new String[]{"tele:PHOTO:1:true","main:VIDEO:1:true","main:PHOTO:2:true","main:PHOTO:1:false"}) {
+            M9SelfTimer1A.Gate gate=new M9SelfTimer1A.Gate();
+            long ticket=gate.start("main:PHOTO:1:true");assertFalse(gate.finish(ticket,next));assertFalse(gate.running());
+        }
+    }
+    @Test public void heldExposureCanRemainFreshAcrossTwelveSecondCountdown() {
+        M9AeLock1A lock=new M9AeLock1A();String iso=new M9AutoIsoSettings(800,1).resolve(24,36).identity;
+        M9AeLock1A.Context context=new M9AeLock1A.Context("0","PHOTO",1,0,0,0,iso,"default");
+        long generation=lock.context(context);
+        M9ExposurePlan1A first=new M9ExposurePlan1A(1,100,1,"0","PHOTO",400,20000000L,
+                400,20000000L,400,20000000L,0,0,"auto",0,0,100).withAutoIsoControls(iso);
+        first=lock.stamp(first,context,generation);assertTrue(lock.engage(first,context,101));
+        M9SelfTimer1A.Gate gate=new M9SelfTimer1A.Gate();long ticket=gate.start("session1");
+        M9ExposurePlan1A release=lock.project(context,lock.context(context),2,12101,12101000000L,1600,40000000L,100,1600,40000000L);
+        assertTrue(gate.finish(ticket,"session1"));assertTrue(lock.accepts(release,context,12102));
+        assertEquals(400,release.iso);assertEquals(20000000L,release.exposureNs);
+        assertNotEquals(first.observedIso,release.observedIso);
+    }
+}

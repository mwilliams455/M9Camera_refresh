+/**
+ * EXACTPERF1A: row-band parallel execution of the frozen SHADINGLUMADECOMP1A
+ * per-pixel lens-shading arithmetic.
+ *
+ * <p>Each output sample depends only on its own input sample, its row and column
+ * coordinates and the immutable gain table. Every pixel therefore performs the
+ * same double-precision operations, in the same order, as the serial loop it
+ * replaces; only the order in which independent rows are visited changes. The
+ * three counters are integer sums and are order-independent. The Bayer plane is
+ * read from a 2x2 table built with the same resolver the serial loop called per
+ * pixel; that resolver depends only on the sample's row and column parity.</p>
+ */
+final class M9ShadingParallel1A {
+    static final String REVISION = "M9EXACTPERF1A_SHADING_ROWBANDS_EXACT";
+    static final int WORKERS =
+            Math.max(2, Math.min(8, Runtime.getRuntime().availableProcessors()));
+    private static final int BANDS_PER_WORKER = 4;
+
+    private static final AtomicInteger THREAD_ID = new AtomicInteger();
+    private static final ThreadFactory THREADS = runnable -> {
+        Thread t = new Thread(runnable, "M9ShadingRows-" + THREAD_ID.incrementAndGet());
+        t.setDaemon(true);
+        return t;
+    };
+    private static volatile ExecutorService pool;
+
+    private M9ShadingParallel1A() {}
+
+    static final class Counts {
+        final long corrected;
+        final long aboveNominal;
+        final long postClip;
+
+        Counts(long corrected, long aboveNominal, long postClip) {
+            this.corrected = corrected;
+            this.aboveNominal = aboveNominal;
+            this.postClip = postClip;
+        }
+    }
+
+    /** RGGB at origin 0: the serial loop's plane is (y&1)*2+(x&1). */
+    static int[] identityPlanes() {
+        return new int[] {0, 1, 2, 3};
+    }
+
+    /** Generic Bayer: the serial loop's per-pixel resolver, evaluated once per 2x2 site. */
+    static int[] bayerPlanes(int cfaPattern, int originX, int originY) {
+        int[] planes = new int[4];
+        for (int py = 0; py < 2; py++) {
+            for (int px = 0; px < 2; px++) {
+                planes[py * 2 + px] =
+                        M9CfaResolver.lensShadingChannelAt(px, py, cfaPattern, originX, originY);
+            }
+        }
+        return planes;
+    }
+
+    private static ExecutorService pool() {
+        ExecutorService current = pool;
+        if (current == null) {
+            synchronized (M9ShadingParallel1A.class) {
+                current = pool;
+                if (current == null) {
+                    current = Executors.newFixedThreadPool(WORKERS, THREADS);
+                    pool = current;
+                }
+            }
+        }
+        return current;
+    }
+
+    static Counts apply(short[] norm16, int width, int height, double[] gains,
+                        int mapW, int mapH, double representationScale, int[] planes, int workers) {
+        if (planes == null || planes.length != 4) {
+            throw new IllegalArgumentException("EXACTPERF1A requires four Bayer planes");
+        }
+        final double xScale = width > 1 ? (mapW - 1.0) / (width - 1.0) : 0.0;
+        final double yScale = height > 1 ? (mapH - 1.0) / (height - 1.0) : 0.0;
+        // Same per-column coordinates as M9R35Renderer.ShadingXCoordinates.
+        final int[] lower = new int[width];
+        final int[] upper = new int[width];
+        final double[] fraction = new double[width];
+        for (int x = 0; x < width; x++) {
+            double gx = x * xScale;
+            int x0 = (int) Math.floor(gx);
+            lower[x] = x0;
+            upper[x] = Math.min(mapW - 1, x0 + 1);
+            fraction[x] = gx - x0;
+        }
+        final int bands = Math.min(height, Math.max(1, workers) * BANDS_PER_WORKER);
+        if (workers <= 1 || bands <= 1) {
+            return rows(norm16, width, 0, height, gains, mapW, mapH, representationScale,
+                    planes, yScale, lower, upper, fraction);
+        }
+        List<Future<Counts>> futures = new ArrayList<>(bands);
+        ExecutorService executor = pool();
+        for (int band = 0; band < bands; band++) {
+            final int yStart = (int) ((long) height * band / bands);
+            final int yEnd = (int) ((long) height * (band + 1) / bands);
+            futures.add(executor.submit(() -> rows(norm16, width, yStart, yEnd, gains, mapW, mapH,
+                    representationScale, planes, yScale, lower, upper, fraction)));
+        }
+        long corrected = 0;
+        long aboveNominal = 0;
+        long postClip = 0;
+        boolean interrupted = false;
+        RuntimeException failure = null;
+        // Wait for every band so no worker can still be writing norm16 after we return.
+        for (Future<Counts> future : futures) {
+            while (true) {
+                try {
+                    Counts counts = future.get();
+                    corrected += counts.corrected;
+                    aboveNominal += counts.aboveNominal;
+                    postClip += counts.postClip;
+                    break;
+                } catch (InterruptedException e) {
+                    interrupted = true;
+                } catch (ExecutionException e) {
+                    if (failure == null) {
+                        failure = new IllegalStateException("EXACTPERF1A shading band failed", e.getCause());
+                    }
+                    break;
+                }
+            }
+        }
+        if (interrupted) Thread.currentThread().interrupt();
+        if (failure != null) throw failure;
+        return new Counts(corrected, aboveNominal, postClip);
+    }
+
+    // Per-pixel body copied from the frozen SHADINGLUMADECOMP1A loop; only the plane
+    // lookup reads the precomputed 2x2 table.
+    private static Counts rows(short[] norm16, int width, int yStart, int yEnd, double[] gains,
+                               int mapW, int mapH, double representationScale, int[] planes,
+                               double yScale, int[] lower, int[] upper, double[] fraction) {
+        long corrected = 0, aboveNominal = 0, postClip = 0;
+        for (int y = yStart; y < yEnd; y++) {
+            double gy = y * yScale;
+            int y0 = (int) Math.floor(gy), y1 = Math.min(mapH - 1, y0 + 1);
+            double fy = gy - y0;
+            int row = y * width, planeBase = (y & 1) * 2;
+            for (int x = 0; x < width; x++) {
+                int x0 = lower[x], x1 = upper[x];
+                double fx = fraction[x];
+                int plane = planes[planeBase + (x & 1)];
+                int i00 = ((y0 * mapW + x0) * 4) + plane, i01 = ((y0 * mapW + x1) * 4) + plane,
+                        i10 = ((y1 * mapW + x0) * 4) + plane, i11 = ((y1 * mapW + x1) * 4) + plane;
+                double g0 = gains[i00] + fx * (gains[i01] - gains[i00]),
+                        g1 = gains[i10] + fx * (gains[i11] - gains[i10]),
+                        gain = g0 + fy * (g1 - g0);
+                int index = row + x;
+                double normalized = (norm16[index] & 0xffff) / 65535.0, correctedLinear = normalized * gain;
+                if (correctedLinear > 1.0) aboveNominal++;
+                double represented = correctedLinear / representationScale;
+                if (represented < -1e-12 || represented > 1.0 + 1e-12) postClip++;
+                represented = Math.max(0.0, Math.min(1.0, represented));
+                int q = (int) Math.floor(represented * 65535.0 + 0.5);
+                norm16[index] = (short) (q & 0xffff);
+                corrected++;
+            }
+        }
+        return new Counts(corrected, aboveNominal, postClip);
+    }
+}

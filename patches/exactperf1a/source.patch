+package com.particlesdevs.photoncamera.m9.render;
+
+import org.junit.Test;
+
+import java.util.Random;
+
+import static org.junit.Assert.assertArrayEquals;
+import static org.junit.Assert.assertEquals;
+
+/** EXACTPERF1A: the parallel shading pass must be byte-identical to the frozen 3.42 serial loops. */
+public class M9ShadingParallel1ATest {
+    private static final int MAP_W = 17, MAP_H = 13;
+
+    /** Verbatim 3.42 SHADINGLUMADECOMP1A gain decomposition (shared by oracle and candidate). */
+    private static double[] gains(float[] src, double alpha, double[] scaleOut) {
+        final int cells = MAP_W * MAP_H;
+        double[] gains = new double[src.length]; double maxGain = Double.NEGATIVE_INFINITY;
+        for (int cell = 0; cell < cells; cell++) { int base = cell * 4; double ls = 0.0; for (int p = 0; p < 4; p++) { double g = src[base + p]; ls += Math.log(g); } double gc = Math.exp(0.25 * ls), ca = Math.exp(alpha * Math.log(gc)); for (int p = 0; p < 4; p++) { double g = (src[base + p] / gc) * ca; gains[base + p] = g; maxGain = Math.max(maxGain, g); } }
+        scaleOut[0] = maxGain;
+        return gains;
+    }
+
+    private static int[] xLower, xUpper; private static double[] xFraction;
+    private static void coordinates(int width, int mapW, double xScale) {
+        xLower = new int[width]; xUpper = new int[width]; xFraction = new double[width];
+        for (int x = 0; x < width; x++) { double gx = x * xScale; int x0 = (int) Math.floor(gx); xLower[x] = x0; xUpper[x] = Math.min(mapW - 1, x0 + 1); xFraction[x] = gx - x0; }
+    }
+
+    /** Verbatim 3.42 per-pixel loops; bayer=false is the RGGB/origin-0 fast path. */
+    private static long[] oracle(short[] norm16, int width, int height, double[] gains, double representationScale,
+                                 boolean bayer, int cfaPattern, int originX, int originY) {
+        final int mapW = MAP_W, mapH = MAP_H;
+        final double xScale = width > 1 ? (mapW - 1.0) / (width - 1.0) : 0.0, yScale = height > 1 ? (mapH - 1.0) / (height - 1.0) : 0.0; long corrected = 0, aboveNominal = 0, postClip = 0;
+        coordinates(width, mapW, xScale);
+        for (int y = 0; y < height; y++) { double gy = y * yScale; int y0 = (int) Math.floor(gy), y1 = Math.min(mapH - 1, y0 + 1); double fy = gy - y0; int row = y * width, planeBase = (y & 1) * 2; for (int x = 0; x < width; x++) { int x0 = xLower[x], x1 = xUpper[x]; double fx = xFraction[x];
+            int plane = bayer ? M9CfaResolver.lensShadingChannelAt(x, y, cfaPattern, originX, originY) : planeBase + (x & 1);
+            int i00 = ((y0 * mapW + x0) * 4) + plane, i01 = ((y0 * mapW + x1) * 4) + plane, i10 = ((y1 * mapW + x0) * 4) + plane, i11 = ((y1 * mapW + x1) * 4) + plane; double g0 = gains[i00] + fx * (gains[i01] - gains[i00]), g1 = gains[i10] + fx * (gains[i11] - gains[i10]), gain = g0 + fy * (g1 - g0); int index = row + x; double normalized = (norm16[index] & 0xffff) / 65535.0, correctedLinear = normalized * gain; if (correctedLinear > 1.0) aboveNominal++; double represented = correctedLinear / representationScale; if (represented < -1e-12 || represented > 1.0 + 1e-12) postClip++; represented = Math.max(0.0, Math.min(1.0, represented)); int q = (int) Math.floor(represented * 65535.0 + 0.5); norm16[index] = (short) (q & 0xffff); corrected++; } }
+        return new long[] {corrected, aboveNominal, postClip};
+    }
+
+    private static float[] grid(long seed) {
+        Random r = new Random(seed); float[] g = new float[MAP_W * MAP_H * 4];
+        for (int y = 0; y < MAP_H; y++) for (int x = 0; x < MAP_W; x++) {
+            double dx = (x - 8) / 8.0, dy = (y - 6) / 6.0, base = 1 + 1.4 * (dx * dx + dy * dy);
+            for (int p = 0; p < 4; p++) g[(y * MAP_W + x) * 4 + p] = (float) (base * (p == 0 ? 1.05 : p == 3 ? 1.09 : 1.0) * (1 + 0.02 * r.nextGaussian()));
+        }
+        return g;
+    }
+
+    private static short[] raw(int n, long seed) {
+        Random r = new Random(seed); short[] s = new short[n];
+        for (int i = 0; i < n; i++) s[i] = (short) (i % 97 == 0 ? 0xffff : i % 89 == 0 ? 0 : r.nextInt(65536));
+        return s;
+    }
+
+    private static void check(int width, int height, double alpha, boolean bayer, int cfa, int ox, int oy, int workers, long seed) {
+        double[] scale = new double[1];
+        double[] g = gains(grid(seed), alpha, scale);
+        short[] expected = raw(width * height, seed + 1), actual = expected.clone();
+        long[] want = oracle(expected, width, height, g, scale[0], bayer, cfa, ox, oy);
+        int[] planes = bayer ? M9ShadingParallel1A.bayerPlanes(cfa, ox, oy) : M9ShadingParallel1A.identityPlanes();
+        M9ShadingParallel1A.Counts got = M9ShadingParallel1A.apply(actual, width, height, g, MAP_W, MAP_H, scale[0], planes, workers);
+        String label = width + "x" + height + " alpha=" + alpha + " bayer=" + bayer + " cfa=" + cfa + " origin=" + ox + "," + oy + " workers=" + workers;
+        assertArrayEquals(label, expected, actual);
+        assertEquals(label, want[0], got.corrected);
+        assertEquals(label, want[1], got.aboveNominal);
+        assertEquals(label, want[2], got.postClip);
+    }
+
+    @Test public void rggbFastPathIsByteIdenticalForAllWorkerCounts() {
+        for (int workers : new int[] {1, 2, 3, 8})
+            for (int[] size : new int[][] {{640, 480}, {1, 7}, {9, 1}, {333, 211}})
+                for (double alpha : new double[] {1.0, 0.6})
+                    check(size[0], size[1], alpha, false, 0, 0, 0, workers, size[0] * 31L + workers);
+    }
+
+    @Test public void genericBayerPathIsByteIdenticalForEveryLayoutAndOrigin() {
+        for (int cfa = 0; cfa < 4; cfa++)
+            for (int ox = 0; ox < 2; ox++)
+                for (int oy = 0; oy < 2; oy++)
+                    for (int workers : new int[] {1, 4, 8})
+                        check(258, 131, 1.0, true, cfa, ox, oy, workers, cfa * 17L + ox * 5L + oy + workers);
+    }
+
+    @Test public void fullFrameMatchesSerialLoop() {
+        check(4096, 3072, 1.0, false, 0, 0, 0, M9ShadingParallel1A.WORKERS, 4096);
+        check(4000, 3000, 1.0, true, 2, 0, 1, M9ShadingParallel1A.WORKERS, 4000);
+    }
+
+    @Test public void planeTableMatchesPerPixelResolverEverywhere() {
+        for (int cfa = 0; cfa < 4; cfa++)
+            for (int ox = -3; ox <= 3; ox++)
+                for (int oy = -3; oy <= 3; oy++) {
+                    int[] planes = M9ShadingParallel1A.bayerPlanes(cfa, ox, oy);
+                    for (int y = 0; y < 9; y++)
+                        for (int x = 0; x < 9; x++)
+                            assertEquals(M9CfaResolver.lensShadingChannelAt(x, y, cfa, ox, oy),
+                                    planes[(y & 1) * 2 + (x & 1)]);
+                }
+        assertArrayEquals(new int[] {0, 1, 2, 3}, M9ShadingParallel1A.identityPlanes());
+    }
+}

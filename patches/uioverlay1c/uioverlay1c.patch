diff --git a/app/src/test/java/com/particlesdevs/photoncamera/ui/camera/views/M9LinearManualLifecycleTest.java b/app/src/test/java/com/particlesdevs/photoncamera/ui/camera/views/M9LinearManualLifecycleTest.java

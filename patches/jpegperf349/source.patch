+    @Test public void mediaStorePublicationIsIndexedWithoutScanRequest() throws Exception {
+        M9PendingJpeg item = M9PendingJpeg.create(target, resolver);
+        assertTrue(item.indexedByMediaStore());
+        SavedEvents events = new SavedEvents();
+        M9JpegFinalizeQueue.Ticket ticket = M9JpegFinalizeQueue.submit(target, encode(item), events, null, item);
+        ticket.awaitCompletion();
+        assertTrue(ticket.error(), ticket.isSuccess());
+        assertEquals(java.util.Collections.singletonList("true:" + target + ":true"), events.calls);
+        // MediaStore fills the image's own metadata on publication, with no scan broadcast.
+        String[] columns = {MediaStore.MediaColumns.WIDTH, MediaStore.MediaColumns.HEIGHT, MediaStore.MediaColumns.SIZE};
+        long deadline = System.nanoTime() + 10_000_000_000L;
+        int width = 0, height = 0; long size = 0;
+        while (System.nanoTime() < deadline) {
+            try (Cursor rows = resolver.query(images, columns, "_display_name = ? AND relative_path = ?",
+                    new String[]{target.getFileName().toString(), "DCIM/Camera/"}, null)) {
+                assertNotNull(rows);
+                assertEquals(1, rows.getCount());
+                assertTrue(rows.moveToFirst());
+                width = rows.getInt(0); height = rows.getInt(1); size = rows.getLong(2);
+            }
+            if (width == 96 && height == 64 && size == Files.size(target)) break;
+            Thread.sleep(100);
+        }
+        assertEquals(96, width);
+        assertEquals(64, height);
+        assertEquals(Files.size(target), size);
+    }

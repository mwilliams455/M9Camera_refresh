+/** JPEGPERF349: the unsynchronized signature reader must return exactly what 3.48 returned. */
+public class M9JpegSignatureReaderTest {
+    /** Returns 1..maxChunk bytes per bulk read, to cross every buffer boundary. */
+    private static final class ChoppyStream extends InputStream {
+        final byte[] data;final Random random;final int maxChunk;int pos;
+        ChoppyStream(byte[] data,long seed,int maxChunk){this.data=data;this.random=new Random(seed);this.maxChunk=maxChunk;}
+        @Override public int read(){return pos<data.length?data[pos++]&255:-1;}
+        @Override public int read(byte[] b,int o,int n){
+            if(n==0)return 0;if(pos>=data.length)return -1;
+            int k=Math.min(Math.min(n,1+random.nextInt(maxChunk)),data.length-pos);
+            System.arraycopy(data,pos,b,o,k);pos+=k;return k;
+        }
+    }
+
+    private static void segment(ByteArrayOutputStream out,int marker,byte[] payload){
+        out.write(255);out.write(marker);int length=payload.length+2;out.write(length>>8);out.write(length&255);
+        out.write(payload,0,payload.length);
+    }
+
+    private static byte[] filled(Random r,int n){byte[] b=new byte[n];r.nextBytes(b);return b;}
+
+    /** Synthetic but structurally valid JPEG: APP0, ICC x2, COM, DQT, SOF, DHT, scans with stuffing, RST and fill bytes. */
+    static byte[] jpeg(long seed,boolean progressive,int scanBytes){
+        Random r=new Random(seed);ByteArrayOutputStream out=new ByteArrayOutputStream();
+        out.write(255);out.write(216);
+        segment(out,224,"JFIF\0\1\2\0\0\1\0\1\0\0".getBytes(java.nio.charset.StandardCharsets.ISO_8859_1));
+        for(int part=1;part<=2;part++){
+            byte[] icc=filled(r,300+part*17);byte[] id="ICC_PROFILE\0".getBytes(java.nio.charset.StandardCharsets.ISO_8859_1);
+            System.arraycopy(id,0,icc,0,12);icc[12]=(byte)part;icc[13]=2;segment(out,226,icc);
+        }
+        segment(out,254,"M9 test".getBytes(java.nio.charset.StandardCharsets.ISO_8859_1));
+        segment(out,219,filled(r,130));
+        segment(out,progressive?194:192,new byte[]{8,12,0,16,0,3,1,0x22,0,2,0x11,1,3,0x11,1});
+        segment(out,196,filled(r,180));
+        int scans=progressive?4:1;
+        for(int s=0;s<scans;s++){
+            segment(out,218,new byte[]{3,1,0,2,0x11,3,0x11,0,63,0});
+            for(int i=0;i<scanBytes;i++){
+                int v=r.nextInt(256);
+                if(v==255){out.write(255);out.write(0);}            // byte stuffing
+                else out.write(v);
+                if(i%4099==4098){out.write(255);out.write(208+(i/4099)%8);} // restart markers
+                if(i%9973==9972){out.write(255);out.write(255);out.write(0);} // fill byte before stuffing
+            }
+            if(s+1<scans){out.write(255);out.write(255);segment(out,196,filled(r,40));} // fill byte before marker
+        }
+        out.write(255);out.write(255);out.write(217);

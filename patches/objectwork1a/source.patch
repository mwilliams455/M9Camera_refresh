+package com.particlesdevs.photoncamera.ui.camera;
+
+import android.app.Application;
+import android.graphics.Bitmap;
+import android.os.SystemClock;
+import com.particlesdevs.photoncamera.control.subject.AutomaticSubjectSelection;
+import com.particlesdevs.photoncamera.control.subject.AutomaticSubjectSelection.Box;
+import com.particlesdevs.photoncamera.control.subject.SceneHeads;
+import com.particlesdevs.photoncamera.control.tracking.SubjectAnchorPolicy.Candidate;
+import java.util.Arrays;
+import java.util.Collections;
+import java.util.concurrent.CountDownLatch;
+import java.util.concurrent.ExecutorService;
+import java.util.concurrent.Executors;
+import java.util.concurrent.TimeUnit;
+import java.util.concurrent.atomic.AtomicInteger;
+import java.util.concurrent.atomic.AtomicReference;
+import org.junit.Test;
+import org.junit.runner.RunWith;
+import org.robolectric.RobolectricTestRunner;
+import org.robolectric.annotation.Config;
+import static org.junit.Assert.*;
+
+@RunWith(RobolectricTestRunner.class)
+@Config(sdk=35, application=Application.class)
+public class ObjectWorkTest {
+    private static Box body(String kind, float l, float t, float r, float b) {
+        return Box.fromBody(new Candidate(kind, .8f, l, t, r, b));
+    }
+    private final Box broad = body("person", .011f, .15f, .985f, .993f);
+    private final Box dog = body("dog", 0f, 0f, 1f, 1f);
+    private static void await(CountDownLatch latch) {
+        try { assertTrue(latch.await(3, TimeUnit.SECONDS)); }
+        catch (InterruptedException ex) { throw new AssertionError(ex); }
+    }
+    @Test public void broadBodyCannotStartOrRenewAnAimByItself() {
+        AutomaticSubjectSelection s = new AutomaticSubjectSelection();
+        Box localized = body("person", .2f, .3f, .84f, .98f);
+        assertTrue(AutomaticSubjectSelection.needsPetDetail(null,Collections.singletonList(broad)));
+        for (int i=1; i<=3; i++) assertNull(s.observe(i,i,Collections.singletonList(broad)));
+        assertSame(localized,s.observe(4,4,Arrays.asList(broad,localized)));
+        assertSame(localized,s.observe(5,5,Collections.singletonList(localized)));
+        assertNull(s.observe(6,6,Collections.emptyList(),broad));
+        assertNull(s.observe(7,7,Collections.singletonList(broad)));
+        assertFalse(s.visibleAt(6 + AutomaticSubjectSelection.HOLD_NS));
+        s.reset();
+        assertSame(dog,s.observe(8,8,Arrays.asList(broad,dog)));
+        s.reset();
+        Box complete = body("person", .08f, .07f, .92f, .93f);
+        assertSame(complete,s.observe(9,9,Collections.singletonList(complete)));
+    }
+    @Test public void broadContextStillSupportsAnIndependentlyLocatedFace() {
+        Box face = SceneHeads.decode(new float[]{105,95,100,110,130,125,180,125,155,147,
+                134,171,175,171,.95f},400,400,0);
+        assertEquals(1,SceneHeads.upperBodyMatches(face,Collections.singletonList(broad)));
+        AutomaticSubjectSelection s = new AutomaticSubjectSelection();
+        assertSame(face,s.observe(1,1,Arrays.asList(broad,face)));
+        assertSame(face,s.observe(2,2,Arrays.asList(broad,face)));
+        assertTrue(s.mayAim());
+    }
+    @Test public void coldPreparationDoesNotOccupyCallerAndModelUsesOneThread() throws Exception {
+        ExecutorService worker=Executors.newSingleThreadExecutor();
+        CountDownLatch entered=new CountDownLatch(1), release=new CountDownLatch(1);
+        AtomicReference<Thread> owner=new AtomicReference<>();
+        AtomicReference<Bitmap> input=new AtomicReference<>();
+        AtomicInteger closed=new AtomicInteger();
+        PetPoseWorker pose=new PetPoseWorker(() -> {
+            owner.set(Thread.currentThread()); entered.countDown(); await(release);
+            return new PetPoseWorker.Model() {
+                public boolean supports(Bitmap b,Box pet) {
+                    assertSame(owner.get(),Thread.currentThread());
+                    input.set(b); return true;
+                }
+                public void close() { assertSame(owner.get(),Thread.currentThread()); closed.incrementAndGet(); }
+            };
+        },worker);
+        Bitmap sample=Bitmap.createBitmap(8,8,Bitmap.Config.ARGB_8888);
+        try {
+            assertFalse(pose.supports(sample,dog,SystemClock.elapsedRealtimeNanos(),false));
+            await(entered);
+            assertFalse(pose.supports(sample,dog,SystemClock.elapsedRealtimeNanos(),false));
+            release.countDown(); worker.submit(() -> {}).get(3,TimeUnit.SECONDS);
+            assertTrue(pose.supports(sample,dog,SystemClock.elapsedRealtimeNanos(),false));
+            assertNotSame(sample,input.get()); assertTrue(input.get().isRecycled()); assertFalse(sample.isRecycled());
+        } finally { release.countDown(); pose.close(); }
+        assertTrue(worker.awaitTermination(3,TimeUnit.SECONDS)); assertEquals(1,closed.get());
+    }
+    @Test public void latePoseDoesNotQueueMoreImagesOrCreditAnOldResult() throws Exception {
+        ExecutorService worker=Executors.newSingleThreadExecutor();
+        CountDownLatch entered=new CountDownLatch(1), release=new CountDownLatch(1);
+        AtomicInteger runs=new AtomicInteger(); AtomicReference<Bitmap> input=new AtomicReference<>();
+        PetPoseWorker pose=new PetPoseWorker(() -> new PetPoseWorker.Model() {
+            public boolean supports(Bitmap frame,Box pet) {
+                input.set(frame); int n=runs.incrementAndGet();
+                if (n==1) { entered.countDown(); await(release); return true; }
+                return false;
+            }
+            public void close() {}
+        },worker);
+        Bitmap sample=Bitmap.createBitmap(8,8,Bitmap.Config.ARGB_8888);
+        try {
+            pose.supports(sample,dog,SystemClock.elapsedRealtimeNanos(),false);
+            worker.submit(() -> {}).get(3,TimeUnit.SECONDS);
+            long nearDeadline=SystemClock.elapsedRealtimeNanos()-AutomaticSubjectSelection.MAX_AGE_NS+100_000_000L;
+            assertFalse(pose.supports(sample,dog,nearDeadline,false));
+            await(entered);
+            assertFalse(pose.supports(sample,dog,SystemClock.elapsedRealtimeNanos(),false));
+            assertEquals(1,runs.get()); assertFalse(input.get().isRecycled());
+            release.countDown(); worker.submit(() -> {}).get(3,TimeUnit.SECONDS); assertTrue(input.get().isRecycled());
+            assertFalse(pose.supports(sample,dog,SystemClock.elapsedRealtimeNanos(),false)); assertEquals(2,runs.get());
+        } finally { release.countDown(); pose.close(); }
+        assertTrue(worker.awaitTermination(3,TimeUnit.SECONDS));
+    }
+    @Test public void failedBackendIsReportedToExistingFallback() throws Exception {
+        ExecutorService worker=Executors.newSingleThreadExecutor(); AtomicInteger calls=new AtomicInteger();
+        PetPoseWorker pose=new PetPoseWorker(() -> { calls.incrementAndGet(); throw new IllegalStateException(); },worker);
+        try {
+            assertFalse(pose.supports(null,dog,SystemClock.elapsedRealtimeNanos(),false));
+            worker.submit(() -> {}).get(3,TimeUnit.SECONDS);
+            assertTrue(pose.unavailable());
+            assertFalse(pose.supports(null,dog,SystemClock.elapsedRealtimeNanos(),false));
+            assertEquals(1,calls.get());
+        } finally { pose.close(); }
+    }
+}

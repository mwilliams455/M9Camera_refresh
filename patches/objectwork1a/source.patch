+import android.os.SystemClock;
+import com.google.ai.edge.litert.LiteRtException;
+import com.particlesdevs.photoncamera.control.subject.AutomaticSubjectSelection;
+import com.particlesdevs.photoncamera.control.subject.AutomaticSubjectSelection.Box;
+import com.particlesdevs.photoncamera.util.Log;
+import java.util.concurrent.ExecutionException;
+import java.util.concurrent.ExecutorService;
+import java.util.concurrent.Executors;
+import java.util.concurrent.Future;
+import java.util.concurrent.TimeUnit;
+import java.util.concurrent.TimeoutException;
+
+/** One serial owner for pet-model construction, inference and disposal. The object detector
+ * calls supports and close serially. Late results never enter a newer frame's decision. */
+final class PetPoseWorker implements AutoCloseable {
+    interface Model extends AutoCloseable {
+        boolean supports(Bitmap frame, Box pet) throws LiteRtException;
+        @Override void close();
+    }
+    interface Loader { Model open() throws LiteRtException; }
+
+    private final Loader loader;
+    private final ExecutorService worker;
+    private Future<?> loading;
+    private Future<Boolean> checking;
+    private Model model; // accessed only on worker
+    private volatile boolean unavailable;
+    private boolean closed;
+
+    PetPoseWorker(Loader loader) {
+        this(loader, Executors.newSingleThreadExecutor(job -> new Thread(job, "M9 pet pose")));
+    }
+    PetPoseWorker(Loader loader, ExecutorService worker) {
+        this.loader = loader;
+        this.worker = worker;
+    }
+    boolean unavailable() { return unavailable; }
+
+    boolean supports(Bitmap frame, Box pet, long frameNs, boolean diagnostics) {
+        long deadline = frameNs + AutomaticSubjectSelection.MAX_AGE_NS;
+        if (closed || unavailable || SystemClock.elapsedRealtimeNanos() >= deadline) return false;
+        if (loading == null) {
+            try {
+                loading = worker.submit(() -> {
+                    long start = SystemClock.elapsedRealtimeNanos();
+                    try {
+                        model = loader.open();
+                    } catch (LiteRtException | RuntimeException | LinkageError | OutOfMemoryError failure) {
+                        unavailable = true;
+                    } finally {
+                        if (diagnostics) trace(frameNs, "prepare", start, unavailable ? "unavailable" : "ready");
+                    }
+                });
+            } catch (java.util.concurrent.RejectedExecutionException | OutOfMemoryError unavailableWorker) {
+                unavailable = true;
+            }
+            return false;
+        }
+        if (!loading.isDone() || (checking != null && !checking.isDone())) return false;
+        // PixelCopy reuses the input as soon as the primary request finishes. A timed-out
+        // inference must keep its own pixels until its native call has returned.
+        Bitmap owned;
+        try {
+            owned = frame.copy(Bitmap.Config.ARGB_8888, false);
+        } catch (RuntimeException | OutOfMemoryError unavailableCopy) {
+            return false;
+        }
+        if (owned == null) return false;
+        try {
+            checking = worker.submit(() -> {
+                long start = SystemClock.elapsedRealtimeNanos();
+                try {
+                    return start < deadline && model.supports(owned, pet);
+                } catch (LiteRtException | RuntimeException | LinkageError | OutOfMemoryError failure) {
+                    unavailable = true;
+                    return false;
+                } finally {
+                    owned.recycle();
+                    if (diagnostics && SystemClock.elapsedRealtimeNanos() >= deadline)
+                        trace(frameNs, "inference", start, "expired");
+                }
+            });
+        } catch (java.util.concurrent.RejectedExecutionException | OutOfMemoryError unavailableWorker) {
+            owned.recycle();
+            return false;
+        }
+        long remaining = deadline - SystemClock.elapsedRealtimeNanos();
+        if (remaining <= 0) return false;
+        try {
+            return checking.get(remaining, TimeUnit.NANOSECONDS) && SystemClock.elapsedRealtimeNanos() < deadline;
+        } catch (TimeoutException expired) {
+            return false;
+        } catch (InterruptedException interrupted) {
+            Thread.currentThread().interrupt();
+            return false;
+        } catch (ExecutionException failure) {
+            unavailable = true;
+            return false;
+        }
+    }
+
+    private static void trace(long frame, String stage, long start, String result) {
+        long end = SystemClock.elapsedRealtimeNanos();
+        Log.i("M9HeadTrace", "tNs=" + end + " pet_pose frameNs=" + frame + " stage=" + stage
+                + " durationMs=" + (end-start)/1_000_000L + " result=" + result);
+    }
+
+    @Override public void close() {
+        if (closed) return;
+        closed = true;
+        if (loading != null) worker.execute(() -> { if (model != null) model.close(); });
+        worker.shutdown();
+    }
+}

+        texture[0]=.5f;rotation[0]=0;viewport[2]=400;
+        JSONObject out=new JSONObject(draw.snapshot(201,null));
+        assertEquals(1,out.getJSONArray("cameraTextureMatrix").getDouble(0),0);
+        assertEquals(1,out.getJSONArray("textureRotationMatrix").getDouble(0),0);
+        assertEquals(900,out.getJSONArray("sharpViewport").getInt(2));
+        assertTrue(out.getBoolean("mirror"));
+    }
+    @Test public void changedProducerCropInvalidatesTheOldTapPatch() {
+        float[] combined=new float[32];combined[0]=combined[16]=1;
+        int[] viewport={0,0,900,1200};

+package com.particlesdevs.photoncamera.m9.preview;
+
+import com.particlesdevs.photoncamera.m9.M9ExposurePlan1A;
+import org.json.JSONArray;
+import org.json.JSONObject;
+
+/** One immutable publication per camera callback; one read per GL draw. */
+public final class M9PreviewFrameState1W {
+    public static final String REVISION = "M9LIVEGL1W_ATOMICSTATE1A";
+    public final M9ExposurePlan1A plan;
+    public final long resultTimestampNs, analyzerElapsedNs;
+    public final float exposureScale, weightA, tungstenWeight;
+    public final float gainEv, shadowPlacement, gamma, pairStrength;
+    private final float[] stats;
+
+    public M9PreviewFrameState1W(M9ExposurePlan1A plan, long resultTimestampNs,
+            long analyzerElapsedNs, float exposureScale, float weightA, float tungstenWeight,
+            float gainEv, float shadowPlacement, float gamma, float pairStrength, float[] stats) {
+        this.plan = plan;
+        this.resultTimestampNs = resultTimestampNs;
+        this.analyzerElapsedNs = analyzerElapsedNs;
+        // Preserve the GL1V renderer's guards exactly.
+        this.exposureScale = bounded(exposureScale > 0 ? exposureScale : 1, 1, .0625f, 16);
+        this.weightA = bounded(weightA, 0, 0, 1);
+        this.tungstenWeight = bounded(tungstenWeight, 0, 0, 1);
+        this.gainEv = bounded(gainEv, -.30f, -2.40f, .50f);
+        this.shadowPlacement = bounded(shadowPlacement, 0, 0, .12f);
+        this.gamma = bounded(gamma, 1.120f, 1, 1.40f);
+        this.pairStrength = bounded(pairStrength, .20f, 0, 1);
+        this.stats = stats == null ? new float[0] : stats.clone();
+    }
+
+    public static M9PreviewFrameState1W defaults() {
+        return new M9PreviewFrameState1W(null, -1, -1, 1, 0, 0, -.30f, 0, 1.120f, .20f, null);
+    }

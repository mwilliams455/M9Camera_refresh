@@ -0,0 +1,80 @@
+package com.particlesdevs.photoncamera.m9.preview;
+
+import android.app.Application;
+import android.graphics.Bitmap;
+import java.util.Arrays;
+import org.junit.Before;
+import org.junit.Test;
+import org.junit.runner.RunWith;
+import org.robolectric.RobolectricTestRunner;
+import org.robolectric.annotation.Config;
+import static org.junit.Assert.*;
+
+@RunWith(RobolectricTestRunner.class)
+@Config(sdk=35, application=Application.class)
+public class M9TrackedSubjectMeterTest {
+    private static final long T = 2_000_000_000L;
+    private static final String CAMERA = "0", MODE = "MOTION";
+
+    @Before public void reset() { M9AutoExposure2D.reset(); }
+
+    private void vote(long id, long frame, int middle, int outside) {
+        M9TrackedSubjectMeter.update(CAMERA, MODE, id, frame, middle, outside);
+    }
+    private double requested(long now) { return M9TrackedSubjectMeter.requested(CAMERA, MODE, now); }
+
+    @Test public void samplesTrackedBodyWithoutSpeciesAndRequiresIndependentSecondFrame() {
+        int w=120,h=90; int[] pixels=new int[w*h];
+        Arrays.fill(pixels,0xffeeeeee);
+        for(int y=30;y<60;y++) Arrays.fill(pixels,y*w+40,y*w+80,0xff101010);
+        Bitmap scene=Bitmap.createBitmap(pixels,w,h,Bitmap.Config.ARGB_8888);
+        M9TrackedSubjectMeter.observe(CAMERA,MODE,7,T,T,scene,1/3f,1/3f,2/3f,2/3f);
+        assertEquals(.25,requested(T),0);
+        M9TrackedSubjectMeter.observe(CAMERA,MODE,7,T,T+10,scene,1/3f,1/3f,2/3f,2/3f);
+        assertEquals(.25,requested(T+10),0);
+        M9TrackedSubjectMeter.observe(CAMERA,MODE,7,T+200_000_000,T+210_000_000,scene,1/3f,1/3f,2/3f,2/3f);
+        assertEquals(.50,requested(T+210_000_000),0);
+        M9TrackedSubjectMeter.observe(CAMERA,MODE,7,T+300_000_000,T+700_000_000,scene,1/3f,1/3f,2/3f,2/3f);
+        assertEquals("",M9TrackedSubjectMeter.trace(T+300_000_000));
+        scene.recycle();
+    }
+    @Test public void fallsAwayOnLossAndNeverMovesAcrossCameraOrMode() {
+        vote(7,T,6,220);
+        assertEquals(.125,requested(T+775_000_000),1e-10);
+        assertEquals(0,requested(T+1_000_000_000),0);
+        assertEquals(0,M9TrackedSubjectMeter.requested("1",MODE,T),0);
+        assertEquals(0,M9TrackedSubjectMeter.requested(CAMERA,"PHOTO",T),0);
+        vote(8,T+300_000_000,8,230);
+        assertEquals(.25,requested(T+300_000_000),0);
+        M9TrackedSubjectMeter.clear();
+        assertEquals(0,requested(T+300_000_000),0);
+    }
+    @Test public void wellLitCatAndDarkRoomDoNotGetALift() {
+        vote(7,T,155,198);assertEquals(0,requested(T),0);
+        vote(7,T+1,10,75);assertEquals(0,requested(T+1),0);
+        vote(7,T+2,4,242);assertEquals(.25,requested(T+2),0);
+        vote(7,T+3,155,198);assertEquals(0,requested(T+3),0);
+    }
+    @Test public void highlightLimitBoundsExtraAndPreservesBaseline() {
+        assertEquals(.25,M9TrackedSubjectMeter.addWithinHeadroom(.25,.50,.25),0);
+        assertEquals(.50,M9TrackedSubjectMeter.addWithinHeadroom(.25,.50,.50),0);
+        assertEquals(.75,M9TrackedSubjectMeter.addWithinHeadroom(.25,.50,1),0);
+        assertEquals(0,M9TrackedSubjectMeter.addWithinHeadroom(0,.50,0),0);
+    }
+    private void probe(long t) {
+        M9AutoExposure2D.Stats[] stats = new M9AutoExposure2D.Stats[M9AutoExposure2D.STEPS];
+        for (int i=0;i<stats.length;i++) stats[i]=new M9AutoExposure2D.Stats(95,0,0,0);
+        M9AutoExposure2D.publish(new M9AutoExposure2D.Sample(CAMERA,MODE,t,t,t,1,stats));
+    }
+    private M9AutoExposure2D.Decision decide(long t,double ev,long manual,int iso,boolean eligible){
+        return M9AutoExposure2D.decide(CAMERA,MODE,t,1,ev,manual,iso,0,eligible);
+    }
+    @Test public void sharedPlanAppliesBiasAndHonoursManualControlsAndEligibility() {
+        probe(T);vote(7,T,6,220);
+        assertEquals(.25,decide(T,0,0,0,true).appliedEv,1e-10);
+        assertEquals(0,decide(T,0,1,0,true).appliedEv,0);
+        assertEquals(0,decide(T,0,0,100,true).appliedEv,0);
+        assertEquals(0,decide(T,.7,0,0,true).appliedEv,0);
+        assertEquals(0,decide(T,0,0,0,false).appliedEv,0);
+    }
+}

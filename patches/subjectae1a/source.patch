@@ -0,0 +1,93 @@
+package com.particlesdevs.photoncamera.m9.preview;
+
+import android.graphics.Bitmap;
+import java.util.Arrays;
+
+/** Additional exposure requested by a subject already selected on the upright viewfinder. */
+public final class M9TrackedSubjectMeter {
+    private static final long MAX_SAMPLE_AGE_NS = 350_000_000L;
+    private static final long HOLD_NS = 550_000_000L;
+    private static final long END_NS = 1_000_000_000L;
+    private static final int[] subject = new int[49];
+    private static final int[] surroundings = new int[108];
+    private static String camera, mode;
+    private static long selection, frame;
+    private static double lift;
+    private static int subjectMedian = -1, background95 = -1;
+
+    private M9TrackedSubjectMeter() {}
+
+    public static synchronized void clear() {
+        camera = mode = null;
+        selection = frame = 0;
+        lift = 0;
+        subjectMedian = background95 = -1;
+    }
+
+    public static synchronized void observe(String cameraId, String shotMode, long id,
+            long timestamp, long now, Bitmap bitmap, float left, float top, float right, float bottom) {
+        if (bitmap == null || bitmap.isRecycled() || timestamp <= 0 || now < timestamp
+                || now - timestamp > MAX_SAMPLE_AGE_NS || !Float.isFinite(left + top + right + bottom)) return;
+        int w = bitmap.getWidth(), h = bitmap.getHeight();
+        left = Math.max(0, left); top = Math.max(0, top);
+        right = Math.min(1, right); bottom = Math.min(1, bottom);
+        float bw = right - left, bh = bottom - top;
+        if (bw * w < 8 || bh * h < 8 || bw * bh > .80f) {
+            update(cameraId, shotMode, id, timestamp, -1, -1);
+            return;
+        }
+        // Read the inner 70% of the subject box to reduce contamination by the background.
+        int n = 0;
+        for (int y = 0; y < 7; y++) {
+            for (int x = 0; x < 7; x++) {
+                float u = left + bw * (.15f + .10f * (x + .5f));
+                float v = top + bh * (.15f + .10f * (y + .5f));
+                subject[n++] = luma(bitmap.getPixel(Math.min(w-1,(int)(u*w)), Math.min(h-1,(int)(v*h))));
+            }
+        }
+        n = 0;
+        for (int y = 0; y < 9; y++) {
+            for (int x = 0; x < 12; x++) {
+                float u = (x + .5f)/12, v = (y + .5f)/9;
+                if (u >= left && u <= right && v >= top && v <= bottom) continue;
+                surroundings[n++] = luma(bitmap.getPixel((int)(u*w), (int)(v*h)));
+            }
+        }
+        Arrays.sort(subject);
+        Arrays.sort(surroundings, 0, n);
+        update(cameraId, shotMode, id, timestamp, subject[24], n < 20 ? -1 : surroundings[(n-1)*95/100]);
+    }
+
+    private static int luma(int rgb) {
+        return (54*((rgb >> 16)&255) + 183*((rgb >> 8)&255) + 19*(rgb&255) + 128) >> 8;
+    }
+
+    static synchronized void update(String cameraId, String shotMode, long id, long timestamp,
+            int middle, int bright) {
+        boolean same = cameraId.equals(camera) && shotMode.equals(mode) && id == selection;
+        if (same && timestamp <= frame) return;
+        boolean continuing = same && lift > 0 && timestamp-frame <= HOLD_NS;
+        boolean qualifies = middle >= 0 && middle <= (continuing ? 36 : 24)
+                && bright >= (continuing ? 175 : 185);
+        lift = qualifies ? (continuing ? .50 : .25) : 0;
+        camera = cameraId; mode = shotMode; selection = id; frame = timestamp;
+        subjectMedian = middle; background95 = bright;
+    }
+
+    public static synchronized double requested(String cameraId, String shotMode, long now) {
+        if (!cameraId.equals(camera) || !shotMode.equals(mode) || now < frame) return 0;
+        long age = now-frame;
+        if (age <= HOLD_NS) return lift;
+        if (age >= END_NS) return 0;
+        return lift * (END_NS-age)/(END_NS-HOLD_NS);
+    }
+
+    static double addWithinHeadroom(double base, double extra, double limit) {
+        return base + Math.max(0, Math.min(extra, limit - base));
+    }
+
+    public static synchronized String trace(long timestamp) {
+        if (timestamp != frame) return "";
+        return " subjectMedian=" + subjectMedian + " outsideP95=" + background95 + " subjectRequestEv=" + lift;
+    }
+}

@@ -0,0 +1,29 @@
+package com.particlesdevs.photoncamera.control.subject;
+
+/** Position and size of the viewfinder square in preview pixels. */
+public final class SubjectFrame {
+    public float x, y, side;
+    private long selection = Long.MIN_VALUE;
+    private boolean wasFace;
+
+    public void update(long id, AutomaticSubjectSelection.Box box, int width, int height) {
+        float target = box.squareSide(width, height);
+        float cx = box.cx() * width, cy = box.cy() * height;
+        if (id != selection) {
+            x = cx;
+            y = cy;
+            side = target;
+            selection = id;
+        } else {
+            // Ease a face/body handover. Follow normal subject motion more closely.
+            float weight = wasFace == box.face ? .72f : .32f;
+            x += (cx-x)*weight;
+            y += (cy-y)*weight;
+            side += (target-side)*.35f;
+        }
+        wasFace = box.face;
+        float half = side*.5f;
+        x = Math.max(half, Math.min(width-half, x));
+        y = Math.max(half, Math.min(height-half, y));
+    }
+}

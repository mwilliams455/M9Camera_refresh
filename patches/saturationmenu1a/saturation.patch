diff --git a/app/src/main/java/com/particlesdevs/photoncamera/processing/M9Saturation.java b/app/src/main/java/com/particlesdevs/photoncamera/processing/M9Saturation.java
--- /dev/null
+++ b/app/src/main/java/com/particlesdevs/photoncamera/processing/M9Saturation.java
@@ -0,0 +1,37 @@
+package com.particlesdevs.photoncamera.processing;
+
+/** Leica M9 1.216 sRGB nSaturation 0..4; signed Q13 M00..M09 at PROCESS/LUTS+0xB44.
+ * Each pair branches on quantized R >= G, before the unchanged curve02 lookup.
+ * No estimated saturation multiplier or source-camera calibration is used here.
+ */
+public final class M9Saturation {
+    public static final int STANDARD = 2;
+    private static final String[] NAMES = {"Low", "Medium low", "Standard", "Medium high", "High"};
+    private static final String[] PAIRS = {"M00_M01", "M02_M03", "M04_M05", "M06_M07", "M08_M09"};
+    private static final int[] MODES = {11, 12, 9, 0, 10};
+    private static final long[][] MATRICES = {
+        {10563,-1281,-1085,-1363,12163,-2607,169,-2448,10465},
+        {11461,-2173,-1085,-1487,12295,-2607,648,-2911,10465},
+        {12420,-3186,-1036,-1891,12946,-2862,-51,-4587,12825},
+        {13471,-4231,-1036,-2068,13130,-2862,495,-5117,12825},
+        {13659,-4457,-1004,-2244,13469,-3033,-199,-6014,14398},
+        {14811,-5604,-1004,-2455,13688,-3033,393,-6588,14398},
+        {16754,-7632,-922,-3124,14774,-3458,-567,-9579,18330},
+        {18160,-9034,-922,-3422,15080,-3458,137,-10264,18330},
+        {19850,-10808,-840,-4004,16080,-3884,-936,-13144,22262},
+        {21509,-12464,-840,-4389,16473,-3884,-117,-13940,22262}
+    };
+    private M9Saturation() {}
+    public static boolean isValid(int bank) { return bank >= 0 && bank < 5; }
+    public static int normalize(int bank) { return isValid(bank) ? bank : STANDARD; }
+    public static int parse(String value) {
+        try { return normalize(Integer.parseInt(value)); }
+        catch (NumberFormatException invalid) { return STANDARD; }
+    }
+    public static String name(int bank) { return NAMES[normalize(bank)]; }
+    public static String pair(int bank) { return PAIRS[normalize(bank)]; }
+    public static int nativeMode(int bank) { return MODES[normalize(bank)]; }
+    public static long[] matrix(int bank, boolean even) {
+        return MATRICES[2 * normalize(bank) + (even ? 0 : 1)].clone();
+    }
+}

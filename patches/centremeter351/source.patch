+    /** M9CENTREMETER351: which AE regions the capture asked for and which the HAL reported. */
+    private static JSONObject centreMeteringDiagnostics351(CaptureRequest request, CaptureResult result) {
+        JSONObject o = new JSONObject();
+        try {
+            o.put("revision", com.particlesdevs.photoncamera.m9.preview.M9CentreMetering1A.REVISION);
+            o.put("enabled", com.particlesdevs.photoncamera.m9.preview.M9CentreMetering1A.enabled());
+            o.put("requestAeRegions", meteringRegions351(request == null ? null
+                    : request.get(CaptureRequest.CONTROL_AE_REGIONS)));
+            o.put("resultAeRegions", meteringRegions351(result == null ? null
+                    : result.get(CaptureResult.CONTROL_AE_REGIONS)));
+        } catch (Exception unavailable) {
+            try { o.put("error", unavailable.toString()); } catch (Exception ignored) { }
+        }
+        return o;
+    }
+
+    private static Object meteringRegions351(android.hardware.camera2.params.MeteringRectangle[] regions)
+            throws org.json.JSONException {
+        if (regions == null) return JSONObject.NULL;
+        org.json.JSONArray out = new org.json.JSONArray();
+        for (android.hardware.camera2.params.MeteringRectangle r : regions) {
+            out.put(new org.json.JSONArray().put(r.getX()).put(r.getY()).put(r.getWidth())
+                    .put(r.getHeight()).put(r.getMeteringWeight()));
+        }
+        return out;
+    }

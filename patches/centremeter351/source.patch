diff --git a/app/src/main/java/com/particlesdevs/photoncamera/m9/preview/M9CentreMetering1A.java b/app/src/main/java/com/particlesdevs/photoncamera/m9/preview/M9CentreMetering1A.java
new file mode 100644
index 0000000..1464735
--- /dev/null
+++ b/app/src/main/java/com/particlesdevs/photoncamera/m9/preview/M9CentreMetering1A.java
@@ -0,0 +1,49 @@
+package com.particlesdevs.photoncamera.m9.preview;
+
+import com.particlesdevs.photoncamera.app.PhotonCamera;
+import com.particlesdevs.photoncamera.settings.SettingsManager;
+
+/**
+ * M9CENTREMETER351: M9-style centre-weighted metering for the phone's reference AE,
+ * plus the steady gate on single quarter-stop placement moves.
+ *
+ * The Leica M9 meters centre-weighted. The M9 profile otherwise inherits the phone's
+ * whole-frame metering as its reference exposure, so a bright window entering the
+ * edge of the frame pulls the whole preview down before the M9 placement lifts it
+ * back. With this on, the M9 profile uses PhotonCamera's existing centre-weighted
+ * AE regions (nested 70/45/20 percent areas weighted 200/300/500) unless a standard
+ * metering mode was explicitly chosen.
+ */
+public final class M9CentreMetering1A {
+    public static final String KEY = "pref_m9_centre_metering";
+    public static final String REVISION = "M9CENTREMETER351";
+    /** PhotonCamera metering modes: -1 phone default, 0 centre-weighted, 1 average, 2 spot. */
+    public static final int PHONE_DEFAULT = -1, CENTRE_WEIGHTED = 0;
+
+    private M9CentreMetering1A() {}
+
+    public static boolean enabled() {
+        return enabled(PhotonCamera.getSettingsManagerStatic());
+    }
+
+    /** No settings context (host tests, early start-up) keeps the previous behaviour. */
+    static boolean enabled(SettingsManager settings) {
+        if (settings == null) return false;
+        try {
+            return settings.getBoolean(SettingsManager.SCOPE_GLOBAL, KEY, true);
+        } catch (RuntimeException malformed) {
+            return true;
+        }
+    }
+
+    /** AE metering mode for the reference exposure. */
+    public static int effectiveMode(int standardMode, boolean m9Profile, boolean enabled) {
+        if (standardMode != PHONE_DEFAULT) return standardMode;
+        return m9Profile && enabled ? CENTRE_WEIGHTED : PHONE_DEFAULT;
+    }
+
+    /** True when this feature, not an explicit standard mode, selects the AE regions. */
+    public static boolean active(int standardMode, boolean m9Profile, boolean enabled) {
+        return standardMode == PHONE_DEFAULT && m9Profile && enabled;
+    }
+}
diff --git a/app/src/main/java/com/particlesdevs/photoncamera/m9/preview/M9PlacementSteadyGate1A.java b/app/src/main/java/com/particlesdevs/photoncamera/m9/preview/M9PlacementSteadyGate1A.java
new file mode 100644
index 0000000..4428cfb
--- /dev/null
+++ b/app/src/main/java/com/particlesdevs/photoncamera/m9/preview/M9PlacementSteadyGate1A.java
@@ -0,0 +1,94 @@
+package com.particlesdevs.photoncamera.m9.preview;
+
+import org.json.JSONException;
+import org.json.JSONObject;
+
+/**
+ * M9STEADYGATE351: holds single quarter-stop placement moves until they persist.
+ *
+ * The rendered placement controller moves Auto EV on a 0.25-EV grid. With a scene
+ * that sits near a grid boundary, small hand movement flips the target between two
+ * neighbouring steps and the preview visibly ticks up and down. This gate only acts
+ * when the controller proposes a single step towards a target that is no more than
+ * one step away: that move is applied once the same direction has been proposed
+ * continuously for {@link #HOLD_NS}. Moves towards targets two or more steps away,
+ * highlight safety releases, recovery and initial acquisition pass straight through.
+ * Pure state machine; no Android dependencies.
+ */
+public final class M9PlacementSteadyGate1A {
+    public static final String REVISION = "M9STEADYGATE351";
+    static final double STEP_EV = .25;
+    static final long HOLD_NS = 1_000_000_000L;
+    private static final double EPS = 1e-9;
+
+    private int pendingDirection;
+    private long pendingSinceNs = -1;
+    private boolean lastHeld;
+    private String lastReason = "idle";
+
+    public void reset() {
+        pendingDirection = 0;
+        pendingSinceNs = -1;
+        lastHeld = false;
+        lastReason = "reset";
+    }
+
+    /**
+     * @param current   Auto EV currently applied
+     * @param proposed  Auto EV the placement controller wants to apply for this sample
+     * @param rawTarget unsettled placement target for this sample
+     * @param sampleNs  timestamp of the rendered sample behind this decision
+     * @param exempt    safety release, recovery or initial acquisition: never held
+     * @return the Auto EV to apply
+     */
+    public double gate(double current, double proposed, double rawTarget, long sampleNs, boolean exempt) {
+        lastHeld = false;
+        if (exempt) {
+            reset();
+            lastReason = "exempt";
+            return proposed;
+        }
+        double move = proposed - current;
+        if (Math.abs(rawTarget - current) >= 2 * STEP_EV - EPS) {
+            // A real exposure change of half a stop or more: unchanged behaviour.
+            reset();
+            lastReason = "large_change";
+            return proposed;
+        }
+        if (Math.abs(move) <= EPS) {
+            if (Math.abs(rawTarget - current) < STEP_EV / 2) {
+                pendingDirection = 0;
+                pendingSinceNs = -1;
+                lastReason = "settled";
+            } else {
+                lastReason = "controller_waiting";
+            }
+            return proposed;
+        }
+        int direction = move > 0 ? 1 : -1;
+        if (direction != pendingDirection || pendingSinceNs < 0) {
+            pendingDirection = direction;
+            pendingSinceNs = sampleNs;
+        }
+        if (sampleNs - pendingSinceNs >= HOLD_NS) {
+            pendingDirection = 0;
+            pendingSinceNs = -1;
+            lastReason = "persisted_step_applied";
+            return proposed;
+        }
+        lastHeld = true;
+        lastReason = "single_step_held";
+        return current;
+    }
+
+    public JSONObject diagnostics(long nowNs) {
+        try {
+            return new JSONObject().put("revision", REVISION).put("held", lastHeld).put("reason", lastReason)
+                    .put("pendingDirection", pendingDirection)
+                    .put("pendingMs", pendingSinceNs < 0 ? 0 : Math.max(0, nowNs - pendingSinceNs) / 1e6)
+                    .put("holdMs", HOLD_NS / 1e6).put("stepEv", STEP_EV);
+        } catch (JSONException e) {
+            return new JSONObject();
+        }
+    }
+}

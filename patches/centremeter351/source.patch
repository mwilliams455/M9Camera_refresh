+package com.particlesdevs.photoncamera.m9.preview;
+
+import org.junit.Test;
+
+import static org.junit.Assert.assertEquals;
+
+/** M9STEADYGATE351: single quarter-stop moves wait for a second; real changes do not. */
+public class M9PlacementSteadyGateTest {
+    private static final long MS = 1_000_000L;
+    private static final double E = 1e-12;
+
+    @Test public void singleStepIsHeldUntilItPersistsForOneSecond() {
+        M9PlacementSteadyGate1A gate = new M9PlacementSteadyGate1A();
+        assertEquals(.25, gate.gate(.25, .50, .50, 0, false), E);
+        assertEquals(.25, gate.gate(.25, .50, .50, 250 * MS, false), E);
+        assertEquals(.25, gate.gate(.25, .50, .50, 999 * MS, false), E);
+        assertEquals(.50, gate.gate(.25, .50, .50, 1000 * MS, false), E);
+        // Settled afterwards: nothing pending.
+        assertEquals(.50, gate.gate(.50, .50, .50, 1250 * MS, false), E);
+    }
+
+    @Test public void downwardSingleStepIsHeldTheSameWay() {
+        M9PlacementSteadyGate1A gate = new M9PlacementSteadyGate1A();
+        assertEquals(.50, gate.gate(.50, .25, .25, 0, false), E);
+        assertEquals(.50, gate.gate(.50, .25, .25, 750 * MS, false), E);
+        assertEquals(.25, gate.gate(.50, .25, .25, 1000 * MS, false), E);
+    }
+
+    @Test public void flickerBetweenNeighbouringStepsNeverMoves() {
+        M9PlacementSteadyGate1A gate = new M9PlacementSteadyGate1A();
+        for (int i = 0; i < 40; i++) {
+            boolean up = (i / 2) % 2 == 0;   // the target flips direction every half second
+            double proposed = up ? .75 : .25;
+            assertEquals("sample " + i, .50, gate.gate(.50, proposed, proposed, i * 250L * MS, false), E);
+        }
+    }
+
+    @Test public void directionChangeRestartsTheHold() {
+        M9PlacementSteadyGate1A gate = new M9PlacementSteadyGate1A();
+        assertEquals(.50, gate.gate(.50, .75, .75, 0, false), E);
+        assertEquals(.50, gate.gate(.50, .25, .25, 500 * MS, false), E);
+        assertEquals(.50, gate.gate(.50, .25, .25, 1400 * MS, false), E);
+        assertEquals(.25, gate.gate(.50, .25, .25, 1500 * MS, false), E);
+    }
+
+    @Test public void controllerWaitingKeepsTheTimerButSettlingClearsIt() {
+        M9PlacementSteadyGate1A gate = new M9PlacementSteadyGate1A();
+        assertEquals(.25, gate.gate(.25, .50, .50, 0, false), E);
+        // The controller itself pauses for a sample while the target is still a step away.
+        assertEquals(.25, gate.gate(.25, .25, .50, 500 * MS, false), E);
+        assertEquals(.50, gate.gate(.25, .50, .50, 1000 * MS, false), E);
+        // A target that returns to the applied value clears the pending move.
+        M9PlacementSteadyGate1A other = new M9PlacementSteadyGate1A();
+        assertEquals(.25, other.gate(.25, .50, .50, 0, false), E);
+        assertEquals(.25, other.gate(.25, .25, .25, 500 * MS, false), E);
+        assertEquals(.25, other.gate(.25, .50, .50, 1000 * MS, false), E);
+        assertEquals(.50, other.gate(.25, .50, .50, 2000 * MS, false), E);
+    }
+
+    @Test public void largeChangesAndExemptMovesPassStraightThrough() {
+        M9PlacementSteadyGate1A gate = new M9PlacementSteadyGate1A();
+        // Target half a stop or more away: the controller's own step applies at once.
+        assertEquals(.50, gate.gate(.25, .50, .75, 0, false), E);
+        assertEquals(1.0, gate.gate(.25, 1.0, 2.0, 0, false), E);
+        assertEquals(0.0, gate.gate(.75, 0.0, 0.0, 0, false), E);
+        // Highlight safety release, recovery or first acquisition: never held.
+        assertEquals(.50, gate.gate(.25, .50, .50, 0, true), E);
+        assertEquals(0.0, gate.gate(.25, 0.0, .25 - .25, 0, true), E);
+    }
+}

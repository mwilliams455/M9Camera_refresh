+package com.particlesdevs.photoncamera.m9.preview;
+
+import com.particlesdevs.photoncamera.settings.SettingsManager;
+
+import org.junit.Test;
+
+import static org.junit.Assert.assertEquals;
+import static org.junit.Assert.assertFalse;
+import static org.junit.Assert.assertTrue;
+import static org.mockito.Mockito.mock;
+import static org.mockito.Mockito.when;
+
+/** M9CENTREMETER351: the M9 profile meters centre-weighted unless told otherwise. */
+public class M9CentreMeteringTest {
+    @Test public void m9ProfileDefaultsToCentreWeighted() {
+        assertEquals(M9CentreMetering1A.CENTRE_WEIGHTED, M9CentreMetering1A.effectiveMode(-1, true, true));
+        assertTrue(M9CentreMetering1A.active(-1, true, true));
+    }
+
+    @Test public void offMonochromOrExplicitModesKeepTheirMetering() {
+        assertEquals(-1, M9CentreMetering1A.effectiveMode(-1, true, false));
+        assertEquals(-1, M9CentreMetering1A.effectiveMode(-1, false, true));
+        for (int explicit : new int[] {0, 1, 2}) {
+            assertEquals(explicit, M9CentreMetering1A.effectiveMode(explicit, true, true));
+            assertFalse(M9CentreMetering1A.active(explicit, true, true));
+        }
+        assertFalse(M9CentreMetering1A.active(-1, false, true));
+        assertFalse(M9CentreMetering1A.active(-1, true, false));
+    }
+
+    @Test public void settingDefaultsOnAndWithoutSettingsKeepsPreviousBehaviour() {
+        SettingsManager settings = mock(SettingsManager.class);
+        when(settings.getBoolean(SettingsManager.SCOPE_GLOBAL, M9CentreMetering1A.KEY, true)).thenReturn(true);
+        assertTrue(M9CentreMetering1A.enabled(settings));
+        when(settings.getBoolean(SettingsManager.SCOPE_GLOBAL, M9CentreMetering1A.KEY, true)).thenReturn(false);
+        assertFalse(M9CentreMetering1A.enabled(settings));
+        when(settings.getBoolean(SettingsManager.SCOPE_GLOBAL, M9CentreMetering1A.KEY, true))
+                .thenThrow(new ClassCastException("stored as string"));
+        assertTrue(M9CentreMetering1A.enabled(settings));
+        assertFalse(M9CentreMetering1A.enabled(null));
+    }
+}

+            put(out, "sensorTimestampNs", capture.get(CaptureResult.SENSOR_TIMESTAMP));
+            put(out, "savedDngDecodedPixelsCompared", false);
+            trace.dngRawPair = out;
+            } catch (Exception | LinkageError | OutOfMemoryError ignored) {
+                // Optional diagnostics cannot invalidate the already-saved normal capture.
+            }
+        }
+    }

@@ -0,0 +1,61 @@
+package com.particlesdevs.photoncamera.ui.camera;
+
+import android.app.Application;
+import com.particlesdevs.photoncamera.control.tracking.SubjectAnchorPolicy.ClassId;
+import org.junit.Test;
+import org.junit.runner.RunWith;
+import org.robolectric.RobolectricTestRunner;
+import org.robolectric.annotation.Config;
+import static org.junit.Assert.*;
+
+@RunWith(RobolectricTestRunner.class)
+@Config(sdk=35, application=Application.class)
+public class PetSpeciesEvidenceTest {
+    @Test public void abstentionsNeverPromoteTheDetectorsDogGuess() {
+        try (PetSpeciesLabel label = new PetSpeciesLabel()) {
+            assertNull(label.displayed(23));
+            for (int i=1; i<=17; i++) {
+                long frame = i*220_000_000L;
+                ClassId reading = i==9 ? ClassId.CAT : null;
+                assertNull(label.record(23, ClassId.DOG, reading, frame, frame+170_000_000L));
+            }
+        }
+    }
+
+    @Test public void catReadingsFromTheSameSelectionSurviveAbstentions() {
+        try (PetSpeciesLabel label = new PetSpeciesLabel()) {
+            label.displayed(33);
+            long[] frames = {254141512674241L, 254141821520803L, 254142029090960L,
+                    254142336460907L, 254142537876116L, 254142745657470L};
+            for (int i=0; i<frames.length; i++) {
+                ClassId reading = i==1 || i==4 ? ClassId.CAT : null;
+                ClassId shown = label.record(33, ClassId.DOG, reading, frames[i], frames[i]+200_000_000L);
+                assertEquals(i>=4 ? ClassId.CAT : null, shown);
+            }
+            assertNull(label.displayed(37));
+        }
+    }
+
+    @Test public void matchingClassifiersConfirmEitherSpeciesOnOneFreshFrame() {
+        try (PetSpeciesLabel label = new PetSpeciesLabel()) {
+            for (ClassId species : new ClassId[]{ClassId.CAT, ClassId.DOG}) {
+                label.reset();
+                assertNull(label.displayed(1));
+                assertEquals(species, label.record(1,species,species,100,101));
+                assertEquals(species, label.displayed(1));
+            }
+        }
+    }
+
+    @Test public void expiredAndOutOfOrderVotesCannotConfirmACorrection() {
+        try (PetSpeciesLabel label = new PetSpeciesLabel()) {
+            label.displayed(3);
+            assertNull(label.record(3,ClassId.DOG,ClassId.CAT,1,2));
+            long late = 1_200_000_000L;
+            assertNull(label.record(3,ClassId.DOG,ClassId.CAT,late,late+1));
+            assertNull(label.record(3,ClassId.DOG,ClassId.CAT,late-1,late));
+            assertNull(label.record(3,ClassId.DOG,ClassId.CAT,late+100,late+400_000_000L));
+            assertEquals(ClassId.CAT,label.record(3,ClassId.DOG,ClassId.CAT,late+200,late+201));
+        }
+    }
+}

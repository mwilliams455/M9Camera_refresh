@@ -0,0 +1,35 @@
+package com.particlesdevs.photoncamera.processing;
+
+import java.time.LocalDateTime;
+import java.time.format.DateTimeFormatter;
+import java.time.format.DateTimeParseException;
+import java.time.format.ResolverStyle;
+import java.util.Locale;
+import java.util.regex.Matcher;
+import java.util.regex.Pattern;
+
+/** M9 DNG interpretation defaults; no sensor values or JPEG tuning. */
+public final class M9DngExportMetadata {
+    // Traced ordinary M9 firmware DNG value. Phone ISO80 does not imply the
+    // Leica pulled-ISO80 capture mode, so its -1.5 EV special case is not copied.
+    public static final double BASELINE_EXPOSURE_EV = -0.5;
+    private static final Pattern STEM = Pattern.compile("^IMG_(\\d{8})_(\\d{6})(?:_|\\.|$)");
+    private static final DateTimeFormatter INPUT = DateTimeFormatter
+            .ofPattern("uuuuMMddHHmmss", Locale.US).withResolverStyle(ResolverStyle.STRICT);
+    private static final DateTimeFormatter OUTPUT = DateTimeFormatter
+            .ofPattern("uuuu:MM:dd HH:mm:ss", Locale.US);
+
+    private M9DngExportMetadata() {}
+
+    /** Capture-local date from the same frozen stem used by JPEG EXIF. */
+    public static String captureDateTime(String fileName) {
+        if (fileName == null) return null;
+        Matcher m = STEM.matcher(fileName);
+        if (!m.find()) return null;
+        try {
+            return LocalDateTime.parse(m.group(1) + m.group(2), INPUT).format(OUTPUT);
+        } catch (DateTimeParseException invalidDate) {
+            return null;
+        }
+    }
+}

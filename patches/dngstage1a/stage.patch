+package com.particlesdevs.photoncamera.processing;
+
+import org.junit.Test;
+import static org.junit.Assert.*;
+
+public class M9DngExportMetadataTest {
+    @Test public void usesCaptureStemDespiteDelayedSaving() {
+        assertEquals("2026:02:03 04:05:06", M9DngExportMetadata.captureDateTime("IMG_20260203_040506_1770000000000_00.dng"));
+    }
+    @Test public void retainsCaptureLocalTimeWithoutTimezoneConversion() {
+        assertEquals("2026:10:25 01:30:00", M9DngExportMetadata.captureDateTime("IMG_20261025_013000_1790000000000_00.dng"));
+    }
+    @Test public void acceptsRealLeapDay() {
+        assertEquals("2024:02:29 23:59:59", M9DngExportMetadata.captureDateTime("IMG_20240229_235959.dng"));
+    }
+    @Test public void rejectsImpossibleOrUnknownNames() {
+        for (String name : new String[]{null,"x.dng","IMG_20260230_120000_00.dng","IMG_20260101_246000_00.dng","IMG_20260101_1200000.dng"})
+            assertNull(M9DngExportMetadata.captureDateTime(name));
+    }
+    @Test public void usesOrdinaryFirmwareDefaultWithoutPhoneIsoLookup() {
+        assertEquals(-0.5, M9DngExportMetadata.BASELINE_EXPOSURE_EV, 0.0);
+    }
+}

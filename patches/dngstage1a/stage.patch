+bool DNGImage::SetBaselineExposure(double ev) {
+  // DNG tag 50730 is SRATIONAL: a reader exposure default, not RAW arithmetic.
+  if (!std::isfinite(ev) || ev < -16.0 || ev > 16.0) return false;
+  double numerator, denominator;
+  if (DoubleToRational(ev, &numerator, &denominator) != 0 ||
+      numerator < -2147483648.0 || numerator > 2147483647.0 ||
+      denominator <= 0.0 || denominator > 2147483647.0) return false;
+  const int data[2] = {static_cast<int>(numerator), static_cast<int>(denominator)};
+  if (!WriteTIFFTag(50730, TIFF_SRATIONAL, 1,
+                    reinterpret_cast<const unsigned char *>(data),
+                    &ifd_tags_, &data_os_)) return false;
+  num_fields_++;
+  return true;
+}

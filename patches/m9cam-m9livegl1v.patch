+package com.particlesdevs.photoncamera.m9.preview;
+
+import java.util.Arrays;
+
+/** Small, rotation-independent regional summary of the existing neutral Y feed. */
+public final class M9PreviewSpatialStats1V {
+    private final int[][] histograms = new int[9][256];
+    private final int[] counts = new int[9];
+    private final int[] medians = new int[9];
+
+    /** Writes second-lowest/highest tile medians; single outlier tiles cannot qualify. */
+    public synchronized boolean fill(byte[] frame, int width, int height,
+                                     float[] out, int offset) {
+        if (out == null || offset < 0 || offset > out.length - 2) return false;
+        out[offset] = Float.NaN;
+        out[offset + 1] = Float.NaN;
+        if (frame == null || width < 3 || height < 3
+                || (long) width * height > frame.length) return false;
+        Arrays.fill(counts, 0);
+        for (int[] histogram : histograms) Arrays.fill(histogram, 0);
+        for (int y = 0; y < height; y++) {
+            int tileRow = (int) ((long) y * 3 / height) * 3;
+            for (int x = 0; x < width; x++) {
+                int tile = tileRow + (int) ((long) x * 3 / width);
+                histograms[tile][frame[y * width + x] & 255]++;
+                counts[tile]++;
+            }
+        }
+        for (int tile = 0; tile < 9; tile++) {
+            int target = (counts[tile] + 1) / 2;
+            int cumulative = 0;
+            for (int code = 0; code < 256; code++) {
+                cumulative += histograms[tile][code];
+                if (cumulative >= target) {
+                    medians[tile] = code;
+                    break;
+                }
+            }
+        }
+        Arrays.sort(medians);
+        out[offset] = medians[1];
+        out[offset + 1] = medians[7];
+        return true;
+    }
+}

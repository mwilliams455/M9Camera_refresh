+package com.particlesdevs.photoncamera.ui.camera;
+
+import android.content.Context;
+import android.graphics.Bitmap;
+import com.particlesdevs.photoncamera.control.subject.AutomaticSubjectSelection.Box;
+import com.particlesdevs.photoncamera.control.subject.SceneHeads;
+import java.io.ByteArrayOutputStream;
+import java.io.IOException;
+import java.io.InputStream;
+import java.util.ArrayList;
+import java.util.List;
+import org.opencv.android.OpenCVLoader;
+import org.opencv.android.Utils;
+import org.opencv.core.Mat;
+import org.opencv.core.MatOfByte;
+import org.opencv.core.Size;
+import org.opencv.imgproc.Imgproc;
+import org.opencv.objdetect.FaceDetectorYN;
+
+/** Serial preview worker. One bounded face pass, using the OpenCV runtime already bundled. */
+final class SceneFaceDetector implements AutoCloseable {
+    private final FaceDetectorYN detector;
+    private final Mat rgba, bgr, output;
+    private final float[] row = new float[15];
+
+    SceneFaceDetector(Context context) throws IOException {
+        if (!OpenCVLoader.initLocal()) throw new IllegalStateException("OpenCV unavailable");
+        try (InputStream in = context.getAssets().open("face_detection_yunet.onnx");
+             ByteArrayOutputStream out = new ByteArrayOutputStream()) {
+            byte[] buffer = new byte[8192];
+            for (int read; (read = in.read(buffer)) != -1;) out.write(buffer, 0, read);
+            MatOfByte weights = new MatOfByte(out.toByteArray()), config = new MatOfByte();
+            try {
+                detector = FaceDetectorYN.create("onnx", weights, config, new Size(540,720), .80f, .3f, 500);
+            } finally {
+                weights.release();
+                config.release();
+            }
+        }
+        rgba = new Mat(); bgr = new Mat(); output = new Mat();
+    }
+
+    List<Box> detect(Bitmap bitmap, int rotation) {
+        Utils.bitmapToMat(bitmap, rgba);
+        // The preview sampler already caps the long edge at 720 px. Preserve the
+        // profile detail in crowded scenes instead of resizing this sample twice.
+        int w=rgba.cols(), h=rgba.rows();
+        Imgproc.cvtColor(rgba, bgr, Imgproc.COLOR_RGBA2BGR);
+        detector.setInputSize(new Size(w,h));
+        detector.detect(bgr, output);
+        List<Box> boxes = new ArrayList<>();
+        for (int i=0; i<output.rows(); i++) {
+            output.get(i,0,row);
+            Box box = SceneHeads.decode(row,w,h,rotation);
+            if (box != null) boxes.add(box);
+        }
+        return boxes;
+    }
+
+    @Override public void close() {
+        rgba.release(); bgr.release(); output.release();
+    }
+}

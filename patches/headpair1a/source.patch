+package com.particlesdevs.photoncamera.control.subject;
+
+import com.particlesdevs.photoncamera.control.subject.AutomaticSubjectSelection.Box;
+import java.util.ArrayList;
+import java.util.Collections;
+import java.util.List;
+
+/** Supplements landmark tracking when two distinct faces share the preview. */
+public final class SceneHeads {
+    private long pairedAt;
+    private List<Box> lastPair = Collections.emptyList();
+
+    public void clear() {
+        lastPair = Collections.emptyList();
+        pairedAt = 0;
+    }
+
+    public void merge(List<Box> landmarkFaces, List<Box> proposals, long frame) {
+        List<Box> distinct = new ArrayList<>(landmarkFaces);
+        for (Box head : proposals) {
+            if (!matchesAny(head, distinct)) distinct.add(head);
+        }
+        if (distinct.size() >= 2) {
+            landmarkFaces.clear();
+            landmarkFaces.addAll(distinct);
+            lastPair = new ArrayList<>(distinct);
+            pairedAt = frame;
+        } else if (frame < pairedAt || frame - pairedAt > AutomaticSubjectSelection.HOLD_NS) {
+            clear();
+        } else if (landmarkFaces.isEmpty() && distinct.size() == 1 && matchesAny(distinct.get(0), lastPair)) {
+            // One of the pair is still visibly detected, for example after the other turns away.
+            landmarkFaces.add(distinct.get(0));
+        }
+    }
+
+    private static boolean matchesAny(Box a, List<Box> faces) {
+        for (Box b : faces) {
+            float w = Math.max(0f, Math.min(a.right,b.right) - Math.max(a.left,b.left));
+            float h = Math.max(0f, Math.min(a.bottom,b.bottom) - Math.max(a.top,b.top));
+            float smaller = Math.min((a.right-a.left)*(a.bottom-a.top), (b.right-b.left)*(b.bottom-b.top));
+            if (w*h >= .48f*smaller && Math.abs(a.cx()-b.cx()) < .52f*Math.max(a.right-a.left,b.right-b.left)
+                    && Math.abs(a.cy()-b.cy()) < .52f*Math.max(a.bottom-a.top,b.bottom-b.top)) return true;
+        }
+        return false;
+    }
+
+    /** YuNet supplies a face box, two eyes, a nose, two mouth corners and a score. */
+    public static Box decode(float[] row, int w, int h, int rotation) {
+        if (row.length != 15 || w <= 0 || h <= 0) return null;
+        for (float value : row) if (!Float.isFinite(value)) return null;
+        float x = row[0], y = row[1], width = row[2], height = row[3];
+        if (row[14] < .80f || row[14] > 1f || width < 12 || height < 12) return null;
+        float eyeY = (row[5]+row[7])*.5f, mouthY = (row[11]+row[13])*.5f;
+        if (row[9]-eyeY < .045f*height || mouthY-row[9] < .045f*height) return null;
+        for (int i=4; i<14; i+=2) {
+            if (row[i] < x-.15f*width || row[i] > x+1.15f*width ||
+                    row[i+1] < y || row[i+1] > y+height) return null;
+        }
+        float left = Math.max(0f,x/w), top = Math.max(0f,y/h);
+        float right = Math.min(1f,(x+width)/w), bottom = Math.min(1f,(y+height)/h);
+        if (left >= right || top >= bottom) return null;
+        return Box.fromHead(left, top, right, bottom, rotation);
+    }
+}

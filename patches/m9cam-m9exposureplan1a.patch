+package com.particlesdevs.photoncamera.m9;
+
+import org.json.JSONObject;
+
+public final class M9ExposurePlanDiagnostics1A {
+    private M9ExposurePlanDiagnostics1A() {}
+
+    public static JSONObject toJson(M9ExposurePlan1A plan) {
+        JSONObject o = new JSONObject();
+        if (plan == null) return o;
+        try {
+            o.put("schema", "m9cam.exposureplan.v1a");
+            o.put("revision", M9ExposurePlan1A.REVISION);
+            o.put("id", plan.id);
+            o.put("createdElapsedMs", plan.createdMs);
+            o.put("sourceSensorTimestampNs", plan.sensorTimestampNs);
+            o.put("cameraId", plan.cameraId);
+            o.put("mode", plan.mode);
+            o.put("observedIso", plan.observedIso);
+            o.put("observedExposureNs", plan.observedExposureNs);
+            o.put("referenceIso", plan.referenceIso);
+            o.put("referenceExposureNs", plan.referenceExposureNs);
+            o.put("plannedIso", plan.iso);
+            o.put("plannedExposureNs", plan.exposureNs);
+            o.put("userEv", plan.userEv);
+            o.put("autoEv", plan.autoEv);
+            o.put("autoReason", plan.autoReason);
+            o.put("manualIso", plan.manualIso);
+            o.put("manualExposureNs", plan.manualExposureNs);
+            o.put("previewExposureScale", plan.previewScale());
+            o.put("previewScaleLimited", plan.previewScale() < 0.0625 || plan.previewScale() > 16.0);
+            o.put("previewPostRawSensitivityBoost", plan.postRawBoost);
+            o.put("previewInput", "neutral_hardware_AE_processed_OES");
+            o.put("previewPlanStage", "submitted_to_GL_not_timestamp_verified_presentation");
+            o.put("renderMeasurementReference", "neutral_plan_without_auto_assist_or_user_offset");
+            o.put("plannedRenderIntentScale", plan.renderIntentScale(plan.iso, plan.exposureNs));
+        } catch (org.json.JSONException e) {
+            throw new IllegalStateException("Exposure-plan diagnostics", e);
+        }
+        return o;
+    }
+}

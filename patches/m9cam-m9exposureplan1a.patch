+package com.particlesdevs.photoncamera.m9;
+
+/** Immutable per-observation exposure intent. No Android or mutable camera state. */
+public final class M9ExposurePlan1A {
+    public static final String REVISION = "M9EXPOSUREPLAN1A";
+    public static final long MAX_AGE_MS = 1500L;
+    public final long id, createdMs, sensorTimestampNs;
+    public final String cameraId, mode, autoReason;
+    public final int observedIso, referenceIso, iso, postRawBoost;
+    public final long observedExposureNs, referenceExposureNs, exposureNs;
+    public final double userEv, autoEv;
+    public final long manualExposureNs;
+    public final int manualIso;
+
+    public M9ExposurePlan1A(long id, long createdMs, long sensorTimestampNs,
+            String cameraId, String mode, int observedIso, long observedExposureNs,
+            int referenceIso, long referenceExposureNs, int iso, long exposureNs,
+            double userEv, double autoEv, String autoReason,
+            long manualExposureNs, int manualIso, int postRawBoost) {
+        if (observedIso <= 0 || observedExposureNs <= 0 || referenceIso <= 0
+                || referenceExposureNs <= 0 || iso <= 0 || exposureNs <= 0
+                || !Double.isFinite(userEv) || !Double.isFinite(autoEv)) {
+            throw new IllegalArgumentException("Invalid M9 exposure plan");
+        }
+        this.id=id; this.createdMs=createdMs; this.sensorTimestampNs=sensorTimestampNs;
+        this.cameraId=cameraId; this.mode=mode; this.observedIso=observedIso;
+        this.observedExposureNs=observedExposureNs; this.referenceIso=referenceIso;
+        this.referenceExposureNs=referenceExposureNs; this.iso=iso; this.exposureNs=exposureNs;
+        this.userEv=userEv; this.autoEv=autoEv; this.autoReason=autoReason;
+        this.manualExposureNs=manualExposureNs; this.manualIso=manualIso;
+        this.postRawBoost=postRawBoost;
+    }
+
+    public double previewScale() {
+        return energy(iso, exposureNs) / energy(observedIso, observedExposureNs);
+    }
+
+    /** Use actual RAW exposure, including sensor limits, relative to the neutral plan. */
+    public double renderIntentScale(int actualIso, long actualExposureNs) {
+        if (actualIso <= 0 || actualExposureNs <= 0) return 1.0;
+        return energy(actualIso, actualExposureNs) / energy(referenceIso, referenceExposureNs);
+    }
+
+    public boolean matches(String camera, String currentMode, long nowMs,
+            double ev, long shutter, int sensitivity) {
+        return cameraId != null && cameraId.equals(camera) && mode.equals(currentMode)
+                && nowMs >= createdMs && nowMs-createdMs <= MAX_AGE_MS
+                && Math.abs(userEv-ev) < 1e-9
+                && manualExposureNs == shutter && manualIso == sensitivity;
+    }
+
+    public static double energy(int iso, long exposureNs) {
+        return (double) iso * exposureNs;
+    }
+
+    /** Pure policy: EV compensation does not disable the automatic scene baseline. */
+    public static boolean autoEligible(boolean photo, boolean tripod,
+            long manualExposureNs, int manualIso) {
+        return photo && !tripod && manualExposureNs == 0 && manualIso == 0;
+    }
+
+    /** TC20 observes neutral-placement statistics; actual exposed pixels are untouched. */
+    public static double neutralBaseGain(double median, double intentScale, double target) {
+        return clamp(target / Math.max(median / validScale(intentScale), 1e-6), 0.5, 16.0);
+    }
+
+    public static double neutralGuardGain(double tail, double intentScale, double target) {
+        return Math.max(1.0, target / Math.max(tail / validScale(intentScale), 1e-9));
+    }
+
+    public static double boundedGain(double gain) {
+        return clamp(gain, Math.pow(2.0, -0.5), Math.pow(2.0, 0.5));
+    }
+
+    private static double validScale(double scale) {
+        return Double.isFinite(scale) && scale > 0 ? scale : 1.0;
+    }
+
+    private static double clamp(double x, double lo, double hi) {
+        return Math.max(lo, Math.min(hi, x));
+    }
+}

@@ -0,0 +1,72 @@
+package com.particlesdevs.photoncamera.m9;
+
+import org.junit.Test;
+
+import static org.junit.Assert.*;
+
+/** M9SETTLEMETER352: the automatic motion hold reuses the AE lock without becoming AE-L. */
+public class M9AeLockAutomaticTest {
+    private static M9AeLock1A.Context context(long manualTime, String mode) {
+        return new M9AeLock1A.Context("0", mode, 1, 0, manualTime, 0,
+                new M9AutoIsoSettings(800, 1).resolve(24, 36).identity, "default");
+    }
+    private static M9AeLock1A.Context normal() { return context(0, "PHOTO"); }
+    private static M9ExposurePlan1A shown(M9AeLock1A lock, M9AeLock1A.Context c, long now) {
+        long generation = lock.context(c);
+        M9ExposurePlan1A plan = new M9ExposurePlan1A(now, now, now * 1000000, c.camera, c.mode, 200, 16000000L,
+                400, 8000000L, 320, 8000000L, c.ev, 0.2, "auto_placement", c.manualTime, c.manualIso, 100)
+                .withAutoIsoControls(c.autoIsoIdentity).withAllocationSnapshot2G("{\"source\":true}")
+                .withAutoPlacement2D("{\"meter\":true}");
+        return lock.stamp(plan, c, generation);
+    }
+
+    @Test public void automaticHoldHoldsTheShownExposureButIsNotAeL() {
+        M9AeLock1A lock = new M9AeLock1A(); M9AeLock1A.Context c = normal();
+        M9ExposurePlan1A plan = shown(lock, c, 100);
+        assertTrue(lock.engageAutomatic(plan, c, 110));
+        assertTrue(lock.isLocked());
+        assertTrue(lock.isAutomaticHold());
+        assertFalse(lock.isUserLocked());
+        M9ExposurePlan1A held = lock.project(c, lock.context(c), 200, 200, 200000000L, 800, 4000000L, 100, 800, 4000000L);
+        assertNotNull(held);
+        assertEquals(plan.iso, held.iso);
+        assertEquals(plan.exposureNs, held.exposureNs);
+        assertTrue(lock.releaseAutomatic());
+        assertFalse(lock.isLocked());
+    }
+
+    @Test public void pressingAeLDuringAHoldKeepsThatExposureAsTheUsersLock() {
+        M9AeLock1A lock = new M9AeLock1A(); M9AeLock1A.Context c = normal();
+        M9ExposurePlan1A plan = shown(lock, c, 100);
+        assertTrue(lock.engageAutomatic(plan, c, 110));
+        M9ExposurePlan1A held = lock.stamp(lock.project(c, lock.context(c), 300, 300, 300000000L,
+                800, 4000000L, 100, 800, 4000000L), c, lock.context(c));
+        assertTrue(lock.engage(held, c, 310));
+        assertTrue(lock.isUserLocked());
+        assertFalse(lock.isAutomaticHold());
+        assertFalse(lock.releaseAutomatic());
+        assertTrue(lock.isLocked());
+        M9ExposurePlan1A after = lock.project(c, lock.context(c), 400, 400, 400000000L, 100, 30000000L, 100, 100, 30000000L);
+        assertEquals(plan.iso, after.iso);
+        assertEquals(plan.exposureNs, after.exposureNs);
+    }
+
+    @Test public void automaticHoldNeverReplacesOrReleasesAeL() {
+        M9AeLock1A lock = new M9AeLock1A(); M9AeLock1A.Context c = normal();
+        assertTrue(lock.engage(shown(lock, c, 100), c, 110));
+        assertFalse(lock.engageAutomatic(shown(lock, c, 120), c, 130));
+        assertFalse(lock.releaseAutomatic());
+        assertTrue(lock.isUserLocked());
+    }
+
+    @Test public void controlChangesEndTheHoldAndManualShutterIsRefused() {
+        M9AeLock1A lock = new M9AeLock1A(); M9AeLock1A.Context c = normal();
+        assertTrue(lock.engageAutomatic(shown(lock, c, 100), c, 110));
+        lock.context(context(0, "PHOTO_OTHER"));
+        assertFalse(lock.isLocked());
+        M9AeLock1A manual = new M9AeLock1A(); M9AeLock1A.Context m = context(10000000L, "PHOTO");
+        assertFalse(manual.engageAutomatic(shown(manual, m, 100), m, 110));
+        M9AeLock1A video = new M9AeLock1A(); M9AeLock1A.Context v = context(0, "VIDEO");
+        assertFalse(video.engageAutomatic(shown(video, v, 100), v, 110));
+    }
+}

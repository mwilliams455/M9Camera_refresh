index 0000000..acbeb2c
--- /dev/null
+++ b/app/src/main/java/com/particlesdevs/photoncamera/m9/preview/M9DisplayEase1A.java
@@ -0,0 +1,54 @@
+package com.particlesdevs.photoncamera.m9.preview;
+
+/**
+ * M9SETTLEMETER352: eases visible exposure steps on screen only.
+ *
+ * When the planned exposure jumps by {@link #MIN_STEP_EV} or more between preview frames
+ * (an M9 placement step, or re-metering after a motion hold), the on-screen brightness glides
+ * to the new exposure over {@link #DURATION_NS} instead of popping. Only the final display
+ * uniform is multiplied: metering probes, evidence panels and the shutter always use the plan.
+ */
+public final class M9DisplayEase1A {
+    public static final M9DisplayEase1A INSTANCE = new M9DisplayEase1A();
+    static final double MIN_STEP_EV = .2, MAX_OFFSET_EV = 4;
+    static final long DURATION_NS = 300_000_000L;
+
+    private boolean havePrevious;
+    private double previousLogEnergy, startOffsetEv;
+    private long startNs = -1;
+
+    public synchronized void reset() {
+        havePrevious = false;
+        startOffsetEv = 0;
+        startNs = -1;
+    }
+
+    /** Called once per preview result with log2 of the planned ISO x exposure-time energy. */
+    public synchronized void observe(long nowNs, double logEnergy, boolean enabled) {
+        if (!enabled || !Double.isFinite(logEnergy)) { reset(); return; }
+        if (havePrevious) {
+            double delta = logEnergy - previousLogEnergy;
+            if (Math.abs(delta) >= MIN_STEP_EV) {
+                // Keep the brightness on screen where it was, then glide from there.
+                startOffsetEv = Math.max(-MAX_OFFSET_EV, Math.min(MAX_OFFSET_EV, offsetEv(nowNs) - delta));
+                startNs = nowNs;
+            }
+        }
+        previousLogEnergy = logEnergy;
+        havePrevious = true;
+    }
+
+    /** EV offset to apply on screen; 0 when no step is easing. */
+    public synchronized double offsetEv(long nowNs) {
+        if (startNs < 0) return 0;
+        long elapsed = nowNs - startNs;
+        if (elapsed < 0) return startOffsetEv;
+        if (elapsed >= DURATION_NS) { startNs = -1; startOffsetEv = 0; return 0; }
+        return startOffsetEv * (1 - elapsed / (double) DURATION_NS);
+    }
+
+    /** Multiplier for the on-screen exposure scale. */
+    public float multiplier(long nowNs) {
+        return (float) Math.pow(2, offsetEv(nowNs));
+    }
+}

@@ -0,0 +1,40 @@
+package com.particlesdevs.photoncamera.m9.preview;
+
+import com.particlesdevs.photoncamera.app.PhotonCamera;
+import com.particlesdevs.photoncamera.settings.SettingsManager;
+
+/**
+ * M9SETTLEMETER352 setting: "Settle, then meter" (default on).
+ *
+ * On: the displayed exposure is held while the phone pans ({@link M9MotionHold1A}), re-metered in
+ * one step once it settles, single quarter-stop flicker is held ({@link M9PlacementSteadyGate1A})
+ * and visible exposure steps glide on screen ({@link M9DisplayEase1A}). Off: continuous metering.
+ */
+public final class M9SettleMeter1A {
+    public static final String KEY = "pref_m9_settle_meter";
+    public static final String REVISION = "M9SETTLEMETER352";
+    private static volatile String lastShutter = "{}";
+
+    private M9SettleMeter1A() {}
+
+    public static boolean enabled() {
+        return enabled(PhotonCamera.getSettingsManagerStatic());
+    }
+
+    /** No settings context (host tests, early start-up) keeps the previous behaviour. */
+    static boolean enabled(SettingsManager settings) {
+        if (settings == null) return false;
+        try {
+            return settings.getBoolean(SettingsManager.SCOPE_GLOBAL, KEY, true);
+        } catch (RuntimeException malformed) {
+            return true;
+        }
+    }
+
+    /** Motion-hold state when the shutter was pressed, for that photo's diagnostics. */
+    public static void recordShutter(org.json.JSONObject state) {
+        lastShutter = state == null ? "{}" : state.toString();
+    }
+
+    public static String lastShutter() { return lastShutter; }
+}

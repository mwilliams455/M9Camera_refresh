+package com.particlesdevs.photoncamera.m9.preview;
+
+import org.json.JSONException;
+import org.json.JSONObject;
+
+/**
+ * M9SETTLEMETER352: decides from gyroscope speed whether the displayed exposure should be held.
+ *
+ * Moving: the phone turns faster than {@link #MOVING_DEG_S} for {@link #MOVING_CONFIRM_NS}.
+ * Settled: slower than {@link #SETTLED_DEG_S} continuously for {@link #SETTLE_NS}. Between the
+ * two thresholds the state does not change, so hand tremor neither starts nor ends a hold.
+ * A hold lasting {@link #MAX_HOLD_NS} pauses for {@link #REFRESH_NS} of live metering so a long
+ * walk or pan still follows the light. Missing or stale gyroscope data never holds.
+ * Pure state machine: the caller engages or releases the actual exposure lock.
+ */
+public final class M9MotionHold1A {
+    public static final String REVISION = "M9SETTLEMETER352";
+    static final double MOVING_DEG_S = 12.0, SETTLED_DEG_S = 4.0;
+    static final long MOVING_CONFIRM_NS = 50_000_000L, SETTLE_NS = 300_000_000L;
+    static final long MAX_HOLD_NS = 2_500_000_000L, REFRESH_NS = 350_000_000L;
+    static final long STALE_GYRO_NS = 200_000_000L;
+
+    private boolean moving;
+    private long fastSinceNs = -1, slowSinceNs = -1, holdSinceNs = -1, refreshUntilNs = -1;
+    private double lastSpeed;
+    private long lastHoldMs, holds;
+    private String reason = "idle";
+
+    public synchronized void reset() {
+        moving = false;
+        fastSinceNs = slowSinceNs = holdSinceNs = refreshUntilNs = -1;
+        reason = "reset";
+    }
+
+    /**
+     * @param nowNs        elapsed-realtime clock
+     * @param speedDegS    smoothed gyroscope speed
+     * @param gyroSampleNs timestamp of the newest gyroscope sample (same clock), or -1
+     * @param allowed      the hold may apply (setting on, no AE-L, tap, manual exposure, bracket)
+     * @return whether the displayed exposure should be held now
+     */
+    public synchronized boolean update(long nowNs, double speedDegS, long gyroSampleNs, boolean allowed) {
+        lastSpeed = speedDegS;
+        boolean fresh = gyroSampleNs > 0 && nowNs - gyroSampleNs <= STALE_GYRO_NS && Double.isFinite(speedDegS);
+        if (!allowed || !fresh) {
+            endHold(nowNs);
+            moving = false;
+            fastSinceNs = slowSinceNs = -1;
+            reason = !allowed ? "not_allowed" : "gyro_unavailable";
+            return false;
+        }
+        if (speedDegS >= MOVING_DEG_S) {
+            slowSinceNs = -1;
+            if (fastSinceNs < 0) fastSinceNs = nowNs;
+            if (!moving && nowNs - fastSinceNs >= MOVING_CONFIRM_NS) moving = true;
+        } else if (speedDegS <= SETTLED_DEG_S) {
+            fastSinceNs = -1;
+            if (slowSinceNs < 0) slowSinceNs = nowNs;
+            if (moving && nowNs - slowSinceNs >= SETTLE_NS) moving = false;
+        } else {
+            fastSinceNs = -1;
+            slowSinceNs = -1;
+        }
+        if (!moving) {
+            endHold(nowNs);
+            refreshUntilNs = -1;
+            reason = "settled";
+            return false;
+        }
+        if (refreshUntilNs >= 0) {
+            if (nowNs < refreshUntilNs) { reason = "refreshing_while_moving"; return false; }
+            refreshUntilNs = -1;
+        }
+        if (holdSinceNs < 0) { holdSinceNs = nowNs; holds++; }
+        if (nowNs - holdSinceNs >= MAX_HOLD_NS) {
+            endHold(nowNs);
+            refreshUntilNs = nowNs + REFRESH_NS;
+            reason = "refreshing_while_moving";
+            return false;
+        }
+        reason = "holding_while_moving";
+        return true;
+    }
+
+    private void endHold(long nowNs) {
+        if (holdSinceNs >= 0) lastHoldMs = (nowNs - holdSinceNs) / 1_000_000L;
+        holdSinceNs = -1;
+    }
+
+    public synchronized boolean moving() { return moving; }
+
+    public synchronized JSONObject diagnostics(long nowNs, boolean lockHeld) {
+        try {
+            return new JSONObject().put("revision", REVISION).put("moving", moving).put("reason", reason)
+                    .put("lockHeld", lockHeld).put("speedDegPerSec", Math.round(lastSpeed * 10) / 10.0)
+                    .put("holdElapsedMs", holdSinceNs < 0 ? 0 : (nowNs - holdSinceNs) / 1_000_000L)
+                    .put("lastHoldMs", lastHoldMs).put("holds", holds)

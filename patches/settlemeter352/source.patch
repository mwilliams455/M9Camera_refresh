new file mode 100644
index 0000000..8e95e13
--- /dev/null
+++ b/app/src/test/java/com/particlesdevs/photoncamera/m9/preview/M9DisplayEaseTest.java
@@ -0,0 +1,57 @@
+package com.particlesdevs.photoncamera.m9.preview;
+
+import org.junit.Test;
+
+import static org.junit.Assert.assertEquals;
+
+/** M9SETTLEMETER352: exposure steps glide on screen over 300 ms; small drifts do not. */
+public class M9DisplayEaseTest {
+    private static final long MS = 1_000_000L;
+    private static final double E = 1e-9;
+
+    @Test public void stepGlidesFromTheOldBrightnessToTheNewOne() {
+        M9DisplayEase1A ease = new M9DisplayEase1A();
+        ease.observe(0, 10.0, true);
+        ease.observe(33 * MS, 11.0, true);                 // one stop brighter
+        assertEquals(-1.0, ease.offsetEv(33 * MS), E);     // screen still shows the old brightness
+        assertEquals(-0.5, ease.offsetEv(183 * MS), E);    // halfway
+        assertEquals(0.0, ease.offsetEv(333 * MS), E);     // arrived
+        assertEquals(1.0, ease.multiplier(400 * MS), E);
+    }
+
+    @Test public void smallChangesAreNotEased() {
+        M9DisplayEase1A ease = new M9DisplayEase1A();
+        ease.observe(0, 10.0, true);
+        for (int i = 1; i <= 20; i++) {
+            ease.observe(i * 33 * MS, 10.0 + i * .1, true); // continuous drift, 0.1 EV per frame
+            assertEquals(0.0, ease.offsetEv(i * 33 * MS), E);
+        }
+    }
+
+    @Test public void aNewStepMidwayStartsFromWhatIsOnScreen() {
+        M9DisplayEase1A ease = new M9DisplayEase1A();
+        ease.observe(0, 10.0, true);
+        ease.observe(0, 11.0, true);                        // offset -1 at t=0
+        ease.observe(150 * MS, 10.0, true);                 // back down by one stop at halfway
+        assertEquals(-0.5 + 1.0, ease.offsetEv(150 * MS), E);
+        assertEquals(0.0, ease.offsetEv(450 * MS), E);
+    }
+
+    @Test public void disabledOrUnknownExposureNeverOffsets() {
+        M9DisplayEase1A ease = new M9DisplayEase1A();
+        ease.observe(0, 10.0, true);
+        ease.observe(33 * MS, 12.0, false);
+        assertEquals(0.0, ease.offsetEv(33 * MS), E);
+        ease.observe(66 * MS, Double.NaN, true);
+        assertEquals(0.0, ease.offsetEv(66 * MS), E);
+        ease.observe(99 * MS, 20.0, true);                  // first value after reset: no step
+        assertEquals(0.0, ease.offsetEv(99 * MS), E);
+    }
+
+    @Test public void offsetIsBoundedToFourStops() {
+        M9DisplayEase1A ease = new M9DisplayEase1A();
+        ease.observe(0, 0.0, true);
+        ease.observe(0, 9.0, true);
+        assertEquals(-4.0, ease.offsetEv(0), E);
+    }
+}
diff --git a/app/src/test/java/com/particlesdevs/photoncamera/m9/preview/M9MotionHoldTest.java b/app/src/test/java/com/particlesdevs/photoncamera/m9/preview/M9MotionHoldTest.java
new file mode 100644
index 0000000..9e20139
--- /dev/null
+++ b/app/src/test/java/com/particlesdevs/photoncamera/m9/preview/M9MotionHoldTest.java
@@ -0,0 +1,74 @@
+package com.particlesdevs.photoncamera.m9.preview;
+
+import org.junit.Test;
+
+import static org.junit.Assert.assertEquals;
+import static org.junit.Assert.assertFalse;
+import static org.junit.Assert.assertTrue;
+
+/** M9SETTLEMETER352: hold while the phone pans, release once it settles. */
+public class M9MotionHoldTest {
+    private static final long MS = 1_000_000L;
+
+    /** Feeds a constant speed at 30 Hz from {@code fromMs} to {@code toMs}; returns the last decision. */
+    private static boolean run(M9MotionHold1A hold, double speed, long fromMs, long toMs, boolean allowed) {
+        boolean out = false;
+        for (long t = fromMs; t <= toMs; t += 33) out = hold.update(t * MS, speed, t * MS, allowed);
+        return out;
+    }
+
+    @Test public void deliberatePanHoldsAndSettlingReleasesAfter300ms() {
+        M9MotionHold1A hold = new M9MotionHold1A();
+        assertFalse(run(hold, 2, 0, 500, true));
+        assertTrue(run(hold, 40, 533, 700, true));
+        // Still: needs 300 ms below the settled threshold.
+        assertTrue(run(hold, 1, 733, 1000, true));
+        assertFalse(run(hold, 1, 1033, 1100, true));
+    }
+
+    @Test public void tremorAndBriefSpikesNeverHold() {
+        M9MotionHold1A hold = new M9MotionHold1A();
+        assertFalse(run(hold, 8, 0, 3000, true));                 // between thresholds: tremor
+        assertFalse(hold.update(3033 * MS, 60, 3033 * MS, true)); // one 33 ms spike
+        assertFalse(hold.update(3066 * MS, 2, 3066 * MS, true));
+        assertFalse(hold.moving());
+    }
+
+    @Test public void speedsBetweenThresholdsKeepTheCurrentState() {
+        M9MotionHold1A hold = new M9MotionHold1A();
+        assertTrue(run(hold, 30, 0, 200, true));
+        assertTrue(run(hold, 8, 233, 2000, true));                // slow pan continues the hold
+    }
+
+    @Test public void longPanRefreshesExposureEveryTwoAndAHalfSeconds() {
+        M9MotionHold1A hold = new M9MotionHold1A();
+        boolean sawRefresh = false, heldAgain = false;
+        for (long t = 0; t <= 4000; t += 33) {
+            boolean h = hold.update(t * MS, 30, t * MS, true);
+            if (t > 2600 && t < 2900 && !h) sawRefresh = true;
+            if (t > 3000 && h) heldAgain = true;
+        }
+        assertTrue(sawRefresh);
+        assertTrue(heldAgain);
+    }
+
+    @Test public void notAllowedOrStaleGyroReleasesImmediately() {
+        M9MotionHold1A hold = new M9MotionHold1A();
+        assertTrue(run(hold, 30, 0, 200, true));
+        assertFalse(hold.update(233 * MS, 30, 233 * MS, false));   // AE-L, tap or manual exposure
+        M9MotionHold1A stale = new M9MotionHold1A();
+        assertTrue(run(stale, 30, 0, 200, true));
+        assertFalse(stale.update(600 * MS, 30, 200 * MS, true));   // newest gyro sample is 400 ms old
+        assertFalse(stale.update(633 * MS, Double.NaN, 633 * MS, true));
+        assertFalse(new M9MotionHold1A().update(0, 50, -1, true));
+    }
+
+    @Test public void diagnosticsDescribeTheHold() throws Exception {
+        M9MotionHold1A hold = new M9MotionHold1A();
+        run(hold, 30, 0, 500, true);
+        org.json.JSONObject d = hold.diagnostics(500 * MS, true);
+        assertEquals(M9MotionHold1A.REVISION, d.getString("revision"));
+        assertTrue(d.getBoolean("moving"));
+        assertTrue(d.getLong("holdElapsedMs") > 0);
+    }
+}

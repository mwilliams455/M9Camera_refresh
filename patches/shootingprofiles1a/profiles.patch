+package com.particlesdevs.photoncamera.m9;
+
+import android.content.SharedPreferences;
+import com.particlesdevs.photoncamera.m9.render.M9SaturationSettings;
+import com.particlesdevs.photoncamera.m9.render.M9ContrastSettings;
+import com.particlesdevs.photoncamera.m9.render.M9SharpnessSettings;
+import org.json.JSONArray;
+import org.json.JSONException;
+import org.json.JSONObject;
+import java.util.ArrayList;
+import java.util.List;
+import java.util.Locale;
+import java.util.Map;
+import java.util.UUID;
+
+/** Named snapshots of existing photographic preferences; no separate rendering path. */
+public final class M9ShootingProfiles {
+    public static final String LIBRARY_KEY = "pref_m9_shooting_profiles_v1";
+    public static final String ACTIVE_KEY = "pref_m9_shooting_profile_active";
+    public static final String EV_KEY = "pref_expocompensation_seekbar_key";
+    public static final int MAX_PROFILES = 20;
+    public static final int MAX_NAME_LENGTH = 40;
+    private final SharedPreferences preferences;
+
+    public enum Problem { NAME, DUPLICATE, LIMIT, MISSING, DATA, SETTINGS }
+    public static final class ProfileException extends RuntimeException {
+        public final Problem problem;
+        ProfileException(Problem problem) { super(problem.name()); this.problem = problem; }
+    }
+
+    public static final class Snapshot {
+        public final int saturation, contrast, sharpness;
+        /** Keep the original text so precise, off-grid EV settings survive recall. */
+        public final String ev;
+        public Snapshot(int saturation, int contrast, int sharpness, String ev) {
+            if (!level(saturation) || !level(contrast) || !level(sharpness) || ev == null)
+                throw new ProfileException(Problem.SETTINGS);
+            try {
+                double number = Double.parseDouble(ev);
+                if (!Double.isFinite(number) || number < -4 || number > 4)
+                    throw new NumberFormatException();
+            } catch (NumberFormatException invalid) { throw new ProfileException(Problem.SETTINGS); }
+            this.saturation = saturation; this.contrast = contrast;
+            this.sharpness = sharpness; this.ev = ev;
+        }
+        private static boolean level(int n) { return n >= 0 && n <= 4; }
+        public boolean sameSettings(Snapshot other) {
+            return other != null && saturation == other.saturation && contrast == other.contrast
+                    && sharpness == other.sharpness && Double.parseDouble(ev) == Double.parseDouble(other.ev);
+        }
+        JSONObject toJson() throws JSONException {
+            return new JSONObject().put("saturation",saturation).put("contrast",contrast)
+                    .put("sharpness",sharpness).put("ev",ev);
+        }
+        static Snapshot fromJson(JSONObject json) throws JSONException {
+            Object ev = json.get("ev");
+            if (!(ev instanceof String)) throw new ProfileException(Problem.DATA);
+            return new Snapshot(integer(json,"saturation"),integer(json,"contrast"),
+                    integer(json,"sharpness"),(String)ev);
+        }
+        private static int integer(JSONObject json, String key) throws JSONException {
+            Object value = json.get(key);
+            if (!(value instanceof Number)) throw new ProfileException(Problem.DATA);
+            Number number = (Number)value;
+            if (number.doubleValue() != number.intValue()) throw new ProfileException(Problem.DATA);
+            return number.intValue();
+        }
+    }
+
+    public static final class Profile {
+        public final String id, name;
+        public final Snapshot settings;
+        Profile(String id, String name, Snapshot settings) {
+            this.id = id; this.name = name; this.settings = settings;
+        }
+    }
+
+    public M9ShootingProfiles(SharedPreferences preferences) { this.preferences = preferences; }
+
+    /** One map snapshot; opening the screen never writes defaults or changes current settings. */
+    public Snapshot current() {
+        Map<String,?> all = preferences.getAll();
+        try {
+            return new Snapshot(Integer.parseInt(text(all,M9SaturationSettings.KEY,"2")),
+                    Integer.parseInt(text(all,M9ContrastSettings.KEY,"2")),
+                    Integer.parseInt(text(all,M9SharpnessSettings.KEY,"2")),text(all,EV_KEY,"0.0"));
+        } catch (RuntimeException invalid) { throw new ProfileException(Problem.SETTINGS); }
+    }
+    private static String text(Map<String,?> all, String key, String fallback) {
+        Object value = all.get(key);
+        if (value == null) return fallback;
+        if (!(value instanceof String)) throw new ProfileException(Problem.SETTINGS);
+        return (String)value;
+    }
+
+    public List<Profile> list() {
+        List<Profile> result = new ArrayList<>();
+        try {
+            String raw = preferences.getString(LIBRARY_KEY,null);
+            if (raw == null) return result;
+            JSONObject root = new JSONObject(raw);
+            Object schema = root.get("schema");
+            if (!(schema instanceof Number) || ((Number)schema).doubleValue() != 1)
+                throw new ProfileException(Problem.DATA);
+            JSONArray rows = root.getJSONArray("profiles");
+            if (rows.length() > MAX_PROFILES) throw new ProfileException(Problem.DATA);
+            for (int i = 0; i < rows.length(); i++) {
+                JSONObject row = rows.getJSONObject(i);
+                Object idValue = row.get("id"), nameValue = row.get("name");
+                if (!(idValue instanceof String) || !(nameValue instanceof String))
+                    throw new ProfileException(Problem.DATA);
+                String id = (String)idValue, name = (String)nameValue;
+                if (id.isEmpty() || id.length() > 80 || !validName(name).equals(name))
+                    throw new ProfileException(Problem.DATA);
+                for (Profile old : result)
+                    if (old.id.equals(id) || sameName(old.name,name)) throw new ProfileException(Problem.DATA);
+                result.add(new Profile(id,name,Snapshot.fromJson(row.getJSONObject("settings"))));
+            }
+            return result;
+        } catch (JSONException | RuntimeException invalid) {
+            // Never replace an unreadable collection with an empty one on a subsequent save.
+            throw new ProfileException(Problem.DATA);
+        }
+    }
+
+    public String activeId() {
+        try { return preferences.getString(ACTIVE_KEY,""); }
+        catch (ClassCastException invalid) { return ""; }
+    }
+
+    public Profile save(String proposedName) {
+        List<Profile> profiles = list();
+        if (profiles.size() >= MAX_PROFILES) throw new ProfileException(Problem.LIMIT);
+        String name = uniqueName(profiles,proposedName,null);
+        Profile profile = new Profile(UUID.randomUUID().toString(),name,current());
+        profiles.add(profile);
+        writeCollection(profiles).putString(ACTIVE_KEY,profile.id).apply();
+        return profile;
+    }
+
+    public void apply(String id) {
+        Profile profile = required(list(),id);
+        Snapshot settings = profile.settings;
+        // A single edit makes all four values visible together to the existing settings listeners.
+        // No output, diagnostic, WB, ISO, shutter, lens or display preference is written here.
+        preferences.edit().putString(M9SaturationSettings.KEY,Integer.toString(settings.saturation))
+                .putString(M9ContrastSettings.KEY,Integer.toString(settings.contrast))
+                .putString(M9SharpnessSettings.KEY,Integer.toString(settings.sharpness))
+                .putString(EV_KEY,settings.ev).putString(ACTIVE_KEY,profile.id).apply();
+    }
+
+    public void update(String id) {
+        List<Profile> profiles = list();
+        Profile profile = required(profiles,id);
+        profiles.set(profiles.indexOf(profile),new Profile(id,profile.name,current()));
+        writeCollection(profiles).putString(ACTIVE_KEY,id).apply();
+    }
+
+    public void rename(String id, String proposedName) {
+        List<Profile> profiles = list();
+        Profile profile = required(profiles,id);
+        String name = uniqueName(profiles,proposedName,id);
+        profiles.set(profiles.indexOf(profile),new Profile(id,name,profile.settings));
+        writeCollection(profiles).apply();
+    }
+
+    public void delete(String id) {
+        List<Profile> profiles = list();
+        profiles.remove(required(profiles,id));
+        SharedPreferences.Editor edit = writeCollection(profiles);
+        if (id.equals(activeId())) edit.remove(ACTIVE_KEY);
+        edit.apply();
+    }
+
+    private SharedPreferences.Editor writeCollection(List<Profile> profiles) {
+        try {
+            JSONArray rows = new JSONArray();
+            for (Profile p : profiles) rows.put(new JSONObject().put("id",p.id).put("name",p.name)
+                    .put("settings",p.settings.toJson()));
+            String json = new JSONObject().put("schema",1).put("profiles",rows).toString();
+            return preferences.edit().putString(LIBRARY_KEY,json);
+        } catch (JSONException invalid) { throw new ProfileException(Problem.DATA); }
+    }
+
+    private static Profile required(List<Profile> profiles, String id) {
+        for (Profile profile : profiles) if (profile.id.equals(id)) return profile;
+        throw new ProfileException(Problem.MISSING);
+    }
+    private static boolean sameName(String left, String right) {
+        return left.toLowerCase(Locale.ROOT).equals(right.toLowerCase(Locale.ROOT));
+    }
+    private static String uniqueName(List<Profile> profiles, String proposed, String exceptId) {
+        String name = validName(proposed);
+        for (Profile p : profiles)
+            if (!p.id.equals(exceptId) && sameName(p.name,name)) throw new ProfileException(Problem.DUPLICATE);
+        return name;
+    }
+    private static String validName(String proposed) {
+        String name = proposed == null ? "" : proposed.trim();
+        if (name.isEmpty() || name.length() > MAX_NAME_LENGTH) throw new ProfileException(Problem.NAME);
+        for (int i = 0; i < name.length(); i++)
+            if (Character.isISOControl(name.charAt(i))) throw new ProfileException(Problem.NAME);
+        return name;
+    }
+}

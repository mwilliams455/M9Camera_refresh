+        }
+        assertTrue(new Snapshot(2,2,2,"-0.0").sameSettings(new Snapshot(2,2,2,"0")));
+    }
+
+    @Test public void unrelatedFieldsInRestoredProfileCannotBecomePreferenceWrites() throws Exception {
+        Memory memory=new Memory(); Profile p=memory.store().save("Safe");
+        JSONObject json=new JSONObject((String)memory.values.get(LIB));
+        json.getJSONArray("profiles").getJSONObject(0).getJSONObject("settings")
+                .put("pref_m9_save_diagnostic_files","1").put("pref_m9_save_unfiltered_dng","1");
+        memory.values.put(LIB,json.toString()); memory.store().apply(p.id);

+package com.particlesdevs.photoncamera.ui.settings;
+
+import android.content.Context;
+import android.text.InputFilter;
+import android.text.InputType;
+import android.widget.FrameLayout;
+import android.widget.Toast;
+import androidx.appcompat.app.AlertDialog;
+import androidx.preference.ListPreference;
+import androidx.preference.Preference;
+import androidx.preference.PreferenceCategory;
+import androidx.preference.PreferenceFragmentCompat;
+import com.google.android.material.dialog.MaterialAlertDialogBuilder;
+import com.google.android.material.textfield.TextInputEditText;
+import com.google.android.material.textfield.TextInputLayout;
+import com.particlesdevs.photoncamera.R;
+import com.particlesdevs.photoncamera.m9.M9ShootingProfiles;
+import com.particlesdevs.photoncamera.m9.M9ShootingProfiles.Profile;
+import com.particlesdevs.photoncamera.m9.M9ShootingProfiles.Snapshot;
+import com.particlesdevs.photoncamera.m9.M9ShootingProfiles.ProfileException;
+import com.particlesdevs.photoncamera.m9.render.M9SaturationSettings;
+import com.particlesdevs.photoncamera.m9.render.M9ContrastSettings;
+import com.particlesdevs.photoncamera.m9.render.M9SharpnessSettings;
+import com.particlesdevs.photoncamera.util.BlurSupport;
+import java.util.List;
+
+/** Settings-only UI. Camera/render consumers continue to read their existing preferences. */
+final class M9ProfilesUi {
+    static final String SCREEN = "pref_m9_profiles_screen";
+    private final PreferenceFragmentCompat fragment;
+    private final Context context;
+    private final M9ShootingProfiles store;
+    private AlertDialog dialog;
+
+    M9ProfilesUi(PreferenceFragmentCompat fragment, M9ShootingProfiles store) {
+        this.fragment = fragment; this.context = fragment.requireContext(); this.store = store;
+        Preference save = fragment.findPreference("m9_profile_save");
+        if (save != null) save.setOnPreferenceClickListener(p -> { nameDialog(null); return true; });
+        refresh();
+    }
+
+    void changed(String key) {
+        if (key == null || key.equals(M9ShootingProfiles.LIBRARY_KEY) || key.equals(M9ShootingProfiles.ACTIVE_KEY)
+                || key.equals(M9ShootingProfiles.EV_KEY) || key.equals(M9SaturationSettings.KEY)
+                || key.equals(M9ContrastSettings.KEY) || key.equals(M9SharpnessSettings.KEY)) refresh();
+    }
+
+    void refresh() {
+        Preference entry = fragment.findPreference(SCREEN);
+        if (entry == null) return;
+        Preference current = fragment.findPreference("m9_profile_current");
+        Preference save = fragment.findPreference("m9_profile_save");
+        PreferenceCategory saved = fragment.findPreference("m9_profile_saved");
+        try {
+            List<Profile> profiles = store.list();
+            Snapshot settings = store.current();
+            String status = context.getString(R.string.m9_profile_custom);
+            for (Profile p : profiles) {
+                if (p.id.equals(store.activeId())) status = p.settings.sameSettings(settings)
+                        ? p.name : context.getString(R.string.m9_profile_modified,p.name);
+            }
+            entry.setSummary(context.getString(R.string.m9_profile_entry_summary,status));
+            if (current != null) {
+                current.setTitle(context.getString(R.string.m9_profile_current_title,status));
+                current.setSummary(describe(settings));
+            }
+            // Parent fragments retain ListPreference objects on the back stack. Update their
+            // cached display values after recall; persistString is a no-op for the same value.
+            syncList(M9SaturationSettings.KEY,settings.saturation);
+            syncList(M9ContrastSettings.KEY,settings.contrast);
+            syncList(M9SharpnessSettings.KEY,settings.sharpness);
+            if (save != null) {
+                boolean hasRoom = profiles.size() < M9ShootingProfiles.MAX_PROFILES;
+                save.setEnabled(hasRoom);
+                save.setSummary(hasRoom ? R.string.m9_profile_save_summary : R.string.m9_profile_error_limit);
+            }
+            if (saved != null && SCREEN.equals(fragment.getPreferenceScreen().getKey())) {
+                saved.removeAll();
+                if (profiles.isEmpty()) {
+                    Preference empty = row("m9_profile_empty",context.getString(R.string.m9_profile_empty));
+                    empty.setSummary(R.string.m9_profile_empty_summary);
+                    empty.setSelectable(false); saved.addPreference(empty);
+                }
+                for (Profile profile : profiles) {
+                    Preference p = row("m9_profile_row_"+profile.id,profile.name);
+                    p.setSummary(describe(profile.settings));
+                    p.setOnPreferenceClickListener(clicked -> { showProfile(profile); return true; });
+                    saved.addPreference(p);
+                }
+            }
+        } catch (ProfileException error) {
+            entry.setSummary(message(error));
+            if (current != null) current.setSummary(message(error));
+            if (save != null) save.setEnabled(false);
+            if (saved != null) saved.removeAll();
+        }
+    }
+
+    private void syncList(String key, int value) {
+        Preference pref = fragment.findPreference(key);
+        if (pref instanceof ListPreference) ((ListPreference)pref).setValue(Integer.toString(value));
+    }
+
+    private Preference row(String key, String title) {
+        Preference p = new Preference(context);
+        p.setKey(key); p.setTitle(title); p.setPersistent(false);
+        p.setLayoutResource(R.layout.preference_m9_profile);
+        p.setIconSpaceReserved(false);
+        return p;
+    }
+
+    private String describe(Snapshot settings) {
+        String[] saturation = context.getResources().getStringArray(R.array.m9_saturation_entries);
+        String[] contrast = context.getResources().getStringArray(R.array.m9_contrast_entries);
+        String[] sharpness = context.getResources().getStringArray(R.array.m9_sharpness_entries);
+        return context.getString(R.string.m9_profile_values,saturation[settings.saturation],
+                contrast[settings.contrast],sharpness[settings.sharpness],settings.ev);
+    }
+
+    private void showProfile(Profile profile) {
+        show(new MaterialAlertDialogBuilder(context).setTitle(profile.name).setMessage(describe(profile.settings))
+                .setPositiveButton(R.string.m9_profile_apply,(d,w) -> act(() -> store.apply(profile.id),R.string.m9_profile_applied))
+                .setNeutralButton(R.string.m9_profile_manage,(d,w) -> manage(profile))
+                .setNegativeButton(android.R.string.cancel,null).create());
+    }
+
+    private void manage(Profile profile) {
+        CharSequence[] actions = {context.getString(R.string.m9_profile_update),
+                context.getString(R.string.m9_profile_rename),context.getString(R.string.m9_profile_delete)};
+        show(new MaterialAlertDialogBuilder(context).setTitle(profile.name).setItems(actions,(d,which) -> {
+            if (which == 0) confirmUpdate(profile);
+            if (which == 1) nameDialog(profile);
+            if (which == 2) show(new MaterialAlertDialogBuilder(context)
+                    .setTitle(context.getString(R.string.m9_profile_delete_title,profile.name))
+                    .setMessage(R.string.m9_profile_delete_message)
+                    .setPositiveButton(R.string.m9_profile_delete,(delete,w) -> act(() -> store.delete(profile.id),R.string.m9_profile_deleted))
+                    .setNegativeButton(android.R.string.cancel,null).create());
+        }).setNegativeButton(android.R.string.cancel,null).create());
+    }
+
+    private void confirmUpdate(Profile profile) {
+        try {
+            String summary = describe(store.current());
+            show(new MaterialAlertDialogBuilder(context)
+                    .setTitle(context.getString(R.string.m9_profile_update_title,profile.name))
+                    .setMessage(summary)
+                    .setPositiveButton(R.string.m9_profile_update_confirm,(d,w) -> act(() -> store.update(profile.id),R.string.m9_profile_updated))
+                    .setNegativeButton(android.R.string.cancel,null).create());
+        } catch (ProfileException error) { toast(message(error)); }
+    }
+
+    private void nameDialog(Profile profile) {
+        TextInputLayout layout = new TextInputLayout(context);
+        layout.setHint(context.getString(R.string.m9_profile_name));
+        TextInputEditText input = new TextInputEditText(layout.getContext());
+        input.setSingleLine(true);
+        input.setInputType(InputType.TYPE_CLASS_TEXT | InputType.TYPE_TEXT_FLAG_CAP_WORDS);
+        input.setFilters(new InputFilter[]{new InputFilter.LengthFilter(M9ShootingProfiles.MAX_NAME_LENGTH)});
+        if (profile != null) { input.setText(profile.name); input.setSelectAllOnFocus(true); }
+        layout.addView(input);
+        FrameLayout container = new FrameLayout(context);
+        int padding = (int)(24*context.getResources().getDisplayMetrics().density);
+        container.setPadding(padding,0,padding,0); container.addView(layout);
+        AlertDialog editor = new MaterialAlertDialogBuilder(context)
+                .setTitle(profile == null ? R.string.m9_profile_save : R.string.m9_profile_rename)
+                .setView(container).setPositiveButton(R.string.m9_profile_save_button,null)
+                .setNegativeButton(android.R.string.cancel,null).create();
+        show(editor);
+        editor.getButton(AlertDialog.BUTTON_POSITIVE).setOnClickListener(v -> {
+            String name = input.getText() == null ? "" : input.getText().toString();
+            try {
+                if (profile == null) store.save(name); else store.rename(profile.id,name);
+                refresh(); editor.dismiss();
+            } catch (ProfileException error) { layout.setError(context.getString(message(error))); }
+        });
+        input.requestFocus();
+    }
+
+    private void act(Runnable action, int success) {
+        try { action.run(); refresh(); toast(success); }
+        catch (ProfileException error) { toast(message(error)); }
+    }
+    private int message(ProfileException error) {
+        switch (error.problem) {
+            case NAME: return R.string.m9_profile_error_name;
+            case DUPLICATE: return R.string.m9_profile_error_duplicate;
+            case LIMIT: return R.string.m9_profile_error_limit;
+            case MISSING: return R.string.m9_profile_error_missing;
+            case SETTINGS: return R.string.m9_profile_error_settings;
+            default: return R.string.m9_profile_error_data;
+        }
+    }
+    private void toast(int resource) { Toast.makeText(context,resource,Toast.LENGTH_SHORT).show(); }
+    private void show(AlertDialog next) {
+        dialog = next;
+        next.setOnDismissListener(d -> { if (dialog == next) dialog = null; });
+        BlurSupport.show(next);
+    }
+    void close() { if (dialog != null) dialog.dismiss(); }
+}

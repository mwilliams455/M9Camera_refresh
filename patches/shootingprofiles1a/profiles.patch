+package com.particlesdevs.photoncamera.m9;
+
+import android.content.SharedPreferences;
+import com.particlesdevs.photoncamera.m9.M9ShootingProfiles.Profile;
+import com.particlesdevs.photoncamera.m9.M9ShootingProfiles.ProfileException;
+import com.particlesdevs.photoncamera.m9.M9ShootingProfiles.Problem;
+import com.particlesdevs.photoncamera.m9.M9ShootingProfiles.Snapshot;
+import org.json.JSONObject;
+import org.junit.Test;
+import java.util.ArrayList;
+import java.util.Arrays;
+import java.util.HashMap;
+import java.util.HashSet;
+import java.util.List;
+import java.util.Map;
+import java.util.Set;
+import static org.junit.Assert.*;
+import static org.mockito.ArgumentMatchers.*;
+import static org.mockito.Mockito.*;
+
+public class M9ShootingProfilesTest {
+    private static final String SAT="pref_m9_saturation", CONTRAST="pref_m9_contrast", SHARP="pref_m9_sharpness";
+    private static final String EV=M9ShootingProfiles.EV_KEY, LIB=M9ShootingProfiles.LIBRARY_KEY, ACTIVE=M9ShootingProfiles.ACTIVE_KEY;
+
+    /** Model SharedPreferences' single-editor commit-to-memory boundary, including post-edit reads. */
+    private static final class Memory {
+        final Map<String,Object> values=new HashMap<>();
+        final List<Set<String>> edits=new ArrayList<>();
+        final List<Map<String,Object>> observed=new ArrayList<>();
+        final SharedPreferences preferences=mock(SharedPreferences.class);
+        Memory() {
+            when(preferences.getAll()).thenAnswer(i -> new HashMap<>(values));
+            when(preferences.getString(anyString(),nullable(String.class))).thenAnswer(i -> {
+                String key=i.getArgument(0); Object value=values.get(key);
+                return value==null ? i.getArgument(1) : (String)value;
+            });
+            when(preferences.edit()).thenAnswer(i -> {
+                Map<String,Object> puts=new HashMap<>(); Set<String> removes=new HashSet<>();
+                SharedPreferences.Editor editor=mock(SharedPreferences.Editor.class,RETURNS_SELF);
+                when(editor.putString(anyString(),anyString())).thenAnswer(call -> {
+                    puts.put(call.getArgument(0),call.getArgument(1)); return editor;
+                });
+                when(editor.remove(anyString())).thenAnswer(call -> { removes.add(call.getArgument(0)); return editor; });
+                doAnswer(call -> {
+                    removes.forEach(values::remove); values.putAll(puts);
+                    Set<String> keys=new HashSet<>(puts.keySet()); keys.addAll(removes); edits.add(keys);
+                    observed.add(new HashMap<>(values)); return null;
+                }).when(editor).apply();
+                return editor;
+            });
+        }
+        M9ShootingProfiles store() { return new M9ShootingProfiles(preferences); }
+        void settings(int saturation,int contrast,int sharpness,String ev) {
+            values.put(SAT,""+saturation); values.put(CONTRAST,""+contrast); values.put(SHARP,""+sharpness); values.put(EV,ev);
+        }
+    }
+    private static void fails(Problem expected,Runnable action) {
+        try { action.run(); fail("Expected "+expected); }
+        catch (ProfileException failure) { assertEquals(expected,failure.problem); }
+    }
+
+    @Test public void readingFreshInstallDoesNotWriteOrInventProfiles() {
+        Memory memory=new Memory(); M9ShootingProfiles store=memory.store();
+        assertTrue(store.list().isEmpty()); assertEquals("",store.activeId());
+        assertTrue(store.current().sameSettings(new Snapshot(2,2,2,"0.0")));
+        assertTrue(memory.values.isEmpty()); assertTrue(memory.edits.isEmpty());
+    }
+
+    @Test public void savePreservesPreciseEvAndWritesOnlyProfileMetadata() {
+        Memory memory=new Memory(); memory.settings(3,1,4,"-0.680001");
+        Profile p=memory.store().save("  Evening  ");
+        assertEquals("Evening",p.name); assertEquals("-0.680001",p.settings.ev);
+        assertEquals(new HashSet<>(Arrays.asList(LIB,ACTIVE)),memory.edits.get(0));
+        assertEquals(p.id,memory.store().list().get(0).id);
+    }
+
+    @Test public void recallIsOneEditAndCannotEnableRawDiagnosticsOrChangeOtherControls() {
+        Memory memory=new Memory(); memory.settings(3,1,4,"-0.68");
+        Profile p=memory.store().save("Evening"); memory.settings(0,4,0,"1.1");
+        Map<String,Object> outside=new HashMap<>();
+        outside.put("pref_save_raw_key","0"); outside.put("pref_m9_save_diagnostic_files","0");
+        outside.put("pref_m9_save_unfiltered_dng","0"); outside.put("pref_m9_omit_auto_remosaic","0");
+        outside.put("pref_m9_full_frame_sat_audit","0"); outside.put("pref_countdown_timer_key","2");
+        outside.put("pref_show_grid_key","1"); outside.put("manual_wb","preserve-me");
+        memory.values.putAll(outside);
+        int count=memory.edits.size(); memory.store().apply(p.id);
+        assertEquals(count+1,memory.edits.size());
+        assertEquals(new HashSet<>(Arrays.asList(SAT,CONTRAST,SHARP,EV,ACTIVE)),memory.edits.get(count));
+        assertTrue(memory.store().current().sameSettings(p.settings));
+        outside.forEach((key,value) -> assertEquals(key,value,memory.values.get(key)));
+        Map<String,Object> observer=memory.observed.get(count);
+        assertEquals("3",observer.get(SAT)); assertEquals("1",observer.get(CONTRAST));
+        assertEquals("4",observer.get(SHARP)); assertEquals("-0.68",observer.get(EV));
+    }
+
+    @Test public void collectionSurvivesRestartAndBackupRestoreOfDefaultPreferences() {
+        Memory original=new Memory(); original.settings(1,2,3,"-0.7");
+        Profile a=original.store().save("Indoors"); original.settings(4,0,0,"0.3");
+        Profile b=original.store().save("Outdoors");
+        Memory restored=new Memory(); restored.values.putAll(original.values);
+        assertEquals(2,restored.store().list().size()); restored.store().apply(a.id);
+        assertTrue(restored.store().current().sameSettings(a.settings));
+        restored.store().apply(b.id); assertTrue(restored.store().current().sameSettings(b.settings));
+    }
+
+    @Test public void manualChangesDoNotSilentlyOverwriteSavedProfile() {
+        Memory memory=new Memory(); memory.settings(2,2,3,"-0.3");
+        Profile p=memory.store().save("Daily"); memory.settings(4,2,3,"-0.3");
+        assertFalse(p.settings.sameSettings(memory.store().current()));
+        assertEquals(2,memory.store().list().get(0).settings.saturation);
+        assertEquals(p.id,memory.store().activeId());
+        memory.store().apply(p.id); assertTrue(p.settings.sameSettings(memory.store().current()));
+    }
+
+    @Test public void updateAndRenameKeepStableIdentityAndDoNotApplyOtherValues() {
+        Memory memory=new Memory(); memory.settings(2,2,2,"0");
+        Profile p=memory.store().save("Daily"); memory.settings(3,1,3,"-0.15");
+        memory.store().update(p.id);
+        assertEquals(new HashSet<>(Arrays.asList(LIB,ACTIVE)),memory.edits.get(1));
+        assertTrue(memory.store().list().get(0).settings.sameSettings(memory.store().current()));
+        memory.store().rename(p.id,"  Family  ");
+        assertEquals(new HashSet<>(Arrays.asList(LIB)),memory.edits.get(2));
+        assertEquals(p.id,memory.store().list().get(0).id); assertEquals("Family",memory.store().list().get(0).name);
+        assertEquals("-0.15",memory.values.get(EV)); assertEquals(p.id,memory.store().activeId());
+    }
+
+    @Test public void deletingActiveProfileLeavesCurrentSettingsAndOtherProfilesIntact() {
+        Memory memory=new Memory(); memory.settings(2,2,2,"0");
+        Profile first=memory.store().save("First"); memory.settings(3,4,1,"-0.68");
+        Profile second=memory.store().save("Second");
+        memory.store().delete(second.id);
+        assertEquals("",memory.store().activeId()); assertTrue(second.settings.sameSettings(memory.store().current()));
+        assertEquals(first.id,memory.store().list().get(0).id);
+    }
+
+    @Test public void namesAreTrimmedUniqueAndValidatedWithoutOverwriting() {
+        Memory memory=new Memory(); memory.store().save("Family"); int count=memory.edits.size();
+        fails(Problem.DUPLICATE,() -> memory.store().save("  FAMILY  "));
+        fails(Problem.NAME,() -> memory.store().save("   "));
+        fails(Problem.NAME,() -> memory.store().save("A\nB"));
+        fails(Problem.NAME,() -> memory.store().save(new String(new char[41]).replace('\0','A')));
+        assertEquals(count,memory.edits.size());
+        assertEquals("Été 家族",memory.store().save("Été 家族").name);
+    }
+
+    @Test public void maximumAndMissingIdsNeverModifyCurrentSettings() {
+        Memory memory=new Memory();
+        for (int i=0;i<M9ShootingProfiles.MAX_PROFILES;i++) memory.store().save("Profile "+i);
+        int count=memory.edits.size();
+        fails(Problem.LIMIT,() -> memory.store().save("Extra"));
+        fails(Problem.MISSING,() -> memory.store().apply("absent"));
+        fails(Problem.MISSING,() -> memory.store().delete("absent"));
+        assertEquals(count,memory.edits.size());
+    }
+
+    @Test public void malformedOrFutureCollectionsAreKeptAndNeverPartiallyApplied() {
+        for (Object raw : Arrays.asList("broken","{\"schema\":2,\"profiles\":[]}","{\"schema\":1.5,\"profiles\":[]}",true)) {
+            Memory memory=new Memory(); memory.values.put(LIB,raw); memory.settings(2,2,3,"-0.7");
+            Map<String,Object> before=new HashMap<>(memory.values);
+            fails(Problem.DATA,() -> memory.store().list());
+            fails(Problem.DATA,() -> memory.store().save("New"));
+            fails(Problem.DATA,() -> memory.store().apply("anything"));
+            assertEquals(before,memory.values); assertTrue(memory.edits.isEmpty());
+        }
+    }
+
+    @Test public void invalidLevelsAndNonfiniteOrOutOfRangeEvCannotEnterAProfile() throws Exception {
+        for (String ev : Arrays.asList("NaN","Infinity","-4.1","4.1","bad")) {
+            Memory memory=new Memory(); memory.settings(2,2,2,ev);
+            fails(Problem.SETTINGS,() -> memory.store().save("Invalid")); assertTrue(memory.edits.isEmpty());
+        }
+        Memory memory=new Memory(); Profile p=memory.store().save("Valid");
+        for (Object level : Arrays.asList(1.5,5,-1,"2")) {
+            JSONObject root=new JSONObject((String)memory.values.get(LIB));
+            root.getJSONArray("profiles").getJSONObject(0).getJSONObject("settings").put("sharpness",level);
+            Memory altered=new Memory(); altered.values.put(LIB,root.toString());
+            fails(Problem.DATA,() -> altered.store().apply(p.id)); assertTrue(altered.edits.isEmpty());
+        }
+    }
+
+    @Test public void allLevelsAndEvLimitsRoundTripWithoutQuantization() {
+        Memory memory=new Memory();
+        for (int level=0;level<5;level++) {
+            String ev=new String[]{"-4","-0.680001","0.0","0.333333","4"}[level];
+            memory.settings(level,level,level,ev); Profile p=memory.store().save("Level "+level);

+package com.particlesdevs.photoncamera.m9;
+
+import com.particlesdevs.photoncamera.m9.preview.M9PreviewTc20Math1A;
+import org.junit.Test;
+import static org.junit.Assert.*;
+
+public class M9PreviewBrightnessTest {
+    private byte[] panel(int n,double luma,double headroom) {
+        byte[] p=new byte[n*4];
+        for(int i=0;i<n;i++)put(p,i,luma,headroom);
+        return p;
+    }
+    private void put(byte[] p,int i,double luma,double headroom) {
+        int y=(int)Math.round(luma*65535),h=(int)Math.round(headroom*65535);
+        p[i*4]=(byte)(y>>8);p[i*4+1]=(byte)y;p[i*4+2]=(byte)(h>>8);p[i*4+3]=(byte)h;
+    }
+    private M9PreviewTc20Math1A.Result measure(double luma,double headroom) {
+        return M9PreviewTc20Math1A.analyzePackedPanel(panel(64,luma,headroom),8,8,1,0);
+    }
+    @Test public void darkScenePredictsExistingHalfStopLift() {
+        assertEquals(.5,measure(.04,.2).boundedEv,0);
+    }
+    @Test public void moderateSceneUsesMeasuredCorrection() {
+        assertEquals(Math.log(M9PreviewTc20Math1A.METER_TARGET/.078)/Math.log(2),measure(.078,.4).boundedEv,.003);
+    }
+    @Test public void brightSceneRetainsExistingHalfStopDarkening() {
+        assertEquals(-.5,measure(.2,.9).boundedEv,0);
+    }
+    @Test public void highlightGuardLimitsLiftWithoutForcingDarkening() {
+        M9PreviewTc20Math1A.Result r=measure(.03,.8);
+        assertEquals(Math.log(.95/.8)/Math.log(2),r.boundedEv,.001);
+        assertTrue(r.guardGain<r.baseGain);
+        assertEquals(0,measure(.03,.98).boundedEv,0);
+    }
+    @Test public void allClippedHeadroomCannotAuthorizeLift() {
+        M9PreviewTc20Math1A.Result r=measure(.03,1);
+        assertEquals(0,r.boundedEv,0);assertEquals(1,r.estimatedClipFraction,0);
+    }
+    @Test public void rawStyleWhiteExclusionDoesNotTurnSpecularIntoDarkening() {
+        byte[] p=panel(1000,.03,.3);put(p,0,.8,1);
+        M9PreviewTc20Math1A.Result r=M9PreviewTc20Math1A.analyzePackedPanel(p,1000,1,1,0);
+        assertEquals(.5,r.boundedEv,0);assertEquals(.001,r.estimatedClipFraction,0);
+    }
+    @Test public void negativePredictionIsIndependentOfHeadroom() {
+        for(double y:new double[]{.1,.12,.16,.3})
+            assertEquals(measure(y,.2).boundedEv,measure(y,1).boundedEv,0);
+    }

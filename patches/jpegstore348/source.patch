@@ -0,0 +1,134 @@
+package com.particlesdevs.photoncamera.m9.render;
+
+import android.content.ContentResolver;
+import android.database.Cursor;
+import android.graphics.Bitmap;
+import android.graphics.BitmapFactory;
+import android.net.Uri;
+import android.os.Environment;
+import android.provider.MediaStore;
+import androidx.exifinterface.media.ExifInterface;
+import androidx.test.ext.junit.runners.AndroidJUnit4;
+import androidx.test.platform.app.InstrumentationRegistry;
+import com.particlesdevs.photoncamera.api.ParseExif;
+import com.particlesdevs.photoncamera.processing.ImageSaver;
+import java.io.IOException;
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.util.UUID;
+import org.json.JSONObject;
+import org.json.JSONArray;
+import com.particlesdevs.photoncamera.processing.M9DngProfileExport;
+import org.junit.After;
+import org.junit.Test;
+import org.junit.runner.RunWith;
+import static org.junit.Assert.*;
+
+@RunWith(AndroidJUnit4.class)
+public class M9SharedJpegTest {
+    private final ContentResolver resolver = InstrumentationRegistry.getInstrumentation().getTargetContext().getContentResolver();
+    private final Path camera = Environment.getExternalStoragePublicDirectory(Environment.DIRECTORY_DCIM).toPath().resolve("Camera");
+    private final String stem = "IMG_20261127_140305_" + UUID.randomUUID();
+    private final Path target = camera.resolve(stem + ".jpg");
+    private final Uri images = MediaStore.Images.Media.getContentUri(MediaStore.VOLUME_EXTERNAL_PRIMARY);
+
+    private int count(String name, int pending) {
+        Uri all = MediaStore.setIncludePending(images);
+        try (Cursor rows = resolver.query(all, new String[]{"_id"},
+                "_display_name = ? AND relative_path = ? AND is_pending = ?",
+                new String[]{name, "DCIM/Camera/", Integer.toString(pending)}, null)) {
+            assertNotNull(rows);
+            return rows.getCount();
+        }
+    }
+
+    private ParseExif.ExifData encode(M9PendingJpeg item) {
+        Bitmap bitmap = Bitmap.createBitmap(96, 64, Bitmap.Config.ARGB_8888);
+        bitmap.eraseColor(0xff457938);
+        ParseExif.ExifData exif = new ParseExif.ExifData();
+        exif.PHOTOGRAPHIC_SENSITIVITY = "320";
+        assertTrue(ImageSaver.Util.saveBitmapAsJPGPayloadM9(item::openOutput, bitmap, 95, exif, true));
+        return exif;
+    }
+
+    @After public void removeTestCaptures() {
+        resolver.delete(MediaStore.setIncludePending(images), "_display_name LIKE ?", new String[]{"%" + stem + "%"});
+    }
+
+    @Test public void finishedJpegIsPublishedAfterExif() throws Exception {
+        M9PendingJpeg item = M9PendingJpeg.create(target, resolver);
+        ParseExif.ExifData exif = encode(item);
+        assertFalse(Files.exists(target));
+        assertEquals(1, count(target.getFileName().toString(), 1));
+        assertEquals(0, count(target.getFileName().toString(), 0));
+        String before = item.readSignature().codingSha256;
+        M9JpegFinalizeQueue.Ticket ticket = M9JpegFinalizeQueue.submit(target, exif, null, null, item);
+        ticket.awaitCompletion();
+        assertTrue(ticket.error(), ticket.isSuccess());
+        assertEquals(1, count(target.getFileName().toString(), 0));
+        assertEquals(0, count(target.getFileName().toString(), 1));
+        assertEquals(before, item.readSignature().codingSha256);
+        ExifInterface saved = new ExifInterface(target.toFile());
+        assertEquals(320, saved.getAttributeInt(ExifInterface.TAG_PHOTOGRAPHIC_SENSITIVITY, -1));
+        assertEquals("2026:11:27 14:03:05", saved.getAttribute(ExifInterface.TAG_DATETIME_ORIGINAL));
+        Bitmap decoded = BitmapFactory.decodeFile(target.toString());
+        assertNotNull(decoded);
+        assertEquals(96, decoded.getWidth());
+        assertEquals(64, decoded.getHeight());
+        decoded.recycle();
+    }
+
+    @Test public void jpegAndProfiledDngShareTheCaptureName() throws Exception {
+        M9PendingJpeg jpeg = M9PendingJpeg.create(target, resolver);
+        M9JpegFinalizeQueue.Ticket ticket = M9JpegFinalizeQueue.submit(target, encode(jpeg), null, null, jpeg);
+        ticket.awaitCompletion();
+        assertTrue(ticket.error(), ticket.isSuccess());
+        // 8x8 RAW16 from the deterministic M9DngProfileStagingTest fixture.
+        byte[] seed = android.util.Base64.decode("", android.util.Base64.DEFAULT);
+        Path finalDng = target.resolveSibling(stem + ".dng");
+        Path raw = M9DngPublication.createStagingFile(finalDng);
+        try {
+            Files.write(raw, seed);
+            JSONObject calibration = new JSONObject().put("effectiveRenderGain", 1.0)
+                    .put("currentPpToM9Composed", new JSONArray("[[1,0,0],[0,1,0],[0,0,1]]"));
+            JSONObject frozen = new JSONObject().put("nativeSaturationBankActuallySelected", 2)
+                    .put("nativeContrastLevelActuallySelected", 2).put("identityHsmApplied", true)
+                    .put("targetDomainTrace1A", calibration);
+            JSONObject profile = M9DngProfileExport.embedStaged(raw, frozen.toString(), true);
+            assertEquals(profile.toString(), "embedded", profile.optString("status"));
+            assertEquals(finalDng, M9DngPublication.publishStagedDng(raw, finalDng));
+            assertTrue(Files.isRegularFile(target));
+            byte[] saved = Files.readAllBytes(finalDng);
+            assertTrue(saved.length > seed.length);
+            assertTrue(new String(saved, java.nio.charset.StandardCharsets.ISO_8859_1)
+                    .contains(profile.getString("profileName")));
+        } finally {
+            Files.deleteIfExists(raw);
+            Files.deleteIfExists(finalDng);
+        }
+    }
+
+    @Test public void rejectedRenderDeletesPendingImage() throws Exception {
+        M9PendingJpeg item = M9PendingJpeg.create(target, resolver);
+        encode(item);
+        item.discard(new IOException("injected render rejection"));
+        assertFalse(Files.exists(target));
+        assertEquals(0, count(target.getFileName().toString(), 0));
+        assertEquals(0, count(target.getFileName().toString(), 1));
+    }
+
+    @Test public void acceptedJpegCanBeRecoveredByCaptureName() throws Exception {
+        M9PendingJpeg item = M9PendingJpeg.create(target, resolver);
+        encode(item);
+        IOException error = new IOException("injected publication failure");
+        item.recover(error);
+        try (Cursor rows = resolver.query(images, new String[]{"_display_name"},
+                "_display_name LIKE ? AND is_pending = 0", new String[]{stem + "_recovered_%.jpg"}, null)) {
+            assertNotNull(rows);
+            assertEquals(1, rows.getCount());
+            assertTrue(rows.moveToFirst());
+            assertNotNull(BitmapFactory.decodeFile(camera.resolve(rows.getString(0)).toString()));
+        }
+        assertFalse(Files.exists(target));
+    }
+}

@@ -0,0 +1,115 @@
+package com.particlesdevs.photoncamera.m9.render;
+
+import android.app.Application;
+import android.graphics.Bitmap;
+import androidx.exifinterface.media.ExifInterface;
+
+import com.particlesdevs.photoncamera.api.ParseExif;
+import com.particlesdevs.photoncamera.processing.ImageSaver;
+
+import java.io.IOException;
+import java.io.OutputStream;
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.util.stream.Stream;
+
+import org.json.JSONObject;
+import org.junit.Rule;
+import org.junit.Test;
+import org.junit.rules.TemporaryFolder;
+import org.junit.runner.RunWith;
+import org.robolectric.RobolectricTestRunner;
+import org.robolectric.annotation.Config;
+
+import static org.junit.Assert.*;
+import static org.mockito.Mockito.*;
+
+@RunWith(RobolectricTestRunner.class)
+@Config(sdk = 35, application = Application.class)
+public class M9Jpeg347Test {
+    @Rule public TemporaryFolder directory = new TemporaryFolder();
+
+    private Path target() {
+        return directory.getRoot().toPath().resolve("IMG_20261127_120315_00.jpg");
+    }
+
+    @Test public void rejectedRenderLeavesExistingGalleryFileAlone() throws Exception {
+        Path target = target();
+        Files.write(target, new byte[]{9, 8, 7});
+        M9PendingJpeg pending = M9PendingJpeg.create(target);
+        Files.write(pending.staged, new byte[]{1, 2});
+        pending.discard(new IOException("render rejected"));
+        assertArrayEquals(new byte[]{9, 8, 7}, Files.readAllBytes(target));
+        assertFalse(Files.exists(pending.staged));
+    }
+
+    @Test public void overlappingCapturesOwnDifferentStagingFiles() throws Exception {
+        M9PendingJpeg first = M9PendingJpeg.create(target());
+        M9PendingJpeg second = M9PendingJpeg.create(target());
+        assertNotEquals(first.staged, second.staged);
+        Files.write(second.staged, new byte[]{5});
+        first.discard(new IOException("first rejected"));
+        assertFalse(Files.exists(target()));
+        second.publish();
+        assertArrayEquals(new byte[]{5}, Files.readAllBytes(target()));
+    }
+
+    @Test public void rejectedEncodeReturnsFailureAndRetainsCallerOwnedBitmap() throws Exception {
+        Bitmap bitmap = mock(Bitmap.class);
+        when(bitmap.compress(eq(Bitmap.CompressFormat.JPEG), eq(95), any(OutputStream.class))).thenReturn(false);
+        M9PendingJpeg pending = M9PendingJpeg.create(target());
+        assertFalse(ImageSaver.Util.saveBitmapAsJPGPayloadM9(pending.staged, bitmap, 95, new ParseExif.ExifData(), false));
+        verify(bitmap, never()).recycle();
+        pending.discard(new IOException("encoder rejected"));
+        assertFalse(Files.exists(pending.staged));
+        assertFalse(Files.exists(target()));
+    }
+
+    @Test public void finalizePublishesEncodedImageWithCaptureTimeAndIso() throws Exception {
+        M9PendingJpeg pending = M9PendingJpeg.create(target());
+        Bitmap bitmap = Bitmap.createBitmap(96, 64, Bitmap.Config.ARGB_8888);
+        bitmap.eraseColor(0xff457938);
+        ParseExif.ExifData exif = new ParseExif.ExifData();
+        exif.PHOTOGRAPHIC_SENSITIVITY = "320";
+        assertTrue(ImageSaver.Util.saveBitmapAsJPGPayloadM9(pending.staged, bitmap, 95, exif));
+        assertFalse(Files.exists(target()));
+        M9JpegFinalizeQueue.Ticket ticket = M9JpegFinalizeQueue.submit(target(), exif, null, null, pending);
+        ticket.awaitCompletion();
+        assertTrue(ticket.error(), ticket.isSuccess());
+        assertFalse(Files.exists(pending.staged));
+        ExifInterface saved = new ExifInterface(target().toFile());
+        assertEquals("2026:11:27 12:03:15", saved.getAttribute(ExifInterface.TAG_DATETIME_ORIGINAL));
+        assertEquals(320, saved.getAttributeInt(ExifInterface.TAG_PHOTOGRAPHIC_SENSITIVITY, -1));
+    }
+
+    @Test public void failedExifRecoversTheCaptureUnderAnotherName() throws Exception {
+        M9PendingJpeg pending = M9PendingJpeg.create(target());
+        byte[] invalid = {12, 34, 56};
+        Files.write(pending.staged, invalid);
+        M9JpegFinalizeQueue.Ticket ticket = M9JpegFinalizeQueue.submit(target(), new ParseExif.ExifData(), null, null, pending);
+        ticket.awaitCompletion();
+        assertFalse(ticket.isSuccess());
+        assertFalse(Files.exists(target()));
+        try (Stream<Path> files = Files.list(target().getParent())) {
+            Path[] recovered = files.toArray(Path[]::new);
+            assertEquals(1, recovered.length);
+            assertTrue(recovered[0].getFileName().toString().startsWith("IMG_20261127_120315_00_recovered_"));
+            assertArrayEquals(invalid, Files.readAllBytes(recovered[0]));
+        }
+    }
+
+    @Test public void skippingEdgeGridPreservesFinishedBitmapMeterReadings() throws Exception {
+        Bitmap bitmap = Bitmap.createBitmap(96, 64, Bitmap.Config.ARGB_8888);
+        for (int y = 0; y < 64; y++) for (int x = 0; x < 96; x++)
+            bitmap.setPixel(x, y, 0xff000000 | (x * 2 << 16) | (y * 3 << 8) | (x ^ y));
+        JSONObject full = M9RenderedLumaDiagnostic.measure(bitmap);
+        JSONObject light = M9RenderedLumaDiagnostic.measure(bitmap, false);
+        assertTrue(full.getBoolean("valid"));
+        assertTrue(light.getBoolean("valid"));
+        assertTrue(full.has("edgePlacementGate1A"));
+        assertFalse(light.has("edgePlacementGate1A"));
+        assertTrue(light.getBoolean("edgeGridSkippedForLockedExposure"));
+        for (String name : new String[]{"global", "center50", "middleCenter33"})
+            assertEquals(full.getJSONObject(name).toString(), light.getJSONObject(name).toString());
+    }
+}

--- /dev/null
+++ b/app/src/main/java/com/particlesdevs/photoncamera/m9/render/M9PendingJpeg.java
@@ -0,0 +1,52 @@
+package com.particlesdevs.photoncamera.m9.render;
+
+import java.io.IOException;
+import java.nio.file.AtomicMoveNotSupportedException;
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.nio.file.StandardCopyOption;
+
+/** A private, same-directory JPEG until the render and its EXIF have both succeeded. */
+final class M9PendingJpeg {
+    final Path target;
+    final Path staged;
+
+    private M9PendingJpeg(Path target, Path staged) {
+        this.target = target;
+        this.staged = staged;
+    }
+
+    static M9PendingJpeg create(Path target) throws IOException {
+        String name = target.getFileName().toString();
+        int dot = name.lastIndexOf('.');
+        String stem = dot > 0 ? name.substring(0, dot) : name;
+        Path staged = Files.createTempFile(target.toAbsolutePath().getParent(), "." + stem + "_recovered_", ".pending");
+        return new M9PendingJpeg(target, staged);
+    }
+
+    void publish() throws IOException {
+        try {
+            Files.move(staged, target, StandardCopyOption.ATOMIC_MOVE, StandardCopyOption.REPLACE_EXISTING);
+        } catch (AtomicMoveNotSupportedException unsupported) {
+            // Both paths are in the same directory; Android rename never copies into the visible name.
+            if (!staged.toFile().renameTo(target.toFile())) throw unsupported;
+        }
+    }
+
+    void discard(Throwable failure) {
+        try { Files.deleteIfExists(staged); }
+        catch (IOException | SecurityException cleanup) { failure.addSuppressed(cleanup); }
+    }
+
+    void recover(Throwable failure) {
+        // Capture-specific and unique. Preserve the private copy if even a recovery rename fails.
+        String name = staged.getFileName().toString();
+        Path recovered = staged.resolveSibling(name.substring(1, name.length() - ".pending".length()) + ".jpg");
+        try {
+            Files.move(staged, recovered);
+            failure.addSuppressed(new IOException("Recovered JPEG at " + recovered));
+        } catch (IOException | SecurityException rename) {
+            failure.addSuppressed(new IOException("Unable to rename pending JPEG at " + staged, rename));
+        }
+    }
+}

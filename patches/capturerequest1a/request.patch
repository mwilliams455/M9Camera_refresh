+package com.particlesdevs.photoncamera.m9.capture;
+
+import com.particlesdevs.photoncamera.settings.SettingsManager;
+import org.junit.Test;
+import org.mockito.MockMakers;
+import static org.junit.Assert.*;
+import static org.mockito.Mockito.*;
+
+public class M9CaptureRequestPolicyTest {
+    private SettingsManager settings() {
+        return mock(SettingsManager.class, withSettings().mockMaker(MockMakers.SUBCLASS));
+    }
+    @Test public void defaultAndUnavailableSettingsPreserveExistingPolicy() {
+        assertFalse(M9CaptureRequestAudit1A.omitEnabled(null));
+        SettingsManager s = settings();
+        assertFalse(M9CaptureRequestAudit1A.omitEnabled(s));
+        verify(s).getBoolean(SettingsManager.SCOPE_GLOBAL, M9CaptureRequestAudit1A.OMIT_KEY, false);
+    }
+    @Test public void selectionChangesOnlyOnNextRead() {
+        SettingsManager s = settings();
+        when(s.getBoolean(SettingsManager.SCOPE_GLOBAL, M9CaptureRequestAudit1A.OMIT_KEY, false))
+                .thenReturn(false, true, false);
+        boolean a = M9CaptureRequestAudit1A.omitEnabled(s);
+        boolean b = M9CaptureRequestAudit1A.omitEnabled(s);
+        assertFalse(a); assertTrue(b);
+        assertFalse(M9CaptureRequestAudit1A.omitEnabled(s));
+        assertTrue(b);
+    }
+    @Test public void corruptPreferenceFallsBackToExistingPolicy() {
+        SettingsManager s = settings();
+        when(s.getBoolean(SettingsManager.SCOPE_GLOBAL, M9CaptureRequestAudit1A.OMIT_KEY, false))
+                .thenThrow(new NumberFormatException());
+        assertFalse(M9CaptureRequestAudit1A.omitEnabled(s));
+    }
+}

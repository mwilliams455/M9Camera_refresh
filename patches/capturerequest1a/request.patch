+package com.particlesdevs.photoncamera.m9.capture;
+
+import java.util.LinkedHashMap;
+
+/** Bounded immutable metadata only; ambiguity must never attach another capture's policy. */
+public final class M9CaptureAuditStore {
+    private static final String DUPLICATE = "{\"status\":\"ambiguous_duplicate_timestamp\"}";
+    private final int capacity;
+    private final int maxChars;
+    private final LinkedHashMap<Long, String> records = new LinkedHashMap<>();
+
+    public M9CaptureAuditStore(int capacity, int maxChars) {
+        if (capacity < 1 || maxChars < DUPLICATE.length()) throw new IllegalArgumentException();
+        this.capacity = capacity;
+        this.maxChars = maxChars;
+    }
+
+    public synchronized void put(long timestamp, String json) {
+        if (timestamp <= 0) return;
+        if (records.containsKey(timestamp)) records.put(timestamp, DUPLICATE);
+        else if (json != null && json.length() <= maxChars) records.put(timestamp, json);
+        while (records.size() > capacity) records.remove(records.keySet().iterator().next());
+    }
+
+    public synchronized String take(long imageTimestamp, long resultTimestamp) {
+        if (imageTimestamp <= 0 || imageTimestamp != resultTimestamp) return null;
+        return records.remove(imageTimestamp);
+    }
+
+    synchronized int size() { return records.size(); }
+}

+
+    private M9CaptureRequestAudit1A() {}
+
+    static boolean omitEnabled(SettingsManager settings) {
+        if (settings == null) return false;
+        try { return settings.getBoolean(SettingsManager.SCOPE_GLOBAL, OMIT_KEY, false); }
+        catch (RuntimeException malformed) { return false; }
+    }
+
+    public static final class Start {
+        public final boolean omitRemosaic;
+        final String physicalId;
+        final String cameraId;
+        final String header;
+        volatile String afterVendor;
+        final Set<String> names;
+        Start(boolean omit, String physicalId, String cameraId, String header,
+              Set<String> names) {
+            this.omitRemosaic = omit; this.physicalId = physicalId; this.cameraId = cameraId;
+            this.header = header; this.names = names;
+        }
+    }
+
+    public static Start begin(CaptureRequest.Builder builder, CameraCharacteristics chars,
+            String physicalId, String cameraId, int width, int height,
+            boolean dualSession, boolean maximumResolution, String declaredTargets) {
+        boolean omit = omitEnabled(PhotonCamera.getSettingsManagerStatic());
+        Set<String> names = names();
+        String header;
+        try {
+            JSONObject d = new JSONObject();
+            d.put("revision", REVISION);
+            d.put("policy", omit ? "B_omit_automatic_remosaic" : "A_existing_automatic_remosaic");
+            d.put("omitAutomaticRemosaic", omit);
+            d.put("policyLatchedBeforeVendorHelper", true);
+            d.put("headerComplete", true);
+            d.put("physicalIdAtRequestConstruction", physicalId);
+            d.put("cameraIdAtRequestConstruction", cameraId);
+            d.put("rawWidth", width); d.put("rawHeight", height);
+            d.put("dualSession", dualSession);
+            d.put("appDeclaredStillTargets", declaredTargets);
+            d.put("targetEvidence", "CaptureController_addTarget_branch_not_HAL_verification");
+            d.put("maximumResolutionFlag", maximumResolution);
+            d.put("tunableConfigurationAtShutter", tunables(physicalId, names));
+            d.put("beforeAutomaticVendorHelper", builder(builder, names, physicalId));
+            d.put("characteristics", characteristics(chars));
+            d.put("availableRequestKeyNames", keyNames(chars == null ? null : chars.getAvailableCaptureRequestKeys()));
+            d.put("availableSessionKeyNames", Build.VERSION.SDK_INT >= 28 && chars != null
+                    ? keyNames(chars.getAvailableSessionKeys()) : JSONObject.NULL);
+            d.put("scope", "Request values establish submission only; result values establish reporting, not independent HAL processing proof");
+            d.put("experimentScope", "Only automatic vendor remosaic assignments omitted in B; template defaults, clientName, pixel mode and custom tunables retained");
+            header = d.toString();
+        } catch (Throwable error) { header = error("begin", error).toString(); }
+        return new Start(omit, physicalId, cameraId, header, names);
+    }
+
+    public static void afterVendor(Start start, CaptureRequest.Builder builder) {
+        if (start == null) return;
+        try { start.afterVendor = builder(builder, start.names, start.physicalId).toString(); }
+        catch (Throwable e) { start.afterVendor = error("afterVendor", e).toString(); }
+    }
+
+    public static void configured(CameraCaptureSession session, CaptureRequest params,
+                                  String physicalId, int sessionType, int outputCount,
+                                  String parameterSubmissionState) {
+        try {
+            JSONObject d = new JSONObject();
+            Set<String> names = names();
+            d.put("configurationState", "onConfigured");
+            d.put("sessionType", sessionType); d.put("outputCount", outputCount);
+            d.put("physicalStreamId", physicalId);
+            d.put("parameterSubmissionState", parameterSubmissionState);
+            d.put("tunableConfigurationAtConfigure", tunables(physicalId, names));
+            d.put("sessionParametersProvided", params != null);
+            d.put("sessionParameterValues", params == null ? JSONObject.NULL : request(params, names, physicalId));
+            SESSIONS.put(session, d.toString());
+        } catch (Throwable ignored) { /* Missing evidence is reported with the capture. */ }
+    }
+
+    public static void completed(Start start, CameraCaptureSession session,
+                                 CaptureRequest request, TotalCaptureResult result) {
+        if (start == null || result == null) return;
+        try {
+            Long timestamp = result.get(CaptureResult.SENSOR_TIMESTAMP);
+            if (timestamp == null || timestamp <= 0) return;
+            JSONObject d = new JSONObject(start.header);
+            if (!d.has("headerComplete")) d.put("headerComplete", false);
+            d.put("revision", REVISION);
+            d.put("policy", start.omitRemosaic ? "B_omit_automatic_remosaic" : "A_existing_automatic_remosaic");
+            d.put("omitAutomaticRemosaic", start.omitRemosaic);
+            d.put("status", "completed_request_and_result_recorded");
+            d.put("sensorTimestampNs", timestamp); d.put("frameNumber", result.getFrameNumber());
+            d.put("request", request(request, start.names, start.physicalId));
+            d.put("afterAutomaticVendorHelperBeforeExposureAssignment", start.afterVendor == null
+                    ? JSONObject.NULL : new JSONObject(start.afterVendor));
+            d.put("result", result(result, start.names));
+            String configured = SESSIONS.get(session);
+            d.put("configuredSession", configured == null ? JSONObject.NULL : new JSONObject(configured));
+            if (Build.VERSION.SDK_INT >= 28) {
+                JSONObject physical = new JSONObject();
+                for (Map.Entry<String, CaptureResult> entry : result.getPhysicalCameraResults().entrySet())
+                    physical.put(entry.getKey(), result(entry.getValue(), start.names));
+                d.put("physicalResults", physical);
+            }
+            FRAMES.put(timestamp, d.toString());
+        } catch (Throwable ignored) { /* Never reject a photo for a diagnostic failure. */ }
+    }
+
+    public static JSONObject take(long imageTimestamp, CaptureResult result) {
+        try {
+            Long timestamp = result == null ? null : result.get(CaptureResult.SENSOR_TIMESTAMP);
+            String json = FRAMES.take(imageTimestamp, timestamp == null ? -1 : timestamp);
+            JSONObject d = json == null ? new JSONObject() : new JSONObject(json);
+            d.put("revision", REVISION); d.put("rawImageTimestampNs", imageTimestamp);
+            d.put("renderResultTimestampNs", timestamp == null ? JSONObject.NULL : timestamp);
+            d.put("rawResultTimestampMatch", timestamp != null && timestamp == imageTimestamp);
+            if (json == null) d.put("status", "missing_or_timestamp_mismatch_no_policy_inferred");
+            return d;
+        } catch (Throwable e) { return error("take", e); }
+    }
+
+    private static Set<String> names() {
+        Set<String> result = new TreeSet<>(Arrays.asList(STANDARD));
+        result.addAll(Arrays.asList(VENDOR)); return result;
+    }
+
+    private static JSONArray tunables(String id, Set<String> names) throws Exception {
+        JSONArray a = new JSONArray();
+        SettingsManager settings = PhotonCamera.getSettingsManagerStatic();
+        if (settings == null) return a;
+        List<VendorTagUtils.TunableKey> keys = TunableKeyManager.loadKeys(settings.getContext(), id);
+        int count = 0;
+        for (VendorTagUtils.TunableKey k : keys) {
+            if (k == null || ++count > 64) continue;
+            JSONObject v = new JSONObject();
+            v.put("name", k.name); v.put("type", k.type); v.put("valueType", k.valueType);
+            v.put("configuredValue", bounded(k.value)); v.put("init", k.init);
+            v.put("lastStoredTested", k.tested); v.put("lastStoredSupported", k.supported);
+            v.put("storedStatusIsCurrentCaptureProof", false); a.put(v);
+            if (k.name != null && !k.name.startsWith("android.jpeg.gps")) names.add(k.name);
+        }
+        return a;
+    }
+
+    private static JSONObject request(CaptureRequest r, Set<String> names, String physical) throws Exception {
+        JSONObject global = new JSONObject(), out = new JSONObject();
+        Map<String, CaptureRequest.Key<?>> keys = new HashMap<>();
+        for (CaptureRequest.Key<?> key : r.getKeys()) keys.put(key.getName(), key);
+        // Explicitly probe known vendor keys; getKeys may omit null/default values.
+        keys.putIfAbsent(VENDOR[0], new CaptureRequest.Key<>(VENDOR[0], String.class));
+        keys.putIfAbsent(VENDOR[1], new CaptureRequest.Key<>(VENDOR[1], Byte.class));
+        keys.putIfAbsent(VENDOR[2], new CaptureRequest.Key<>(VENDOR[2], Byte.class));
+        keys.putIfAbsent(VENDOR[3], new CaptureRequest.Key<>(VENDOR[3], int[].class));
+        for (String name : names) {
+            CaptureRequest.Key<?> key = keys.get(name);
+            if (key == null) { global.put(name, state("not_listed")); continue; }
+            try { global.put(name, value(r.get(key))); }
+            catch (Throwable e) { global.put(name, error("read", e)); }
+        }
+        out.put("global", global);
+        out.put("physicalMemberReadScope", "public_immutable_request_API_unavailable_see_builder_snapshot");
+        out.put("physicalId", physical); return out;
+    }
+
+    private static JSONObject builder(CaptureRequest.Builder b, Set<String> names, String physical) throws Exception {
+        CaptureRequest r = b.build();
+        JSONObject out = request(r, names, physical), member = new JSONObject();
+        if (Build.VERSION.SDK_INT >= 28 && physical != null) {
+            Map<String, CaptureRequest.Key<?>> keys = new HashMap<>();
+            for (CaptureRequest.Key<?> k : r.getKeys()) keys.put(k.getName(), k);
+            keys.putIfAbsent(VENDOR[0], new CaptureRequest.Key<>(VENDOR[0], String.class));
+            keys.putIfAbsent(VENDOR[1], new CaptureRequest.Key<>(VENDOR[1], Byte.class));
+            keys.putIfAbsent(VENDOR[2], new CaptureRequest.Key<>(VENDOR[2], Byte.class));
+            keys.putIfAbsent(VENDOR[3], new CaptureRequest.Key<>(VENDOR[3], int[].class));
+            for (String name : names) {
+                CaptureRequest.Key<?> k = keys.get(name);
+                if (k == null) { member.put(name, state("not_listed")); continue; }
+                try { member.put(name, value(b.getPhysicalCameraKey(k, physical))); }
+                catch (Throwable e) { member.put(name, error("physical_read", e)); }
+            }
+        }
+        out.put("physicalMember", member);
+        out.put("physicalMemberReadScope", "public_Builder_getPhysicalCameraKey");
+        return out;
+    }
+
+    private static JSONObject result(CaptureResult r, Set<String> names) throws Exception {
+        JSONObject out = new JSONObject();
+        Map<String, CaptureResult.Key<?>> keys = new HashMap<>();
+        for (CaptureResult.Key<?> key : r.getKeys()) keys.put(key.getName(), key);
+        for (String name : names) {
+            CaptureResult.Key<?> key = keys.get(name);
+            if (key == null) { out.put(name, state("not_listed")); continue; }
+            try { out.put(name, value(r.get(key))); }
+            catch (Throwable e) { out.put(name, error("read", e)); }
+        }
+        if (Build.VERSION.SDK_INT >= 31) out.put("cameraId", r.getCameraId());
+        return out;
+    }
+
+    private static JSONObject characteristics(CameraCharacteristics chars) throws Exception {
+        JSONObject out = new JSONObject();
+        if (chars == null) return out;
+        for (CameraCharacteristics.Key<?> key : chars.getKeys()) {
+            if (!CHARACTERISTICS.contains(key.getName())) continue;
+            try { out.put(key.getName(), value(chars.get(key))); }
+            catch (Throwable e) { out.put(key.getName(), error("read", e)); }
+        }
+        return out;
+    }
+
+    private static JSONArray keyNames(List<CaptureRequest.Key<?>> keys) {
+        JSONArray a = new JSONArray();
+        if (keys != null) for (CaptureRequest.Key<?> k : keys) a.put(k.getName());
+        return a;
+    }
+
+    private static JSONObject value(Object v) throws Exception {
+        JSONObject d = state(v == null ? "null" : "present");
+        d.put("value", encode(v)); return d;
+    }
+
+    private static Object encode(Object v) throws Exception {
+        if (v == null) return JSONObject.NULL;
+        if (v instanceof Rational) {
+            Rational r = (Rational)v;
+            return new JSONArray().put(r.getNumerator()).put(r.getDenominator());
+        }
+        if (v instanceof Number || v instanceof Boolean) return v;
+        if (v instanceof RggbChannelVector) {
+            RggbChannelVector g = (RggbChannelVector)v;
+            return new JSONArray().put(g.getRed()).put(g.getGreenEven()).put(g.getGreenOdd()).put(g.getBlue());
+        }
+        if (v instanceof ColorSpaceTransform) {
+            ColorSpaceTransform m = (ColorSpaceTransform)v; JSONArray a = new JSONArray();
+            for (int row=0; row<3; row++) for (int col=0; col<3; col++) a.put(encode(m.getElement(col,row)));
+            return a;
+        }
+        if (v.getClass().isArray()) {
+            int n = Array.getLength(v); JSONArray a = new JSONArray();
+            for (int i=0; i<Math.min(n,64); i++) a.put(encode(Array.get(v,i)));
+            if (n>64) return new JSONObject().put("prefix", a).put("totalLength", n).put("truncated", true);
+            return a;
+        }
+        return bounded(String.valueOf(v));
+    }
+
+    private static String bounded(String s) { return s == null || s.length()<=1024 ? s : s.substring(0,1024)+"[truncated]"; }
+    private static JSONObject state(String s) {
+        JSONObject d = new JSONObject(); try { d.put("status", s); } catch (Exception ignored) {} return d;
+    }
+    private static JSONObject error(String at, Throwable e) {
+        JSONObject d = state("error");
+        try { d.put("at", at); d.put("errorType", e.getClass().getSimpleName()); } catch (Exception ignored) {}
+        return d;
+    }
+}

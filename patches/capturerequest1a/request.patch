+        "android.shading.mode", "android.statistics.lensShadingMapMode",
+        "android.statistics.hotPixelMapMode", "android.colorCorrection.mode",
+        "android.colorCorrection.aberrationMode", "android.colorCorrection.gains",
+        "android.colorCorrection.transform", "android.distortionCorrection.mode",
+        "android.tonemap.mode", "android.lens.focusDistance", "android.lens.state",
+        "android.lens.aperture", "android.lens.focalLength", "android.lens.opticalStabilizationMode",
+        "android.scaler.cropRegion", "android.flash.mode"};
+    private static final Set<String> CHARACTERISTICS = new HashSet<>(Arrays.asList(
+        "android.request.availableCapabilities", "android.info.supportedHardwareLevel",
+        "android.sensor.info.colorFilterArrangement", "android.sensor.info.pixelArraySize",
+        "android.sensor.info.activeArraySize", "android.sensor.info.preCorrectionActiveArraySize",
+        "android.sensor.info.whiteLevel", "android.sensor.blackLevelPattern",
+        "android.sensor.info.lensShadingApplied", "android.sensor.info.binningFactor",
+        "android.noiseReduction.availableNoiseReductionModes", "android.edge.availableEdgeModes",

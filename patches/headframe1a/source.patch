+package com.particlesdevs.photoncamera.ui.camera.views;
+
+import android.os.SystemClock;
+import com.particlesdevs.photoncamera.util.Log;
+
+/** Main-looper diagnostic for a tracking session. All sample and event times use elapsed realtime. */
+public final class HeadDisplayTrace {
+    private static final String TAG = "M9HeadTrace";
+    private String path = "overlay";
+    private long selection, primaryFrame, headFrame;
+    private int previousCount = -1, previousIndex = -2;
+    private String previousPath, previousState;
+    private long previousSelection;
+    private long windowStart;
+    private int logged, skipped;
+
+    private void record(long now, String message) {
+        if (now-windowStart >= 1_000_000_000L) {
+            windowStart = now;
+            logged = 0;
+        }
+        if (logged >= 48) {
+            skipped++;
+            return;
+        }
+        Log.i(TAG, "tNs=" + now + " " + message + (skipped == 0 ? "" : " skipped=" + skipped));
+        logged++;
+        skipped = 0;
+    }
+
+    public void preview(long frame, long cameraFrame, boolean hasPerson, boolean detectorBusy) {
+        record(SystemClock.elapsedRealtimeNanos(), "preview frameNs=" + frame + " cameraFrameNs=" + cameraFrame
+                + " primaryPerson=" + hasPerson + " detectorBusy=" + detectorBusy);
+    }
+
+    public void detector(long frame, long start, long finish, int raw, int confirmed, String result) {
+        record(SystemClock.elapsedRealtimeNanos(), "detector frameNs=" + frame + " startNs=" + start
+                + " finishNs=" + finish + " raw=" + raw + " confirmed=" + confirmed + " result=" + result);
+    }
+
+    public void motion(long reference, long preview, int matched, String result) {
+        record(SystemClock.elapsedRealtimeNanos(), "motion refNs=" + reference + " previewNs=" + preview
+                + " matched=" + matched + " result=" + result);
+    }
+
+    public void decision(String path, long selection, long primaryFrame, long headFrame) {
+        this.path = path;
+        this.selection = selection;
+        this.primaryFrame = primaryFrame;
+        this.headFrame = headFrame;
+    }
+
+    public void displayed(int count, int selectedIndex, String state, long deadline) {
+        if (count == previousCount && selectedIndex == previousIndex && previousSelection == selection
+                && path.equals(previousPath) && state.equals(previousState)) return;
+        previousCount = count;
+        previousIndex = selectedIndex;
+        previousSelection = selection;
+        previousPath = path;
+        previousState = state;
+        long now = SystemClock.elapsedRealtimeNanos();
+        record(now, "display squares=" + count + " selectedHead=" + selectedIndex + " selection=" + selection
+                + " path=" + path + " state=" + state + " primaryNs=" + primaryFrame
+                + " headNs=" + headFrame + " deadlineNs=" + deadline);
+    }
+}

@@ -0,0 +1,56 @@
+package com.particlesdevs.photoncamera.m9;
+
+/** Physical ISO/time allocation shared by preview intent and the single-RAW capture plan. */
+public final class M9ExposureAllocation {
+    private M9ExposureAllocation() {}
+    public static final class Result {
+        public final int iso, automaticIsoMax;
+        public final long exposureNs, automaticExposureMaxNs, slowestNs;
+        public final String reason;
+        Result(int iso, long exposure, int maxIso, long maxTime, long slowest, String reason) {
+            this.iso=iso; exposureNs=exposure; automaticIsoMax=maxIso;
+            automaticExposureMaxNs=maxTime; slowestNs=slowest; this.reason=reason;
+        }
+    }
+    public static Result allocate(double target, int isoLow, int sensorIsoHigh,
+            long timeLow, long sensorTimeHigh, int policyIsoHigh, long policyTimeHigh,
+            long preferredTime, int manualIso, long manualTime, M9AutoIsoSettings.Controls controls) {
+        if (!Double.isFinite(target) || target <= 0 || isoLow <= 0 || sensorIsoHigh < isoLow
+                || timeLow <= 0 || sensorTimeHigh < timeLow || controls == null)
+            throw new IllegalArgumentException("Invalid physical exposure bounds");
+        int autoIsoHigh = (int)clamp(Math.min(policyIsoHigh,controls.maxIso),isoLow,sensorIsoHigh);
+        long autoTimeHigh = clamp(policyTimeHigh,timeLow,sensorTimeHigh);
+        long slowest = clamp(controls.slowestNs,timeLow,autoTimeHigh);
+        int iso; long exposure; String reason;
+        if (manualIso > 0 && manualTime > 0) {
+            iso=(int)clamp(manualIso,isoLow,sensorIsoHigh);
+            exposure=clamp(manualTime,timeLow,sensorTimeHigh);
+            reason="explicit_sensor_pair";
+        } else if (manualTime > 0) {
+            exposure=clamp(manualTime,timeLow,sensorTimeHigh);
+            iso=(int)clamp(Math.round(target/exposure),isoLow,autoIsoHigh);
+            reason="explicit_shutter_auto_iso";
+        } else if (manualIso > 0) {
+            iso=(int)clamp(manualIso,isoLow,sensorIsoHigh);
+            exposure=clamp(Math.round(target/iso),timeLow,autoTimeHigh);
+            reason="explicit_iso_auto_shutter";
+        } else if (target <= M9ExposurePlan1A.energy(isoLow,timeLow)) {
+            iso=isoLow; exposure=timeLow;
+            reason="minimum_exposure_boundary";
+        } else if (target >= M9ExposurePlan1A.energy(autoIsoHigh,autoTimeHigh)) {
+            iso=autoIsoHigh; exposure=autoTimeHigh;
+            reason="maximum_automatic_exposure_boundary";
+        } else {
+            // Slowest is a preference, not an underexposure-inducing hard cap. At the
+            // ISO ceiling the feasible interval requires a longer shutter instead.
+            double shortest=Math.max(timeLow,target/autoIsoHigh);
+            double longest=Math.min(autoTimeHigh,target/isoLow);
+            double shutter=Math.max(shortest,Math.min(longest,Math.min(preferredTime,slowest)));
+            iso=(int)clamp((long)Math.ceil(target/shutter),isoLow,autoIsoHigh);
+            exposure=clamp(Math.round(target/iso),timeLow,autoTimeHigh);
+            reason="intent_preserved_within_automatic_bounds";
+        }
+        return new Result(iso,exposure,autoIsoHigh,autoTimeHigh,slowest,reason);
+    }
+    private static long clamp(long n, long low, long high) { return Math.max(low,Math.min(high,n)); }
+}

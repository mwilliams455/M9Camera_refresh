+package com.particlesdevs.photoncamera.m9;
+
+import android.hardware.camera2.CameraCharacteristics;
+import android.util.SizeF;
+import com.particlesdevs.photoncamera.app.PhotonCamera;
+import com.particlesdevs.photoncamera.capture.CaptureController;
+import com.particlesdevs.photoncamera.settings.SettingsManager;
+
+/** Read both global controls atomically; resolve against the active camera's metadata. */
+public final class M9AutoIsoRuntime {
+    private M9AutoIsoRuntime() {}
+    public static M9AutoIsoSettings.Controls snapshot() {
+        SettingsManager settings = PhotonCamera.getSettingsManagerStatic();
+        M9AutoIsoSettings selected = M9AutoIsoSettings.read(settings == null ? null
+                : settings.getDefaultPreferences().getAll());
+        CameraCharacteristics camera = CaptureController.mCameraCharacteristics;
+        float[] focals = camera == null ? null : camera.get(CameraCharacteristics.LENS_INFO_AVAILABLE_FOCAL_LENGTHS);
+        SizeF size = camera == null ? null : camera.get(CameraCharacteristics.SENSOR_INFO_PHYSICAL_SIZE);
+        return selected.resolve(focals != null && focals.length > 0 ? focals[0] : Double.NaN,
+                size != null ? size.getWidth() : Double.NaN);
+    }
+}
diff --git a/app/src/main/java/com/particlesdevs/photoncamera/m9/M9AutoIsoSettings.java b/app/src/main/java/com/particlesdevs/photoncamera/m9/M9AutoIsoSettings.java

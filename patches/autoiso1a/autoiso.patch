--- /dev/null
+++ b/app/src/test/java/com/particlesdevs/photoncamera/m9/M9AutoIsoTest.java
@@ -0,0 +1,127 @@
+package com.particlesdevs.photoncamera.m9;
+
+import java.util.HashMap;
+import java.util.Map;
+import java.util.Random;
+import org.junit.Test;
+import static org.junit.Assert.*;
+
+public class M9AutoIsoTest {
+    private static M9AutoIsoSettings.Controls controls(int max, int slow) {
+        return new M9AutoIsoSettings(max,slow).resolve(24,36);
+    }
+    private static M9ExposureAllocation.Result auto(double energy, int max, int slow, long preferred) {
+        return M9ExposureAllocation.allocate(energy,100,6400,100000L,1000000000L,
+                3200,1000000000L,preferred,0,0,controls(max,slow));
+    }
+    private static void energy(double target, M9ExposureAllocation.Result result) {
+        assertEquals(target,M9ExposurePlan1A.energy(result.iso,result.exposureNs),result.iso * 0.51);
+    }
+    @Test public void defaultsAndMalformedStorageAreReadWithoutWrites() {
+        Map<String,Object> map=new HashMap<>();
+        assertEquals(2500,M9AutoIsoSettings.read(map).maxIso);
+        assertEquals(0,M9AutoIsoSettings.read(map).slowestMode);
+        assertTrue(map.isEmpty());
+        map.put(M9AutoIsoSettings.MAX_ISO_KEY,"10000"); map.put(M9AutoIsoSettings.SLOWEST_KEY,"-1");
+        assertEquals(2500,M9AutoIsoSettings.read(map).maxIso);
+        assertEquals(0,M9AutoIsoSettings.read(map).slowestMode);
+        map.put(M9AutoIsoSettings.MAX_ISO_KEY,640); map.put(M9AutoIsoSettings.SLOWEST_KEY,"bad");
+        assertEquals(2500,M9AutoIsoSettings.read(map).maxIso);
+        map.put(M9AutoIsoSettings.MAX_ISO_KEY,"640"); map.put(M9AutoIsoSettings.SLOWEST_KEY,"4");
+        assertEquals(640,M9AutoIsoSettings.read(map).maxIso);
+        assertEquals(4,M9AutoIsoSettings.read(map).slowestMode);
+    }
+    @Test public void lensPolicyUsesEquivalentFocalAndFixedSpeedsIgnoreLens() {
+        M9AutoIsoSettings setting=new M9AutoIsoSettings(2500,0);
+        assertEquals(15,setting.resolve(13,36).denominator);
+        assertEquals(30,setting.resolve(6,9).denominator);
+        assertEquals(30,setting.resolve(35,36).denominator);
+        assertEquals(60,setting.resolve(50,36).denominator);
+        assertEquals(125,setting.resolve(120,36).denominator);
+        assertEquals(35.0,setting.resolve(Double.NaN,0).equivalentFocalX10/10.0,0);
+        assertTrue(setting.resolve(Double.POSITIVE_INFINITY,36).lensFallback);
+        assertFalse(setting.resolve(6,9).lensFallback);
+        for (int mode=1;mode<=5;mode++)
+            assertEquals(new M9AutoIsoSettings(800,mode).resolve(13,36).slowestNs,
+                    new M9AutoIsoSettings(800,mode).resolve(120,36).slowestNs);
+    }
+    @Test public void nonBindingControlsKeepPreferredExposureExactly() {
+        M9ExposureAllocation.Result r=auto(200*4000000.0,2500,1,4000000L);
+        assertEquals(200,r.iso); assertEquals(4000000L,r.exposureNs);
+    }
+    @Test public void isoRisesBeforeShutterCrossesThreshold() {
+        double target=400*16000000.0;
+        M9ExposureAllocation.Result r=auto(target,1600,1,16000000L);
+        assertEquals(800,r.iso); assertEquals(8000000L,r.exposureNs); energy(target,r);
+    }
+    @Test public void shutterLengthensOnlyAfterIsoCeilingToPreserveExposure() {
+        double target=400*16000000.0;
+        M9ExposureAllocation.Result r=auto(target,400,1,16000000L);
+        assertEquals(400,r.iso); assertEquals(16000000L,r.exposureNs); energy(target,r);
+        assertTrue(r.exposureNs>r.slowestNs);
+    }
+    @Test public void physicalFloorAndAnalogOrExplicitIsoLimitRemainAuthoritative() {
+        M9ExposureAllocation.Result floor=M9ExposureAllocation.allocate(320*20000000.0,
+                320,6400,100000L,1000000000L,3200,1000000000L,20000000L,0,0,controls(160,1));
+        assertEquals(320,floor.iso); assertEquals(320,floor.automaticIsoMax);
+        M9ExposureAllocation.Result limited=M9ExposureAllocation.allocate(2000*20000000.0,
+                100,6400,100000L,1000000000L,800,1000000000L,20000000L,0,0,controls(2500,1));
+        assertEquals(800,limited.iso); assertEquals(50000000L,limited.exposureNs);
+    }
+    @Test public void manualShutterIsExactWhileAutoIsoIsCapped() {
+        M9ExposureAllocation.Result r=M9ExposureAllocation.allocate(800*8000000.0,
+                100,6400,100000L,1000000000L,3200,4000000L,4000000L,0,8000000L,controls(400,5));
+        assertEquals(8000000L,r.exposureNs); assertEquals(400,r.iso);
+        assertEquals("explicit_shutter_auto_iso",r.reason);
+    }
+    @Test public void manualIsoAndFullyManualPairBypassBothMenuControls() {
+        M9ExposureAllocation.Result r=M9ExposureAllocation.allocate(3200*20000000.0,
+                100,6400,100000L,1000000000L,800,1000000000L,8000000L,3200,0,controls(160,1));
+        assertEquals(3200,r.iso); assertEquals(20000000L,r.exposureNs);
+        M9ExposureAllocation.Result both=M9ExposureAllocation.allocate(100,
+                100,6400,100000L,1000000000L,800,8000000L,8000000L,5000,50000000L,controls(160,1));
+        assertEquals(5000,both.iso); assertEquals(50000000L,both.exposureNs);
+        M9ExposureAllocation.Result sensor=M9ExposureAllocation.allocate(100,
+                100,6400,100000L,1000000000L,800,8000000L,8000000L,10000,2000000000L,controls(160,1));
+        assertEquals(6400,sensor.iso); assertEquals(1000000000L,sensor.exposureNs);
+    }
+    @Test public void sensorAndExplicitShutterBoundariesDoNotInventExposure() {
+        M9ExposureAllocation.Result min=auto(1,2500,1,8000000L);
+        assertEquals(100,min.iso); assertEquals(100000L,min.exposureNs);
+        M9ExposureAllocation.Result max=auto(1e14,400,1,8000000L);
+        assertEquals(400,max.iso); assertEquals(1000000000L,max.exposureNs);
+        M9ExposureAllocation.Result hard=M9ExposureAllocation.allocate(1e14,
+                100,6400,100000L,1000000000L,3200,4000000L,8000000L,0,0,controls(400,5));
+        assertEquals(400,hard.iso); assertEquals(4000000L,hard.exposureNs);
+    }
+    @Test public void feasibleExposureEnergyAndEvArePreservedAcrossControls() {
+        Random random=new Random(236);
+        int[] caps={160,200,250,320,400,500,640,800,1000,1250,1600,2000,2500};
+        for (int cap:caps) for (int mode=0;mode<=5;mode++) for(int n=0;n<100;n++) {
+            double target=100*100000.0+random.nextDouble()*(cap*1000000000.0-100*100000.0);
+            M9ExposureAllocation.Result r=auto(target,cap,mode,40000000L);
+            energy(target,r); assertTrue(r.iso>=100 && r.iso<=cap);
+            assertTrue(r.exposureNs>=100000L && r.exposureNs<=1000000000L);
+            if (r.exposureNs>r.slowestNs+1000) assertEquals(cap,r.iso);
+        }
+        double base=200*16000000.0;
+        for (int thirds=-9;thirds<=9;thirds++) {
+            double target=base*Math.pow(2,thirds/3.0); energy(target,auto(target,2500,1,16000000L));
+        }
+    }
+    @Test public void controlIdentitySurvivesCopiesAndRejectsChangedSettingsOrLens() {
+        String identity=controls(800,0).identity;
+        M9ExposurePlan1A bare=new M9ExposurePlan1A(1,100,200,"0","PHOTO",200,8000000L,
+                200,8000000L,200,8000000L,0,0,"auto",0,0,100);
+        assertFalse(bare.matchesAutoIsoControls(identity));
+        M9ExposurePlan1A plan=bare.withAutoIsoControls(identity).withAllocationSnapshot2G("{}")
+                .withAutoPlacement2D("{}").withShutterPreviewSnapshot1W("{}");
+        assertTrue(plan.matchesAutoIsoControls(identity));
+        assertTrue(plan.matches("0","PHOTO",200,0,0,0));
+        assertFalse(plan.matchesAutoIsoControls(controls(640,0).identity));
+        assertFalse(plan.matchesAutoIsoControls(controls(800,1).identity));
+        assertFalse(plan.matchesAutoIsoControls(new M9AutoIsoSettings(800,0).resolve(120,36).identity));
+        assertFalse(plan.matches("1","PHOTO",200,0,0,0));
+        assertFalse(plan.matches("0","PHOTO",1700,0,0,0));

--- /dev/null
+++ b/app/src/main/java/com/particlesdevs/photoncamera/m9/M9AutoIsoSettings.java
@@ -0,0 +1,70 @@
+package com.particlesdevs.photoncamera.m9;
+
+import java.util.Map;
+
+/** M9 menu values in physical sensor ISO. No claim of calibrated M9 sensor sensitivity. */
+public final class M9AutoIsoSettings {
+    public static final String REVISION = "M9AUTOISO1A";
+    public static final String MAX_ISO_KEY = "pref_m9_auto_iso_max";
+    public static final String SLOWEST_KEY = "pref_m9_auto_iso_slowest";
+    public static final int DEFAULT_MAX_ISO = 2500, DEFAULT_SLOWEST = 0;
+    private static final int[] ISO_VALUES = {160,200,250,320,400,500,640,800,1000,1250,1600,2000,2500};
+    private static final int[] SHUTTERS = {125,60,30,15,8};
+    public final int maxIso, slowestMode;
+
+    public M9AutoIsoSettings(int maxIso, int slowestMode) {
+        if (!validMaxIso(maxIso) || !validSlowest(slowestMode))
+            throw new IllegalArgumentException("Invalid M9 Auto ISO settings");
+        this.maxIso = maxIso; this.slowestMode = slowestMode;
+    }
+    public static boolean validMaxIso(int value) {
+        for (int iso : ISO_VALUES) if (iso == value) return true;
+        return false;
+    }
+    public static boolean validSlowest(int value) { return value >= 0 && value <= 5; }
+    public static M9AutoIsoSettings read(Map<String,?> values) {
+        int max = integer(values,MAX_ISO_KEY,DEFAULT_MAX_ISO);
+        int slow = integer(values,SLOWEST_KEY,DEFAULT_SLOWEST);
+        return new M9AutoIsoSettings(validMaxIso(max) ? max : DEFAULT_MAX_ISO,
+                validSlowest(slow) ? slow : DEFAULT_SLOWEST);
+    }
+    private static int integer(Map<String,?> values, String key, int fallback) {
+        Object value = values == null ? null : values.get(key);
+        if (!(value instanceof String)) return fallback;
+        try { return Integer.parseInt((String)value); }
+        catch (NumberFormatException invalid) { return fallback; }
+    }
+
+    /** Same whole-stop, 35mm-equivalent lens policy as Monochrom; no digital-zoom multiplier. */
+    public Controls resolve(double focalMm, double sensorWidthMm) {
+        double equivalent = focalMm * 36.0 / sensorWidthMm;
+        boolean fallback = !Double.isFinite(focalMm) || focalMm <= 0
+                || !Double.isFinite(sensorWidthMm) || sensorWidthMm <= 0
+                || !Double.isFinite(equivalent) || equivalent <= 0;
+        int equivalentX10 = fallback ? 350 : (int)Math.round(Math.max(8,Math.min(200,equivalent))*10);
+        int denominator = slowestMode == 0 ? nearestWholeStop(equivalentX10 / 10.0)
+                : SHUTTERS[slowestMode-1];
+        return new Controls(maxIso,slowestMode,equivalentX10,fallback,denominator);
+    }
+    private static int nearestWholeStop(double focal) {
+        int result = 8; double best = Double.POSITIVE_INFINITY;
+        for (int speed : new int[]{8,15,30,60,125}) {
+            double distance = Math.abs(Math.log(focal / speed));
+            if (distance < best) { best = distance; result = speed; }
+        }
+        return result;
+    }
+
+    /** One immutable preference/lens snapshot is used for both neutral and intended plans. */
+    public static final class Controls {
+        public final int maxIso, slowestMode, equivalentFocalX10, denominator;
+        public final boolean lensFallback;
+        public final long slowestNs;
+        public final String identity;
+        private Controls(int max, int mode, int focal, boolean fallback, int denominator) {
+            maxIso=max; slowestMode=mode; equivalentFocalX10=focal; lensFallback=fallback;
+            this.denominator=denominator; slowestNs=Math.round(1e9 / denominator);
+            identity=REVISION+":"+max+":"+mode+":"+focal+":"+fallback+":"+slowestNs;
+        }
+    }
+}

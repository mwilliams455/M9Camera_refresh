+    private void forgetPrimaryPair() {
+        primaryPairThumb=null;
+        primaryPair=followedPair=Collections.emptyList();
+        primaryPairFrame=triedPairTarget=followedAt=0;
+        primaryPairOwner=-1;
+    }
+
+    private void rememberPrimaryPair(List<Box> candidates, Box selected, long frame) {
+        forgetPrimaryPair();
+        if (!selected.face || latestThumb==null || latestAt!=frame) return;
+        List<Box> faces=new ArrayList<>(2);
+        for (Box candidate : candidates) if (candidate.face) faces.add(candidate);
+        if (faces.size()!=2 || !faces.contains(selected)) return;
+        primaryPair=faces;
+        primaryPairOwner=faces.indexOf(selected);
+        primaryPairThumb=latestThumb;
+        primaryPairFrame=frame;
+        primaryPairSelection=automatic.selectionId();
+    }
+
+    private boolean startPrimaryMotion(long ticket, TrackingGeometry g) {
+        long span=latestAt-primaryPairFrame;
+        // The new sample's own display deadline must also fit inside the existing owner hold.
+        if (primaryPairThumb==null || triedPairTarget==latestAt || span<=0 ||
+                span>AutomaticSubjectSelection.HOLD_NS-AutomaticSubjectSelection.MAX_AGE_NS) return false;
+        final long origin=primaryPairFrame, target=latestAt;
+        final Bitmap before=primaryPairThumb, after=latestThumb;
+        final List<Box> faces=primaryPair;
+        triedPairTarget=target;
+        motionBusy=true;
+        headMotionWorker.execute(() -> {
+            List<Box> result=Collections.emptyList();
+            try { result=SceneHeadTracker.follow(before,after,faces); }
+            catch (RuntimeException | LinkageError | OutOfMemoryError ignored) { /* No verified pair. */ }
+            final List<Box> matched=result;
+            main.post(() -> {
+                motionBusy=false;
+                if (!accepts(ticket,g) || !boxVisible) return;
+                if (applyPrimaryMotion(origin,target,matched)) drawPersonFrames(g);
+                refreshHeads(ticket,g);
+            });
+        });
+        return true;
+    }
+
+    // Return true when the current preview was evaluated, including an unsuccessful match.
+    private boolean applyPrimaryMotion(long origin,long target,List<Box> matched) {
+        long age=SystemClock.elapsedRealtimeNanos()-target;
+        if (origin!=primaryPairFrame || target!=latestAt || primaryPairSelection!=automatic.selectionId()
+                || primaryPerson==null || age<0 || age>=AutomaticSubjectSelection.MAX_AGE_NS) {
+            if (headTrace!=null) headTrace.motion(origin,target,matched.size(),"primary_motion_superseded");
+            return false;
+        }
+        // follow preserves input order on success. Check both mappings and reject ambiguous overlap.
+        boolean both=primaryPair.size()==2 && matched.size()==2
+                && HeadContinuity.focusOwner(primaryPair.get(0),matched)==matched.get(0)
+                && HeadContinuity.focusOwner(primaryPair.get(1),matched)==matched.get(1);
+        followedPair=both ? matched : Collections.emptyList();
+        followedAt=both ? target : 0;
+        if (headTrace!=null) headTrace.motion(origin,target,matched.size(),
+                both ? "primary_motion_pair" : "primary_motion_unconfirmed");
+        return true;
+    }
+
+    private boolean hasFollowedPair(long now) {
+        return followedAt>0 && followedAt==latestAt && primaryPairSelection==automatic.selectionId()
+                && now>=followedAt && now-followedAt<AutomaticSubjectSelection.MAX_AGE_NS;
+    }

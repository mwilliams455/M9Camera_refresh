+    private void seedMeasuredPair() {
+        observedPair = confirmedHeads();
+        observedAt = now-217_000_000L;
+        previewAt = now;
+        Bitmap thumb=Bitmap.createBitmap(8,8,Bitmap.Config.ARGB_8888);
+        ReflectionHelpers.setField(controller,"latestThumb",thumb);
+        ReflectionHelpers.setField(controller,"latestAt",observedAt);
+        ReflectionHelpers.setField(controller,"primaryCandidates",observedPair);
+        ReflectionHelpers.setField(controller,"primaryPerson",observedPair.get(1));
+        ReflectionHelpers.setField(controller,"primaryAt",observedAt);
+        remember(observedPair,observedPair.get(1),observedAt);
+        ReflectionHelpers.setField(controller,"latestAt",previewAt);
+    }
+
+    private void remember(List<Box> measured,Box selected,long time) {
+        ReflectionHelpers.callInstanceMethod(controller,"rememberPrimaryPair",
+                ReflectionHelpers.ClassParameter.from(List.class,measured),
+                ReflectionHelpers.ClassParameter.from(Box.class,selected),
+                ReflectionHelpers.ClassParameter.from(long.class,time));
+    }
+
+    private boolean complete(List<Box> matched) {

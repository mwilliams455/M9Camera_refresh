+++ b/app/src/main/java/com/particlesdevs/photoncamera/m9/render/M9RenderDiagnostics.java
@@ -0,0 +1,31 @@
+package com.particlesdevs.photoncamera.m9.render;
+
+import com.particlesdevs.photoncamera.app.PhotonCamera;
+import com.particlesdevs.photoncamera.settings.SettingsManager;
+
+/** Optional expensive research work; never selects photographic processing. */
+public final class M9RenderDiagnostics {
+    public static final String REVISION = "M9PERF2S_AUDITOPT1A";
+    public static final String SAT_AUDIT_KEY = "pref_m9_full_frame_sat_audit";
+
+    private M9RenderDiagnostics() {}
+
+    public static boolean fullFrameSatAuditEnabled() {
+        return fullFrameSatAuditEnabled(PhotonCamera.getSettingsManagerStatic());
+    }
+
+    static boolean fullFrameSatAuditEnabled(SettingsManager settings) {
+        if (settings == null) return false;
+        try {
+            return settings.getBoolean(SettingsManager.SCOPE_GLOBAL, SAT_AUDIT_KEY, false);
+        } catch (NumberFormatException malformedPreference) {
+            // A damaged optional diagnostic preference must not prevent a photograph.
+            return false;
+        }
+    }
+
+    static boolean shouldRunSatAudit(boolean userEnabled, boolean legacyProbe,
+                                     int skyChromaMode, boolean inputEligible) {
+        return (userEnabled || legacyProbe) && skyChromaMode == 0 && inputEligible;
+    }
+}

diff --git a/app/src/test/java/com/particlesdevs/photoncamera/m9/render/M9RenderDiagnosticsTest.java b/app/src/test/java/com/particlesdevs/photoncamera/m9/render/M9RenderDiagnosticsTest.java
new file mode 100644
index 00000000..fbf40039
--- /dev/null
+++ b/app/src/test/java/com/particlesdevs/photoncamera/m9/render/M9RenderDiagnosticsTest.java
@@ -0,0 +1,49 @@
+package com.particlesdevs.photoncamera.m9.render;
+
+import com.particlesdevs.photoncamera.settings.SettingsManager;
+import org.junit.Test;
+import org.mockito.MockMakers;
+import static org.junit.Assert.*;
+import static org.mockito.Mockito.*;
+
+public class M9RenderDiagnosticsTest {
+    private SettingsManager settings() {
+        return mock(SettingsManager.class, withSettings().mockMaker(MockMakers.SUBCLASS));
+    }
+
+    @Test public void unsetPreferenceAndUnavailableSettingsLeaveAuditOff() {
+        assertFalse(M9RenderDiagnostics.fullFrameSatAuditEnabled(null));
+        SettingsManager settings = settings();
+        assertFalse(M9RenderDiagnostics.fullFrameSatAuditEnabled(settings));
+        verify(settings).getBoolean(SettingsManager.SCOPE_GLOBAL,
+                M9RenderDiagnostics.SAT_AUDIT_KEY, false);
+    }
+
+    @Test public void userCanEnableThenDisableWithoutRestarting() {
+        SettingsManager settings = settings();
+        when(settings.getBoolean(SettingsManager.SCOPE_GLOBAL,
+                M9RenderDiagnostics.SAT_AUDIT_KEY, false)).thenReturn(true, false);
+        assertTrue(M9RenderDiagnostics.fullFrameSatAuditEnabled(settings));
+        assertFalse(M9RenderDiagnostics.fullFrameSatAuditEnabled(settings));
+    }
+
+    @Test public void malformedOptionalPreferenceDoesNotRejectPhotograph() {
+        SettingsManager settings = settings();
+        when(settings.getBoolean(SettingsManager.SCOPE_GLOBAL,
+                M9RenderDiagnostics.SAT_AUDIT_KEY, false)).thenThrow(new NumberFormatException());
+        assertFalse(M9RenderDiagnostics.fullFrameSatAuditEnabled(settings));
+    }
+
+    @Test public void ordinaryCaptureSkipsAuditAndExplicitControlCanRunIt() {
+        assertFalse(M9RenderDiagnostics.shouldRunSatAudit(false, false, 0, true));
+        assertTrue(M9RenderDiagnostics.shouldRunSatAudit(true, false, 0, true));
+        assertTrue(M9RenderDiagnostics.shouldRunSatAudit(false, true, 0, true));
+    }
+
+    @Test public void optInDoesNotBypassControlModeOrMemoryLayoutGuards() {
+        for (int mode : new int[]{0, 1, 8, 9, 10}) {
+            assertFalse(M9RenderDiagnostics.shouldRunSatAudit(true, true, mode, false));
+            if (mode != 0) assertFalse(M9RenderDiagnostics.shouldRunSatAudit(true, true, mode, true));
+        }
+    }
+}

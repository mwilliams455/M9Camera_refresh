+    // Every measured face from the primary observation must map to a different new face.
+    private static Box pairOwner(Box primary,List<Box> candidates,List<Box> faces) {
+        if (faces.size()!=2) return null;
+        Box owner=HeadContinuity.focusOwner(primary,faces);
+        if (owner==null) return null;
+        int covered=0;
+        for (Box box : candidates) {
+            if (!box.face) continue;
+            Box match=HeadContinuity.focusOwner(box,faces);
+            if (match==null) return null;
+            int bit=match==faces.get(0) ? 1 : 2;
+            if ((covered & bit)!=0) return null;
+            covered |= bit;
+        }
+        return owner;
+    }

+            Imgproc.matchTemplate(region,pattern,response,Imgproc.TM_CCOEFF_NORMED);
+            Core.MinMaxLocResult best=Core.minMaxLoc(response);
+            if (best.maxVal<.80) return null;
+            int rad=Math.max(3,Math.round(.22f*Math.min(patch.width,patch.height)));
+            int x=(int)best.maxLoc.x,y=(int)best.maxLoc.y;
+            Imgproc.rectangle(response,new Point(Math.max(0,x-rad),Math.max(0,y-rad)),
+                    new Point(Math.min(response.cols()-1,x+rad),Math.min(response.rows()-1,y+rad)),Scalar.all(-1),-1);
+            if (best.maxVal-Core.minMaxLoc(response).maxVal<.055) return null;
+            return new Point(l+x,t+y);
+        } finally {
+            pattern.release(); region.release(); response.release(); mean.release(); sd.release();
+        }
+    }
+
+    @Override public void close() {
+        rgba.release(); bgr.release(); resized.release(); padded.release(); previous.release(); gray.release();
+    }
+}

+/** Runs on its own single-flight worker. The native model outputs cx,cy,w,h in padded input pixels. */
+final class SceneHeadTracker implements AutoCloseable {
+    private static final int SIZE = 640;
+    private static final int ANCHORS = 8400;
+    private static final int MAX_DETECTIONS = 24;
+    private static final List<String> OUTPUTS = Arrays.asList("boxes","scores","classes");
+    private final Net network;
+    private final HeadContinuity tracker = new HeadContinuity();
+    private final Mat rgba = new Mat(), bgr = new Mat(), resized = new Mat();
+    private final Mat padded = new Mat(SIZE,SIZE,CvType.CV_8UC3);
+    private Mat previous = new Mat(), gray = new Mat();
+    private final float[] coords = new float[4*ANCHORS], scores = new float[ANCHORS], classes = new float[ANCHORS];
+    private long epoch = Long.MIN_VALUE;
+
+    static SceneHeadTracker open(Context context) throws IOException {
+        if (!OpenCVLoader.initLocal()) throw new IOException("OpenCV unavailable");
+        File temp = File.createTempFile("subject-head-", ".onnx", context.getCacheDir());
+        try {
+            try (InputStream in = context.getAssets().open("person_head.onnx");
+                 FileOutputStream out = new FileOutputStream(temp)) {
+                byte[] buffer = new byte[65536];
+                for (int count; (count=in.read(buffer)) != -1;) out.write(buffer,0,count);
+            }
+            return new SceneHeadTracker(Dnn.readNetFromONNX(temp.getAbsolutePath()));
+        } finally {
+            temp.delete();
+        }
+    }
+
+    private SceneHeadTracker(Net network) { this.network=network; }
+
+    List<Box> detect(Bitmap sample, long ticket, long frame) {
+        if (ticket != epoch || previous.cols() != sample.getWidth() || previous.rows() != sample.getHeight()) {
+            tracker.reset();
+            previous.release();
+            epoch=ticket;
+        }
+        Utils.bitmapToMat(sample,rgba);
+        Imgproc.cvtColor(rgba,bgr,Imgproc.COLOR_RGBA2BGR);
+        Imgproc.cvtColor(bgr,gray,Imgproc.COLOR_BGR2GRAY);
+        int w=bgr.cols(), h=bgr.rows();
+        double scale=(double)SIZE/Math.max(w,h);
+        int rw=Math.max(1,(int)(w*scale)), rh=Math.max(1,(int)(h*scale));
+        int x=(SIZE-rw)/2, y=(SIZE-rh)/2;
+        padded.setTo(Scalar.all(114));
+        Imgproc.resize(bgr,resized,new Size(rw,rh));
+        Mat roi=padded.submat(new Rect(x,y,rw,rh));
+        try { resized.copyTo(roi); } finally { roi.release(); }
+        Mat blob=Dnn.blobFromImage(padded,1.0/255.0);
+        List<Mat> out=new ArrayList<>();
+        try {
+            network.setInput(blob);
+            network.forward(out,OUTPUTS);
+            read(out.get(0),coords);
+            read(out.get(1),scores);
+            read(out.get(2),classes);
+        } finally {
+            blob.release();
+            for (Mat m : out) m.release();
+        }
+        List<Candidate> heads=new ArrayList<>(), bodies=new ArrayList<>();
+        for (int i=0;i<ANCHORS;i++) {
+            if (!Float.isFinite(scores[i]) || scores[i]<.35f || scores[i]>1f) continue;
+            int j=4*i;
+            float left=(coords[j]-coords[j+2]*.5f-x)/rw, top=(coords[j+1]-coords[j+3]*.5f-y)/rh;
+            float right=(coords[j]+coords[j+2]*.5f-x)/rw, bottom=(coords[j+1]+coords[j+3]*.5f-y)/rh;
+            if (!(left<right && top<bottom && right>0 && bottom>0 && left<1 && top<1)) continue;
+            Candidate c=new Candidate("person",scores[i],Math.max(0,left),Math.max(0,top),Math.min(1,right),Math.min(1,bottom));
+            if (classes[i]==1f) heads.add(c);
+            else if (classes[i]==0f) bodies.add(c);

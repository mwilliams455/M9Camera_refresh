+            dx=median(xs,count)/w; dy=median(ys,count)/h;
+            if (Math.abs(dx)>.7*head.width() || Math.abs(dy)>.7*head.height() || head.left+dx<0
+                    || head.top+dy<0 || head.right+dx>1 || head.bottom+dy>1) return null;
+            return new Point(dx,dy);
+        } finally {
+            region.release(); corners.release(); from.release(); to.release(); back.release();
+            forwardStatus.release(); backStatus.release(); error.release(); backError.release();
+        }
+    }
+
+    private static Candidate locate(Mat previous,Mat gray,Candidate head) {
+        if (previous.empty()) return null;
+        int w=gray.cols(), h=gray.rows();
+        int l=Math.round((head.left+.13f*head.width())*w), r=Math.round((head.right-.13f*head.width())*w);
+        int t=Math.round((head.top+.13f*head.height())*h), b=Math.round((head.bottom-.13f*head.height())*h);
+        if (Math.min(r-l,b-t)<7) return null;
+        Rect patch=new Rect(l,t,r-l,b-t);
+        int pad=Math.max(7,Math.round(.45f*Math.max(head.width()*w,head.height()*h)));
+        Point f=match(previous,gray,patch,pad);
+        if (f==null) return null;
+        Point back=match(gray,previous,new Rect((int)f.x,(int)f.y,r-l,b-t),pad);
+        if (back==null || Math.hypot(back.x-l,back.y-t)>Math.max(2,.06f*Math.min(head.width()*w,head.height()*h)))
+            return null;
+        float dx=(float)(f.x-l)/w, dy=(float)(f.y-t)/h;
+        if (head.left+dx<0 || head.right+dx>1 || head.top+dy<0 || head.bottom+dy>1) return null;
+        return new Candidate("person",head.score,head.left+dx,head.top+dy,head.right+dx,head.bottom+dy);
+    }
+
+    private static Point match(Mat from,Mat to,Rect patch,int pad) {
+        int l=Math.max(0,patch.x-pad), t=Math.max(0,patch.y-pad);
+        int r=Math.min(to.cols(),patch.x+patch.width+pad), b=Math.min(to.rows(),patch.y+patch.height+pad);
+        Mat pattern=from.submat(patch), region=to.submat(new Rect(l,t,r-l,b-t)), response=new Mat();
+        org.opencv.core.MatOfDouble mean=new org.opencv.core.MatOfDouble(), sd=new org.opencv.core.MatOfDouble();

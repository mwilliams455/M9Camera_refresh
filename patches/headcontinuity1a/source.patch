+            for (Point p : points) { p.x+=l; p.y+=t; }
+            from.fromArray(points);
+            Size window=new Size(15,15);
+            TermCriteria criteria=new TermCriteria(TermCriteria.COUNT|TermCriteria.EPS,20,.03);
+            Video.calcOpticalFlowPyrLK(before,after,from,to,forwardStatus,error,window,2,criteria);
+            Video.calcOpticalFlowPyrLK(after,before,to,back,backStatus,backError,window,2,criteria);

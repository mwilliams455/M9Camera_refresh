+                        returned[i].x-points[i].x,returned[i].y-points[i].y)<1.1;
+                if (reliable[i]) {
+                    xs[count]=moved[i].x-points[i].x;
+                    ys[count++]=moved[i].y-points[i].y;
+                }
+            }
+            if (count<Math.max(5,points.length*.60)) return null;
+            double dx=median(xs,count), dy=median(ys,count);
+            double spread=Math.max(1.6,.09*Math.min(width,height));
+            double minX=w,maxX=0,minY=h,maxY=0;
+            count=0;
+            for (int i=0;i<points.length;i++) {
+                double x=moved[i].x-points[i].x, y=moved[i].y-points[i].y;
+                if (!reliable[i] || Math.hypot(x-dx,y-dy)>=spread) continue;
+                xs[count]=x;
+                ys[count++]=y;
+                minX=Math.min(minX,points[i].x); maxX=Math.max(maxX,points[i].x);
+                minY=Math.min(minY,points[i].y); maxY=Math.max(maxY,points[i].y);

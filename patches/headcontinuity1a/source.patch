+        return (values[(count-1)/2]+values[count/2])*.5;
+    }
+
+    /** Allow a turning head to change shape if its interior features move together in both directions. */
+    private static Point featureMotion(Mat before,Mat after,Candidate head) {
+        int w=before.cols(), h=before.rows();
+        double width=head.width()*w, height=head.height()*h;
+        int l=(int)((head.left+.12f*head.width())*w), t=(int)((head.top+.12f*head.height())*h);

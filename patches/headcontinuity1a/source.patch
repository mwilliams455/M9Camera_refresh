+    /** Recheck late detections against a newer preview sample before drawing them. */
+    static List<Box> follow(Bitmap reference, Bitmap current, List<Box> heads) {
+        List<Box> result=new ArrayList<>();
+        if (reference.getWidth()!=current.getWidth() || reference.getHeight()!=current.getHeight()) return result;

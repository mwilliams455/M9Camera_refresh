+    private static void read(Mat tensor,float[] target) {
+        if (tensor.type()!=CvType.CV_32F || tensor.total()!=target.length)
+            throw new IllegalStateException("Unexpected head detector tensor");
+        tensor.get(new int[tensor.dims()],target);
+    }

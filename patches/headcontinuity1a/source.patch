+package com.particlesdevs.photoncamera.control.subject;
+
+import com.particlesdevs.photoncamera.control.subject.AutomaticSubjectSelection.Box;
+import com.particlesdevs.photoncamera.control.tracking.SubjectAnchorPolicy.Candidate;
+import com.particlesdevs.photoncamera.control.tracking.SubjectAnchorPolicy.ClassId;
+import java.util.ArrayList;
+import java.util.Collections;
+import java.util.List;
+
+/** Tracks independently observed heads in upright preview coordinates. Results are viewfinder hints. */
+public final class HeadContinuity {
+    public interface Motion {
+        Candidate locate(Candidate previous);
+    }
+
+    private static final long GAP_NS = 600_000_000L;
+    private static final int MAX_TRACKS = 8;
+    private long lastFrame;
+    private List<Candidate> pending = Collections.emptyList();
+    private List<Track> tracks = Collections.emptyList();
+
+    private static final class Track {
+        final Candidate head;
+        final long observed;
+        final boolean visible;
+
+        Track(Candidate head, long observed, boolean visible) {
+            this.head = head;
+            this.observed = observed;
+            this.visible = visible;
+        }
+    }
+
+    public void reset() {
+        pending = Collections.emptyList();
+        tracks = Collections.emptyList();
+        lastFrame = 0;
+    }
+
+    public static float overlap(Candidate a, Candidate b) {
+        float w = Math.max(0f, Math.min(a.right,b.right)-Math.max(a.left,b.left));
+        float h = Math.max(0f, Math.min(a.bottom,b.bottom)-Math.max(a.top,b.top));
+        float intersection = w*h;
+        return intersection/(a.width()*a.height()+b.width()*b.height()-intersection);
+    }
+
+    private static boolean supports(Candidate h, Candidate b) {
+        return h.score >= .40f && b.score >= .35f
+                && h.cx() > b.left-.05f*b.width() && h.cx() < b.right+.05f*b.width()
+                && h.cy() > b.top-.85f*h.height() && h.cy() < b.top+.38f*b.height()
+                && h.height() < .70f*b.height() && h.width() < .87f*b.width();
+    }
+
+    private static boolean higherHead(Candidate head, List<Candidate> heads) {
+        for (Candidate other : heads) {
+            float rise = head.top-other.top;
+            if (other != head && other.score >= .40f && rise > 0 && rise < 1.25f*head.height()
+                    && Math.abs(other.cx()-head.cx()) < .62f*head.width()
+                    && other.bottom > head.top-.25f*head.height()) return true;
+        }
+        return false;
+    }
+
+    private static List<Candidate> supported(List<Candidate> heads, List<Candidate> bodies) {
+        Candidate[] best = new Candidate[bodies.size()];
+        for (Candidate head : heads) {
+            int owner = -1;
+            for (int i=0; i<bodies.size(); i++) {
+                if (!supports(head,bodies.get(i))) continue;
+                if (owner >= 0) { owner = -1; break; }
+                owner = i;
+            }
+            if (owner >= 0 && (best[owner] == null || head.score > best[owner].score)) best[owner] = head;
+        }
+        List<Candidate> result = new ArrayList<>();
+        for (Candidate head : best) if (head != null && !higherHead(head,heads)) result.add(head);
+        return result;
+    }
+
+    private static Candidate unique(Candidate head, List<Candidate> options, float minimum) {
+        Candidate match = null;
+        for (Candidate candidate : options) {
+            if (overlap(head,candidate) < minimum) continue;
+            if (match != null) return null;
+            match = candidate;
+        }
+        return match;
+    }
+
+    private static boolean overlapsAny(Candidate h, List<Candidate> options, float limit) {
+        for (Candidate option : options) if (overlap(h,option) >= limit) return true;
+        return false;
+    }
+
+    public List<Box> observe(long frame, List<Candidate> heads, List<Candidate> bodies, Motion motion) {
+        if (frame <= lastFrame) return Collections.emptyList();
+        if (frame-lastFrame > GAP_NS) reset();
+        lastFrame = frame;
+        List<Candidate> strong = supported(heads,bodies);
+        List<Track> next = new ArrayList<>();
+        List<Candidate> occupied = new ArrayList<>(), visible = new ArrayList<>(), used = new ArrayList<>();
+        for (Track old : tracks) {
+            if (frame-old.observed > GAP_NS) continue;
+            Candidate position = old.visible ? motion.locate(old.head) : null;
+            Candidate found = unique(position != null ? position : old.head, heads,.32f);
+            boolean current = found != null && !used.contains(found)
+                    && (strong.contains(found) || (found.score >= .43f
+                        && (overlap(old.head,found) >= .65f || (position != null && overlap(position,found) >= .44f))));
+            if (current) {
+                used.add(found);
+                visible.add(found);
+                next.add(new Track(found,frame,true));
+                occupied.add(found);
+            } else if (position != null && !overlapsAny(position,strong,.25f)
+                    && !overlapsAny(position,visible,.25f)) {
+                visible.add(position);
+                next.add(new Track(position,old.observed,true));
+                occupied.add(position);
+            } else if (frame-old.observed < GAP_NS) {
+                // Remember the identity briefly. A missed match has no visible rectangle.
+                next.add(new Track(old.head,old.observed,false));
+                occupied.add(old.head);
+            }
+        }
+        for (Candidate head : strong) {
+            if (next.size() >= MAX_TRACKS) break;
+            if (unique(head,pending,.35f) != null && !overlapsAny(head,occupied,.25f)) {
+                visible.add(head);
+                next.add(new Track(head,frame,true));
+                occupied.add(head);
+            }
+        }
+        tracks = next;
+        pending = strong;
+        List<Box> boxes = new ArrayList<>();
+        for (Candidate h : visible) boxes.add(Box.fromHead(h.left,h.top,h.right,h.bottom,0));
+        return boxes;
+    }
+
+    /** Only replace the main square when exactly one indicated head belongs to the selected person. */
+    public static Box focusOwner(Box selected, List<Box> heads) {
+        if (selected == null || selected.type != ClassId.PERSON || heads.size() < 2) return null;
+        Box result = null;
+        for (Box h : heads) {
+            if (selected.face) {
+                float dx = Math.abs(selected.cx()-h.cx()), dy = Math.abs(selected.cy()-h.cy());
+                if (dx >= .45f*Math.max(selected.right-selected.left,h.right-h.left)
+                        || dy >= .45f*Math.max(selected.bottom-selected.top,h.bottom-h.top)) continue;
+            } else if (h.cx() < selected.left || h.cx() > selected.right
+                    || h.cy() < selected.top-.85f*(h.bottom-h.top)
+                    || h.cy() > selected.top+.48f*(selected.bottom-selected.top)) continue;
+            if (result != null) return null;
+            result=h;
+        }
+        return result;
+    }
+}
